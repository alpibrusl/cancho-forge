edition 9;

import std.bytes;
import std.json;
import std.test;
import forge.patch_check;

// Unit tests for src/patch_check.cho: the bounds Forge puts on a `repo.change` patch (docs/company-lifecycle.md section 4.2 item 3).
// Run with `cancho test`.

fn operator() -> [] &static [byte] {
    return "{\"allow\":[\"src/**\",\"tests/**\"],\"deny\":[\"src/secret/**\"]}";
}

fn good_patch() -> [] &static [byte] {
    return "diff -ruN base/src/a.cho tree/src/a.cho\n--- base/src/a.cho\t2026-01-01 00:00:00.000000000 +0000\n+++ tree/src/a.cho\t2026-01-01 00:00:01.000000000 +0000\n@@ -1,2 +1,3 @@\n one\n+two\n three\n";
}

fn verdict[&h, &p](heap: &!h Heap, patch: &p [byte], max_files: int, max_lines: int) -> [heap] patch_check.Verdict {
    let text = operator();
    var v = patch_check.Verdict { code: 99, files: 0, added: 0 };
    let tape = box_slice(heap, json.tape_len(text), 0);
    borrow mut tape as &!tw in {
        let tp = contents(tw);
        if json.parse(text, tp) > 0 {
            v = patch_check.check(patch, text, tp, json.get(text, tp, 0, "allow"), json.get(text, tp, 0, "deny"), max_files, max_lines);
        }
    }
    unbox_slice(heap, tape);
    return v;
}

fn code[&h, &p](heap: &!h Heap, patch: &p [byte]) -> [heap] int {
    return verdict(heap, patch, 5, 100).code;
}

fn test_a_patch_inside_the_row_is_held_and_counted[&h](heap: &!h Heap) -> [heap] int {
    let v = verdict(heap, good_patch(), 5, 100);
    test.assert_eq(v.code, 0);
    test.assert_eq(v.files, 1);
    test.assert_eq(v.added, 1);
    return 0;
}

fn test_a_new_file_and_two_files_are_counted[&h](heap: &!h Heap) -> [heap] int {
    let two = "--- base/src/new.cho\t1970-01-01 00:00:00 +0000\n+++ tree/src/new.cho\t2026-01-01 00:00:01 +0000\n@@ -0,0 +1,2 @@\n+edition 7;\n+fn a() {}\n\\ No newline at end of file\n--- base/tests/n_test.cho\n+++ tree/tests/n_test.cho\n@@ -1 +1 @@\n-x\n+y\n";
    let v = verdict(heap, two, 5, 100);
    test.assert_eq(v.code, 0);
    test.assert_eq(v.files, 2);
    test.assert_eq(v.added, 3);
    return 0;
}

fn test_a_patch_outside_publish_allow_is_patch_path_denied[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(code(heap, "--- base/docs/a.md\n+++ tree/docs/a.md\n@@ -1 +1 @@\n-x\n+y\n"), patch_check.path_denied());
    test.assert_eq(code(heap, "--- base/README.md\n+++ tree/README.md\n@@ -1 +1 @@\n-x\n+y\n"), patch_check.path_denied());
    return 0;
}

fn test_a_patch_inside_publish_deny_is_patch_path_denied[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(code(heap, "--- base/src/secret/k.cho\n+++ tree/src/secret/k.cho\n@@ -1 +1 @@\n-x\n+y\n"), patch_check.path_denied());
    return 0;
}

fn test_a_path_that_leaves_or_hides_is_patch_path_denied[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(code(heap, "--- base/src/../.git/config\n+++ tree/src/../.git/config\n@@ -1 +1 @@\n-x\n+y\n"), patch_check.path_denied());
    test.assert_eq(code(heap, "--- base//etc/passwd\n+++ tree//etc/passwd\n@@ -1 +1 @@\n-x\n+y\n"), patch_check.path_denied());
    test.assert_eq(code(heap, "--- base/src/a b.cho\n+++ tree/src/a b.cho\n@@ -1 +1 @@\n-x\n+y\n"), patch_check.path_denied());
    return 0;
}

fn test_a_patch_with_a_rename_is_patch_kind_invalid[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(code(heap, "diff --git a/src/a.cho b/src/b.cho\nsimilarity index 100%\nrename from src/a.cho\nrename to src/b.cho\n"), patch_check.kind_invalid());
    test.assert_eq(code(heap, "rename from src/a.cho\n--- base/src/a.cho\n+++ tree/src/a.cho\n@@ -1 +1 @@\n-x\n+y\n"), patch_check.kind_invalid());
    return 0;
}

fn test_a_patch_with_a_mode_change_or_a_binary_hunk_is_patch_kind_invalid[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(code(heap, "old mode 100644\nnew mode 100755\n--- base/src/a.cho\n+++ tree/src/a.cho\n@@ -1 +1 @@\n-x\n+y\n"), patch_check.kind_invalid());
    test.assert_eq(code(heap, "Binary files base/src/a.cho and tree/src/a.cho differ\n"), patch_check.kind_invalid());
    test.assert_eq(code(heap, "--- base/src/a.cho\n+++ tree/src/a.cho\nGIT binary patch\nliteral 3\n"), patch_check.kind_invalid());
    return 0;
}

fn test_an_empty_truncated_or_unprefixed_patch_is_patch_kind_invalid[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(code(heap, ""), patch_check.kind_invalid());
    test.assert_eq(code(heap, "hello\n"), patch_check.kind_invalid());
    test.assert_eq(code(heap, "--- base/src/a.cho\n+++ tree/src/a.cho\n@@ -1,3 +1,3 @@\n x\n"), patch_check.kind_invalid());
    test.assert_eq(code(heap, "--- a/src/a.cho\n+++ b/src/a.cho\n@@ -1 +1 @@\n-x\n+y\n"), patch_check.kind_invalid());
    test.assert_eq(code(heap, "--- base/src/a.cho\n+++ tree/src/b.cho\n@@ -1 +1 @@\n-x\n+y\n"), patch_check.kind_invalid());
    test.assert_eq(code(heap, "@@ -1 +1 @@\n-x\n+y\n"), patch_check.kind_invalid());
    test.assert_eq(code(heap, "--- base/src/a.cho\n+++ tree/src/a.cho\n@@ -1 +1 @@\n-x\n+y\njunk\n"), patch_check.kind_invalid());
    test.assert_eq(code(heap, "--- base/src/a.cho\n+++ tree/src/a.cho\n@@ -x +1 @@\n-x\n+y\n"), patch_check.kind_invalid());
    return 0;
}

fn test_a_line_that_looks_like_a_header_inside_a_hunk_is_a_line_of_the_hunk[&h](heap: &!h Heap) -> [heap] int {
    // the removed line is `-- base/docs/x.md` and the added one `++ tree/docs/x.md`: written with their hunk markers
    let p = "--- base/src/a.cho\n+++ tree/src/a.cho\n@@ -1 +1 @@\n--- base/docs/x.md\n+++ tree/docs/x.md\n";
    let v = verdict(heap, p, 5, 100);
    test.assert_eq(v.code, 0);
    test.assert_eq(v.files, 1);
    return 0;
}

fn test_a_patch_over_max_patch_lines_or_files_is_patch_too_large[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(verdict(heap, good_patch(), 5, 1).code, 0);
    test.assert_eq(verdict(heap, good_patch(), 5, 0).code, patch_check.too_large());
    let two = "--- base/src/a.cho\n+++ tree/src/a.cho\n@@ -1 +1 @@\n-x\n+y\n--- base/src/b.cho\n+++ tree/src/b.cho\n@@ -1 +1 @@\n-x\n+y\n";
    test.assert_eq(verdict(heap, two, 2, 100).code, 0);
    test.assert_eq(verdict(heap, two, 1, 100).code, patch_check.too_large());
    return 0;
}

fn test_kind_outranks_path_and_path_outranks_size[&h](heap: &!h Heap) -> [heap] int {
    let denied_big = "--- base/docs/a.md\n+++ tree/docs/a.md\n@@ -0,0 +1,2 @@\n+a\n+b\n";
    test.assert_eq(verdict(heap, denied_big, 5, 1).code, patch_check.path_denied());
    test.assert_eq(code(heap, "rename from x\n--- base/docs/a.md\n+++ tree/docs/a.md\n@@ -1 +1 @@\n-x\n+y\n"), patch_check.kind_invalid());
    return 0;
}

fn test_the_patch_rule_tags_are_the_documented_ones() -> [] int {
    test.assert(bytes.equal(patch_check.rule_name(1), "patch-kind-invalid"));
    test.assert(bytes.equal(patch_check.rule_name(2), "patch-path-denied"));
    test.assert(bytes.equal(patch_check.rule_name(3), "patch-too-large"));
    test.assert_eq(len(patch_check.rule_name(0)), 0);
    return 0;
}
