edition 9;

import std.buffer;
import std.test;
import forge.review_verdict;

// Unit tests for src/review_verdict.cho (docs/review-step.md section 6): what Forge accepts as a model reviewer's reply. Run with `cancho test`.

fn judge_of[&h, &r](heap: &!h Heap, reply: &r [byte]) -> [heap] int {
    return review_verdict.judge(heap, reply);
}

fn one_item() -> [] &static [byte] {
    return "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"src/a.cho\",\"line\":12,\"claim\":\"the bound is off by one\"}]}";
}

fn test_a_reply_of_approve_with_no_items_is_approve[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(judge_of(heap, "{\"verdict\":\"approve\",\"items\":[]}"), review_verdict.approve());
    test.assert_eq(judge_of(heap, "{\"items\":[],\"verdict\":\"approve\"}"), review_verdict.approve());
    return 0;
}

fn test_a_reply_of_concerns_with_items_is_concerns[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(judge_of(heap, one_item()), review_verdict.concerns());
    return 0;
}

fn test_approve_with_items_and_concerns_without_are_unparsed[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(judge_of(heap, "{\"verdict\":\"approve\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"x\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[]}"), review_verdict.unparsed());
    return 0;
}

fn test_anything_around_the_object_is_unparsed[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(judge_of(heap, ""), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "Here it is: {\"verdict\":\"approve\",\"items\":[]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"approve\",\"items\":[]} thanks"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "```json\n{\"verdict\":\"approve\",\"items\":[]}\n```"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"approve\",\"items\":[]}{\"verdict\":\"approve\",\"items\":[]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "[{\"verdict\":\"approve\",\"items\":[]}]"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"approve\",\"items\":"), review_verdict.unparsed());
    return 0;
}

fn test_a_missing_extra_or_repeated_key_is_unparsed[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(judge_of(heap, "{\"verdict\":\"approve\"}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"items\":[]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"approve\",\"items\":[],\"note\":\"fine\"}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"approve\",\"verdict\":\"approve\"}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"x\",\"why\":\"y\"}]}"), review_verdict.unparsed());
    return 0;
}

fn test_a_verdict_other_than_the_two_words_is_unparsed[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(judge_of(heap, "{\"verdict\":\"Approve\",\"items\":[]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"approved\",\"items\":[]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"\",\"items\":[]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":1,\"items\":[]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":true,\"items\":[]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"approve\",\"items\":null}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"approve\",\"items\":{}}"), review_verdict.unparsed());
    return 0;
}

fn test_the_line_is_a_whole_number_from_0_to_10_million[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":0,\"claim\":\"x\"}]}"), review_verdict.concerns());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":10000000,\"claim\":\"x\"}]}"), review_verdict.concerns());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":10000001,\"claim\":\"x\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":-1,\"claim\":\"x\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1.5,\"claim\":\"x\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":\"3\",\"claim\":\"x\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":99999999999999999999,\"claim\":\"x\"}]}"), review_verdict.unparsed());
    return 0;
}

fn test_a_file_is_1_to_200_bytes_and_a_claim_1_to_400[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"\",\"line\":1,\"claim\":\"x\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"line\":1,\"claim\":\"x\"}]}"), review_verdict.concerns());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"line\":1,\"claim\":\"x\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"\"}]}"), review_verdict.concerns());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"\"}]}"), review_verdict.unparsed());
    return 0;
}

fn test_a_string_with_a_control_or_a_non_ascii_byte_is_unparsed[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"a\\nb\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"café\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"a\tb\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a b/c~d\",\"line\":1,\"claim\":\"~!@#$%^&*()_+ `-=[]{};':,./<>? |\"}]}"), review_verdict.concerns());
    return 0;
}

fn test_at_most_20_items[&h](heap: &!h Heap) -> [heap] int {
    let twenty = "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"}]}";
    let twenty_one = "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"},{\"file\":\"a\",\"line\":1,\"claim\":\"x\"}]}";
    test.assert_eq(judge_of(heap, twenty), review_verdict.concerns());
    test.assert_eq(judge_of(heap, twenty_one), review_verdict.unparsed());
    return 0;
}

// A good reply, every prefix of it, and every position changed to each of eight bytes: each is a verdict (a value), never a trap, and no prefix is accepted.
fn test_every_truncation_and_every_single_byte_change_is_a_verdict[&h](heap: &!h Heap) -> [heap] int {
    let text = one_item();
    let n = len(text);
    var cut = 0;
    while cut < n {
        test.assert_eq(judge_of(heap, text[0..cut]), review_verdict.unparsed());
        cut = cut + 1;
    }
    let swaps = "\"{}[:,x\n";
    var at = 0;
    while at < n {
        var k = 0;
        while k < len(swaps) {
            var copy = buffer.empty(heap, n + 1);
            var j = 0;
            while j < n {
                if j == at {
                    copy = buffer.push(heap, copy, swaps[k]);
                } else {
                    copy = buffer.push(heap, copy, text[j]);
                }
                j = j + 1;
            }
            borrow copy as &cb in {
                let v = judge_of(heap, buffer.bytes(cb));
                test.assert(v == review_verdict.approve() || v == review_verdict.concerns() || v == review_verdict.unparsed());
            }
            buffer.drop(heap, copy);
            k = k + 1;
        }
        at = at + 1;
    }
    return 0;
}

// The replies of the I-1 measurement (i1-reviewer/, tests/fixtures/review_replies/): real Sonnet replies whose claims quote code, so they carry `\"` and `\\`.
// Forge held 21 of 46 of them as unparsed because of those escapes; each is one valid JSON object and now parses.
fn real_f_div_split() -> [] &static [byte] {
    return "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"src/diff.cho\",\"line\":109,\"claim\":\"`total / 2 + grown / 2` truncates each half separately; `total` and `grown` always have the same parity, so when both are odd the result is one too small, e.g. `diff_stat(heap, \\\"\\\", \\\"x\\\\n\\\")` gives (0, 1) instead of (1, 0).\"},{\"file\":\"src/diff.cho\",\"line\":109,\"claim\":\"The correct formula is `(total + grown) / 2`; with the split form, inputs like total=5, grown=3 give added=3 and removed=2 instead of 4 and 1, so the pair is wrong whenever the line count changes by an odd amount.\"},{\"file\":\"tests/diff_test.cho\",\"line\":232,\"claim\":\"All five `diff_stat` tests have an even `total` (2, 2, 3 with grown -3 where truncation happens to hide the bug, 2, 4), so no test covers the odd-sum case with a positive growth, e.g. adding one line to an empty text, and the bug above passes.\"}]}";
}

fn real_f_trailing_nl() -> [] &static [byte] {
    return "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"src/diff.cho\",\"line\":108,\"claim\":\"The fast path returns (0, 0) whenever `b` is `a` plus one trailing line feed, which is wrong for `a` = 'a\\\\n' and `b` = 'a\\\\n\\\\n' (should be (1, 0)), for `a` = '' and `b` = '\\\\n' (should be (1, 0)), and for `a` = 'x' and `b` = 'x\\\\n' (should be (1, 1)), so the sum no longer equals `edit_count`.\"},{\"file\":\"src/diff.cho\",\"line\":108,\"claim\":\"The early return is unnecessary: the general formula below it already gives (0, 0) for equal texts, so the extra branch only adds the wrong results above.\"},{\"file\":\"tests/diff_test.cho\",\"line\":231,\"claim\":\"No test covers equal texts, a final line without a line feed, or `b` equal to `a` plus a trailing line feed, so the fast-path bug goes undetected.\"}]}";
}

fn real_f_nonl() -> [] &static [byte] {
    return "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"src/diff.cho\",\"line\":108,\"claim\":\"`grown` is computed as `len(b) / 40 - len(a) / 40`, which is a byte length divided by 40 and not the difference of the line counts of `b` and `a`, so `added` and `removed` are wrong.\"},{\"file\":\"src/diff.cho\",\"line\":109,\"claim\":\"`added = (total + grown) / 2` relies on `grown` being the true line-count difference; with the byte-based `grown`, `diff_stat(heap, \\\"\\\", \\\"x\\\\ny\\\\n\\\")` gives (1, 1) instead of (2, 0).\"},{\"file\":\"tests/diff_test.cho\",\"line\":240,\"claim\":\"`test_diff_stat_2` and `test_diff_stat_3` expect (2, 0) and (0, 3), but the implementation returns (1, 1) and (2, 1) for them, so the new tests would fail the gate.\"}]}";
}

fn test_real_replies_with_escaped_quotes_and_backslashes_parse[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(judge_of(heap, real_f_div_split()), review_verdict.concerns());
    test.assert_eq(judge_of(heap, real_f_trailing_nl()), review_verdict.concerns());
    test.assert_eq(judge_of(heap, real_f_nonl()), review_verdict.concerns());
    return 0;
}

fn test_the_valid_json_escapes_that_decode_to_printable_ascii_parse[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"say \\\"x\\\"\"}]}"), review_verdict.concerns());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"a\\\\nb is a backslash and an n\"}]}"), review_verdict.concerns());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"a\\/b\"}]}"), review_verdict.concerns());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"\\u0041\\u007e\"}]}"), review_verdict.concerns());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"\\\\\"}]}"), review_verdict.concerns());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"\\\"\"}]}"), review_verdict.concerns());
    return 0;
}

fn test_an_escape_that_decodes_to_a_control_or_non_ascii_byte_is_unparsed[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"a\\nb\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"a\\tb\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"a\\rb\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"a\\u0000b\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"a\\u001fb\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"a\\u007fb\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"caf\\u00e9\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"\\u20ac\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"\\ud83d\\ude00\"}]}"), review_verdict.unparsed());
    return 0;
}

fn test_a_malformed_escape_is_unparsed[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"a\\xb\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"a\\u12b\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"a\\uZZZZ\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"a\\ud800b\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"a\\\"}]}"), review_verdict.unparsed());
    return 0;
}

fn test_the_length_bound_is_on_the_decoded_value[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\"}]}"), review_verdict.concerns());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\\u0061\"}]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"}]}"), review_verdict.concerns());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\",\"line\":1,\"claim\":\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"}]}"), review_verdict.unparsed());
    return 0;
}

fn test_an_escaped_verdict_word_or_file_is_judged_by_value[&h](heap: &!h Heap) -> [heap] int {
    test.assert_eq(judge_of(heap, "{\"verdict\":\"appro\\u0076e\",\"items\":[]}"), review_verdict.unparsed());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"src/\\\"a\\\".cho\",\"line\":1,\"claim\":\"x\"}]}"), review_verdict.concerns());
    test.assert_eq(judge_of(heap, "{\"verdict\":\"concerns\",\"items\":[{\"file\":\"a\\n\",\"line\":1,\"claim\":\"x\"}]}"), review_verdict.unparsed());
    return 0;
}
