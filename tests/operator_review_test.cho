    test.assert(reason_of(heap, "{\"review\":{\"worker\":\"repo_review\",\"provider\":\"anthropic\",\"model\":\"claude-sonnet-5-5\",\"key_file\":\"/k/key\",\"host\":\"-a\",\"max_tokens\":2048,\"max_diff_bytes\":65536,\"mode\":\"advisory\"}}") == false);
