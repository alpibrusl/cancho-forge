edition 9;

import std.buffer;
import std.bytes;
import std.test;
import forge.patch_apply;

// Unit tests for src/patch_apply.cho (docs/company.md section 21): a `diff -ruN base tree` patch applied strictly, in cancho. Run with `cancho test`.

// The result and the code of applying the first section of `patch` to `original`.
fn applied[&h, &p, &o](heap: &!h Heap, patch: &p [byte], original: &o [byte]) -> [heap] (buffer.Buffer, int) {
    let s = patch_apply.next_section(patch, 0);
    if s.found == false {
        return (buffer.empty(heap, 1), 0 - 1);
    }
    return patch_apply.apply_section(heap, patch[s.body..s.end], original);
}

fn same[&h, &p, &o, &w](heap: &!h Heap, patch: &p [byte], original: &o [byte], want: &w [byte]) -> [heap] bool {
    let (out, code) = applied(heap, patch, original);
    var ok = false;
    borrow out as &ob in {
        ok = code == 0 && bytes.equal(buffer.bytes(ob), want);
    }
    buffer.drop(heap, out);
    return ok;
}

fn code_of[&h, &p, &o](heap: &!h Heap, patch: &p [byte], original: &o [byte]) -> [heap] int {
    let (out, code) = applied(heap, patch, original);
    buffer.drop(heap, out);
    return code;
}

fn head() -> [] &static [byte] {
    return "--- base/src/a.cho\t2026-01-01 00:00:00\n+++ tree/src/a.cho\t2026-01-02 00:00:00\n";
}

fn test_a_changed_middle_line[&h](heap: &!h Heap) -> [heap] int {
    let patch = "--- base/a\n+++ tree/a\n@@ -1,3 +1,3 @@\n one\n-two\n+TWO\n three\n";
    test.assert(same(heap, patch, "one\ntwo\nthree\n", "one\nTWO\nthree\n"));
    return 0;
}

fn test_a_line_added_after_a_context_line_at_the_end[&h](heap: &!h Heap) -> [heap] int {
    test.assert(same(heap, "--- base/a\n+++ tree/a\n@@ -3 +3,2 @@\n three\n+four\n", "one\ntwo\nthree\n", "one\ntwo\nthree\nfour\n"));
    return 0;
}

fn test_a_line_added_after_three_context_lines[&h](heap: &!h Heap) -> [heap] int {
    test.assert(same(heap, "--- base/a\n+++ tree/a\n@@ -1,3 +1,4 @@\n one\n two\n three\n+four\n", "one\ntwo\nthree\n", "one\ntwo\nthree\nfour\n"));
    return 0;
}

fn test_a_line_added_at_the_start[&h](heap: &!h Heap) -> [heap] int {
    test.assert(same(heap, "--- base/a\n+++ tree/a\n@@ -1,2 +1,3 @@\n+zero\n one\n two\n", "one\ntwo\nthree\n", "zero\none\ntwo\nthree\n"));
    return 0;
}

fn test_a_new_file_is_applied_to_an_empty_original[&h](heap: &!h Heap) -> [heap] int {
    test.assert(same(heap, "--- base/n\n+++ tree/n\n@@ -0,0 +1,2 @@\n+x\n+y\n", "", "x\ny\n"));
    return 0;
}

fn test_lines_outside_the_hunks_are_kept_byte_for_byte[&h](heap: &!h Heap) -> [heap] int {
    let orig = "a\nb\nc\nd\ne\nf\ng\nh\n";
    let patch = "--- base/a\n+++ tree/a\n@@ -2,3 +2,3 @@\n b\n-c\n+C\n d\n@@ -7,2 +7,2 @@\n g\n-h\n+H\n";
    test.assert(same(heap, patch, orig, "a\nb\nC\nd\ne\nf\ng\nH\n"));
    return 0;
}

fn test_a_hunk_that_adds_and_removes_several_lines[&h](heap: &!h Heap) -> [heap] int {
    let patch = "--- base/a\n+++ tree/a\n@@ -1,4 +1,3 @@\n a\n-b\n-c\n+X\n+Y\n d\n";
    test.assert(same(heap, patch, "a\nb\nc\nd\n", "a\nX\nY\nd\n") == false);
    let patch2 = "--- base/a\n+++ tree/a\n@@ -1,4 +1,4 @@\n a\n-b\n-c\n+X\n+Y\n d\n";
    test.assert(same(heap, patch2, "a\nb\nc\nd\n", "a\nX\nY\nd\n"));
    return 0;
}

fn test_a_file_without_a_last_line_end[&h](heap: &!h Heap) -> [heap] int {
    let patch = "--- base/a\n+++ tree/a\n@@ -1,2 +1,2 @@\n one\n-two\n\\ No newline at end of file\n+TWO\n\\ No newline at end of file\n";
    test.assert(same(heap, patch, "one\ntwo", "one\nTWO"));
    let patch2 = "--- base/a\n+++ tree/a\n@@ -1,2 +1,3 @@\n one\n-two\n\\ No newline at end of file\n+two\n+three\n";
    test.assert(same(heap, patch2, "one\ntwo", "one\ntwo\nthree\n"));
    return 0;
}

fn test_a_context_line_that_is_not_the_files_is_code_1[&h](heap: &!h Heap) -> [heap] int {
    let patch = "--- base/a\n+++ tree/a\n@@ -1,3 +1,3 @@\n one\n-two\n+TWO\n THREE\n";
    test.assert_eq(code_of(heap, patch, "one\ntwo\nthree\n"), 1);
    return 0;
}

fn test_a_hunk_at_another_place_than_its_header_says_is_code_1[&h](heap: &!h Heap) -> [heap] int {
    let patch = "--- base/a\n+++ tree/a\n@@ -2,2 +2,2 @@\n one\n-two\n+TWO\n";
    test.assert_eq(code_of(heap, patch, "one\ntwo\nthree\n"), 1);
    return 0;
}

fn test_a_hunk_past_the_end_of_the_file_is_code_1[&h](heap: &!h Heap) -> [heap] int {
    let patch = "--- base/a\n+++ tree/a\n@@ -9,1 +9,1 @@\n-nine\n+NINE\n";
    test.assert_eq(code_of(heap, patch, "one\n"), 1);
    return 0;
}

fn test_a_file_that_ends_where_the_patch_says_it_does_not_is_code_1[&h](heap: &!h Heap) -> [heap] int {
    let patch = "--- base/a\n+++ tree/a\n@@ -1,2 +1,2 @@\n one\n-two\n\\ No newline at end of file\n+TWO\n\\ No newline at end of file\n";
    test.assert_eq(code_of(heap, patch, "one\ntwo\n"), 1);
    return 0;
}

fn test_removing_every_line_is_a_deletion_code_3[&h](heap: &!h Heap) -> [heap] int {
    let patch = "--- base/a\n+++ tree/a\n@@ -1,2 +0,0 @@\n-one\n-two\n";
    test.assert_eq(code_of(heap, patch, "one\ntwo\n"), 3);
    return 0;
}

fn test_hunks_that_do_not_say_what_they_hold_are_code_2_or_not_a_section() -> [] int {
    let s = patch_apply.next_section("--- base/a\n+++ tree/a\n@@ -1,2 +1,2 @@\n one\n", 0);
    test.assert(s.found == false);
    let t = patch_apply.next_section("--- base/a\n+++ tree/b\n@@ -1 +1 @@\n-a\n+b\n", 0);
    test.assert(t.found == false);
    let u = patch_apply.next_section("--- base/a\n+++ tree/a\n", 0);
    test.assert(u.found == false);
    let v = patch_apply.next_section("", 0);
    test.assert(v.found == false);
    return 0;
}

fn test_a_section_names_its_path_and_a_tab_ends_the_name() -> [] int {
    let patch = "--- base/src/a.cho\t2026-01-01\n+++ tree/src/a.cho\t2026-01-02\n@@ -1 +1 @@\n-a\n+b\n";
    let s = patch_apply.next_section(patch, 0);
    test.assert(s.found);
    test.assert(bytes.equal(patch[s.path_at..s.path_at + s.path_len], "src/a.cho"));
    test.assert_eq(s.end, len(patch));
    return 0;
}

fn test_the_sections_of_a_patch_are_walked_one_after_the_other() -> [] int {
    let patch = "diff -ruN base/a tree/a\n--- base/a\n+++ tree/a\n@@ -1 +1 @@\n-a\n+b\n--- base/c\n+++ tree/c\n@@ -0,0 +1 @@\n+new\n";
    let first = patch_apply.next_section(patch, 0);
    test.assert(first.found);
    test.assert(bytes.equal(patch[first.path_at..first.path_at + first.path_len], "a"));
    let second = patch_apply.next_section(patch, first.end);
    test.assert(second.found);
    test.assert(bytes.equal(patch[second.path_at..second.path_at + second.path_len], "c"));
    test.assert_eq(second.end, len(patch));
    let third = patch_apply.next_section(patch, second.end);
    test.assert(third.found == false);
    return 0;
}

fn test_a_removed_line_that_looks_like_a_file_header_is_a_line_of_its_hunk[&h](heap: &!h Heap) -> [heap] int {
    let patch = "--- base/a\n+++ tree/a\n@@ -1,2 +1,1 @@\n--- base/b\n x\n";
    let s = patch_apply.next_section(patch, 0);
    test.assert(s.found);
    test.assert_eq(s.end, len(patch));
    test.assert(same(heap, patch, "-- base/b\nx\n", "x\n"));
    return 0;
}
