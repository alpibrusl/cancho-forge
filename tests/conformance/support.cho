edition 9;
module forge.support;

import std.buffer;
import std.bytes;
import std.io;
import forge.journal_io;

// Helpers the conformance programs share (tests/conformance/*.cho). Not part
// of Forge: nothing in src/ imports this file.

// Print "ok   <name>" or "FAIL <name>"; answers 0 when it held, 1 when not.
pub fn verdict[&i, &n](io: &!i Io, held: bool, name: &n [byte]) -> [io_write] int {
    if held {
        io.write_all(io, "ok   ");
    } else {
        io.write_all(io, "FAIL ");
    }
    io.write_all(io, name);
    io.newline(io);
    if held {
        return 0;
    }
    return 1;
}

// `dir` + "/" + `name`.
pub fn under[&h, &d, &n](heap: &!h Heap, dir: &d [byte], name: &n [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 64), dir);
    b = buffer.push(heap, b, byte_of(47));
    return buffer.append(heap, b, name);
}

// The bytes of the file (empty if there is none) and the errno of reading it.
pub fn contents_of[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte]) -> [heap, fs_read(""), file_read] (buffer.Buffer, int) {
    return journal_io.read_all(heap, fs, path);
}

pub fn size_of[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte]) -> [heap, fs_read(""), file_read] int {
    let (data, errno) = contents_of(heap, fs, path);
    var n = 0;
    borrow data as &db in {
        n = buffer.size(db);
    }
    buffer.drop(heap, data);
    return n;
}

// Is the file exactly `before`?
pub fn unchanged[&h, &f, &p, &b](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], before: &b [byte]) -> [heap, fs_read(""), file_read] bool {
    let (data, errno) = contents_of(heap, fs, path);
    var same = false;
    borrow data as &db in {
        same = bytes.equal(buffer.bytes(db), before);
    }
    buffer.drop(heap, data);
    return same && errno == 0;
}

// Does a file or directory exist at `path`? (A name that cannot be opened for
// any reason other than "not found" counts as existing.)
pub fn exists[&f, &p](fs: &f Fs(""), path: &p [byte]) -> [fs_read("")] bool {
    if journal_io.path_ok(path) == false {
        return false;
    }
    match open_read(fs, path) {
        Opened::Failed(e) => {
            return e != 2;
        }
        Opened::Ok(opened) => {
            file_close(opened);
            return true;
        }
    }
}

// Make the file at `path` hold exactly `bytes` (create or truncate, one write).
// 0 or an errno.
pub fn put_file[&f, &p, &b](fs: &f Fs(""), path: &p [byte], contents: &b [byte]) -> [fs_write(""), file_write] int {
    if journal_io.path_ok(path) == false {
        return 0 - 2;
    }
    match open_write(fs, path) {
        Opened::Failed(e) => {
            return e;
        }
        Opened::Ok(opened) => {
            var file = opened;
            var rc = 0;
            borrow mut file as &!x in {
                rc = journal_io.write_all(x, contents);
            }
            file_close(file);
            return rc;
        }
    }
}

// The non-negative number written in `text` (digits only, at most 9), or -1.
pub fn nat_of[&t](text: &t [byte]) -> [] int {
    if len(text) < 1 || len(text) > 9 {
        return 0 - 1;
    }
    var n = 0;
    var k = 0;
    while k < len(text) {
        let c = int_of(text[k]);
        if c < 48 || c > 57 {
            return 0 - 1;
        }
        n = n * 10 + (c - 48);
        k = k + 1;
    }
    return n;
}
