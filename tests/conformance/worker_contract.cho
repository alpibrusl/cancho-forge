edition 9;

import std.buffer;
import std.bytes;
import std.io;
import forge.dispatch;
import forge.response;
import forge.support;
import forge.worker;

// The worker contract tests (docs/worker-contract.md, section 8), run against the mock worker: a real child process
// started beneath a workers directory under a deadline, driven only by its request (`task.input.inject`,
// tests/contract/mock_worker.cho). One case per way a run can end, each answering a rule tag and a consequence.
// Built and run by scripts/gate.sh. The same table is what the Cancho Code adapter must pass when it exists.
// Usage: worker_contract <workers directory holding mock_worker> <execution directory>
// The gate makes the execution directory with a symlink named `link` in it, to a file outside.

// The reason code of a refused reply, or -1.
fn reason_of(e: dispatch.Ending) -> [] int {
    match e {
        dispatch.Ending::Reply(verdict) => {
            match verdict {
                response.Verdict::Refused(rule, reason) => {
                    return reason;
                }
                response.Verdict::Valid(state) => {
                    return 0 - 1;
                }
            }
        }
        dispatch.Ending::Unavailable(errno) => {
            return errno;
        }
        dispatch.Ending::Timeout => {
            return 0 - 1;
        }
        dispatch.Ending::Overflow => {
            return 0 - 1;
        }
        dispatch.Ending::Crashed(signal) => {
            return 0 - 1;
        }
        dispatch.Ending::Error(code) => {
            return code;
        }
        dispatch.Ending::Setup(errno) => {
            return errno;
        }
    }
}

// The input of a task that tells the mock what to do.
fn input[&h, &m](heap: &!h Heap, inject: &m [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 32), "{\"inject\":\"");
    b = buffer.append(heap, b, inject);
    return buffer.append(heap, b, "\"}");
}

// One case: the worker `name` told to `inject`, under `most` bytes and `timeout_ms`, must end with `tag`, the
// consequence `then` and the reason `reason` (-1000 for none), within `within_ms` milliseconds.
fn case[&h, &x, &w, &f, &c, &i, &d, &r](heap: &!h Heap, exec: &x Exec(""), workers: &w Dir, fs: &f Fs(""), clock: &c Clock, io: &!i Io, exec_dir: &d [byte], label: &r [byte], name: &r [byte], inject: &r [byte], most: int, timeout_ms: int, tag: &r [byte], then: &r [byte], reason: int, within_ms: int) -> [heap, exec_under, clock, poll, fs_read(""), dir_read, file_read, io_write] int {
    let inp = input(heap, inject);
    let began = clock_ms(clock);
    var held = false;
    borrow inp as &ib in {
        let req = worker.build_execute(heap, "r-1", 1, "t-1", "mock.run", buffer.bytes(ib), timeout_ms, most, "workspace/w", exec_dir);
        borrow req as &qb in {
            let e = worker.execute(heap, exec, workers, fs, clock, name, buffer.bytes(qb), "r-1", "t-1", exec_dir, most, timeout_ms, false);
            held = bytes.equal(dispatch.rule_tag(e), tag) && bytes.equal(dispatch.consequence_name(dispatch.consequence(e)), then) && (reason == 0 - 1000 || reason_of(e) == reason);
        }
        buffer.drop(heap, req);
    }
    buffer.drop(heap, inp);
    return support.verdict(io, held && clock_ms(clock) - began <= within_ms, label);
}

fn run[&h, &x, &w, &f, &c, &i, &d](heap: &!h Heap, exec: &x Exec(""), workers: &w Dir, fs: &f Fs(""), clock: &c Clock, io: &!i Io, exec_dir: &d [byte]) -> [heap, exec_under, clock, poll, fs_read(""), dir_read, file_read, io_write] int {
    var bad = 0;
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "ok: succeeded is a claim for verification", "mock_worker", "ok", 65536, 5000, "", "verification", 0 - 1000, 10000);
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "fail: the worker's own failure is left to its retryable flag", "mock_worker", "fail", 65536, 5000, "", "worker-said", 0 - 1000, 10000);
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "partial: left to the worker's error", "mock_worker", "partial", 65536, 5000, "", "worker-said", 0 - 1000, 10000);
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "hang: killed at the deadline", "mock_worker", "hang", 65536, 500, "worker-timeout", "retry-or-fail", 0 - 1000, 2000);
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "garbage: exit 0 and not JSON", "mock_worker", "garbage", 65536, 5000, "worker-protocol", "failed", response.r_not_json(), 10000);
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "exit3: a non-zero exit", "mock_worker", "exit3", 65536, 5000, "worker-error", "retry-or-fail", 3, 10000);
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "crash: ended by a signal", "mock_worker", "crash", 65536, 5000, "worker-crashed", "retry-or-fail", 0 - 1000, 10000);
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "overflow: more than the cap", "mock_worker", "overflow", 4096, 5000, "worker-output-overflow", "failed", 0 - 1000, 10000);
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "wrong_id: a reply to another request", "mock_worker", "wrong_id", 65536, 5000, "worker-protocol", "failed", response.r_request_id(), 10000);
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "bad_hash: recomputed and refused", "mock_worker", "bad_hash", 65536, 5000, "evidence-ref-invalid", "failed", response.r_evidence_sha_mismatch(), 10000);
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "bad_size: recomputed and refused", "mock_worker", "bad_size", 65536, 5000, "evidence-ref-invalid", "failed", response.r_evidence_bytes_mismatch(), 10000);
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "missing: evidence that is not there", "mock_worker", "missing", 65536, 5000, "evidence-ref-invalid", "failed", response.r_evidence_missing(), 10000);
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "link: a symlink out of the directory is not followed", "mock_worker", "link", 65536, 5000, "evidence-ref-invalid", "failed", response.r_evidence_unreadable(), 10000);
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "dotdot: refused by the validator before any open", "mock_worker", "dotdot", 65536, 5000, "evidence-ref-invalid", "failed", response.r_evidence_ref(), 10000);
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "a worker that is not there is unavailable", "nope", "ok", 65536, 5000, "worker-unavailable", "blocked", 2, 10000);
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "a rooted name is refused before the spawn", "/bin/echo", "ok", 65536, 5000, "worker-unavailable", "blocked", 0 - 2, 10000);
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "a name with .. is refused before the spawn", "../mock_worker", "ok", 65536, 5000, "worker-unavailable", "blocked", 0 - 2, 10000);
    bad = bad + case(heap, exec, workers, fs, clock, io, exec_dir, "an empty name is refused before the spawn", "", "ok", 65536, 5000, "worker-unavailable", "blocked", 0 - 2, 10000);
    bad = bad + case(heap, exec, workers, fs, clock, io, "/nonexistent-forge-dir", "an execution directory that is not there is path-invalid", "mock_worker", "ok", 65536, 5000, "path-invalid", "blocked", 2, 10000);
    return bad;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(net);
    release(signals);
    release(tty);
    var console = io;
    var memory = heap;
    var status = 2;
    borrow fs as &f in {
        borrow exec as &x in {
            borrow clock as &c in {
                borrow mut console as &!i in {
                    borrow mut memory as &!h in {
                        borrow args as &g in {
                            if arg_count(g) == 3 {
                                match open_dir(f, arg(g, 1)) {
                                    DirOpened::Ok(d) => {
                                        var workers = d;
                                        borrow workers as &w in {
                                            status = run(h, x, w, f, c, i, arg(g, 2));
                                        }
                                        dir_close(workers);
                                    }
                                    DirOpened::Failed(e) => {
                                        io.error_all(i, "worker_contract: cannot open the workers directory\n");
                                    }
                                }
                            } else {
                                io.error_all(i, "usage: worker_contract <workers directory> <execution directory>\n");
                            }
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(exec);
    release(clock);
    release(console);
    release(memory);
    release(args);
    return status;
}
