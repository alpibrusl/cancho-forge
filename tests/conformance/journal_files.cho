edition 9;

import std.buffer;
import std.bytes;
import std.io;
import std.map;
import forge.journal;
import forge.journal_io;
import forge.task;

// Conformance for the journal's file layer. `cancho test` cannot run it: a
// test is handed only a Heap and an Io (docs/testing.md), and a file needs an
// Fs. So this is a program, built and run by scripts/gate.sh against a
// scratch directory the script makes and removes (the way spike/run.sh
// does), and it prints one line per case:
//
//     ok   <case>
//     FAIL <case>
//
// and exits 0 only if every case held. Usage: journal_files <existing dir>.
//
// What it covers that the pure tests (tests/journal_test.cho) cannot: bytes
// really appended with one write and synced, a torn tail really cut with
// `file_truncate` (and a second recovery changing nothing), a duplicated run
// of records and a garbage line really left untouched, a path with `..`
// refused before the capability could trap on it, and a missing file read as
// an empty journal. Not covered, said plainly: a kill at an instrumented
// crash point, power loss, a full disk, the lock (spike S5 measured it).

fn verdict[&i, &n](io: &!i Io, held: bool, name: &n [byte]) -> [io_write] int {
    if held {
        io.write_all(io, "ok   ");
    } else {
        io.write_all(io, "FAIL ");
    }
    io.write_all(io, name);
    io.newline(io);
    if held {
        return 0;
    }
    return 1;
}

// `dir` + "/" + `name`.
fn under[&h, &d, &n](heap: &!h Heap, dir: &d [byte], name: &n [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 64), dir);
    b = buffer.push(heap, b, byte_of(47));
    return buffer.append(heap, b, name);
}

// The bytes of the file (empty if there is none) and the errno of reading it.
fn contents_of[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte]) -> [heap, fs_read(""), file_read] (buffer.Buffer, int) {
    return journal_io.read_all(heap, fs, path);
}

fn size_of[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte]) -> [heap, fs_read(""), file_read] int {
    let (data, errno) = contents_of(heap, fs, path);
    var n = 0;
    borrow data as &db in {
        n = buffer.size(db);
    }
    buffer.drop(heap, data);
    return n;
}

// Is the file exactly `before`?
fn unchanged[&h, &f, &p, &b](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], before: &b [byte]) -> [heap, fs_read(""), file_read] bool {
    let (data, errno) = contents_of(heap, fs, path);
    var same = false;
    borrow data as &db in {
        same = bytes.equal(buffer.bytes(db), before);
    }
    buffer.drop(heap, data);
    return same && errno == 0;
}

// Submit one move and append what it produced (a transition or a refusal)
// durably. Answers the table and the rule code (0: moved), or -100 when the
// append itself failed.
fn step[&h, &f, &p, &i](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], table: map.Map[int], seq: int, id: &i [byte], target: task.State, actor: task.Actor, observed: bool) -> [heap, fs_read(""), fs_write(""), file_write] (map.Map[int], int) {
    let (next, record, rule) = journal.submit(heap, table, seq, id, target, actor, observed);
    var rc = rule;
    borrow record as &rb in {
        if journal_io.append(fs, path, buffer.bytes(rb), seq == 1) != 0 {
            rc = 0 - 100;
        }
    }
    buffer.drop(heap, record);
    return (next, rc);
}

// proposed, approved, ready, running, verification for task t-1 in `path`.
fn write_happy[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte]) -> [heap, fs_read(""), fs_write(""), file_write] int {
    var table = map.empty(heap, 16, 0, 0);
    var bad = 0;
    let (t1, r1) = step(heap, fs, path, table, 1, "t-1", task.State::Proposed, task.Actor::Human, false);
    let (t2, r2) = step(heap, fs, path, t1, 2, "t-1", task.State::Approved, task.Actor::Human, false);
    let (t3, r3) = step(heap, fs, path, t2, 3, "t-1", task.State::Ready, task.Actor::Forge, false);
    let (t4, r4) = step(heap, fs, path, t3, 4, "t-1", task.State::Running, task.Actor::Forge, false);
    let (t5, r5) = step(heap, fs, path, t4, 5, "t-1", task.State::Verification, task.Actor::Forge, false);
    table = t5;
    map.drop(heap, table);
    if r1 != 0 || r2 != 0 || r3 != 0 || r4 != 0 || r5 != 0 {
        bad = 1;
    }
    return bad;
}

// Recover, and answer the rule name of the report, then drop the table.
struct Outcome {
    rule: int,
    records: int,
    cut: int,
    errno: int,
    state: int,
    line: int,
}

fn recover_of[&h, &f, &p, &i](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], id: &i [byte]) -> [heap, fs_read(""), fs_write(""), file_read, file_write] Outcome {
    let (table, report, done) = journal_io.recover(heap, fs, path);
    var state = 0;
    borrow table as &tb in {
        state = journal.state_of(tb, id);
    }
    map.drop(heap, table);
    return Outcome { rule: report.rule, records: report.records, cut: done.cut, errno: done.errno, state: state, line: report.line };
}

fn named(rule: int, name: &static [byte]) -> [] bool {
    return bytes.equal(task.rule_code_name(rule), name);
}

fn run[&h, &f, &i, &d](heap: &!h Heap, fs: &f Fs(""), io: &!i Io, dir: &d [byte]) -> [heap, fs_read(""), fs_write(""), file_read, file_write, io_write] int {
    var failed = 0;

    // ---- the path rule: refused before the capability could trap ----------
    failed = failed + verdict(io, journal_io.path_ok(fs, "/tmp/x/journal.jsonl"), "path: an absolute path is ok");
    failed = failed + verdict(io, journal_io.path_ok(fs, "/a/..b/c..") == false && journal_io.path_ok(fs, "/a/b..") == false && journal_io.path_ok(fs, "/a/b.c/d.e"), "path: two dots in a row are refused wherever they are (the capability traps on the byte pair, spike S8); single dots are ok");
    failed = failed + verdict(io, journal_io.path_ok(fs, "") == false && journal_io.path_ok(fs, "/") == false && journal_io.path_ok(fs, "rel/x") == false, "path: empty, root and relative are refused");
    failed = failed + verdict(io, journal_io.path_ok(fs, "/a/../b") == false && journal_io.path_ok(fs, "/..") == false && journal_io.path_ok(fs, "/a/b/..") == false && journal_io.path_ok(fs, "/../a") == false, "path: a .. component is refused");
    var withnul = buffer.append(heap, buffer.empty(heap, 16), "/a/b");
    withnul = buffer.push(heap, withnul, byte_of(0));
    withnul = buffer.append(heap, withnul, "c");
    borrow withnul as &wb in {
        failed = failed + verdict(io, journal_io.path_ok(fs, buffer.bytes(wb)) == false, "path: a NUL is refused");
    }
    buffer.drop(heap, withnul);

    var dotted = under(heap, dir, "../escape.jsonl");
    borrow dotted as &pb in {
        let o = recover_of(heap, fs, buffer.bytes(pb), "t-1");
        failed = failed + verdict(io, named(o.rule, "path-invalid") && o.errno == 0, "recover: a .. path is path-invalid, not a trap");
        failed = failed + verdict(io, journal_io.append(fs, buffer.bytes(pb), "x\n", true) == 0 - 2, "append: a .. path is refused (-2), not a trap");
    }
    buffer.drop(heap, dotted);

    // The path the first version of `path_ok` accepted and the capability trapped on (spike S8).
    var inname = under(heap, dir, "a..b/journal.jsonl");
    borrow inname as &nb in {
        let o = recover_of(heap, fs, buffer.bytes(nb), "t-1");
        failed = failed + verdict(io, named(o.rule, "path-invalid") && o.errno == 0, "recover: a name with .. inside is path-invalid, not a trap");
        failed = failed + verdict(io, journal_io.append(fs, buffer.bytes(nb), "x\n", true) == 0 - 2, "append: a name with .. inside is refused (-2), not a trap");
        failed = failed + verdict(io, journal_io.exists(fs, buffer.bytes(nb)) == false, "exists: a name with .. inside is not a trap");
    }
    buffer.drop(heap, inname);

    // ---- a missing file is an empty journal --------------------------------
    var missing = under(heap, dir, "missing.jsonl");
    borrow missing as &mb in {
        let o = recover_of(heap, fs, buffer.bytes(mb), "t-1");
        failed = failed + verdict(io, o.rule == 0 && o.records == 0 && o.cut == 0 && o.errno == 0, "recover: a missing file is an empty journal");
        failed = failed + verdict(io, size_of(heap, fs, buffer.bytes(mb)) == 0, "recover: and it is not created by reading");
    }
    buffer.drop(heap, missing);

    // ---- appending to a directory that is not there is an errno -------------
    var nodir = under(heap, dir, "no/such/dir/journal.jsonl");
    borrow nodir as &nb in {
        failed = failed + verdict(io, journal_io.append(fs, buffer.bytes(nb), "x\n", false) > 0, "append: a missing directory is an errno");
    }
    buffer.drop(heap, nodir);

    // ---- a clean journal ----------------------------------------------------
    var clean = under(heap, dir, "clean.jsonl");
    borrow clean as &cb in {
        let wrote = write_happy(heap, fs, buffer.bytes(cb));
        failed = failed + verdict(io, wrote == 0, "append: five transitions appended and synced");
        let o = recover_of(heap, fs, buffer.bytes(cb), "t-1");
        failed = failed + verdict(io, o.rule == 0 && o.records == 5 && o.cut == 0 && o.state == 6, "recover: a clean journal replays to verification and cuts nothing");
    }
    buffer.drop(heap, clean);

    // ---- a torn tail is cut, once --------------------------------------------
    var torn = under(heap, dir, "torn.jsonl");
    borrow torn as &tb in {
        let wrote = write_happy(heap, fs, buffer.bytes(tb));
        let whole = size_of(heap, fs, buffer.bytes(tb));
        let tail = "{\"v\":1,\"seq\":6,\"kind\":\"task.acc";
        let appended = journal_io.append(fs, buffer.bytes(tb), tail, false);
        failed = failed + verdict(io, wrote == 0 && appended == 0 && size_of(heap, fs, buffer.bytes(tb)) == whole + len(tail), "torn: half a record appended with no newline");
        let first = recover_of(heap, fs, buffer.bytes(tb), "t-1");
        failed = failed + verdict(io, first.rule == 0 && first.cut == len(tail) && first.errno == 0 && first.records == 5, "torn: recovery reports the torn bytes cut");
        failed = failed + verdict(io, size_of(heap, fs, buffer.bytes(tb)) == whole, "torn: the file is back to its last whole record");
        let second = recover_of(heap, fs, buffer.bytes(tb), "t-1");
        failed = failed + verdict(io, second.rule == 0 && second.cut == 0 && size_of(heap, fs, buffer.bytes(tb)) == whole, "torn: a second recovery changes nothing");
        // the journal goes on from where it was cut
        let (table, report, done) = journal_io.recover(heap, fs, buffer.bytes(tb));
        let (next, rc) = step(heap, fs, buffer.bytes(tb), table, report.records + 1, "t-1", task.State::Accepted, task.Actor::Forge, true);
        map.drop(heap, next);
        let after = recover_of(heap, fs, buffer.bytes(tb), "t-1");
        failed = failed + verdict(io, rc == 0 && after.rule == 0 && after.records == 6 && after.state == 7, "torn: an observed Forge acceptance is appended and replays to accepted");
    }
    buffer.drop(heap, torn);

    // ---- a duplicated run of records is corruption: nothing is cut -----------
    var dup = under(heap, dir, "dup.jsonl");
    borrow dup as &db in {
        let wrote = write_happy(heap, fs, buffer.bytes(db));
        // the first three records again, byte for byte (the S5 case)
        let (data, errno) = contents_of(heap, fs, buffer.bytes(db));
        var again = buffer.empty(heap, 256);
        borrow data as &xb in {
            let all = buffer.bytes(xb);
            var k = 0;
            var lines = 0;
            while k < len(all) && lines < 3 {
                again = buffer.push(heap, again, all[k]);
                if int_of(all[k]) == 10 {
                    lines = lines + 1;
                }
                k = k + 1;
            }
        }
        buffer.drop(heap, data);
        borrow again as &ab in {
            journal_io.append(fs, buffer.bytes(db), buffer.bytes(ab), false);
        }
        buffer.drop(heap, again);
        let (before, e2) = contents_of(heap, fs, buffer.bytes(db));
        borrow before as &bb in {
            let o = recover_of(heap, fs, buffer.bytes(db), "t-1");
            failed = failed + verdict(io, named(o.rule, "journal-corrupt") && o.line == 6 && o.cut == 0 && o.errno == 0, "duplicate: seq 1-3 again is journal-corrupt at line 6");
            failed = failed + verdict(io, unchanged(heap, fs, buffer.bytes(db), buffer.bytes(bb)), "duplicate: the file is byte-for-byte untouched");
        }
        buffer.drop(heap, before);
    }
    buffer.drop(heap, dup);

    // ---- a garbage line AND a torn tail: still nothing is cut ----------------
    var both = under(heap, dir, "both.jsonl");
    borrow both as &obp in {
        let wrote = write_happy(heap, fs, buffer.bytes(obp));
        journal_io.append(fs, buffer.bytes(obp), "this is not a record\n{\"v\":1,\"seq\":7,\"ki", false);
        let (before, e2) = contents_of(heap, fs, buffer.bytes(obp));
        borrow before as &bb in {
            let o = recover_of(heap, fs, buffer.bytes(obp), "t-1");
            failed = failed + verdict(io, named(o.rule, "journal-corrupt") && o.line == 6 && o.cut == 0, "garbage + torn: refused, the torn tail is not offered");
            failed = failed + verdict(io, unchanged(heap, fs, buffer.bytes(obp), buffer.bytes(bb)), "garbage + torn: the file is byte-for-byte untouched");
        }
        buffer.drop(heap, before);
    }
    buffer.drop(heap, both);

    // ---- a well-formed line the state machine refuses -------------------------
    var claim = under(heap, dir, "claim.jsonl");
    borrow claim as &clb in {
        let wrote = write_happy(heap, fs, buffer.bytes(clb));
        journal_io.append(fs, buffer.bytes(clb), "{\"v\":1,\"seq\":6,\"kind\":\"task.accepted\",\"task\":\"t-1\",\"actor\":\"worker\",\"basis\":\"observed\"}\n", false);
        let (before, e2) = contents_of(heap, fs, buffer.bytes(clb));
        borrow before as &bb in {
            let o = recover_of(heap, fs, buffer.bytes(clb), "t-1");
            failed = failed + verdict(io, named(o.rule, "accept-unverified") && o.line == 6 && o.cut == 0, "claim: a worker's accepted in the file is accept-unverified");
            failed = failed + verdict(io, unchanged(heap, fs, buffer.bytes(clb), buffer.bytes(bb)), "claim: the file is untouched");
        }
        buffer.drop(heap, before);
    }
    buffer.drop(heap, claim);

    // ---- a refusal is written, and does not move the task ---------------------
    var refused = under(heap, dir, "refused.jsonl");
    borrow refused as &rb in {
        let wrote = write_happy(heap, fs, buffer.bytes(rb));
        let (table, report, done) = journal_io.recover(heap, fs, buffer.bytes(rb));
        let (next, rc) = step(heap, fs, buffer.bytes(rb), table, report.records + 1, "t-1", task.State::Accepted, task.Actor::Worker, true);
        map.drop(heap, next);
        let o = recover_of(heap, fs, buffer.bytes(rb), "t-1");
        failed = failed + verdict(io, named(rc, "accept-unverified") && o.rule == 0 && o.records == 6 && o.state == 6, "refusal: a worker's claim is recorded as a refusal and the task stays in verification");
    }
    buffer.drop(heap, refused);

    return failed;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    release(tty);
    var console = io;
    var memory = heap;
    var status = 2;
    borrow fs as &f in {
        borrow mut console as &!i in {
            borrow mut memory as &!h in {
                borrow args as &g in {
                    if arg_count(g) == 2 {
                        status = run(h, f, i, arg(g, 1));
                    } else {
                        io.error_all(i, "usage: journal_files <existing directory>\n");
                    }
                }
            }
        }
    }
    release(fs);
    release(console);
    release(memory);
    release(args);
    return status;
}
