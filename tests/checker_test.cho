edition 9;

import std.bytes;
import std.test;
import checker;

// Unit tests for pilot/audit/reference/checker.cho (docs/pilot-audit.md section 5): the pure heart of the reference checker, against the contract (pilot/contract.cho) and the
// shapes the audit's refusal cases use. Run with `cancho test`.

fn ip(a: int, b: int, c: int, d: int) -> [] int {
    return a * 16777216 + b * 65536 + c * 256 + d;
}

fn test_the_verdict_is_a_function_of_the_measurements_and_nothing_else() -> [] int {
    test.assert_eq(checker.verdict_of(false, true, 200, 90, 10), 0);
    test.assert_eq(checker.verdict_of(true, false, 200, 90, 10), 0);
    test.assert_eq(checker.verdict_of(true, true, 200, 90, 10), 2);
    test.assert_eq(checker.verdict_of(true, true, 404, 90, 10), 2);
    test.assert_eq(checker.verdict_of(true, true, 410, 90, 10), 2);
    test.assert_eq(checker.verdict_of(true, true, 301, 90, 10), 2);
    test.assert_eq(checker.verdict_of(true, true, 399, 90, 10), 2);
    test.assert_eq(checker.verdict_of(true, true, 400, 90, 10), 1);
    test.assert_eq(checker.verdict_of(true, true, 403, 90, 10), 1);
    test.assert_eq(checker.verdict_of(true, true, 429, 90, 10), 1);
    test.assert_eq(checker.verdict_of(true, true, 499, 90, 10), 1);
    test.assert_eq(checker.verdict_of(true, true, 500, 90, 10), 1);
    test.assert_eq(checker.verdict_of(true, true, 503, 90, 10), 1);
    test.assert_eq(checker.verdict_of(true, true, 200, 14, 10), 2);
    test.assert_eq(checker.verdict_of(true, true, 200, 13, 10), 1);
    test.assert_eq(checker.verdict_of(true, true, 200, 90, 5000), 2);
    test.assert_eq(checker.verdict_of(true, true, 200, 90, 5001), 1);
    test.assert_eq(checker.verdict_of(false, false, 500, 0, 99999), 0);
    return 0;
}

fn test_a_verdict_has_its_stable_name() -> [] int {
    test.assert(bytes.equal(checker.verdict_name(0), "down"));
    test.assert(bytes.equal(checker.verdict_name(1), "degraded"));
    test.assert(bytes.equal(checker.verdict_name(2), "up"));
    return 0;
}

fn test_private_ranges_are_refused_and_their_neighbours_are_not() -> [] int {
    test.assert(checker.private_v4(ip(0, 0, 0, 0)));
    test.assert(checker.private_v4(ip(0, 255, 255, 255)));
    test.assert(checker.private_v4(ip(1, 0, 0, 0)) == false);
    test.assert(checker.private_v4(ip(9, 255, 255, 255)) == false);
    test.assert(checker.private_v4(ip(10, 0, 0, 0)));
    test.assert(checker.private_v4(ip(10, 255, 255, 255)));
    test.assert(checker.private_v4(ip(11, 0, 0, 0)) == false);
    test.assert(checker.private_v4(ip(100, 63, 255, 255)) == false);
    test.assert(checker.private_v4(ip(100, 64, 0, 0)));
    test.assert(checker.private_v4(ip(100, 127, 255, 255)));
    test.assert(checker.private_v4(ip(100, 128, 0, 0)) == false);
    test.assert(checker.private_v4(ip(126, 255, 255, 255)) == false);
    test.assert(checker.private_v4(ip(127, 0, 0, 1)));
    test.assert(checker.private_v4(ip(127, 255, 255, 255)));
    test.assert(checker.private_v4(ip(128, 0, 0, 0)) == false);
    test.assert(checker.private_v4(ip(169, 253, 255, 255)) == false);
    test.assert(checker.private_v4(ip(169, 254, 0, 0)));
    test.assert(checker.private_v4(ip(169, 254, 169, 254)));
    test.assert(checker.private_v4(ip(169, 255, 0, 0)) == false);
    test.assert(checker.private_v4(ip(172, 15, 255, 255)) == false);
    test.assert(checker.private_v4(ip(172, 16, 0, 0)));
    test.assert(checker.private_v4(ip(172, 31, 255, 255)));
    test.assert(checker.private_v4(ip(172, 32, 0, 0)) == false);
    test.assert(checker.private_v4(ip(192, 0, 0, 5)));
    test.assert(checker.private_v4(ip(192, 0, 1, 5)) == false);
    test.assert(checker.private_v4(ip(192, 167, 255, 255)) == false);
    test.assert(checker.private_v4(ip(192, 168, 0, 0)));
    test.assert(checker.private_v4(ip(192, 168, 255, 255)));
    test.assert(checker.private_v4(ip(192, 169, 0, 0)) == false);
    test.assert(checker.private_v4(ip(223, 255, 255, 255)) == false);
    test.assert(checker.private_v4(ip(224, 0, 0, 1)));
    test.assert(checker.private_v4(ip(239, 255, 255, 255)));
    test.assert(checker.private_v4(ip(240, 0, 0, 0)));
    test.assert(checker.private_v4(ip(255, 255, 255, 255)));
    test.assert(checker.private_v4(ip(8, 8, 8, 8)) == false);
    test.assert(checker.private_v4(ip(203, 0, 113, 7)) == false);
    test.assert(checker.private_v4(ip(93, 184, 216, 34)) == false);
    test.assert(checker.private_v4(0 - 1));
    test.assert(checker.private_v4(4294967296));
    return 0;
}

fn test_every_way_to_write_loopback_is_read_as_loopback() -> [] int {
    test.assert_eq(checker.ipv4_loose("127.0.0.1"), ip(127, 0, 0, 1));
    test.assert_eq(checker.ipv4_loose("2130706433"), ip(127, 0, 0, 1));
    test.assert_eq(checker.ipv4_loose("0177.0.0.1"), ip(127, 0, 0, 1));
    test.assert_eq(checker.ipv4_loose("0x7f.1"), ip(127, 0, 0, 1));
    test.assert_eq(checker.ipv4_loose("0x7f000001"), ip(127, 0, 0, 1));
    test.assert_eq(checker.ipv4_loose("127.1"), ip(127, 0, 0, 1));
    test.assert_eq(checker.ipv4_loose("0x7F.0.0.1"), ip(127, 0, 0, 1));
    test.assert_eq(checker.ipv4_loose("017700000001"), ip(127, 0, 0, 1));
    test.assert_eq(checker.ipv4_loose("0"), 0);
    test.assert_eq(checker.ipv4_loose("0.0.0.0"), 0);
    test.assert_eq(checker.ipv4_loose("4294967295"), ip(255, 255, 255, 255));
    test.assert_eq(checker.ipv4_loose("8.8.8.8"), ip(8, 8, 8, 8));
    return 0;
}

fn test_a_name_is_not_an_address_and_a_broken_number_is_invalid() -> [] int {
    test.assert_eq(checker.ipv4_loose("example.test"), 0 - 1);
    test.assert_eq(checker.ipv4_loose("localhost"), 0 - 1);
    test.assert_eq(checker.ipv4_loose("abc.def"), 0 - 1);
    test.assert_eq(checker.ipv4_loose("1.2.3.x"), 0 - 1);
    test.assert_eq(checker.ipv4_loose("0x.test"), 0 - 1);
    test.assert_eq(checker.ipv4_loose(""), 0 - 1);
    test.assert_eq(checker.ipv4_loose("256.1.1.1"), 0 - 2);
    test.assert_eq(checker.ipv4_loose("1.2.3.4.5"), 0 - 2);
    test.assert_eq(checker.ipv4_loose("08.1.1.1"), 0 - 2);
    test.assert_eq(checker.ipv4_loose("4294967296"), 0 - 2);
    test.assert_eq(checker.ipv4_loose("1..2"), 0 - 1);
    test.assert_eq(checker.ipv4_loose("0x"), 0 - 2);
    test.assert_eq(checker.ipv4_loose("1.2.65536"), 0 - 2);
    return 0;
}

fn test_ipv6_literals_are_classified_for_a_checker_that_reaches_ipv4_only() -> [] int {
    test.assert_eq(checker.ipv6_class("::1"), 1);
    test.assert_eq(checker.ipv6_class("::"), 1);
    test.assert_eq(checker.ipv6_class("::ffff:127.0.0.1"), 1);
    test.assert_eq(checker.ipv6_class("::FFFF:10.0.0.5"), 1);
    test.assert_eq(checker.ipv6_class("::ffff:7f00:1"), 1);
    test.assert_eq(checker.ipv6_class("::ffff:8.8.8.8"), 0);
    test.assert_eq(checker.ipv6_class("::ffff:0808:0808"), 0);
    test.assert_eq(checker.ipv6_class("::7f00:1"), 1);
    test.assert_eq(checker.ipv6_class("::127.0.0.1"), 1);
    test.assert_eq(checker.ipv6_class("fc00::1"), 1);
    test.assert_eq(checker.ipv6_class("fd12:3456::1"), 1);
    test.assert_eq(checker.ipv6_class("fe80::1"), 1);
    test.assert_eq(checker.ipv6_class("febf::1"), 1);
    test.assert_eq(checker.ipv6_class("fec0::1"), 0);
    test.assert_eq(checker.ipv6_class("ff02::1"), 1);
    test.assert_eq(checker.ipv6_class("2001:db8::1"), 0);
    test.assert_eq(checker.ipv6_class("2606:4700::1111"), 0);
    test.assert_eq(checker.ipv6_class("fbff::1"), 0);
    test.assert_eq(checker.ipv6_class("fe7f::1"), 0);
    test.assert_eq(checker.ipv6_class("x::1"), 0 - 2);
    test.assert_eq(checker.ipv6_class("1"), 0 - 2);
    test.assert_eq(checker.ipv6_class(""), 0 - 2);
    test.assert_eq(checker.ipv6_class("::ffff:1.2.3"), 0 - 2);
    test.assert_eq(checker.ipv6_class("::ffff:1.2.3.999"), 0 - 2);
    return 0;
}

fn rule(url: &static [byte]) -> [] &static [byte] {
    return checker.url_rule(url);
}

fn test_a_url_is_refused_under_the_first_rule_it_breaks() -> [] int {
    test.assert(bytes.equal(rule("http://example.test/"), ""));
    test.assert(bytes.equal(rule("https://example.test:8443/a?b=c#d"), ""));
    test.assert(bytes.equal(rule("HTTP://Example.Test:8080"), ""));
    // url_rule is the contract's pure port list; the server lifts it for loopback only under --allow-loopback (docs/pilot-audit.md section 4.1)
    test.assert(bytes.equal(rule("http://127.0.0.1:41001/"), "url.port"));
    test.assert(bytes.equal(rule("http://[::1]/"), ""));
    test.assert(bytes.equal(rule(""), "url.invalid"));
    test.assert(bytes.equal(rule("example.test"), "url.invalid"));
    test.assert(bytes.equal(rule("/just/a/path"), "url.invalid"));
    test.assert(bytes.equal(rule("http:/example.test"), "url.invalid"));
    test.assert(bytes.equal(rule("http://"), "url.invalid"));
    test.assert(bytes.equal(rule("http:///path"), "url.invalid"));
    test.assert(bytes.equal(rule("http://exa mple.test/"), "url.invalid"));
    test.assert(bytes.equal(rule("http://example.test/a b"), "url.invalid"));
    test.assert(bytes.equal(rule("http://exa<mple.test/"), "url.invalid"));
    test.assert(bytes.equal(rule("http://.example.test/"), "url.invalid"));
    test.assert(bytes.equal(rule("http://example.test:/"), "url.invalid"));
    test.assert(bytes.equal(rule("http://example.test:80a/"), "url.invalid"));
    test.assert(bytes.equal(rule("http://[::1/"), "url.invalid"));
    test.assert(bytes.equal(rule("http://[nope]/"), "url.invalid"));
    test.assert(bytes.equal(rule("ftp://example.test/a"), "url.scheme"));
    test.assert(bytes.equal(rule("file:///etc/passwd"), "url.scheme"));
    test.assert(bytes.equal(rule("javascript:alert(1)"), "url.scheme"));
    test.assert(bytes.equal(rule("gopher://example.test/"), "url.scheme"));
    test.assert(bytes.equal(rule("httpx://example.test/"), "url.scheme"));
    test.assert(bytes.equal(rule("http://user:secret@example.test/"), "url.credentials"));
    test.assert(bytes.equal(rule("http://user@example.test/"), "url.credentials"));
    test.assert(bytes.equal(rule("https://@example.test/"), "url.credentials"));
    test.assert(bytes.equal(rule("http://example.test:22/"), "url.port"));
    test.assert(bytes.equal(rule("http://example.test:25/"), "url.port"));
    test.assert(bytes.equal(rule("http://example.test:0/"), "url.port"));
    test.assert(bytes.equal(rule("http://example.test:65536/"), "url.port"));
    test.assert(bytes.equal(rule("http://example.test:8081/"), "url.port"));
    test.assert(bytes.equal(rule("http://example.test:443/"), ""));
    test.assert(bytes.equal(rule("https://example.test:80/"), ""));
    test.assert(bytes.equal(rule("http://user@example.test:22/"), "url.credentials"));
    return 0;
}

fn test_the_host_the_port_the_scheme_and_the_target_are_read_from_a_url() -> [] int {
    test.assert(bytes.equal(checker.url_host("http://Example.test:8080/a?b#c"), "Example.test"));
    test.assert(bytes.equal(checker.url_host("http://[::1]:8080/"), "[::1]"));
    test.assert(bytes.equal(checker.url_host("http://127.0.0.1"), "127.0.0.1"));
    test.assert_eq(checker.url_port("http://a.test/"), 80);
    test.assert_eq(checker.url_port("https://a.test/"), 443);
    test.assert_eq(checker.url_port("http://a.test:8080/"), 8080);
    test.assert_eq(checker.url_port("http://[::1]:8443/"), 8443);
    test.assert_eq(checker.url_port("http://a.test:x/"), 0 - 1);
    test.assert(checker.url_is_https("HTTPS://a.test/"));
    test.assert(checker.url_is_https("http://a.test/") == false);
    test.assert(bytes.equal(checker.url_target("http://a.test/p/q?x=1#frag"), "/p/q?x=1"));
    test.assert(bytes.equal(checker.url_target("http://a.test?x=1"), "?x=1"));
    test.assert(bytes.equal(checker.url_target("http://a.test"), ""));
    return 0;
}

fn test_a_host_is_private_by_every_spelling_of_its_address_and_not_by_its_name() -> [] int {
    test.assert_eq(checker.literal_private("127.0.0.1"), 1);
    test.assert_eq(checker.literal_private("2130706433"), 1);
    test.assert_eq(checker.literal_private("0177.0.0.1"), 1);
    test.assert_eq(checker.literal_private("0x7f.1"), 1);
    test.assert_eq(checker.literal_private("0.0.0.0"), 1);
    test.assert_eq(checker.literal_private("10.0.0.5"), 1);
    test.assert_eq(checker.literal_private("172.16.0.1"), 1);
    test.assert_eq(checker.literal_private("192.168.1.1"), 1);
    test.assert_eq(checker.literal_private("169.254.169.254"), 1);
    test.assert_eq(checker.literal_private("[::1]"), 1);
    test.assert_eq(checker.literal_private("[::ffff:127.0.0.1]"), 1);
    test.assert_eq(checker.literal_private("[fe80::1]"), 1);
    test.assert_eq(checker.literal_private("[2001:db8::1]"), 0);
    test.assert_eq(checker.literal_private("8.8.8.8"), 0);
    test.assert_eq(checker.literal_private("203.0.113.7"), 0);
    test.assert_eq(checker.literal_private("example.test"), 0);
    test.assert_eq(checker.literal_private("localhost"), 0);
    test.assert_eq(checker.literal_private("256.1.1.1"), 0 - 2);
    test.assert_eq(checker.literal_private("[nope]"), 0 - 2);
    test.assert_eq(checker.literal_private("[]"), 0 - 2);
    return 0;
}

fn test_every_rule_the_contract_names_has_a_repair() -> [] int {
    test.assert(len(checker.repair_of("url.invalid")) > 0);
    test.assert(len(checker.repair_of("url.scheme")) > 0);
    test.assert(len(checker.repair_of("url.credentials")) > 0);
    test.assert(len(checker.repair_of("url.port")) > 0);
    test.assert(len(checker.repair_of("target.private-address")) > 0);
    test.assert(len(checker.repair_of("target.too-many-redirects")) > 0);
    test.assert(len(checker.repair_of("rate.limited")) > 0);
    test.assert(len(checker.repair_of("check.timeout")) > 0);
    test.assert_eq(len(checker.repair_of("nothing.here")), 0);
    return 0;
}
