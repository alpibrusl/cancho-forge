edition 9;

import std.buffer;
import std.bytes;
import std.process;
import std.test;
import forge.dispatch;
import forge.response;
import forge.verbs;

// Unit tests for src/verbs.cho (docs/worker-contract.md, sections 1.2, 3.1, 3.3 to 3.6). Run with `cancho test`.
// An outcome is (class, code): class 1 `worker-protocol`, 2 `worker-contract-version`, 3 `worker-verb-unsupported`,
// 4 `evidence-ref-invalid` (the code is the reason); 10/11 a `sync`/`async` worker; 20 to 22 a cancel (cancelled, not
// running, too late); 30 to 33 a status (queued, running, finished, unknown); 40 a result not ready; 50 + n a result
// whose response is in state n of `forge.response` (succeeded 50, failed 51, partial 52, cancelled 53, accepted 54).

fn outcome(j: verbs.Judged) -> [] (int, int) {
    match j {
        verbs.Judged::Capabilities(level) => {
            match level {
                verbs.Level::Sync => {
                    return (10, 0);
                }
                verbs.Level::Async => {
                    return (11, 0);
                }
            }
        }
        verbs.Judged::Cancel(c) => {
            match c {
                verbs.CancelState::Cancelled => {
                    return (20, 0);
                }
                verbs.CancelState::NotRunning => {
                    return (21, 0);
                }
                verbs.CancelState::TooLate => {
                    return (22, 0);
                }
            }
        }
        verbs.Judged::Status(s) => {
            match s {
                verbs.StatusState::Queued => {
                    return (30, 0);
                }
                verbs.StatusState::Running => {
                    return (31, 0);
                }
                verbs.StatusState::Finished => {
                    return (32, 0);
                }
                verbs.StatusState::Unknown => {
                    return (33, 0);
                }
            }
        }
        verbs.Judged::Result(r) => {
            match r {
                verbs.Resulted::NotReady => {
                    return (40, 0);
                }
                verbs.Resulted::Ready(s) => {
                    match s {
                        response.State::Succeeded => {
                            return (50, 0);
                        }
                        response.State::Failed => {
                            return (51, 0);
                        }
                        response.State::Partial => {
                            return (52, 0);
                        }
                        response.State::Cancelled => {
                            return (53, 0);
                        }
                        response.State::Accepted => {
                            return (54, 0);
                        }
                    }
                }
            }
        }
        verbs.Judged::Refused(rule, reason) => {
            match rule {
                verbs.Rule::Protocol => {
                    return (1, reason);
                }
                verbs.Rule::ContractVersion => {
                    return (2, reason);
                }
                verbs.Rule::VerbUnsupported => {
                    return (3, reason);
                }
                verbs.Rule::EvidenceRefInvalid => {
                    return (4, reason);
                }
            }
        }
    }
}

// The verdict on `body` as the reply to `verb`: request id `r-1`, target `r-0`, task `t-1`.
fn judge[&h, &b, &v](heap: &!h Heap, verb: &v [byte], body: &b [byte]) -> [heap] (int, int) {
    return outcome(verbs.judge(heap, verb, body, "r-1", "r-0", "t-1"));
}

fn same(got: (int, int), class: int, code: int) -> [] int {
    let (c, r) = got;
    test.assert_eq(c, class);
    test.assert_eq(r, code);
    return 0;
}

// The class of how a call ended when it was not a clean exit (1 unavailable, 2 timeout, 3 overflow, 4 crashed, 5 error),
// or 0 when the exit was clean and the reply was judged.
fn ended[&h, &b](heap: &!h Heap, ran: process.Ran, body: &b [byte]) -> [heap] int {
    match verbs.settle(heap, ran, "capabilities", body, "r-1", "r-0", "t-1") {
        verbs.Settled::Reply(j) => {
            return 0;
        }
        verbs.Settled::Ended(e) => {
            match e {
                dispatch.Ending::Unavailable(errno) => {
                    return 1;
                }
                dispatch.Ending::Timeout => {
                    return 2;
                }
                dispatch.Ending::Overflow => {
                    return 3;
                }
                dispatch.Ending::Crashed(signal) => {
                    return 4;
                }
                dispatch.Ending::Error(code) => {
                    return 5;
                }
                dispatch.Ending::Setup(errno) => {
                    return 6;
                }
                dispatch.Ending::Reply(v) => {
                    return 7;
                }
            }
        }
    }
}

// A valid reply, every prefix of it and every position changed to each of eight bytes: each is a verdict (a value), never
// a trap, and no proper prefix is accepted.
fn sweep[&h, &v, &b](heap: &!h Heap, verb: &v [byte], whole: &b [byte]) -> [heap] int {
    let n = len(whole);
    var refused = 0;
    var cut = 0;
    while cut < n {
        let (c, r) = judge(heap, verb, whole[0..cut]);
        test.assert_eq(c, 1);
        refused = refused + 1;
        cut = cut + 1;
    }
    let swaps = "\"{}[:,x9";
    var changed = 0;
    var at = 0;
    while at < n {
        var k = 0;
        while k < len(swaps) {
            var copy = buffer.empty(heap, n + 1);
            var j = 0;
            while j < n {
                if j == at {
                    copy = buffer.push(heap, copy, swaps[k]);
                } else {
                    copy = buffer.push(heap, copy, whole[j]);
                }
                j = j + 1;
            }
            borrow copy as &cb in {
                let (c, r) = judge(heap, verb, buffer.bytes(cb));
                test.assert(c >= 1);
                changed = changed + 1;
            }
            buffer.drop(heap, copy);
            k = k + 1;
        }
        at = at + 1;
    }
    test.assert(refused > 50);
    test.assert(changed > 400);
    return 0;
}

fn test_a_well_formed_capabilities_reply_names_its_level[&h](heap: &!h Heap) -> [heap] int {
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 10, 0);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\"],\"level\":\"async\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 11, 0);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[]}"), 10, 0);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/0\",\"forge-worker/1\",\"forge-worker/2\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 10, 0);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"extra\":[1,{\"x\":null}],\"worker\":{\"name\":\"m\",\"version\":\"1\",\"more\":true},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"a\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1,\"other\":2},\"note\":\"x\"}]}"), 10, 0);
    return 0;
}

fn test_a_capabilities_reply_that_is_not_one_is_worker_protocol_with_its_reason[&h](heap: &!h Heap) -> [heap] int {
    same(judge(heap, "capabilities", "this is not json"), 1, 1);
    same(judge(heap, "capabilities", "[1,2]"), 1, 2);
    same(judge(heap, "capabilities", "\"x\""), 1, 2);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/2\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 3);
    same(judge(heap, "capabilities", "{\"contract\":1,\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 3);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-other\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 4);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":7,\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 4);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":\"mock\",\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 30);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 30);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"version\":\"1\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 30);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"\",\"version\":\"1\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 30);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"m\\u0041\",\"version\":\"1\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 30);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":7,\"version\":\"1\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 30);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"m\",\"version\":[\"1\"]},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 30);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"version\":\"1\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 30);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"version\":\"1\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 10, 0);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":\"forge-worker/1\",\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 31);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 31);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\",1],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 31);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 31);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\",\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 10, 0);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\"],\"level\":\"eventually\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 32);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\"],\"level\":\"Sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 32);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\"],\"level\":true,\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 32);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":\"repo.change\"}"), 1, 33);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":{}}"), 1, 33);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"t0\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t1\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t2\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t3\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t4\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t5\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t6\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t7\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t8\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t9\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t10\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t11\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t12\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t13\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t14\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t15\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t16\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t17\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t18\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t19\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t20\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t21\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t22\",\"limits_max\":{\"timeout_ms\":1,\"max_output_bytes\":1}},{\"type\":\"t23\",\"limits_max\":{\"timeout_ms