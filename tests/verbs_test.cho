fn test_no_common_contract_version_is_its_own_rule_and_only_for_a_well_formed_reply[&h](heap: &!h Heap) -> [heap] int {
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/2\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 2, 31);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/0\",\"forge-worker/2\",\"x\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 2, 31);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"Forge-Worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 2, 31);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1 \"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 2, 31);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/2\"],\"level\":\"nope\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 32);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":1,\"supports\":[\"forge-worker/2\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}"), 1, 30);
    same(judge(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/2\"],\"level\":\"sync\",\"task_types\":[1]}"), 1, 34);
    return 0;
}

fn test_a_cancel_reply_has_one_of_three_states_and_names_its_target[&h](heap: &!h Heap) -> [heap] int {
    same(judge(heap, "cancel", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"cancelled\",\"target\":\"r-0\"}"), 20, 0);
    same(judge(heap, "cancel", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"not_running\",\"target\":\"r-0\"}"), 21, 0);
    same(judge(heap, "cancel", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"too_late\",\"target\":\"r-0\"}"), 22, 0);
    same(judge(heap, "cancel", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"cancelled\",\"target\":\"r-0\",\"extra\":{\"a\":[1]}}"), 20, 0);
    same(judge(heap, "cancel", "not json"), 1, 1);
    same(judge(heap, "cancel", "[]"), 1, 2);
    same(judge(heap, "cancel", "{\"contract\":\"x\",\"request_id\":\"r-1\",\"state\":\"cancelled\",\"target\":\"r-0\"}"), 1, 3);
    same(judge(heap, "cancel", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-2\",\"state\":\"cancelled\",\"target\":\"r-0\"}"), 1, 4);
    same(judge(heap, "cancel", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"cancelled\"}"), 1, 36);
    same(judge(heap, "cancel", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"cancelled\",\"target\":\"r-9\"}"), 1, 36);
    same(judge(heap, "cancel", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"cancelled\",\"target\":5}"), 1, 36);
    same(judge(heap, "cancel", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"done\",\"target\":\"r-0\"}"), 1, 37);
    same(judge(heap, "cancel", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"Cancelled\",\"target\":\"r-0\"}"), 1, 37);
    same(judge(heap, "cancel", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":null,\"target\":\"r-0\"}"), 1, 37);
    same(judge(heap, "cancel", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"accepted\",\"target\":\"r-0\"}"), 1, 37);
    same(judge(heap, "cancel", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"queued\",\"target\":\"r-0\"}"), 1, 37);
    return 0;
}

fn test_a_status_reply_has_one_of_four_states_and_an_optional_progress[&h](heap: &!h Heap) -> [heap] int {
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"queued\",\"target\":\"r-0\"}"), 30, 0);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\"}"), 31, 0);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"finished\",\"target\":\"r-0\"}"), 32, 0);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"unknown\",\"target\":\"r-0\"}"), 33, 0);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"step\":\"running tests\",\"fraction\":0.6},\"updated\":\"2026-10-19T10:00:00Z\"}"), 31, 0);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{}}"), 31, 0);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"step\":\"x\"}}"), 31, 0);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"fraction\":0}}"), 31, 0);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"fraction\":1}}"), 31, 0);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"fraction\":0.0}}"), 31, 0);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"fraction\":1.0}}"), 31, 0);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"fraction\":1e0}}"), 31, 0);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"fraction\":5e-1}}"), 31, 0);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"step\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}}"), 31, 0);
    same(judge(heap, "status", "not json"), 1, 1);
    same(judge(heap, "status", "7"), 1, 2);
    same(judge(heap, "status", "{\"contract\":2,\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\"}"), 1, 3);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"\",\"state\":\"running\",\"target\":\"r-0\"}"), 1, 4);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\"}"), 1, 36);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-3\"}"), 1, 36);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"paused\",\"target\":\"r-0\"}"), 1, 38);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"Running\",\"target\":\"r-0\"}"), 1, 38);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":true,\"target\":\"r-0\"}"), 1, 38);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"cancelled\",\"target\":\"r-0\"}"), 1, 38);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":5}"), 1, 39);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":\"x\"}"), 1, 39);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":[]}"), 1, 39);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"step\":7}}"), 1, 39);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"step\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}}"), 1, 39);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"fraction\":\"0.5\"}}"), 1, 39);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"fraction\":-0.1}}"), 1, 39);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"fraction\":1.1}}"), 1, 39);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"fraction\":2}}"), 1, 39);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"fraction\":-1}}"), 1, 39);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"fraction\":1e1}}"), 1, 39);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"fraction\":null}}"), 1, 39);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"updated\":5}"), 1, 40);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"updated\":\"\"}"), 1, 40);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"updated\":[\"x\"]}"), 1, 40);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"updated\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}"), 1, 40);
    same(judge(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"updated\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}"), 31, 0);
    return 0;
}

fn test_a_result_is_not_ready_or_the_final_response_of_execute[&h](heap: &!h Heap) -> [heap] int {
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"not_ready\"}"), 40, 0);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"not_ready\",\"target\":\"r-0\",\"x\":[]}"), 40, 0);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"succeeded\",\"task_id\":\"t-1\",\"evidence\":[]}"), 50, 0);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"succeeded\",\"task_id\":\"t-1\",\"evidence\":[{\"id\":\"ev-1\",\"kind\":\"file\",\"ref\":\"out.txt\",\"sha256\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"bytes\":3}]}"), 50, 0);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"failed\",\"task_id\":\"t-1\",\"evidence\":[],\"error\":{\"code\":\"c\",\"message\":\"m\",\"retryable\":false}}"), 51, 0);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"partial\",\"task_id\":\"t-1\",\"evidence\":[],\"error\":{\"code\":\"c\",\"message\":\"m\",\"retryable\":false}}"), 52, 0);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"cancelled\",\"task_id\":\"t-1\",\"evidence\":[]}"), 53, 0);
    same(judge(heap, "result", "not json"), 1, 1);
    same(judge(heap, "result", "null"), 1, 2);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/9\",\"request_id\":\"r-1\",\"state\":\"succeeded\",\"task_id\":\"t-1\",\"evidence\":[]}"), 1, 3);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-2\",\"state\":\"succeeded\",\"task_id\":\"t-1\",\"evidence\":[]}"), 1, 4);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"succeeded\",\"task_id\":\"t-2\",\"evidence\":[]}"), 1, 6);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"accepted\",\"task_id\":\"t-1\",\"evidence\":[]}"), 1, 5);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"task_id\":\"t-1\",\"evidence\":[]}"), 1, 5);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"not_ready\",\"task_id\":\"t-1\",\"evidence\":[]}"), 40, 0);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"failed\",\"task_id\":\"t-1\",\"evidence\":[]}"), 1, 17);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"succeeded\",\"task_id\":\"t-1\",\"evidence\":[],\"error\":{\"code\":\"c\",\"message\":\"m\",\"retryable\":false}}"), 1, 17);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-2\",\"state\":\"not_ready\"}"), 1, 4);
    same(judge(heap, "result", "{\"contract\":\"x\",\"request_id\":\"r-1\",\"state\":\"not_ready\"}"), 1, 3);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"Not_Ready\"}"), 1, 5);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"succeeded\",\"task_id\":\"t-1\",\"evidence\":[{\"id\":\"ev-1\",\"kind\":\"file\",\"ref\":\"../x\",\"sha256\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"bytes\":3}]}"), 4, 13);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"succeeded\",\"task_id\":\"t-1\",\"evidence\":[{\"id\":\"ev-1\",\"kind\":\"file\",\"ref\":\"/etc/passwd\",\"sha256\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"bytes\":3}]}"), 4, 13);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"succeeded\",\"task_id\":\"t-1\",\"evidence\":[{\"id\":\"ev-1\",\"kind\":\"file\",\"ref\":\"a\",\"sha256\":\"xyz\",\"bytes\":3}]}"), 4, 14);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"succeeded\",\"task_id\":\"t-1\",\"evidence\":[{\"id\":\"ev-1\",\"kind\":\"file\",\"ref\":\"a\",\"sha256\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"bytes\":-1}]}"), 4, 15);
    same(judge(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"succeeded\",\"task_id\":\"t-1\",\"evidence\":[{\"id\":\"ev-1\",\"kind\":\"weird\",\"ref\":\"a\",\"sha256\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"bytes\":1}]}"), 1, 12);
    return 0;
}

fn test_which_verbs_a_level_has_and_what_an_unknown_verb_is[&h](heap: &!h Heap) -> [heap] int {
    test.assert(verbs.verb_allowed(verbs.Level::Sync, "capabilities"));
    test.assert(verbs.verb_allowed(verbs.Level::Sync, "execute"));
    test.assert(!verbs.verb_allowed(verbs.Level::Sync, "cancel"));
    test.assert(!verbs.verb_allowed(verbs.Level::Sync, "status"));
    test.assert(!verbs.verb_allowed(verbs.Level::Sync, "result"));
    test.assert(verbs.verb_allowed(verbs.Level::Async, "capabilities"));
    test.assert(verbs.verb_allowed(verbs.Level::Async, "execute"));
    test.assert(verbs.verb_allowed(verbs.Level::Async, "cancel"));
    test.assert(verbs.verb_allowed(verbs.Level::Async, "status"));
    test.assert(verbs.verb_allowed(verbs.Level::Async, "result"));
    test.assert(!verbs.verb_allowed(verbs.Level::Async, ""));
    test.assert(!verbs.verb_allowed(verbs.Level::Async, "Execute"));
    test.assert(!verbs.verb_allowed(verbs.Level::Async, "frobnicate"));
    test.assert(!verbs.verb_allowed(verbs.Level::Sync, "cancel "));
    same(outcome(verbs.refuse_verb()), 3, verbs.r_verb());
    same(judge(heap, "frobnicate", "{}"), 3, verbs.r_verb());
    same(judge(heap, "execute", "{}"), 3, verbs.r_verb());
    same(judge(heap, "", "{}"), 3, verbs.r_verb());
    return 0;
}

fn test_the_requests_are_written_exactly[&h](heap: &!h Heap) -> [heap] int {
    let cap = verbs.build_capabilities(heap, "r-0");
    borrow cap as &cb in {
        test.assert(bytes.equal(buffer.bytes(cb), "{\"contract\":\"forge-worker/1\",\"verb\":\"capabilities\",\"request_id\":\"r-0\"}"));
    }
    buffer.drop(heap, cap);
    let c = verbs.build_targeted(heap, "cancel", "r-18", "r-17");
    borrow c as &b in {
        test.assert(bytes.equal(buffer.bytes(b), "{\"contract\":\"forge-worker/1\",\"verb\":\"cancel\",\"request_id\":\"r-18\",\"target\":\"r-17\"}"));
    }
    buffer.drop(heap, c);
    let s = verbs.build_targeted(heap, "status", "r-19", "r-17");
    borrow s as &b2 in {
        test.assert(bytes.equal(buffer.bytes(b2), "{\"contract\":\"forge-worker/1\",\"verb\":\"status\",\"request_id\":\"r-19\",\"target\":\"r-17\"}"));
    }
    buffer.drop(heap, s);
    let r = verbs.build_targeted(heap, "result", "r-20", "r-17");
    borrow r as &b3 in {
        test.assert(bytes.equal(buffer.bytes(b3), "{\"contract\":\"forge-worker/1\",\"verb\":\"result\",\"request_id\":\"r-20\",\"target\":\"r-17\"}"));
    }
    buffer.drop(heap, r);
    // a verb that is not one of the three is not built, so that a wrong name cannot reach a worker
    let e = verbs.build_targeted(heap, "execute", "r-1", "r-0");
    borrow e as &eb in {
        test.assert_eq(len(buffer.bytes(eb)), 0);
    }
    buffer.drop(heap, e);
    let e2 = verbs.build_targeted(heap, "capabilities", "r-1", "r-0");
    borrow e2 as &e2b in {
        test.assert_eq(len(buffer.bytes(e2b)), 0);
    }
    buffer.drop(heap, e2);
    let e3 = verbs.build_targeted(heap, "", "r-1", "r-0");
    borrow e3 as &e3b in {
        test.assert_eq(len(buffer.bytes(e3b)), 0);
    }
    buffer.drop(heap, e3);
    // an id with a quote or a newline is escaped, not copied into the JSON
    let q = verbs.build_targeted(heap, "status", "r\"1", "r\n0");
    borrow q as &b4 in {
        test.assert(bytes.equal(buffer.bytes(b4), "{\"contract\":\"forge-worker/1\",\"verb\":\"status\",\"request_id\":\"r\\\"1\",\"target\":\"r\\n0\"}"));
    }
    buffer.drop(heap, q);
    return 0;
}

fn test_a_capabilities_reply_written_by_a_worker_is_one_this_judges_valid[&h](heap: &!h Heap) -> [heap] int {
    let a = verbs.capabilities_reply(heap, "r-1", "stub-llm", "0.1.0", "sync", "repo.change", 600000, 1048576);
    borrow a as &ab in {
        same(judge(heap, "capabilities", buffer.bytes(ab)), 10, 0);
        test.assert(verbs.lists_type(heap, buffer.bytes(ab), "repo.change"));
        test.assert(!verbs.lists_type(heap, buffer.bytes(ab), "repo.gate"));
        test.assert(!verbs.lists_type(heap, buffer.bytes(ab), ""));
        test.assert(!verbs.lists_type(heap, buffer.bytes(ab), "repo.chang"));
    }
    buffer.drop(heap, a);
    let b = verbs.capabilities_reply(heap, "r-1", "x", "1", "async", "repo.gate", 86400000, 1);
    borrow b as &bb in {
        same(judge(heap, "capabilities", buffer.bytes(bb)), 11, 0);
        test.assert(verbs.lists_type(heap, buffer.bytes(bb), "repo.gate"));
    }
    buffer.drop(heap, b);
    let c = verbs.capabilities_reply(heap, "r-1", "x", "1", "sync", "", 1, 1);
    borrow c as &cb in {
        same(judge(heap, "capabilities", buffer.bytes(cb)), 10, 0);
        test.assert(!verbs.lists_type(heap, buffer.bytes(cb), "repo.gate"));
    }
    buffer.drop(heap, c);
    // the wanted type is found wherever it is in the list
    let many = "{\"task_types\":[{\"type\":\"a\"},{\"type\":\"b\"},{\"type\":\"c\"}]}";
    test.assert(verbs.lists_type(heap, many, "a"));
    test.assert(verbs.lists_type(heap, many, "b"));
    test.assert(verbs.lists_type(heap, many, "c"));
    test.assert(!verbs.lists_type(heap, many, "d"));
    // a level the reply writer is given that is not one of the two is not a valid reply
    let d = verbs.capabilities_reply(heap, "r-1", "x", "1", "maybe", "repo.gate", 1, 1);
    borrow d as &db in {
        same(judge(heap, "capabilities", buffer.bytes(db)), 1, verbs.r_level());
    }
    buffer.drop(heap, d);
    // a limit of zero is not a valid limit, and the type list is read only from a body that is an object
    test.assert(!verbs.lists_type(heap, "not json", "repo.change"));
    test.assert(!verbs.lists_type(heap, "[]", "repo.change"));
    test.assert(!verbs.lists_type(heap, "{\"task_types\":5}", "repo.change"));
    return 0;
}

fn test_how_a_call_ended_is_the_ending_of_execute_and_a_clean_exit_is_judged[&h](heap: &!h Heap) -> [heap] int {
    // exit status 0 is judged; every other ending is the one of `forge.dispatch`, whatever was written
    let body = "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}";
    match verbs.settle(heap, process.Ran::Code(0), "capabilities", body, "r-1", "r-0", "t-1") {
        verbs.Settled::Reply(j) => {
            same(outcome(j), 10, 0);
        }
        verbs.Settled::Ended(e) => {
            test.assert(false);
        }
    }
    match verbs.settle(heap, process.Ran::Code(0), "capabilities", "garbage", "r-1", "r-0", "t-1") {
        verbs.Settled::Reply(j) => {
            same(outcome(j), 1, 1);
        }
        verbs.Settled::Ended(e) => {
            test.assert(false);
        }
    }
    test.assert(ended(heap, process.Ran::Code(3), body) == 5);
    test.assert(ended(heap, process.Ran::Code(1), "") == 5);
    test.assert(ended(heap, process.Ran::Failed(2), body) == 1);
    test.assert(ended(heap, process.Ran::TimedOut, body) == 2);
    test.assert(ended(heap, process.Ran::TooMuch, body) == 3);
    test.assert(ended(heap, process.Ran::Signaled(9), body) == 4);
    test.assert(ended(heap, process.Ran::Code(0), body) == 0);
    return 0;
}

fn test_every_truncation_and_every_single_byte_change_of_each_reply_is_a_verdict[&h](heap: &!h Heap) -> [heap] int {
    sweep(heap, "capabilities", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"worker\":{\"name\":\"mock\",\"version\":\"0.1.0\"},\"supports\":[\"forge-worker/1\"],\"level\":\"sync\",\"task_types\":[{\"type\":\"repo.change\",\"limits_max\":{\"timeout_ms\":600000,\"max_output_bytes\":1048576}}]}");
    sweep(heap, "cancel", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"cancelled\",\"target\":\"r-0\"}");
    sweep(heap, "status", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"running\",\"target\":\"r-0\",\"progress\":{\"step\":\"a\",\"fraction\":0.5},\"updated\":\"t\"}");
    sweep(heap, "result", "{\"contract\":\"forge-worker/1\",\"request_id\":\"r-1\",\"state\":\"succeeded\",\"task_id\":\"t-1\",\"evidence\":[{\"id\":\"ev-1\",\"kind\":\"file\",\"ref\":\"out.txt\",\"sha256\":\"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"bytes\":3}]}");
    return 0;
}
