edition 9;

import std.buffer;
import std.bytes;
import std.option;
import std.test;
import forge.company_budget;
import forge.company_manifest;
import forge.company_graph;
import forge.company_state;
import forge.journal;
import forge.task;

// Unit tests for src/company_state.cho (docs/superpowers/specs/2026-10-27-forge-company-layer-design.md, section 4.3): the company
// journal's events and their replay. The journals are built with the event builders or written out by hand; a hand-written line is
// the way to reach a line a builder cannot write. Run with `cancho test`.

fn manifest_text() -> [] &static [byte] {
    return "{\"id\":\"co\",\"mission\":\"m\",\"model\":{\"provider\":\"anthropic\",\"name\":\"haiku\"},\"budget\":{\"input\":1,\"output\":1,\"cache_write\":1,\"cache_read\":1,\"max_cost\":1,\"price_table\":\"p.json\"},\"human_gates\":[\"g\"],\"roles\":[\"qa\"],\"steps\":[{\"id\":\"a\",\"role\":\"qa\",\"task_type\":\"repo.gate\",\"needs\":[],\"input\":\"x\"},{\"id\":\"b\",\"role\":\"qa\",\"task_type\":\"repo.gate\",\"needs\":[\"a\"],\"input\":\"x\"},{\"id\":\"c\",\"role\":\"qa\",\"task_type\":\"repo.gate\",\"needs\":[\"b\"],\"input\":\"x\"}]}";
}

// Everything a test asks of a replay, as plain numbers: the state is `res` and cannot leave the borrow of the manifest it was
// replayed against.
struct Probe {
    rule: int,
    line: int,
    records: int,
    valid: int,
    torn: int,
    cut: int,
    mask: int,
    oob: int,
    next: int,
    gate: int,
    other_gate: int,
    input: int,
    output: int,
    cache_write: int,
    cache_read: int,
    admitted_a: int,
    admitted_b: int,
    admitted_c: int,
}

fn probe_of[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] Probe {
    var p = Probe { rule: 0 - 1, line: 0, records: 0, valid: 0, torn: 0, cut: 0, mask: 0, oob: 0, next: 0 - 2, gate: 0, other_gate: 0, input: 0, output: 0, cache_write: 0, cache_read: 0, admitted_a: 0, admitted_b: 0, admitted_c: 0 };
    match company_manifest.parse(heap, manifest_text()) {
        company_manifest.ManifestResult::Held(m) => {
            borrow m as &mr in {
                let s = company_state.replay(heap, text, mr);
                borrow s as &sr in {
                    let r = company_state.report_of(sr);
                    var mask = 0;
                    var i = 0;
                    while i < 3 {
                        if company_state.accepted_at(sr, i) {
                            mask = mask + 1 * pow2(i);
                        }
                        i = i + 1;
                    }
                    var oob = 0;
                    if company_state.accepted_at(sr, 3) || company_state.accepted_at(sr, 0 - 1) {
                        oob = 1;
                    }
                    var next = 0 - 1;
                    match company_graph.ready(mr, company_state.accepted_flags(sr)) {
                        option.Option::Some(n) => {
                            next = n;
                        }
                        option.Option::None => {
                            next = 0 - 1;
                        }
                    }
                    p = Probe { rule: r.rule, line: r.line, records: r.records, valid: r.valid_bytes, torn: r.torn_bytes, cut: journal.recovery_cut(r), mask: mask, oob: oob, next: next, gate: company_state.gate_state(sr, "g"), other_gate: company_state.gate_state(sr, "h"), input: company_state.spend_input(sr), output: company_state.spend_output(sr), cache_write: company_state.spend_cache_write(sr), cache_read: company_state.spend_cache_read(sr), admitted_a: company_state.admitted_count(sr, "a"), admitted_b: company_state.admitted_count(sr, "b"), admitted_c: company_state.admitted_count(sr, "c") };
                }
                company_state.drop(heap, s);
            }
            company_manifest.drop(heap, m);
        }
        company_manifest.ManifestResult::Refused(r) => {
            test.assert(false);
        }
    }
    return p;
}

fn pow2(n: int) -> [] int {
    var v = 1;
    var i = 0;
    while i < n {
        v = v * 2;
        i = i + 1;
    }
    return v;
}

// `journal` with `record` appended.
fn add[&h](heap: &!h Heap, journal: buffer.Buffer, record: buffer.Buffer) -> [heap] buffer.Buffer {
    var out = journal;
    borrow record as &rb in {
        out = buffer.append(heap, out, buffer.bytes(rb));
    }
    buffer.drop(heap, record);
    return out;
}

fn rule_name_of[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] &static [byte] {
    return task.rule_code_name(probe_of(heap, text).rule);
}

// ---- accepted flags -------------------------------------------------------------------------------------------------------

fn test_an_empty_journal_has_nothing_accepted_and_nothing_spent[&h](heap: &!h Heap) -> [heap] int {
    let p = probe_of(heap, "");
    test.assert_eq(p.records, 0);
    test.assert_eq(p.rule, 0);
    test.assert_eq(p.mask, 0);
    test.assert_eq(p.next, 0);
    test.assert_eq(p.gate, 0);
    test.assert_eq(p.input, 0);
    test.assert_eq(p.admitted_a, 0);
    return 0;
}

fn test_accepted_steps_are_flagged_by_step_number_and_the_graph_reads_them[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 512);
    j = add(heap, j, company_state.admitted(heap, 1, "a", "t-1"));
    j = add(heap, j, company_state.accepted(heap, 2, "a", "out/a.txt", "abc"));
    j = add(heap, j, company_state.admitted(heap, 3, "b", "t-2"));
    j = add(heap, j, company_state.check_failed(heap, 4, "b", 1, 3));
    borrow j as &jb in {
        let p = probe_of(heap, buffer.bytes(jb));
        test.assert_eq(p.rule, 0);
        test.assert_eq(p.records, 4);
        test.assert_eq(p.mask, 1);
        test.assert_eq(p.oob, 0);
        test.assert_eq(p.admitted_a, 1);
        test.assert_eq(p.admitted_b, 1);
        test.assert_eq(p.admitted_c, 0);
        // b was admitted and failed its check: it is still the next step to run
        test.assert_eq(p.next, 1);
    }
    var k = j;
    k = add(heap, k, company_state.accepted(heap, 5, "b", "out/b.txt", "def"));
    k = add(heap, k, company_state.accepted(heap, 6, "c", "out/c.txt", "ghi"));
    borrow k as &kb in {
        let p = probe_of(heap, buffer.bytes(kb));
        test.assert_eq(p.mask, 7);
        test.assert_eq(p.next, 0 - 1);
    }
    buffer.drop(heap, k);
    return 0;
}

fn test_an_accepted_event_for_a_step_not_in_the_manifest_changes_nothing[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.accepted(heap, 1, "zzz", "out", "abc"));
    borrow j as &jb in {
        let p = probe_of(heap, buffer.bytes(jb));
        test.assert_eq(p.rule, 0);
        test.assert_eq(p.mask, 0);
        test.assert_eq(p.oob, 0);
    }
    buffer.drop(heap, j);
    return 0;
}

fn test_a_step_admitted_twice_counts_twice[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.admitted(heap, 1, "a", "t-1"));
    j = add(heap, j, company_state.admitted(heap, 2, "a", "t-2"));
    borrow j as &jb in {
        test.assert_eq(probe_of(heap, buffer.bytes(jb)).admitted_a, 2);
    }
    buffer.drop(heap, j);
    return 0;
}

// ---- gates ----------------------------------------------------------------------------------------------------------------

fn test_a_gate_with_no_decision_is_open[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.admitted(heap, 1, "a", "t-1"));
    borrow j as &jb in {
        test.assert_eq(probe_of(heap, buffer.bytes(jb)).gate, 0);
    }
    buffer.drop(heap, j);
    return 0;
}

fn test_approved_is_1_and_rejected_is_2[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.gate_decided(heap, 1, "g", "approved", "ana", "fine"));
    borrow j as &jb in {
        test.assert_eq(probe_of(heap, buffer.bytes(jb)).gate, 1);
    }
    var k = buffer.empty(heap, 256);
    k = add(heap, k, company_state.gate_decided(heap, 1, "g", "rejected", "ana", "no"));
    borrow k as &kb in {
        test.assert_eq(probe_of(heap, buffer.bytes(kb)).gate, 2);
    }
    buffer.drop(heap, j);
    buffer.drop(heap, k);
    return 0;
}

fn test_approved_then_rejected_is_2_the_last_decision_wins[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.gate_decided(heap, 1, "g", "approved", "ana", "fine"));
    j = add(heap, j, company_state.gate_decided(heap, 2, "g", "rejected", "ana", "changed my mind"));
    borrow j as &jb in {
        test.assert_eq(probe_of(heap, buffer.bytes(jb)).gate, 2);
    }
    var k = buffer.empty(heap, 256);
    k = add(heap, k, company_state.gate_decided(heap, 1, "g", "rejected", "ana", "no"));
    k = add(heap, k, company_state.gate_decided(heap, 2, "g", "approved", "ana", "yes"));
    borrow k as &kb in {
        test.assert_eq(probe_of(heap, buffer.bytes(kb)).gate, 1);
    }
    buffer.drop(heap, j);
    buffer.drop(heap, k);
    return 0;
}

fn test_a_decision_on_one_gate_does_not_touch_another[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.gate_decided(heap, 1, "h", "approved", "ana", "fine"));
    borrow j as &jb in {
        let p = probe_of(heap, buffer.bytes(jb));
        test.assert_eq(p.gate, 0);
        test.assert_eq(p.other_gate, 1);
    }
    buffer.drop(heap, j);
    return 0;
}

// ---- a torn tail ----------------------------------------------------------------------------------------------------------

// The last gate decision is cut mid-record, at every byte: the gate stays open, the report counts the torn bytes, and the cut
// recovery would make is the valid prefix.
fn test_a_journal_cut_mid_record_in_the_last_gate_decision_leaves_the_gate_open[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.admitted(heap, 1, "a", "t-1"));
    let whole = company_state.gate_decided(heap, 2, "g", "approved", "ana", "fine");
    borrow whole as &wb in {
        let w = buffer.bytes(wb);
        var k = 1;
        while k < len(w) {
            var cut = buffer.empty(heap, 256);
            borrow j as &jb in {
                cut = buffer.append(heap, cut, buffer.bytes(jb));
            }
            cut = buffer.append(heap, cut, w[0..k]);
            borrow cut as &cb in {
                let p = probe_of(heap, buffer.bytes(cb));
                test.assert_eq(p.rule, 0);
                test.assert_eq(p.records, 1);
                test.assert_eq(p.torn, k);
                test.assert_eq(p.gate, 0);
                test.assert_eq(p.cut, p.valid);
            }
            buffer.drop(heap, cut);
            k = k + 1;
        }
    }
    buffer.drop(heap, whole);
    buffer.drop(heap, j);
    return 0;
}

fn test_a_torn_decision_after_an_approval_leaves_the_approval[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.gate_decided(heap, 1, "g", "approved", "ana", "fine"));
    j = buffer.append(heap, j, "{\"v\":1,\"seq\":2,\"kind\":\"company.gate.decided\",\"task\":\"g\",\"gate\":\"g\",\"verdict\":\"reje");
    borrow j as &jb in {
        let p = probe_of(heap, buffer.bytes(jb));
        test.assert_eq(p.gate, 1);
        test.assert(p.torn > 0);
    }
    buffer.drop(heap, j);
    return 0;
}

// ---- unknown kinds, and what is refused -----------------------------------------------------------------------------------

fn test_an_unknown_kind_is_ignored_and_its_seq_still_counts[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.admitted(heap, 1, "a", "t-1"));
    j = buffer.append(heap, j, "{\"v\":1,\"seq\":2,\"kind\":\"company.future.thing\",\"task\":\"a\",\"x\":7}\n");
    j = buffer.append(heap, j, "{\"v\":1,\"seq\":3,\"kind\":\"something.else\",\"task\":\"a\"}\n");
    j = add(heap, j, company_state.accepted(heap, 4, "a", "out", "abc"));
    borrow j as &jb in {
        let p = probe_of(heap, buffer.bytes(jb));
        test.assert_eq(p.rule, 0);
        test.assert_eq(p.records, 4);
        test.assert_eq(p.mask, 1);
    }
    buffer.drop(heap, j);
    return 0;
}

fn test_a_seq_gap_is_journal_corrupt_and_replay_stops_there[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.accepted(heap, 1, "a", "out", "abc"));
    j = add(heap, j, company_state.accepted(heap, 3, "b", "out", "abc"));
    borrow j as &jb in {
        let p = probe_of(heap, buffer.bytes(jb));
        test.assert(bytes.equal(task.rule_code_name(p.rule), "journal-corrupt"));
        test.assert_eq(p.line, 2);
        test.assert_eq(p.records, 1);
        test.assert_eq(p.mask, 1);
        // a complete wrong line is never cut
        test.assert_eq(p.cut, 0 - 1);
    }
    buffer.drop(heap, j);
    return 0;
}

fn test_a_duplicate_seq_and_a_journal_not_starting_at_1_are_corrupt[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.admitted(heap, 1, "a", "t-1"));
    j = add(heap, j, company_state.admitted(heap, 1, "a", "t-1"));
    borrow j as &jb in {
        test.assert(bytes.equal(rule_name_of(heap, buffer.bytes(jb)), "journal-corrupt"));
    }
    var k = buffer.empty(heap, 256);
    k = add(heap, k, company_state.admitted(heap, 2, "a", "t-1"));
    borrow k as &kb in {
        test.assert(bytes.equal(rule_name_of(heap, buffer.bytes(kb)), "journal-corrupt"));
    }
    buffer.drop(heap, j);
    buffer.drop(heap, k);
    return 0;
}

fn test_a_complete_line_that_is_not_a_record_is_corrupt_and_nothing_is_cut_even_with_a_torn_tail[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.admitted(heap, 1, "a", "t-1"));
    j = buffer.append(heap, j, "not json at all\n");
    j = buffer.append(heap, j, "{\"v\":1,\"seq\":3,\"kind\":\"company.step.acc");
    borrow j as &jb in {
        let p = probe_of(heap, buffer.bytes(jb));
        test.assert(bytes.equal(task.rule_code_name(p.rule), "journal-corrupt"));
        test.assert_eq(p.line, 2);
        test.assert_eq(p.cut, 0 - 1);
    }
    var k = buffer.empty(heap, 256);
    k = buffer.append(heap, k, "{\"v\":2,\"seq\":1,\"kind\":\"company.step.admitted\",\"task\":\"a\",\"forge_task\":\"t\"}\n");
    borrow k as &kb in {
        test.assert(bytes.equal(rule_name_of(heap, buffer.bytes(kb)), "journal-corrupt"));
    }
    buffer.drop(heap, j);
    buffer.drop(heap, k);
    return 0;
}

fn test_a_known_kind_with_the_wrong_fields_is_event_malformed[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.gate_decided(heap, 1, "g", "maybe", "ana", "hm"));
    borrow j as &jb in {
        test.assert(bytes.equal(rule_name_of(heap, buffer.bytes(jb)), "event-malformed"));
    }
    var k = buffer.empty(heap, 256);
    k = buffer.append(heap, k, "{\"v\":1,\"seq\":1,\"kind\":\"company.step.accepted\",\"task\":\"a\",\"artifact\":3}\n");
    borrow k as &kb in {
        test.assert(bytes.equal(rule_name_of(heap, buffer.bytes(kb)), "event-malformed"));
    }
    var m = buffer.empty(heap, 256);
    m = add(heap, m, company_state.spend_recorded(heap, 1, "a", 0 - 5, 0, 0, 0));
    borrow m as &mb in {
        test.assert(bytes.equal(rule_name_of(heap, buffer.bytes(mb)), "event-malformed"));
    }
    buffer.drop(heap, j);
    buffer.drop(heap, k);
    buffer.drop(heap, m);
    return 0;
}

// ---- spend ----------------------------------------------------------------------------------------------------------------

fn test_spend_adds_up_per_token_class[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 512);
    j = add(heap, j, company_state.spend_recorded(heap, 1, "a", 100, 20, 3, 4));
    j = add(heap, j, company_state.spend_recorded(heap, 2, "b", 10, 2, 0, 400));
    borrow j as &jb in {
        let p = probe_of(heap, buffer.bytes(jb));
        test.assert_eq(p.rule, 0);
        test.assert_eq(p.input, 110);
        test.assert_eq(p.output, 22);
        test.assert_eq(p.cache_write, 3);
        test.assert_eq(p.cache_read, 404);
    }
    buffer.drop(heap, j);
    return 0;
}

fn test_a_torn_spend_record_is_not_counted[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 512);
    j = add(heap, j, company_state.spend_recorded(heap, 1, "a", 100, 20, 3, 4));
    j = buffer.append(heap, j, "{\"v\":1,\"seq\":2,\"kind\":\"company.spend.recorded\",\"task\":\"a\",\"input\":999,\"out");
    borrow j as &jb in {
        let p = probe_of(heap, buffer.bytes(jb));
        test.assert_eq(p.rule, 0);
        test.assert_eq(p.input, 100);
    }
    buffer.drop(heap, j);
    return 0;
}

fn test_spend_saturates_instead_of_overflowing[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 512);
    j = add(heap, j, company_state.spend_recorded(heap, 1, "a", 1000000000000000, 0, 0, 0));
    j = add(heap, j, company_state.spend_recorded(heap, 2, "a", 1000000000000000, 0, 0, 0));
    j = buffer.append(heap, j, "{\"v\":1,\"seq\":3,\"kind\":\"company.spend.recorded\",\"task\":\"a\",\"input\":9223372036854775807,\"output\":0,\"cache_write\":0,\"cache_read\":0}\n");
    borrow j as &jb in {
        let p = probe_of(heap, buffer.bytes(jb));
        test.assert(bytes.equal(task.rule_code_name(p.rule), "event-malformed"));
        test.assert_eq(p.input, 1000000000000000);
    }
    buffer.drop(heap, j);
    return 0;
}

// ---- recorded cost (cost_micro) ---------------------------------------------------------------------------------------------

// One micro-dollar per token of every class, no over tier.
fn flat_prices() -> [] company_budget.Prices {
    return company_budget.Prices { input: 1000000, output: 1000000, cache_write: 1000000, cache_read: 1000000, prompt_limit: 0, has_over: false, over_input: 0, over_output: 0, over_cache_write: 0, over_cache_read: 0 };
}

struct CostProbe {
    rule: int,
    input: int,
    recorded: int,
    spent: int,
    a_input: int,
    a_output: int,
    a_cost: int,
    b_input: int,
    b_cost: int,
    out_of_range: int,
}

fn cost_probe[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] CostProbe {
    var p = CostProbe { rule: 0 - 1, input: 0, recorded: 0, spent: 0, a_input: 0, a_output: 0, a_cost: 0, b_input: 0, b_cost: 0, out_of_range: 0 - 1 };
    match company_manifest.parse(heap, manifest_text()) {
        company_manifest.ManifestResult::Held(m) => {
            borrow m as &mr in {
                let s = company_state.replay(heap, text, mr);
                borrow s as &sr in {
                    let a = company_state.step_recorded(sr, 0);
                    let b = company_state.step_recorded(sr, 1);
                    let far = company_state.step_recorded(sr, 9223372036854775807);
                    p = CostProbe { rule: company_state.report_of(sr).rule, input: company_state.spend_input(sr), recorded: company_state.spend_cost_micro(sr), spent: company_state.spent_cost_micro(sr, flat_prices()), a_input: a.input, a_output: a.output, a_cost: company_state.step_cost_micro(sr, 0), b_input: b.input, b_cost: company_state.step_cost_micro(sr, 1), out_of_range: far.input + company_state.step_cost_micro(sr, 0 - 1) + company_state.step_cost_micro(sr, 3) + company_state.step_cost_micro(sr, 9223372036854775807) + company_state.step_recorded(sr, 3).input };
                }
                company_state.drop(heap, s);
            }
            company_manifest.drop(heap, m);
        }
        company_manifest.ManifestResult::Refused(r) => {
            test.assert(false);
        }
    }
    return p;
}

// A priced record carries the cost Forge derived when it recorded it; replay sums it, per company and per step.
fn test_the_recorded_cost_is_summed_per_company_and_per_step[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 512);
    j = add(heap, j, company_state.spend_priced(heap, 1, "a", 100, 20, 0, 0, 7));
    j = add(heap, j, company_state.spend_priced(heap, 2, "b", 10, 0, 0, 0, 5));
    j = add(heap, j, company_state.spend_priced(heap, 3, "a", 1, 2, 0, 0, 1));
    borrow j as &jb in {
        let p = cost_probe(heap, buffer.bytes(jb));
        test.assert_eq(p.rule, 0);
        test.assert_eq(p.input, 111);
        test.assert_eq(p.recorded, 13);
        test.assert_eq(p.spent, 13);
        test.assert_eq(p.a_input, 101);
        test.assert_eq(p.a_output, 22);
        test.assert_eq(p.a_cost, 8);
        test.assert_eq(p.b_input, 10);
        test.assert_eq(p.b_cost, 5);
        test.assert_eq(p.out_of_range, 0);
    }
    buffer.drop(heap, j);
    return 0;
}

// The recorded cost is authoritative: a million tokens recorded at a cost of 3 are 3, not re-priced from the totals (the replay
// does not know the per-call tier; pricing the totals would put Haiku at its higher tier).
fn test_a_recorded_cost_is_not_repriced_from_the_tokens[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 512);
    j = add(heap, j, company_state.spend_priced(heap, 1, "a", 1000000, 0, 0, 0, 3));
    borrow j as &jb in {
        let p = cost_probe(heap, buffer.bytes(jb));
        test.assert_eq(p.rule, 0);
        test.assert_eq(p.input, 1000000);
        test.assert_eq(p.spent, 3);
    }
    buffer.drop(heap, j);
    return 0;
}

// A record without `cost_micro` (written before the field existed) is unpriced: its recorded cost is 0, and `spent_cost_micro`
// prices its tokens with the prices it is given (the caller's, conservative tier), beside the recorded cost of the others.
fn test_a_record_without_cost_is_priced_by_the_caller_and_added[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 512);
    j = add(heap, j, company_state.spend_recorded(heap, 1, "a", 100, 0, 0, 0));
    j = add(heap, j, company_state.spend_priced(heap, 2, "b", 50, 0, 0, 0, 7));
    borrow j as &jb in {
        let p = cost_probe(heap, buffer.bytes(jb));
        test.assert_eq(p.rule, 0);
        test.assert_eq(p.input, 150);
        test.assert_eq(p.recorded, 7);
        test.assert_eq(p.spent, 107);
        test.assert_eq(p.a_input, 100);
        test.assert_eq(p.a_cost, 0);
    }
    buffer.drop(heap, j);
    return 0;
}

fn test_a_cost_that_is_not_a_count_is_event_malformed[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = buffer.append(heap, j, "{\"v\":1,\"seq\":1,\"kind\":\"company.spend.recorded\",\"task\":\"a\",\"input\":1,\"output\":0,\"cache_write\":0,\"cache_read\":0,\"cost_micro\":-1}\n");
    var k = buffer.empty(heap, 256);
    k = buffer.append(heap, k, "{\"v\":1,\"seq\":1,\"kind\":\"company.spend.recorded\",\"task\":\"a\",\"input\":1,\"output\":0,\"cache_write\":0,\"cache_read\":0,\"cost_micro\":\"7\"}\n");
    var m = buffer.empty(heap, 256);
    m = buffer.append(heap, m, "{\"v\":1,\"seq\":1,\"kind\":\"company.spend.recorded\",\"task\":\"a\",\"input\":1,\"output\":0,\"cache_write\":0,\"cache_read\":0,\"cost_micro\":1000000000000001}\n");
    var n = buffer.empty(heap, 256);
    n = add(heap, n, company_state.spend_priced(heap, 1, "a", 1, 0, 0, 0, 0 - 4));
    borrow j as &jb in {
        test.assert(bytes.equal(rule_name_of(heap, buffer.bytes(jb)), "event-malformed"));
    }
    borrow k as &kb in {
        test.assert(bytes.equal(rule_name_of(heap, buffer.bytes(kb)), "event-malformed"));
    }
    borrow m as &mb in {
        test.assert(bytes.equal(rule_name_of(heap, buffer.bytes(mb)), "event-malformed"));
        test.assert_eq(cost_probe(heap, buffer.bytes(mb)).input, 0);
    }
    borrow n as &nb in {
        test.assert(bytes.equal(rule_name_of(heap, buffer.bytes(nb)), "event-malformed"));
    }
    buffer.drop(heap, j);
    buffer.drop(heap, k);
    buffer.drop(heap, m);
    buffer.drop(heap, n);
    return 0;
}

// A spend record for a step id the manifest does not have counts for the company, and for no step.
fn test_a_spend_of_an_unknown_step_counts_for_the_company_only[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.spend_priced(heap, 1, "zzz", 9, 0, 0, 0, 4));
    borrow j as &jb in {
        let p = cost_probe(heap, buffer.bytes(jb));
        test.assert_eq(p.rule, 0);
        test.assert_eq(p.input, 9);
        test.assert_eq(p.recorded, 4);
        test.assert_eq(p.a_input + p.b_input + p.a_cost + p.b_cost, 0);
    }
    buffer.drop(heap, j);
    return 0;
}

fn test_the_recorded_cost_saturates[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.spend_priced(heap, 1, "a", 0, 0, 0, 0, 1000000000000000));
    j = add(heap, j, company_state.spend_priced(heap, 2, "a", 0, 0, 0, 0, 1000000000000000));
    j = add(heap, j, company_state.spend_recorded(heap, 3, "a", 1000000000000000, 0, 0, 0));
    borrow j as &jb in {
        let p = cost_probe(heap, buffer.bytes(jb));
        test.assert_eq(p.rule, 0);
        test.assert_eq(p.recorded, 1000000000000000);
        test.assert_eq(p.a_cost, 1000000000000000);
        test.assert_eq(p.spent, 1000000000000000);
    }
    buffer.drop(heap, j);
    return 0;
}

// ---- held by a check (no Forge-level retry) ----------------------------------------------------------------------------------

// The held codes of steps a, b, c (0 free, 1 check-failed, 2 check-unavailable) as one number a + 10 b + 100 c, the rule, and the
// step number of a few gate names.
struct HeldProbe {
    held: int,
    rule: int,
    retry_a: int,
    retry_c: int,
    retry_none: int,
    retry_bare: int,
}

fn held_probe[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] HeldProbe {
    var p = HeldProbe { held: 0 - 1, rule: 0 - 1, retry_a: 0, retry_c: 0, retry_none: 0, retry_bare: 0 };
    match company_manifest.parse(heap, manifest_text()) {
        company_manifest.ManifestResult::Held(m) => {
            borrow m as &mr in {
                let s = company_state.replay(heap, text, mr);
                borrow s as &sr in {
                    let held = company_state.held_by_check(sr, 0) + 10 * company_state.held_by_check(sr, 1) + 100 * company_state.held_by_check(sr, 2) + company_state.held_by_check(sr, 3) + company_state.held_by_check(sr, 0 - 1) + company_state.held_by_check(sr, 9223372036854775807);
                    p = HeldProbe { held: held, rule: company_state.report_of(sr).rule, retry_a: company_state.retry_step(mr, "retry:a"), retry_c: company_state.retry_step(mr, "retry:c"), retry_none: company_state.retry_step(mr, "retry:zz"), retry_bare: company_state.retry_step(mr, "a") + company_state.retry_step(mr, "retry:") + company_state.retry_step(mr, "") };
                }
                company_state.drop(heap, s);
            }
            company_manifest.drop(heap, m);
        }
        company_manifest.ManifestResult::Refused(r) => {
            test.assert(false);
        }
    }
    return p;
}

fn test_a_retry_gate_names_a_step_of_the_manifest[&h](heap: &!h Heap) -> [heap] int {
    let p = held_probe(heap, "");
    test.assert_eq(p.held, 0);
    test.assert_eq(p.retry_a, 0);
    test.assert_eq(p.retry_c, 2);
    test.assert_eq(p.retry_none, 0 - 1);
    test.assert_eq(p.retry_bare, 0 - 3);
    test.assert(bytes.equal(company_state.retry_prefix(), "retry:"));
    return 0;
}

// A failed check holds its step: the run will not start it again by itself (spec section 10: no Forge-level retry).
fn test_a_failed_check_holds_the_step[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 512);
    j = add(heap, j, company_state.admitted(heap, 1, "a", "steps/a"));
    j = add(heap, j, company_state.check_failed(heap, 2, "a", 1, 2));
    borrow j as &jb in {
        let p = held_probe(heap, buffer.bytes(jb));
        test.assert_eq(p.rule, 0);
        test.assert_eq(p.held, 1);
    }
    buffer.drop(heap, j);
    return 0;
}

fn test_an_unavailable_check_holds_the_step_and_says_so[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 512);
    j = add(heap, j, company_state.check_unavailable(heap, 1, "b", "check-unavailable"));
    borrow j as &jb in {
        let p = held_probe(heap, buffer.bytes(jb));
        test.assert_eq(p.rule, 0);
        test.assert_eq(p.held, 20);
    }
    buffer.drop(heap, j);
    return 0;
}

// The recorded reason is kept, so a later run names the same refusal (fix wave, M1): 3 artifact-invalid, 4 usage-invalid; any other
// reason text is a plain unavailable check (2).
fn test_the_reason_of_an_unavailable_check_is_kept_as_its_held_code[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 512);
    j = add(heap, j, company_state.check_unavailable(heap, 1, "a", "artifact-invalid"));
    j = add(heap, j, company_state.check_unavailable(heap, 2, "b", "usage-invalid"));
    j = add(heap, j, company_state.check_unavailable(heap, 3, "c", "something else"));
    borrow j as &jb in {
        let p = held_probe(heap, buffer.bytes(jb));
        test.assert_eq(p.rule, 0);
        test.assert_eq(p.held, 3 + 40 + 200);
    }
    buffer.drop(heap, j);
    return 0;
}

// A person approving `retry:<step>` AFTER the failure lets it go; a rejection, a retry of another step, or an approval made
// BEFORE the failure does not; a later failure holds it again; acceptance frees it.
fn test_only_an_approved_retry_recorded_after_the_failure_frees_the_step[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 1024);
    j = add(heap, j, company_state.gate_decided(heap, 1, "retry:a", "approved", "ana", "early"));
    j = add(heap, j, company_state.check_failed(heap, 2, "a", 1, 2));
    j = add(heap, j, company_state.gate_decided(heap, 3, "retry:a", "rejected", "ana", "no"));
    j = add(heap, j, company_state.gate_decided(heap, 4, "retry:b", "approved", "ana", "other"));
    borrow j as &jb in {
        test.assert_eq(held_probe(heap, buffer.bytes(jb)).held, 1);
    }
    j = add(heap, j, company_state.gate_decided(heap, 5, "retry:a", "approved", "ana", "try again"));
    borrow j as &jb in {
        test.assert_eq(held_probe(heap, buffer.bytes(jb)).held, 0);
    }
    j = add(heap, j, company_state.check_unavailable(heap, 6, "a", "check-unavailable"));
    borrow j as &jb in {
        test.assert_eq(held_probe(heap, buffer.bytes(jb)).held, 2);
    }
    j = add(heap, j, company_state.gate_decided(heap, 7, "retry:a", "approved", "ana", "again"));
    j = add(heap, j, company_state.check_failed(heap, 8, "c", 0, 3));
    j = add(heap, j, company_state.accepted(heap, 9, "c", "x", "y"));
    borrow j as &jb in {
        let p = held_probe(heap, buffer.bytes(jb));
        test.assert_eq(p.rule, 0);
        test.assert_eq(p.held, 0);
    }
    buffer.drop(heap, j);
    return 0;
}

fn test_an_unavailable_record_without_a_reason_is_event_malformed[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = buffer.append(heap, j, "{\"v\":1,\"seq\":1,\"kind\":\"company.step.check_unavailable\",\"task\":\"a\"}\n");
    borrow j as &jb in {
        test.assert(bytes.equal(rule_name_of(heap, buffer.bytes(jb)), "event-malformed"));
    }
    buffer.drop(heap, j);
    return 0;
}

// ---- the builders ---------------------------------------------------------------------------------------------------------

fn test_every_builder_writes_one_complete_line[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 512);
    j = add(heap, j, company_state.admitted(heap, 1, "a", "t-1"));
    j = add(heap, j, company_state.accepted(heap, 2, "a", "out", "abc"));
    j = add(heap, j, company_state.check_failed(heap, 3, "b", 0, 2));
    j = add(heap, j, company_state.gate_decided(heap, 4, "g", "approved", "ana", "ok"));
    j = add(heap, j, company_state.spend_recorded(heap, 5, "a", 1, 2, 3, 4));
    borrow j as &jb in {
        let data = buffer.bytes(jb);
        test.assert_eq(journal.after_last_newline(data), len(data));
        let p = probe_of(heap, data);
        test.assert_eq(p.rule, 0);
        test.assert_eq(p.records, 5);
        test.assert_eq(p.torn, 0);
        test.assert_eq(p.valid, len(data));
        test.assert_eq(p.gate, 1);
        test.assert_eq(p.input, 1);
        test.assert_eq(p.cache_read, 4);
    }
    buffer.drop(heap, j);
    return 0;
}

// ---- human gates: which steps a gate blocks ------------------------------------------------------------------------------

// Step a is behind gate g, b needs a (no gate), c needs nothing (no gate).
fn gate_manifest_text() -> [] &static [byte] {
    return "{\"id\":\"co\",\"mission\":\"m\",\"model\":{\"provider\":\"anthropic\",\"name\":\"haiku\"},\"budget\":{\"input\":1,\"output\":1,\"cache_write\":1,\"cache_read\":1,\"max_cost\":1,\"price_table\":\"p.json\"},\"human_gates\":[\"g\"],\"roles\":[\"qa\"],\"steps\":[{\"id\":\"a\",\"role\":\"qa\",\"task_type\":\"repo.gate\",\"needs\":[],\"input\":\"x\",\"gate\":\"g\"},{\"id\":\"b\",\"role\":\"qa\",\"task_type\":\"repo.gate\",\"needs\":[\"a\"],\"input\":\"x\"},{\"id\":\"c\",\"role\":\"qa\",\"task_type\":\"repo.gate\",\"needs\":[],\"input\":\"x\"}]}";
}

// blocked-by-gate of steps a, b, c as 3 digits (a*100 + b*10 + c), and the next runnable step number (-1 for none).
struct GateProbe {
    blocked: int,
    next: int,
    out_of_range: int,
}

fn gate_probe_of[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] GateProbe {
    var p = GateProbe { blocked: 0 - 1, next: 0 - 2, out_of_range: 0 - 1 };
    match company_manifest.parse(heap, gate_manifest_text()) {
        company_manifest.ManifestResult::Held(m) => {
            borrow m as &mr in {
                let s = company_state.replay(heap, text, mr);
                borrow s as &sr in {
                    let a = company_state.step_blocked_by_gate(mr, sr, 0);
                    let b = company_state.step_blocked_by_gate(mr, sr, 1);
                    let c = company_state.step_blocked_by_gate(mr, sr, 2);
                    var next = 0 - 1;
                    match company_state.next_runnable(mr, sr) {
                        option.Option::Some(n) => {
                            next = n;
                        }
                        option.Option::None => {
                            next = 0 - 1;
                        }
                    }
                    p = GateProbe { blocked: a * 100 + b * 10 + c, next: next, out_of_range: company_state.step_blocked_by_gate(mr, sr, 3) + company_state.step_blocked_by_gate(mr, sr, 0 - 1) };
                }
                company_state.drop(heap, s);
            }
            company_manifest.drop(heap, m);
        }
        company_manifest.ManifestResult::Refused(r) => {
            test.assert(false);
        }
    }
    return p;
}

fn test_a_step_behind_an_open_gate_is_blocked_gate_open_and_a_free_step_is_not[&h](heap: &!h Heap) -> [heap] int {
    let p = gate_probe_of(heap, "");
    test.assert_eq(p.blocked, 100);
    test.assert_eq(p.next, 2);
    test.assert_eq(p.out_of_range, 0);
    return 0;
}

fn test_an_approved_gate_frees_its_step[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.gate_decided(heap, 1, "g", "approved", "ana", "fine"));
    borrow j as &jb in {
        let p = gate_probe_of(heap, buffer.bytes(jb));
        test.assert_eq(p.blocked, 0);
        test.assert_eq(p.next, 0);
    }
    buffer.drop(heap, j);
    return 0;
}

fn test_a_rejected_gate_blocks_its_step_gate_rejected_and_its_dependents_are_never_ready[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.gate_decided(heap, 1, "g", "rejected", "ana", "no"));
    borrow j as &jb in {
        let p = gate_probe_of(heap, buffer.bytes(jb));
        test.assert_eq(p.blocked, 200);
        test.assert_eq(p.next, 2);
    }
    // c done: nothing is runnable, b waits on a, a is rejected.
    j = add(heap, j, company_state.accepted(heap, 2, "c", "out", "abc"));
    borrow j as &kb in {
        let p = gate_probe_of(heap, buffer.bytes(kb));
        test.assert_eq(p.blocked, 200);
        test.assert_eq(p.next, 0 - 1);
    }
    buffer.drop(heap, j);
    return 0;
}

fn test_approve_reject_approve_the_last_decision_decides_what_is_runnable[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 512);
    j = add(heap, j, company_state.gate_decided(heap, 1, "g", "approved", "ana", "ok"));
    j = add(heap, j, company_state.gate_decided(heap, 2, "g", "rejected", "ana", "no"));
    borrow j as &ab in {
        test.assert_eq(gate_probe_of(heap, buffer.bytes(ab)).blocked, 200);
    }
    j = add(heap, j, company_state.gate_decided(heap, 3, "g", "approved", "ana", "ok again"));
    borrow j as &bb in {
        test.assert_eq(gate_probe_of(heap, buffer.bytes(bb)).blocked, 0);
        test.assert_eq(gate_probe_of(heap, buffer.bytes(bb)).next, 0);
    }
    buffer.drop(heap, j);
    return 0;
}

fn test_an_accepted_gated_step_is_not_runnable_and_its_dependent_is[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 256);
    j = add(heap, j, company_state.gate_decided(heap, 1, "g", "approved", "ana", "ok"));
    j = add(heap, j, company_state.accepted(heap, 2, "a", "out", "abc"));
    borrow j as &jb in {
        test.assert_eq(gate_probe_of(heap, buffer.bytes(jb)).next, 1);
    }
    buffer.drop(heap, j);
    return 0;
}

// ---- the artifact an accepted step left (task 8c: what `needs` passes on) ------------------------------------------------

// 1 when step number `i`'s recorded artifact is `path` with the digest `sha` (both empty: nothing recorded for it), else 0.
fn artifact_is[&h, &t, &p, &x](heap: &!h Heap, text: &t [byte], i: int, path: &p [byte], sha: &x [byte]) -> [heap] int {
    var got = 0 - 1;
    match company_manifest.parse(heap, manifest_text()) {
        company_manifest.ManifestResult::Held(m) => {
            borrow m as &mr in {
                let s = company_state.replay(heap, text, mr);
                borrow s as &sr in {
                    let (ap, ah) = company_state.artifact_of(sr, i);
                    got = 0;
                    if bytes.equal(ap, path) {
                        if bytes.equal(ah, sha) {
                            got = 1;
                        }
                    }
                }
                company_state.drop(heap, s);
            }
            company_manifest.drop(heap, m);
        }
        company_manifest.ManifestResult::Refused(r) => {
            test.assert(false);
        }
    }
    return got;
}

fn test_an_accepted_step_exposes_the_artifact_and_digest_it_was_accepted_with[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 512);
    j = add(heap, j, company_state.admitted(heap, 1, "a", "steps/a"));
    j = add(heap, j, company_state.accepted(heap, 2, "a", "steps/a/ev/project.cho", "ab12"));
    j = add(heap, j, company_state.admitted(heap, 3, "b", "steps/b"));
    borrow j as &jb in {
        let t = buffer.bytes(jb);
        test.assert_eq(artifact_is(heap, t, 0, "steps/a/ev/project.cho", "ab12"), 1);
        test.assert_eq(artifact_is(heap, t, 1, "", ""), 1);
        test.assert_eq(artifact_is(heap, t, 2, "", ""), 1);
        test.assert_eq(artifact_is(heap, t, 3, "", ""), 1);
        test.assert_eq(artifact_is(heap, t, 0 - 1, "", ""), 1);
        test.assert_eq(artifact_is(heap, t, 9223372036854775807, "", ""), 1);
    }
    buffer.drop(heap, j);
    test.assert_eq(artifact_is(heap, "", 0, "", ""), 1);
    return 0;
}

// The path is held decoded: an escape in the journal's string is the byte it stands for.
fn test_an_escaped_artifact_path_is_held_decoded[&h](heap: &!h Heap) -> [heap] int {
    let line = "{\"v\":1,\"seq\":1,\"kind\":\"company.step.accepted\",\"task\":\"b\",\"artifact\":\"steps/q\\\"x\\\\y/ev/p\",\"sha256\":\"ff\"}\n";
    test.assert_eq(artifact_is(heap, line, 1, "steps/q\"x\\y/ev/p", "ff"), 1);
    test.assert_eq(artifact_is(heap, line, 0, "", ""), 1);
    return 0;
}

fn test_the_last_accepted_record_of_a_step_is_its_artifact[&h](heap: &!h Heap) -> [heap] int {
    var j = buffer.empty(heap, 512);
    j = add(heap, j, company_state.accepted(heap, 1, "c", "first", "11"));
    j = add(heap, j, company_state.accepted(heap, 2, "a", "of-a", "aa"));
    j = add(heap, j, company_state.accepted(heap, 3, "c", "second", "22"));
    j = add(heap, j, company_state.accepted(heap, 4, "zz", "unknown", "33"));
    borrow j as &jb in {
        let t = buffer.bytes(jb);
        test.assert_eq(artifact_is(heap, t, 2, "second", "22"), 1);
        test.assert_eq(artifact_is(heap, t, 0, "of-a", "aa"), 1);
        test.assert_eq(artifact_is(heap, t, 1, "", ""), 1);
    }
    buffer.drop(heap, j);
    return 0;
}

// A malformed accepted record ends the replay: nothing of it is held.
fn test_a_malformed_accepted_record_records_no_artifact[&h](heap: &!h Heap) -> [heap] int {
    let line = "{\"v\":1,\"seq\":1,\"kind\":\"company.step.accepted\",\"task\":\"a\",\"artifact\":\"p\",\"sha256\":7}\n";
    test.assert_eq(artifact_is(heap, line, 0, "", ""), 1);
    return 0;
}
