    test.assert(bytes.equal(steps_rule(heap, "{\"id\":\"a\",\"role\":\"qa\",\"task_type\":\"repo.gate\",\"needs\":[],\"input\":\"x\",\"gate\":\"product-brief\"}"), ""));
