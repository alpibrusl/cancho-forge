fn test_a_missing_budget_or_price_table_is_refused[&h](heap: &!h Heap) -> [heap] int {
    test.assert(bytes.equal(budget_rule(heap, ""), "budget-missing"));
    test.assert(bytes.equal(budget_rule(heap, "\"budget\":{\"input\":1,\"output\":1,\"cache_write\":1,\"cache_read\":1,\"max_cost\":1}"), "price-table-missing"));
    test.assert(bytes.equal(budget_rule(heap, "\"budget\":{\"input\":1,\"output\":1,\"cache_write\":1,\"cache_read\":1,\"price_table\":\"p.json\"}"), "budget-missing"));
    test.assert(bytes.equal(budget_rule(heap, "\"budget\":{}"), "budget-missing"));
    return 0;
}

fn test_a_price_table_that_is_not_a_plain_file_name_is_malformed[&h](heap: &!h Heap) -> [heap] int {
    test.assert(bytes.equal(budget_rule(heap, "\"budget\":{\"input\":1,\"output\":1,\"cache_write\":1,\"cache_read\":1,\"max_cost\":1,\"price_table\":\"\"}"), "price-table-missing"));
    test.assert(bytes.equal(budget_rule(heap, "\"budget\":{\"input\":1,\"output\":1,\"cache_write\":1,\"cache_read\":1,\"max_cost\":1,\"price_table\":\"/etc/passwd\"}"), "manifest-malformed"));
    test.assert(bytes.equal(budget_rule(heap, "\"budget\":{\"input\":1,\"output\":1,\"cache_write\":1,\"cache_read\":1,\"max_cost\":1,\"price_table\":\"../p.json\"}"), "manifest-malformed"));
    test.assert(bytes.equal(budget_rule(heap, "\"budget\":{\"input\":1,\"output\":1,\"cache_write\":1,\"cache_read\":1,\"max_cost\":1,\"price_table\":5}"), "manifest-malformed"));
    return 0;
}

fn test_a_step_may_need_one_written_after_it[&h](heap: &!h Heap) -> [heap] int {
    let s = "{\"id\":\"a\",\"role\":\"qa\",\"task_type\":\"repo.gate\",\"needs\":[\"b\"],\"input\":\"x\"},{\"id\":\"b\",\"role\":\"qa\",\"task_type\":\"repo.gate\",\"needs\":[],\"input\":\"y\"}";
    test.assert(bytes.equal(steps_rule(heap, s), ""));
    return 0;
}

// `n` steps named s0, s1, ...; step k needs step k + 1 (the last needs nothing), or, with `ring`, the last needs s0.
fn chain[&h](heap: &!h Heap, n: int, ring: bool) -> [heap] buffer.Buffer {
    var o = buffer.empty(heap, 40000);
    var k = 0;
    while k < n {
        if k > 0 {
            o = buffer.push(heap, o, byte_of(44));
        }
        o = buffer.append(heap, o, "{\"id\":\"s");
        o = buffer.push_nat(heap, o, k);
        o = buffer.append(heap, o, "\",\"role\":\"qa\",\"task_type\":\"repo.gate\",\"needs\":[");
        if k + 1 < n {
            o = buffer.append(heap, o, "\"s");
            o = buffer.push_nat(heap, o, k + 1);
            o = buffer.push(heap, o, byte_of(34));
        } else if ring {
            o = buffer.append(heap, o, "\"s0\"");
        }
        o = buffer.append(heap, o, "],\"input\":\"x\"}");
        k = k + 1;
    }
    return o;
}

fn test_the_most_steps_in_a_chain_are_held_and_one_more_is_malformed[&h](heap: &!h Heap) -> [heap] int {
    let ok = chain(heap, 256, false);
    borrow ok as &b in {
        test.assert(bytes.equal(steps_rule(heap, buffer.bytes(b)), ""));
    }
    buffer.drop(heap, ok);
    let ring = chain(heap, 256, true);
    borrow ring as &b in {
        test.assert(bytes.equal(steps_rule(heap, buffer.bytes(b)), "step-cycle"));
    }
    buffer.drop(heap, ring);
    let over = chain(heap, 257, false);
    borrow over as &b in {
        test.assert(bytes.equal(steps_rule(heap, buffer.bytes(b)), "manifest-malformed"));
    }
    buffer.drop(heap, over);
    return 0;
}

fn test_a_library_on_a_builder_with_a_contract_is_held_and_reads_back[&h](heap: &!h Heap) -> [heap] int {
    let d = doc(heap, "{\"id\":\"a\",\"role\":\"builder\",\"task_type\":\"project.build\",\"needs\":[],\"input\":\"x\",\"check\":\"c.cho\",\"contract\":\"api.txt\",\"library\":\"diff\"},{\"id\":\"b\",\"role\":\"builder\",\"task_type\":\"project.build\",\"needs\":[],\"input\":\"x\",\"check\":\"c.cho\"}", budget(), "");
    borrow d as &db in {
        match company_manifest.parse(heap, buffer.bytes(db)) {
            company_manifest.ManifestResult::Held(m) => {
                borrow m as &mr in {
                    test.assert(bytes.equal(company_manifest.step_library(mr, company_manifest.step_at(mr, 0)), "diff"));
                    test.assert_eq(len(company_manifest.step_library(mr, company_manifest.step_at(mr, 1))), 0);
                }
                company_manifest.drop(heap, m);
            }
            company_manifest.ManifestResult::Refused(r) => {
                test.assert(false);
            }
        }
    }
    buffer.drop(heap, d);
    return 0;
}

