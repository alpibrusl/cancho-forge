edition 9;

import std.buffer;
import std.bytes;
import std.io;
import std.json;
import forge.support;
import forge.verbs;

// The mock worker of docs/worker-contract.md, section 8: one `execute` request on stdin, one response on stdout, exit
// 0. It does what the request tells it to, the way a real worker would be driven: `task.input.inject` names the
// behaviour, so the adapter under test is called exactly as production calls it (no argument, no environment).
//
//   inject        what the mock does
//   ok            writes `out.txt` ("abc") in `grants.execution_dir` and answers `succeeded` with it as evidence
//   fail          answers `failed` with an `error` (retryable)
//   fail_final    answers `failed` with an `error` that is not retryable
//   partial       answers `partial`, with `out.txt` and an `error`
//   hang          never answers
//   garbage       exits 0 having written something that is not JSON
//   exit3         exits 3 having written nothing
//   crash         traps (an out-of-bounds read): ended by a signal
//   overflow      writes far more than any cap the tests set
//   wrong_id      answers for another `request_id`
//   bad_hash      evidence whose hash is not the file's
//   bad_size      evidence whose size is not the file's
//   missing       evidence naming a file that is not there
//   link          evidence naming `link`, which the gate made a symlink to a file outside the directory
//   dotdot        evidence whose ref has two dots
//
// The other four verbs (section 3.6) are answered from the request id (`capabilities`) or the `target` (`cancel`, `status`,
// `result`), so a test reaches every verdict of `forge.verbs` with a real child process:
//
//   capabilities, request id      reply
//   r-async                       level `async` (any other id: `sync`)
//   r-caps-noversion              `supports` lists a version Forge does not speak
//   r-caps-level, r-caps-limits, r-caps-worker, r-caps-types, r-caps-supports   one malformed part
//   cancel, target                reply
//   c-cancelled, c-none, c-late   `cancelled`, `not_running`, `too_late`
//   c-bad-state, c-wrong-target, c-no-target, c-wrong-id   one malformed part
//   status, target                reply
//   s-queued, s-running, s-finished, s-unknown   the four states (`s-running` with a progress and a time)
//   s-bad-state, s-bad-fraction, s-bad-step, s-bad-updated, s-wrong-target   one malformed part
//   result, target                reply
//   x-notready, x-ok, x-failed    `not_ready`; `succeeded`; `failed` with an error (task id `t-1`)
//   x-accepted, x-bad-id, x-garbage, x-bad-ref   `accepted` (never a result); another request id; not JSON; an escaped ref
//
// It holds `Fs` (to write its evidence), `Io` and `Heap`: no `Net`, no `Exec`.

fn abc_sha() -> [] &static [byte] {
    return "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
}

fn empty_sha() -> [] &static [byte] {
    return "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
}

fn read_request[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_read] buffer.Buffer {
    var all = buffer.empty(heap, 256);
    var c = getchar(io);
    while c >= 0 {
        all = buffer.push(heap, all, byte_of(c));
        c = getchar(io);
    }
    return all;
}

fn is[&s, &t](src: &s [byte], tape: &t [int], node: int, text: &static [byte]) -> [] bool {
    return json.is_string(tape, node) && json.string_equals(src, tape, node, text);
}

// The response, written to stdout. `entry` says whether there is one evidence entry, with this `ref`, hash and size.
fn answer[&h, &i, &r, &k, &p](heap: &!h Heap, io: &!i Io, request_id: &r [byte], task_id: &k [byte], state: &static [byte], entry: bool, path: &p [byte], sha: &static [byte], size: int, failing: bool, retryable: bool) -> [heap, io_write] int {
    var w = json.writer(heap, 256);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "contract");
    w = json.put_string(heap, w, "forge-worker/1");
    w = json.put_key(heap, w, "request_id");
    w = json.put_string(heap, w, request_id);
    w = json.put_key(heap, w, "state");
    w = json.put_string(heap, w, state);
    w = json.put_key(heap, w, "task_id");
    w = json.put_string(heap, w, task_id);
    w = json.put_key(heap, w, "summary");
    w = json.put_string(heap, w, "mock");
    w = json.put_key(heap, w, "evidence");
    w = json.begin_array(heap, w);
    if entry {
        w = json.begin_object(heap, w);
        w = json.put_key(heap, w, "id");
        w = json.put_string(heap, w, "ev-1");
        w = json.put_key(heap, w, "kind");
        w = json.put_string(heap, w, "file");
        w = json.put_key(heap, w, "ref");
        w = json.put_string(heap, w, path);
        w = json.put_key(heap, w, "sha256");
        w = json.put_string(heap, w, sha);
        w = json.put_key(heap, w, "bytes");
        w = json.put_int(heap, w, size);
        w = json.end_object(heap, w);
    }
    w = json.end_array(heap, w);
    w = json.put_key(heap, w, "error");
    if failing {
        w = json.begin_object(heap, w);
        w = json.put_key(heap, w, "code");
        w = json.put_string(heap, w, "mock-failed");
        w = json.put_key(heap, w, "message");
        w = json.put_string(heap, w, "injected");
        w = json.put_key(heap, w, "retryable");
        w = json.put_bool(heap, w, retryable);
        w = json.end_object(heap, w);
    } else {
        w = json.put_null(heap, w);
    }
    w = json.end_object(heap, w);
    let out = json.finish(w);
    borrow out as &o in {
        buffer.write(io, o);
    }
    io.newline(io);
    buffer.drop(heap, out);
    return 0;
}

// ---- the verbs besides `execute` ---------------------------------------------------------------------------

fn isn[&s, &t](src: &s [byte], tape: &t [int], node: int, text: &static [byte]) -> [] bool {
    return node >= 0 && json.is_string(tape, node) && json.string_equals(src, tape, node, text);
}

fn textn[&s, &t](src: &s [byte], tape: &t [int], node: int) -> [] &s [byte] {
    if node >= 0 && json.is_string(tape, node) && json.string_plain(tape, node) {
        return json.string_view(src, tape, node);
    }
    return "";
}

// The start of every reply: `{"contract":"forge-worker/1","request_id":...`.
fn head[&h, &r](heap: &!h Heap, request_id: &r [byte]) -> [heap] json.Writer {
    var w = json.writer(heap, 256);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "contract");
    w = json.put_string(heap, w, "forge-worker/1");
    w = json.put_key(heap, w, "request_id");
    w = json.put_string(heap, w, request_id);
    return w;
}

fn finish[&h, &i](heap: &!h Heap, io: &!i Io, w: json.Writer) -> [heap, io_write] int {
    let done = json.end_object(heap, w);
    let out = json.finish(done);
    borrow out as &o in {
        buffer.write(io, o);
    }
    io.newline(io);
    buffer.drop(heap, out);
    return 0;
}

fn put_target[&h, &g](heap: &!h Heap, w: json.Writer, target: &g [byte]) -> [heap] json.Writer {
    var x = json.put_key(heap, w, "target");
    x = json.put_string(heap, x, target);
    return x;
}

fn reply_capabilities[&h, &i, &r](heap: &!h Heap, io: &!i Io, rid: &r [byte]) -> [heap, io_write] int {
    var level = "sync";
    if bytes.equal(rid, "r-async") {
        level = "async";
    }
    var version = "forge-worker/1";
    if bytes.equal(rid, "r-caps-noversion") {
        version = "forge-worker/9";
    }
    var w = head(heap, rid);
    w = json.put_key(heap, w, "worker");
    if bytes.equal(rid, "r-caps-worker") {
        w = json.put_string(heap, w, "mock");
    } else {
        w = json.begin_object(heap, w);
        w = json.put_key(heap, w, "name");
        w = json.put_string(heap, w, "mock");
        w = json.put_key(heap, w, "version");
        w = json.put_string(heap, w, "0.1.0");
        w = json.end_object(heap, w);
    }
    w = json.put_key(heap, w, "supports");
    if bytes.equal(rid, "r-caps-supports") {
        w = json.begin_array(heap, w);
        w = json.end_array(heap, w);
    } else {
        w = json.begin_array(heap, w);
        w = json.put_string(heap, w, version);
        w = json.end_array(heap, w);
    }
    w = json.put_key(heap, w, "level");
    if bytes.equal(rid, "r-caps-level") {
        w = json.put_string(heap, w, "eventually");
    } else {
        w = json.put_string(heap, w, level);
    }
    w = json.put_key(heap, w, "task_types");
    if bytes.equal(rid, "r-caps-types") {
        w = json.put_string(heap, w, "repo.change");
    } else {
        w = json.begin_array(heap, w);
        w = json.begin_object(heap, w);
        w = json.put_key(heap, w, "type");
        w = json.put_string(heap, w, "repo.change");
        w = json.put_key(heap, w, "limits_max");
        w = json.begin_object(heap, w);
        w = json.put_key(heap, w, "timeout_ms");
        if bytes.equal(rid, "r-caps-limits") {
            w = json.put_int(heap, w, 0);
        } else {
            w = json.put_int(heap, w, 600000);
        }
        w = json.put_key(heap, w, "max_output_bytes");
        w = json.put_int(heap, w, 1048576);
        w = json.end_object(heap, w);
        w = json.end_object(heap, w);
        w = json.end_array(heap, w);
    }
    return finish(heap, io, w);
}

fn reply_cancel[&h, &i, &r, &g](heap: &!h Heap, io: &!i Io, rid: &r [byte], target: &g [byte]) -> [heap, io_write] int {
    var state = "cancelled";
    if bytes.equal(target, "c-none") {
        state = "not_running";
    }
    if bytes.equal(target, "c-late") {
        state = "too_late";
    }
    if bytes.equal(target, "c-bad-state") {
        state = "done";
    }
    var id = rid;
    if bytes.equal(target, "c-wrong-id") {
        id = "r-other";
    }
    var w = head(heap, id);
    w = json.put_key(heap, w, "state");
    w = json.put_string(heap, w, state);
    if bytes.equal(target, "c-wrong-target") {
        w = put_target(heap, w, "r-other");
    } else if !bytes.equal(target, "c-no-target") {
        w = put_target(heap, w, target);
    }
    return finish(heap, io, w);
}

fn reply_status[&h, &i, &r, &g](heap: &!h Heap, io: &!i Io, rid: &r [byte], target: &g [byte]) -> [heap, io_write] int {
    var state = "queued";
    if bytes.equal(target, "s-running") || bytes.equal(target, "s-bad-fraction") || bytes.equal(target, "s-bad-step") || bytes.equal(target, "s-bad-updated") {
        state = "running";
    }
    if bytes.equal(target, "s-finished") {
        state = "finished";
    }
    if bytes.equal(target, "s-unknown") {
        state = "unknown";
    }
    if bytes.equal(target, "s-bad-state") {
        state = "paused";
    }
    var w = head(heap, rid);
    w = json.put_key(heap, w, "state");
    w = json.put_string(heap, w, state);
    if bytes.equal(target, "s-wrong-target") {
        w = put_target(heap, w, "r-other");
    } else {
        w = put_target(heap, w, target);
    }
    if bytes.equal(target, "s-running") || bytes.equal(target, "s-bad-fraction") || bytes.equal(target, "s-bad-step") {
        w = json.put_key(heap, w, "progress");
        w = json.begin_object(heap, w);
        w = json.put_key(heap, w, "step");
        if bytes.equal(target, "s-bad-step") {
            w = json.put_int(heap, w, 7);
        } else {
            w = json.put_string(heap, w, "running tests");
        }
        w = json.put_key(heap, w, "fraction");
        if bytes.equal(target, "s-bad-fraction") {
            w = json.put_int(heap, w, 2);
        } else {
            w = json.put_fragment(heap, w, "0.6");
        }
        w = json.end_object(heap, w);
    }
    if bytes.equal(target, "s-running") {
        w = json.put_key(heap, w, "updated");
        w = json.put_string(heap, w, "2026-10-21T10:00:00Z");
    }
    if bytes.equal(target, "s-bad-updated") {
        w = json.put_key(heap, w, "updated");
        w = json.put_int(heap, w, 5);
    }
    return finish(heap, io, w);
}

fn reply_result[&h, &i, &r, &g](heap: &!h Heap, io: &!i Io, rid: &r [byte], target: &g [byte]) -> [heap, io_write] int {
    if bytes.equal(target, "x-garbage") {
        io.write_all(io, "this is not json\n");
        return 0;
    }
    if bytes.equal(target, "x-notready") {
        var w = head(heap, rid);
        w = json.put_key(heap, w, "state");
        w = json.put_string(heap, w, "not_ready");
        return finish(heap, io, w);
    }
    var id = rid;
    if bytes.equal(target, "x-bad-id") {
        id = "r-other";
    }
    if bytes.equal(target, "x-failed") {
        return answer(heap, io, id, "t-1", "failed", false, "", abc_sha(), 0, true, true);
    }
    if bytes.equal(target, "x-accepted") {
        return answer(heap, io, id, "t-1", "accepted", false, "", abc_sha(), 0, false, true);
    }
    if bytes.equal(target, "x-bad-ref") {
        return answer(heap, io, id, "t-1", "succeeded", true, "../x", abc_sha(), 3, false, true);
    }
    return answer(heap, io, id, "t-1", "succeeded", false, "", abc_sha(), 0, false, true);
}

// Is this request one of the four verbs besides `execute` of this contract? If so it is answered here and this is true;
// anything else (an `execute`, or what is not a request of the contract) is left to `serve`.
fn serve_verb[&h, &i, &s, &t](heap: &!h Heap, io: &!i Io, src: &s [byte], tp: &t [int]) -> [heap, io_read, io_write] bool {
    if !isn(src, tp, json.get(src, tp, 0, "contract"), "forge-worker/1") {
        return false;
    }
    let verb = json.get(src, tp, 0, "verb");
    let rid = textn(src, tp, json.get(src, tp, 0, "request_id"));
    let target = textn(src, tp, json.get(src, tp, 0, "target"));
    if bytes.equal(target, "v-overflow") {
        var n = 0;
        while n < 200 {
            io.write_all(io, "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
            n = n + 1;
        }
    }
    if bytes.equal(target, "v-hang") {
        var c = getchar(io);
        while c >= 0 || c < 0 {
            c = getchar(io);
        }
    }
    if isn(src, tp, verb, "capabilities") {
        reply_capabilities(heap, io, rid);
        return true;
    }
    if isn(src, tp, verb, "cancel") {
        reply_cancel(heap, io, rid, target);
        return true;
    }
    if isn(src, tp, verb, "status") {
        reply_status(heap, io, rid, target);
        return true;
    }
    if isn(src, tp, verb, "result") {
        reply_result(heap, io, rid, target);
        return true;
    }
    return false;
}

fn serve[&h, &i, &f, &g](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), g: &g Args) -> [heap, io_read, io_write, args, fs_write(""), file_write] int {
    let request = read_request(heap, io);
    var code = 0;
    borrow request as &rb in {
        let src = buffer.bytes(rb);
        let tape = box_slice(heap, json.tape_len(src), 0);
        borrow mut tape as &!t in {
            let tp = contents(t);
            let handled = json.parse(src, tp) > 0 && json.is_object(tp, 0) && serve_verb(heap, io, src, tp);
            if handled {
            } else if json.parse(src, tp) > 0 && json.is_object(tp, 0) {
                let task = json.get(src, tp, 0, "task");
                let inject = json.get(src, tp, json.get(src, tp, task, "input"), "inject");
                let rid = json.string_view(src, tp, json.get(src, tp, 0, "request_id"));
                let tid = json.string_view(src, tp, json.get(src, tp, task, "id"));
                let dir = json.string_view(src, tp, json.get(src, tp, json.get(src, tp, 0, "grants"), "execution_dir"));
                let target = support.under(heap, dir, "out.txt");
                // A request that is not an `execute` of this contract is not served.
                var serving = true;
                if !is(src, tp, json.get(src, tp, 0, "contract"), "forge-worker/1") || !is(src, tp, json.get(src, tp, 0, "verb"), "execute") {
                    code = 4;
                    serving = false;
                }
                if serving {
                    if is(src, tp, inject, "ok") || is(src, tp, inject, "partial") || is(src, tp, inject, "bad_hash") || is(src, tp, inject, "bad_size") {
                        borrow target as &tb in {
                            support.put_file(fs, buffer.bytes(tb), "abc");
                        }
                    }
                    if is(src, tp, inject, "ok") {
                        answer(heap, io, rid, tid, "succeeded", true, "out.txt", abc_sha(), 3, false, true);
                    }
                    if is(src, tp, inject, "partial") {
                        answer(heap, io, rid, tid, "partial", true, "out.txt", abc_sha(), 3, true, true);
                    }
                    if is(src, tp, inject, "fail") {
                        answer(heap, io, rid, tid, "failed", false, "", abc_sha(), 0, true, true);
                    }
                    if is(src, tp, inject, "fail_final") {
                        answer(heap, io, rid, tid, "failed", false, "", abc_sha(), 0, true, false);
                    }
                    if is(src, tp, inject, "wrong_id") {
                        answer(heap, io, "r-other", tid, "succeeded", false, "", abc_sha(), 0, false, true);
                    }
                    if is(src, tp, inject, "bad_hash") {
                        answer(heap, io, rid, tid, "succeeded", true, "out.txt", empty_sha(), 3, false, true);
                    }
                    if is(src, tp, inject, "bad_size") {
                        answer(heap, io, rid, tid, "succeeded", true, "out.txt", abc_sha(), 4, false, true);
                    }
                    if is(src, tp, inject, "missing") {
                        answer(heap, io, rid, tid, "succeeded", true, "gone.txt", abc_sha(), 3, false, true);
                    }
                    if is(src, tp, inject, "link") {
                        answer(heap, io, rid, tid, "succeeded", true, "link", abc_sha(), 7, false, true);
                    }
                    if is(src, tp, inject, "dotdot") {
                        answer(heap, io, rid, tid, "succeeded", true, "../x", abc_sha(), 3, false, true);
                    }
                    if is(src, tp, inject, "garbage") {
                        io.write_all(io, "this is not json\n");
                    }
                    if is(src, tp, inject, "exit3") {
                        code = 3;
                    }
                    if is(src, tp, inject, "overflow") {
                        var n = 0;
                        while n < 20000 {
                            io.write_all(io, "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
                            n = n + 1;
                        }
                    }
                    if is(src, tp, inject, "crash") {
                        // An index that is out of bounds traps: the worker ends by a signal.
                        code = int_of(arg(g, 7)[0]);
                    }
                    if is(src, tp, inject, "hang") {
                        var c = getchar(io);
                        while c >= 0 || c < 0 {
                            c = getchar(io);
                        }
                    }
                }
                buffer.drop(heap, target);
            } else {
                io.write_all(io, "this is not json\n");
            }
        }
        unbox_slice(heap, tape);
    }
    buffer.drop(heap, request);
    return code;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    release(tty);
    var console = io;
    var memory = heap;
    var code = 0;
    borrow fs as &f in {
        borrow mut console as &!i in {
            borrow mut memory as &!h in {
                borrow args as &g in {
                    code = serve(h, i, f, g);
                }
            }
        }
    }
    release(fs);
    release(console);
    release(memory);
    release(args);
    return code;
}
