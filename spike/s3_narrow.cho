edition 9;

import std.io;

// Spike 3: a worker is handed a *narrowed* `Exec`. One binary holds two
// unrelated narrowings, one program ("/bin/echo") and one directory
// ("/usr/bin"); argv[1] picks which spawn to attempt. Spawns inside the bound
// run; spawns outside it must trap (docs/processes.md section 4.1).
//   a: /bin/echo via Exec("/bin/echo")         -> allowed
//   b: /bin/cat  via Exec("/bin/echo")         -> outside the bound
//   c: /usr/bin/true via Exec("/usr/bin")      -> allowed
//   d: /usr/bin/../../bin/cat via Exec("/usr/bin") -> `..` component
//   e: /bin/cat  via Exec("/usr/bin")          -> outside the bound

fn reap[&i](io: &!i Io, label: &i [byte], child: Child) -> [io_write] int {
    io.write_all(io, label);
    io.write_all(io, ": ");
    match child_wait(child) {
        Exited::Code(n) => {
            io.write_all(io, "exited code ");
            io.print_int(io, n);
        }
        Exited::Signaled(s) => {
            io.write_all(io, "signaled ");
            io.print_int(io, s);
        }
        Exited::Failed(e) => {
            io.write_all(io, "wait failed ");
            io.print_int(io, e);
        }
    }
    io.newline(io);
    return 0;
}

fn spawn_one[&x, &i](exec: &x Exec("/bin/echo"), io: &!i Io, path: &i [byte]) -> [exec("/bin/echo"), io_write] int {
    match exec_spawn(exec, path, "narrowed\0", "", Stdio::Null, Stdio::Null, Stdio::Null) {
        Spawned::Failed(e) => {
            io.write_all(io, "spawn failed errno ");
            io.print_int(io, e);
            io.newline(io);
        }
        Spawned::Ok(child) => {
            reap(io, path, child);
        }
    }
    return 0;
}

fn spawn_dir[&x, &i](exec: &x Exec("/usr/bin"), io: &!i Io, path: &i [byte]) -> [exec("/usr/bin"), io_write] int {
    match exec_spawn(exec, path, "", "", Stdio::Null, Stdio::Null, Stdio::Null) {
        Spawned::Failed(e) => {
            io.write_all(io, "spawn failed errno ");
            io.print_int(io, e);
            io.newline(io);
        }
        Spawned::Ok(child) => {
            reap(io, path, child);
        }
    }
    return 0;
}

fn pick[&x, &y, &i, &g](one: &x Exec("/bin/echo"), dir: &y Exec("/usr/bin"), io: &!i Io, g: &g Args) -> [exec("/bin/echo"), exec("/usr/bin"), io_write, args] int {
    let mode = int_of(arg(g, 1)[0]);
    if mode == 'a' {
        spawn_one(one, io, "/bin/echo");
    }
    if mode == 'b' {
        spawn_one(one, io, "/bin/cat");
    }
    if mode == 'c' {
        spawn_dir(dir, io, "/usr/bin/true");
    }
    if mode == 'd' {
        spawn_dir(dir, io, "/usr/bin/../../bin/cat");
    }
    if mode == 'e' {
        spawn_dir(dir, io, "/bin/cat");
    }
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(fs);
    release(heap);
    release(net);
    release(clock);
    release(signals);
    release(tty);
    let (one, dir) = narrow(exec, "/bin/echo", "/usr/bin");
    var console = io;
    borrow one as &x in {
        borrow dir as &y in {
            borrow mut console as &!i in {
                borrow args as &g in {
                    pick(x, y, i, g);
                }
            }
        }
    }
    release(one);
    release(dir);
    release(console);
    release(args);
    return 0;
}
