edition 9;

import std.buffer;
import std.io;
import std.process;

// Spike 12: gap G10 (cancho #562, built by cancho #588 as `exec_spawn_detached_under`). S7 measured that a worker
// started by `exec_spawn` / `exec_spawn_under` leaks what it started when `capture` ends it at its deadline, and that
// `exec_spawn_detached` does not; there was no form that was both "found beneath a run-time `Dir`" (G1, S9) and "leads
// a group of its own" (S7). Now there is. The worker is a name beneath argv[2] (a directory opened as a `Dir`), under
// `Exec("")` with no path in the program; the worker is a script that starts `sleep 79`. An external `ps` after this
// program exits answers whether the grandchild is left.
//
//   argv[1] = u  exec_spawn_under: not a group leader; `capture` kills the worker's pid only (the control)
//             d  exec_spawn_detached_under: the worker leads a group of its own; `capture` kills the group
//   argv[2]  the directory holding the worker `grandkid`

fn begin[&x, &d](exec: &x Exec(""), dir: &d Dir, detached: bool, child_in: ChildEnd, child_out: ChildEnd) -> [exec_under, exec_detached] Spawned {
    if detached {
        return exec_spawn_detached_under(exec, dir, "grandkid", "", "", Stdio::Pipe(child_in), Stdio::Pipe(child_out), Stdio::Null);
    }
    return exec_spawn_under(exec, dir, "grandkid", "", "", Stdio::Pipe(child_in), Stdio::Pipe(child_out), Stdio::Null);
}

fn run[&h, &x, &d, &c, &i](heap: &!h Heap, exec: &x Exec(""), dir: &d Dir, clock: &c Clock, io: &!i Io, mode: int) -> [heap, exec_under, exec_detached, clock, poll, io_write] int {
    match process.channels() {
        process.Channels::Failed(e) => {
            io.write_all(io, "channels failed\n");
        }
        process.Channels::Ok(to_child, child_in, from_child, child_out) => {
            match begin(exec, dir, mode != 'u', child_in, child_out) {
                Spawned::Failed(e) => {
                    process.close(to_child, from_child);
                    io.write_all(io, "spawn failed errno ");
                    io.print_int(io, e);
                    io.newline(io);
                }
                Spawned::Ok(child) => {
                    let (out, ran) = process.capture(heap, clock, child, to_child, from_child, "", 4096, 300);
                    buffer.drop(heap, out);
                    match ran {
                        process.Ran::TimedOut => {
                            io.write_all(io, "worker timed out; killed and reaped\n");
                        }
                        _ => {
                            io.write_all(io, "unexpected ending\n");
                        }
                    }
                }
            }
        }
    }
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(net);
    release(signals);
    release(tty);
    var console = io;
    var memory = heap;
    borrow fs as &f in {
        borrow exec as &x in {
            borrow clock as &c in {
                borrow mut console as &!i in {
                    borrow mut memory as &!h in {
                        borrow args as &g in {
                            match open_dir(f, arg(g, 2)) {
                                DirOpened::Ok(d) => {
                                    var workers = d;
                                    borrow workers as &w in {
                                        run(h, x, w, c, i, int_of(arg(g, 1)[0]));
                                    }
                                    dir_close(workers);
                                }
                                DirOpened::Failed(e) => {
                                    io.write_all(i, "cannot open the directory\n");
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(exec);
    release(clock);
    release(console);
    release(memory);
    release(args);
    return 0;
}
