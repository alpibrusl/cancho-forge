edition 9;

import std.buffer;
import std.io;
import std.process;

// Spike 1: spawn a child under an `Exec` narrowed to "/bin", capture its
// standard output, and report how it ended (docs/processes.md section 7.1).

fn say_ran[&i](io: &!i Io, ran: process.Ran) -> [io_write] int {
    match ran {
        process.Ran::Code(n) => {
            io.write_all(io, "ran: code ");
            io.print_int(io, n);
        }
        process.Ran::Signaled(s) => {
            io.write_all(io, "ran: signaled ");
            io.print_int(io, s);
        }
        process.Ran::TimedOut => {
            io.write_all(io, "ran: timed out");
        }
        process.Ran::TooMuch => {
            io.write_all(io, "ran: too much");
        }
        process.Ran::Failed(e) => {
            io.write_all(io, "ran: failed errno ");
            io.print_int(io, e);
        }
    }
    io.newline(io);
    return 0;
}

fn run_echo[&h, &x, &c, &i](heap: &!h Heap, exec: &x Exec("/bin"), clock: &c Clock, io: &!i Io) -> [heap, exec("/bin"), clock, poll, io_write] int {
    match process.channels() {
        process.Channels::Failed(e) => {
            io.write_all(io, "channels failed\n");
        }
        process.Channels::Ok(to_child, child_in, from_child, child_out) => {
            match exec_spawn(exec, "/bin/echo", "hello from child\0", "", Stdio::Pipe(child_in), Stdio::Pipe(child_out), Stdio::Null) {
                Spawned::Failed(e) => {
                    process.close(to_child, from_child);
                    io.write_all(io, "spawn failed errno ");
                    io.print_int(io, e);
                    io.newline(io);
                }
                Spawned::Ok(child) => {
                    let (out, ran) = process.capture(heap, clock, child, to_child, from_child, "", 4096, 5000);
                    say_ran(io, ran);
                    borrow out as &o in {
                        io.write_all(io, "stdout: ");
                        io.write_all(io, buffer.bytes(o));
                    }
                    buffer.drop(heap, out);
                }
            }
        }
    }
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(fs);
    release(args);
    release(net);
    release(signals);
    release(tty);
    let bin = narrow(exec, "/bin");
    var console = io;
    var memory = heap;
    borrow bin as &x in {
        borrow clock as &c in {
            borrow mut console as &!i in {
                borrow mut memory as &!h in {
                    run_echo(h, x, c, i);
                }
            }
        }
    }
    release(bin);
    release(clock);
    release(console);
    release(memory);
    return 0;
}
