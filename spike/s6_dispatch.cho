edition 9;

import std.buffer;
import std.io;
import std.json;
import std.process;

// Spike 6: the whole worker round trip, as docs/worker-contract.md describes
// it. Forge holds `Exec` narrowed to ONE directory, writes a JSON request to
// a worker child's stdin, captures its stdout under a deadline and a size
// bound, and maps every way it can end to one outcome with a name.
// A worker that says "succeeded" is reported as a claim, never as acceptance.

fn bin() -> [] &static [byte] {
    return "/tmp/cancho-forge-spike/bin";
}

fn request[&h](heap: &!h Heap) -> [heap] buffer.Buffer {
    var w = json.writer(heap, 96);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "v");
    w = json.put_int(heap, w, 1);
    w = json.put_key(heap, w, "op");
    w = json.put_string(heap, w, "execute");
    w = json.put_key(heap, w, "task");
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "id");
    w = json.put_string(heap, w, "t-1");
    w = json.end_object(heap, w);
    w = json.end_object(heap, w);
    return json.finish(w);
}

// What a captured stdout means once the child exited 0.
fn read_state[&h, &s](heap: &!h Heap, out: &s [byte]) -> [heap] int {
    // 0 = not JSON, 1 = succeeded claim, 2 = failed claim, 3 = JSON with an unknown state
    let tape = box_slice(heap, json.tape_len(out), 0);
    var meaning = 0;
    borrow mut tape as &!t in {
        let tp = contents(t);
        if json.parse(out, tp) > 0 && json.is_object(tp, 0) {
            let state = json.get(out, tp, 0, "state");
            meaning = 3;
            if json.string_equals(out, tp, state, "succeeded") {
                meaning = 1;
            }
            if json.string_equals(out, tp, state, "failed") {
                meaning = 2;
            }
        }
    }
    unbox_slice(heap, tape);
    return meaning;
}

fn outcome[&h, &i](heap: &!h Heap, io: &!i Io, ran: process.Ran, out: buffer.Buffer) -> [heap, io_write] int {
    match ran {
        process.Ran::TimedOut => {
            io.write_all(io, "worker_timeout (child killed and reaped)");
        }
        process.Ran::TooMuch => {
            io.write_all(io, "worker_output_overflow (child killed and reaped)");
        }
        process.Ran::Failed(e) => {
            io.write_all(io, "worker_unavailable errno ");
            io.print_int(io, e);
        }
        process.Ran::Signaled(s) => {
            io.write_all(io, "worker_crashed signal bit ");
            io.print_int(io, s);
        }
        process.Ran::Code(n) => {
            if n != 0 {
                io.write_all(io, "worker_error exit ");
                io.print_int(io, n);
            } else {
                var meaning = 0;
                borrow out as &o in {
                    meaning = read_state(heap, buffer.bytes(o));
                }
                if meaning == 1 {
                    io.write_all(io, "worker_claims_succeeded -> verification (not accepted)");
                }
                if meaning == 2 {
                    io.write_all(io, "worker_reports_failed");
                }
                if meaning == 3 {
                    io.write_all(io, "protocol_error: unknown state");
                }
                if meaning == 0 {
                    io.write_all(io, "protocol_error: stdout is not a JSON object");
                }
            }
        }
    }
    buffer.drop(heap, out);
    return 0;
}

fn dispatch[&h, &x, &c, &i, &m](heap: &!h Heap, exec: &x Exec("/tmp/cancho-forge-spike/bin"), clock: &c Clock, io: &!i Io, label: &m [byte], args: &m [byte], timeout: int) -> [heap, exec("/tmp/cancho-forge-spike/bin"), clock, poll, io_write] int {
    let start = clock_ms(clock);
    io.write_all(io, label);
    io.write_all(io, ": ");
    let req = request(heap);
    match process.channels() {
        process.Channels::Failed(e) => {
            io.write_all(io, "channels failed\n");
        }
        process.Channels::Ok(to_child, child_in, from_child, child_out) => {
            match exec_spawn(exec, "/tmp/cancho-forge-spike/bin/mock_worker", args, "", Stdio::Pipe(child_in), Stdio::Pipe(child_out), Stdio::Null) {
                Spawned::Failed(e) => {
                    process.close(to_child, from_child);
                    io.write_all(io, "spawn failed errno ");
                    io.print_int(io, e);
                }
                Spawned::Ok(child) => {
                    borrow req as &q in {
                        let (out, ran) = process.capture(heap, clock, child, to_child, from_child, buffer.bytes(q), 4096, timeout);
                        outcome(heap, io, ran, out);
                    }
                }
            }
        }
    }
    io.write_all(io, " [");
    io.print_int(io, clock_ms(clock) - start);
    io.write_all(io, " ms]\n");
    buffer.drop(heap, req);
    return 0;
}

fn scenarios[&h, &x, &c, &i](heap: &!h Heap, exec: &x Exec("/tmp/cancho-forge-spike/bin"), clock: &c Clock, io: &!i Io) -> [heap, exec("/tmp/cancho-forge-spike/bin"), clock, poll, io_write] int {
    dispatch(heap, exec, clock, io, "normal      ", "", 2000);
    dispatch(heap, exec, clock, io, "reports fail", "f\0", 2000);
    dispatch(heap, exec, clock, io, "garbage     ", "g\0", 2000);
    dispatch(heap, exec, clock, io, "exit 3      ", "x\0", 2000);
    dispatch(heap, exec, clock, io, "hang (500ms)", "h\0", 500);
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(fs);
    release(args);
    release(net);
    release(signals);
    release(tty);
    let workers = narrow(exec, "/tmp/cancho-forge-spike/bin");
    var console = io;
    var memory = heap;
    borrow workers as &x in {
        borrow clock as &c in {
            borrow mut console as &!i in {
                borrow mut memory as &!h in {
                    scenarios(h, x, c, i);
                }
            }
        }
    }
    release(workers);
    release(clock);
    release(console);
    release(memory);
    return 0;
}
