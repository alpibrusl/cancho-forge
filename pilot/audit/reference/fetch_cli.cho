edition 9;

import std.buffer;
import std.bytes;
import std.io;
import fetch;

// A command line for the reference fetcher, used by pilot/audit/reference/fetch_check.sh to show the fetcher against the audit's world:
//
//     fetch_cli <resolver ip> <resolver port> <allow-loopback: 0|1> <url>
//
// Prints `refused <rule>` or the answer's JSON, and exits 0 (answered), 1 (refused), 2 (usage).

fn go[&h, &i, &n, &c, &g](heap: &!h Heap, io: &!i Io, net: &n Net(""), clock: &c Clock, args: &g Args) -> [heap, io_write, net_out(""), udp_send, udp_recv, conn_read, conn_write, poll, clock, args] int {
    var port = 0;
    var k = 0;
    while k < len(arg(args, 2)) {
        port = port * 10 + int_of(arg(args, 2)[k]) - 48;
        k = k + 1;
    }
    match fetch.run(heap, net, clock, arg(args, 1), port, bytes.equal(arg(args, 3), "1"), arg(args, 4)) {
        fetch.Outcome::Refused(rule) => {
            io.write_all(io, "refused ");
            io.write_all(io, rule);
            io.newline(io);
            return 1;
        }
        fetch.Outcome::Done(d) => {
            borrow d as &db in {
                io.write_all(io, buffer.bytes(db));
            }
            io.newline(io);
            buffer.drop(heap, d);
            return 0;
        }
    }
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(fs);
    release(signals);
    release(exec);
    release(tty);
    var console = io;
    var memory = heap;
    var code = 2;
    borrow net as &n in {
        borrow clock as &c in {
            borrow args as &g in {
                borrow mut console as &!i in {
                    borrow mut memory as &!h in {
                        if arg_count(g) >= 5 {
                            code = go(h, i, n, c, g);
                        }
                    }
                }
            }
        }
    }
    release(net);
    release(clock);
    release(console);
    release(memory);
    release(args);
    return code;
}
