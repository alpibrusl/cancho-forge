edition 9;

import std.buffer;
import std.bytes;
import std.io;
import audit_expect;

// The audit's driver (docs/pilot-audit.md section 4): one request to a candidate checker on loopback, one answer read under a deadline, one comparison with a spec.
//
//     driver <port> <target> <timeout_ms> <spec> [<method>]
//
// It sends `<method> <target> HTTP/1.1` (GET unless a method is given) to 127.0.0.1:<port> with `Connection: close`, reads until the peer closes, the answer passes 1 MiB or
// the deadline passes, takes the status from the status line and the body after the blank line, and checks them against <spec> (pilot/audit/expect.cho). It writes ONE line to
// standard output: `ok`, or `fail <why>`. Exit 0 when the spec held, 1 when it did not, 2 for a usage error, 3 when there was no answer to check (nothing listened, the peer
// sent nothing, the deadline passed with no status line). The candidate's own output is never read here; the driver is a separate process from the candidate.

fn number[&t](text: &t [byte]) -> [] int {
    if len(text) == 0 {
        return 0 - 1;
    }
    var n = 0;
    var k = 0;
    while k < len(text) {
        let c = int_of(text[k]);
        if c < 48 || c > 57 {
            return 0 - 1;
        }
        n = n * 10 + c - 48;
        k = k + 1;
    }
    return n;
}

fn send_all[&c, &d](conn: &!c Conn, data: &d [byte]) -> [conn_write] bool {
    var at = 0;
    while at < len(data) {
        match conn_write(conn, data[at..len(data)]) {
            Sent::Wrote(n) => {
                at = at + n;
            }
            Sent::Again => {
                at = at + 0;
            }
            Sent::Failed(e) => {
                return false;
            }
        }
    }
    return true;
}

// The status of the answer in `text` (`HTTP/1.x NNN ...`), or -1.
fn status_of[&t](text: &t [byte]) -> [] int {
    if len(text) < 12 || bytes.equal(text[0..5], "HTTP/") == false || int_of(text[8]) != 32 {
        return 0 - 1;
    }
    return number(text[9..12]);
}

// The offset just past the blank line that ends the head, or -1.
fn body_at[&t](text: &t [byte]) -> [] int {
    let at = bytes.find(text, "\r\n\r\n");
    if at < 0 {
        return 0 - 1;
    }
    return at + 4;
}

// Read the whole answer into `into`: stops at the peer's close, 1 MiB, or `deadline` (a clock_ms).
fn read_answer[&h, &c, &k](heap: &!h Heap, conn: &!c Conn, clock: &k Clock, deadline: int, into: buffer.Buffer) -> [heap, conn_read, poll, clock] buffer.Buffer {
    var out = into;
    conn_nonblocking(conn);
    match poller_new() {
        Polling::Failed(e) => {
            return out;
        }
        Polling::Ok(poller) => {
            var pw = poller;
            var done = false;
            var total = 0;
            borrow mut pw as &!pm in {
                poller_add_conn(pm, conn, 1, 1);
                region r {
                    let events = alloc_slice[r](8, 0);
                    let block = alloc_slice[r](8192, byte_of(0));
                    while done == false {
                        let left = deadline - clock_ms(clock);
                        if left <= 0 {
                            done = true;
                        } else {
                            let ready = poller_wait(pm, events, left);
                            if ready > 0 {
                                match conn_read(conn, block) {
                                    Received::Data(n) => {
                                        out = buffer.append(heap, out, block[0..n]);
                                        total = total + n;
                                        if total > 1048576 {
                                            done = true;
                                        }
                                    }
                                    Received::End => {
                                        done = true;
                                    }
                                    Received::Again => {
                                        done = false;
                                    }
                                    Received::Failed(e) => {
                                        done = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            poller_close(pw);
            return out;
        }
    }
}

fn run[&h, &i, &n, &k, &g](heap: &!h Heap, io: &!i Io, net: &n Net(""), clock: &k Clock, args: &g Args) -> [heap, io_write, net_out(""), conn_read, conn_write, poll, clock, args] int {
    let port = number(arg(args, 1));
    let timeout = number(arg(args, 3));
    if port < 1 || port > 65535 || timeout < 1 || len(arg(args, 2)) == 0 || len(arg(args, 4)) == 0 {
        io.write_all(io, "usage: driver <port> <target> <timeout_ms> <spec> [<method>]\n");
        return 2;
    }
    var method = "GET";
    if arg_count(args) > 5 {
        method = arg(args, 5);
    }
    let deadline = clock_ms(clock) + timeout;
    match tcp_connect(net, "127.0.0.1", port) {
        Dialed::Failed(e) => {
            io.write_all(io, "fail nothing listens on the port\n");
            return 3;
        }
        Dialed::Ok(opened) => {
            var conn = opened;
            var request = buffer.append(heap, buffer.empty(heap, 256), method);
            request = buffer.append(heap, request, " ");
            request = buffer.append(heap, request, arg(args, 2));
            request = buffer.append(heap, request, " HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n");
            var answer = buffer.empty(heap, 4096);
            var sent = false;
            borrow request as &rb in {
                borrow mut conn as &!c in {
                    sent = send_all(c, buffer.bytes(rb));
                    if sent {
                        answer = read_answer(heap, c, clock, deadline, answer);
                    }
                }
            }
            conn_close(conn);
            buffer.drop(heap, request);
            var code = 3;
            borrow answer as &ab in {
                let text = buffer.bytes(ab);
                let status = status_of(text);
                let at = body_at(text);
                if status < 0 || at < 0 {
                    io.write_all(io, "fail no complete answer head");
                    io.newline(io);
                } else {
                    let verdict = audit_expect.check(heap, status, text[at..len(text)], arg(args, 4));
                    if verdict == 0 {
                        io.write_all(io, "ok\n");
                        code = 0;
                    } else {
                        io.write_all(io, "fail check ");
                        io.print_int(io, verdict);
                        io.write_all(io, " status ");
                        io.print_int(io, status);
                        io.newline(io);
                        code = 1;
                    }
                }
            }
            buffer.drop(heap, answer);
            return code;
        }
    }
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(fs);
    release(signals);
    release(exec);
    release(tty);
    var console = io;
    var memory = heap;
    var code = 2;
    borrow net as &n in {
        borrow clock as &c in {
            borrow args as &g in {
                borrow mut console as &!i in {
                    borrow mut memory as &!h in {
                        if arg_count(g) >= 5 {
                            code = run(h, i, n, c, g);
                        } else {
                            console_usage(i);
                        }
                    }
                }
            }
        }
    }
    release(net);
    release(clock);
    release(console);
    release(memory);
    release(args);
    return code;
}

fn console_usage[&i](io: &!i Io) -> [io_write] int {
    io.write_all(io, "usage: driver <port> <target> <timeout_ms> <spec> [<method>]\n");
    return 0;
}
