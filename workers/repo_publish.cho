edition 9;

import std.buffer;
import std.bytes;
import std.io;
import std.json;
import std.process;
import forge.company_files;
import forge.gate_task;
import forge.journal_io;
import forge.publish_plan;
import forge.snapshot;

// The publish worker (docs/company.md, section 15): one JSON request on standard input, one JSON line on standard output, exit 0. It
// is started by `forge company publish` and by nothing else. The request names a checkout of the operator's, a repository of the
// allow-list, a branch to create, the accepted artifact (a directory and a name in it, and the SHA-256 Forge accepted it with), where
// it goes in the checkout, the text of `docs/provenance.md` and of the commit message. The worker
//
//   1. checks the request again (Forge checked it first; a worker trusts no caller) and the checkout: the toplevel of a git
//      repository whose `origin` is the allow-listed repository on github.com, with nothing modified or untracked, with no branch of
//      that name, and with no link on the way to where the artifact goes;
//   2. reads the artifact beneath its directory (no link followed, at most 16 MiB), hashes it and compares: another digest is
//      `publish-artifact-changed`, and nothing has been touched;
//   3. creates the branch, writes the artifact and the provenance, commits them (hooks off, no signing) with the message, and goes
//      back to the branch the checkout was on, so the working tree the operator left is the working tree it finds;
//   4. answers `{"ok":true,"commit":"<40 hex>"}`, or `{"ok":false,"rule":"<tag>","message":"..."}`. A failure after the branch was
//      made undoes it: reset, the files this publish added removed, back to the first branch, the new branch deleted.
//
// It never pushes: its shell is `/bin/sh` and the commands it builds name no remote but `git remote get-url`.
//
// Authority (`cancho authority`, docs/authority-repo-publish.txt): `Exec` narrowed to `/bin/sh`; `Fs("")` for the checkout, the
// artifact and the evidence (every path has passed `gate_task.path_ok`, or is the fixed `.git`-free name beneath one); a clock for the
// deadline; no network.

fn request_cap() -> [] int {
    return 1048576;
}

fn deadline_ms() -> [] int {
    return 60000;
}

fn read_request[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_read] (buffer.Buffer, bool) {
    var all = buffer.empty(heap, 1024);
    var c = getchar(io);
    var n = 0;
    while c >= 0 {
        if n >= request_cap() {
            return (all, false);
        }
        all = buffer.push(heap, all, byte_of(c));
        n = n + 1;
        c = getchar(io);
    }
    return (all, true);
}

fn shell_args[&h, &s](heap: &!h Heap, script: &s [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 64), "-c");
    b = buffer.push(heap, b, byte_of(0));
    b = buffer.append(heap, b, script);
    return buffer.push(heap, b, byte_of(0));
}

// `/bin/sh -c script` with `input` on its standard input, its output captured under 64 KiB and the deadline. The exit status of the
// shell as 0 or more, -1 for a run that did not end with one (a signal, the deadline, too much output, no shell), and what it wrote.
fn run_sh[&h, &x, &c, &s, &n](heap: &!h Heap, exec: &x Exec("/bin/sh"), clock: &c Clock, script: &s [byte], input: &n [byte]) -> [heap, exec("/bin/sh"), clock, poll] (int, buffer.Buffer) {
    match process.channels() {
        process.Channels::Failed(e) => {
            return (0 - 1, buffer.empty(heap, 1));
        }
        process.Channels::Ok(to_child, child_in, from_child, child_out) => {
            let args = shell_args(heap, script);
            var status = 0 - 1;
            var out = buffer.empty(heap, 1);
            borrow args as &ab in {
                match exec_spawn(exec, "/bin/sh", buffer.bytes(ab), "", Stdio::Pipe(child_in), Stdio::Pipe(child_out), Stdio::Null) {
                    Spawned::Failed(e) => {
                        process.close(to_child, from_child);
                    }
                    Spawned::Ok(child) => {
                        let (got, ran) = process.capture(heap, clock, child, to_child, from_child, input, 65536, deadline_ms());
                        buffer.drop(heap, out);
                        out = got;
                        match ran {
                            process.Ran::Code(n) => {
                                status = n;
                            }
                            process.Ran::Signaled(s) => {
                                status = 0 - 1;
                            }
                            process.Ran::TimedOut => {
                                status = 0 - 1;
                            }
                            process.Ran::TooMuch => {
                                status = 0 - 1;
                            }
                            process.Ran::Failed(e) => {
                                status = 0 - 1;
                            }
                        }
                    }
                }
            }
            buffer.drop(heap, args);
            return (status, out);
        }
    }
}

fn answer_failed[&h, &i](heap: &!h Heap, io: &!i Io, rule: &static [byte], message: &static [byte]) -> [heap, io_write] int {
    var w = json.writer(heap, 256);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "ok");
    w = json.put_bool(heap, w, false);
    w = json.put_key(heap, w, "rule");
    w = json.put_string(heap, w, rule);
    w = json.put_key(heap, w, "message");
    w = json.put_string(heap, w, message);
    w = json.end_object(heap, w);
    let out = json.finish(w);
    borrow out as &o in {
        buffer.write(io, o);
    }
    io.newline(io);
    buffer.drop(heap, out);
    return 0;
}

fn answer_ok[&h, &i, &c](heap: &!h Heap, io: &!i Io, commit: &c [byte]) -> [heap, io_write] int {
    var w = json.writer(heap, 128);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "ok");
    w = json.put_bool(heap, w, true);
    w = json.put_key(heap, w, "commit");
    w = json.put_string(heap, w, commit);
    w = json.end_object(heap, w);
    let out = json.finish(w);
    borrow out as &o in {
        buffer.write(io, o);
    }
    io.newline(io);
    buffer.drop(heap, out);
    return 0;
}

// The string `name` of the request when it is written plain (no escape), else empty: a field that goes into a path or a script is
// either plain or refused by the check that follows.
fn text_of[&s, &t](src: &s [byte], tape: &t [int], name: &static [byte]) -> [] &s [byte] {
    let node = json.get(src, tape, 0, name);
    if node >= 0 && json.is_string(tape, node) && json.string_plain(tape, node) {
        return json.string_view(src, tape, node);
    }
    return src[0..0];
}

// The decoded text of the string `name` (escapes resolved): the provenance and the message, which are data, never a path or a word.
fn decoded_of[&h, &s, &t](heap: &!h Heap, src: &s [byte], tape: &t [int], name: &static [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 256);
    let node = json.get(src, tape, 0, name);
    if node < 0 || json.is_string(tape, node) == false {
        return out;
    }
    let n = json.string_length(src, tape, node);
    if n < 0 {
        return out;
    }
    let room = box_slice(heap, n, byte_of(0));
    borrow mut room as &!rw in {
        json.string_into(src, tape, node, contents(rw));
    }
    borrow room as &rr in {
        out = buffer.append(heap, out, contents(rr));
    }
    unbox_slice(heap, room);
    return out;
}

fn hex64[&t](text: &t [byte]) -> [] bool {
    if len(text) != 64 {
        return false;
    }
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if (c < 48 || c > 57) && (c < 97 || c > 102) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn write_file[&f, &p, &b](fs: &f Fs(""), path: &p [byte], contents: &b [byte]) -> [fs_write(""), file_write] int {
    if journal_io.path_ok(fs, path) == false {
        return 0 - 2;
    }
    match open_write(fs, path) {
        Opened::Failed(e) => {
            return e;
        }
        Opened::Ok(opened) => {
            var file = opened;
            var rc = 0;
            borrow mut file as &!x in {
                rc = journal_io.write_all(x, contents);
            }
            file_close(file);
            return rc;
        }
    }
}

// The directory part of `dest` (everything before the last slash), or empty.
fn dir_of[&d](dest: &d [byte]) -> [] &d [byte] {
    var k = len(dest);
    while k > 0 {
        if int_of(dest[k - 1]) == 47 {
            return dest[0..k - 1];
        }
        k = k - 1;
    }
    return dest[0..0];
}

fn put[&h, &t](heap: &!h Heap, out: buffer.Buffer, text: &t [byte]) -> [heap] buffer.Buffer {
    return buffer.append(heap, out, text);
}

// `text` between single quotes. Every piece the worker puts in a script has passed a name rule (letters, digits, `._/-`), so none
// holds a quote; the quotes are for the shell's own sake.
fn q[&h, &t](heap: &!h Heap, out: buffer.Buffer, text: &t [byte]) -> [heap] buffer.Buffer {
    return buffer.push(heap, buffer.append(heap, buffer.push(heap, out, byte_of(39)), text), byte_of(39));
}

// The part of a script that fails with 16 when a link or a directory is where `path` (relative to the checkout) goes, or on the way.
fn on_the_way[&h, &t](heap: &!h Heap, out: buffer.Buffer, path: &t [byte]) -> [heap] buffer.Buffer {
    var s = put(heap, out, "p=''\nw=");
    s = q(heap, s, path);
    s = put(heap, s, "\nIFS=/\nset -f\nfor c in $w; do p=\"$p$c\"; if [ -L \"$p\" ]; then exit 16; fi; p=\"$p/\"; done\nunset IFS\nif [ -d ");
    s = q(heap, s, path);
    s = put(heap, s, " ]; then exit 16; fi\n");
    return s;
}

// Step 1, as a script. Exits: 11 the checkout is not a directory, not the toplevel of a repository, or has no commit; 13 `origin` is not
// the allow-listed repository on github.com; 14 something is modified or untracked; 15 the branch exists; 16 a link or a directory is where a
// file goes. On success it prints the branch the checkout is on (or, detached, the commit).
fn checks_script[&h, &c, &r, &b, &d, &e](heap: &!h Heap, checkout: &c [byte], repo: &r [byte], branch: &b [byte], dest: &d [byte], prov: &e [byte]) -> [heap] buffer.Buffer {
    var s = put(heap, buffer.empty(heap, 1024), "cd ");
    s = q(heap, s, checkout);
    s = put(heap, s, " 2>/dev/null || exit 11\nroot=$(git rev-parse --show-toplevel 2>/dev/null) || exit 11\nhere=$(pwd -P)\n[ \"$root\" = \"$here\" ] || exit 11\n");
    s = put(heap, s, "git rev-parse --verify --quiet HEAD >/dev/null 2>&1 || exit 11\nurl=$(git remote get-url origin 2>/dev/null) || exit 13\ncase \"$url\" in\n  'https://github.com/");
    s = put(heap, s, repo);
    s = put(heap, s, "'|'https://github.com/");
    s = put(heap, s, repo);
    s = put(heap, s, ".git'|'git@github.com:");
    s = put(heap, s, repo);
    s = put(heap, s, "'|'git@github.com:");
    s = put(heap, s, repo);
    s = put(heap, s, ".git') ;;\n  *) exit 13 ;;\nesac\nmod=$(git status --porcelain --untracked-files=all 2>/dev/null) || exit 11\n[ -z \"$mod\" ] || exit 14\n");
    s = put(heap, s, "if git rev-parse --verify --quiet 'refs/heads/");
    s = put(heap, s, branch);
    s = put(heap, s, "' >/dev/null 2>&1; then exit 15; fi\n");
    s = on_the_way(heap, s, dest);
    s = on_the_way(heap, s, prov);
    s = put(heap, s, "git symbolic-ref -q --short HEAD || git rev-parse HEAD\n");
    return s;
}

// Step 3a: make the branch and the directories. Exit 18 when either fails (the caller then undoes).
fn branch_script[&h, &c, &b, &d, &e](heap: &!h Heap, checkout: &c [byte], branch: &b [byte], dest: &d [byte], prov: &e [byte]) -> [heap] buffer.Buffer {
    var s = put(heap, buffer.empty(heap, 512), "cd ");
    s = q(heap, s, checkout);
    s = put(heap, s, " || exit 11\ngit checkout -q -b ");
    s = q(heap, s, branch);
    s = put(heap, s, " || exit 18\n");
    let dd = dir_of(dest);
    let pd = dir_of(prov);
    if len(dd) > 0 {
        s = put(heap, s, "mkdir -p ");
        s = q(heap, s, dd);
        s = put(heap, s, " || exit 18\n");
    }
    if len(pd) > 0 {
        s = put(heap, s, "mkdir -p ");
        s = q(heap, s, pd);
        s = put(heap, s, " || exit 18\n");
    }
    return s;
}

// Step 3b: stage, commit with the message on standard input (hooks off, no signing), print the commit, go back. Exit 19 when staging or
// committing fails (no identity, an ignored path), 20 when going back fails.
fn commit_script[&h, &c, &d, &e, &o](heap: &!h Heap, checkout: &c [byte], dest: &d [byte], prov: &e [byte], orig: &o [byte]) -> [heap] buffer.Buffer {
    var s = put(heap, buffer.empty(heap, 512), "cd ");
    s = q(heap, s, checkout);
    s = put(heap, s, " || exit 11\ngit add -- ");
    s = q(heap, s, dest);
    s = put(heap, s, " ");
    s = q(heap, s, prov);
    s = put(heap, s, " || exit 19\ngit -c core.hooksPath=/dev/null -c commit.gpgsign=false commit -q --no-verify -F - || exit 19\ngit rev-parse HEAD || exit 19\ngit checkout -q ");
    s = q(heap, s, orig);
    s = put(heap, s, " || exit 20\n");
    return s;
}

// The undo of a publish that failed after the branch was made. The checkout was clean when it began, so a reset loses nothing of the
// operator's; a file this publish added that git does not track is removed.
fn undo_script[&h, &c, &b, &d, &e, &o](heap: &!h Heap, checkout: &c [byte], branch: &b [byte], dest: &d [byte], prov: &e [byte], orig: &o [byte]) -> [heap] buffer.Buffer {
    var s = put(heap, buffer.empty(heap, 512), "cd ");
    s = q(heap, s, checkout);
    s = put(heap, s, " || exit 11\ngit reset -q --hard\nfor f in ");
    s = q(heap, s, dest);
    s = put(heap, s, " ");
    s = q(heap, s, prov);
    s = put(heap, s, "; do git ls-files --error-unmatch \"$f\" >/dev/null 2>&1 || rm -f \"$f\"; done\ngit checkout -q ");
    s = q(heap, s, orig);
    s = put(heap, s, "\ngit branch -D -q ");
    s = q(heap, s, branch);
    s = put(heap, s, "\n");
    return s;
}

fn under[&h, &d, &n](heap: &!h Heap, dir: &d [byte], name: &n [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 64), dir);
    b = buffer.push(heap, b, byte_of(47));
    return buffer.append(heap, b, name);
}

// A name the worker may put in a script: letters, digits and `._/-`, 1 to 200 bytes.
fn script_name[&t](text: &t [byte]) -> [] bool {
    if len(text) < 1 || len(text) > 200 {
        return false;
    }
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        let letter = c >= 65 && c <= 90 || c >= 97 && c <= 122;
        let digit = c >= 48 && c <= 57;
        if !letter && !digit && c != 46 && c != 47 && c != 45 && c != 95 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn first_line[&t](text: &t [byte]) -> [] &t [byte] {
    var e = 0;
    while e < len(text) && int_of(text[e]) != 10 {
        e = e + 1;
    }
    return text[0..e];
}

fn hex64_40[&t](text: &t [byte]) -> [] bool {
    if len(text) != 40 {
        return false;
    }
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if (c < 48 || c > 57) && (c < 97 || c > 102) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Undo, then answer `rule`.
fn undo_and_fail[&h, &i, &x, &c, &k, &b, &d, &e, &o](heap: &!h Heap, io: &!i Io, exec: &x Exec("/bin/sh"), clock: &c Clock, checkout: &k [byte], branch: &b [byte], dest: &d [byte], prov: &e [byte], orig: &o [byte], rule: &static [byte], message: &static [byte]) -> [heap, io_write, exec("/bin/sh"), clock, poll] int {
    let script = undo_script(heap, checkout, branch, dest, prov, orig);
    borrow script as &sb in {
        let (status, out) = run_sh(heap, exec, clock, buffer.bytes(sb), "");
        buffer.drop(heap, out);
    }
    buffer.drop(heap, script);
    return answer_failed(heap, io, rule, message);
}

// The request has been parsed into `src`/`tp`: check it, then do the publish.
fn publish[&h, &i, &f, &c, &x, &s, &t](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), clock: &c Clock, exec: &x Exec("/bin/sh"), src: &s [byte], tp: &t [int]) -> [heap, io_write, fs_read(""), fs_write(""), dir_read, file_read, file_write, exec("/bin/sh"), clock, poll] int {
    let checkout = text_of(src, tp, "checkout");
    let repo = text_of(src, tp, "repo");
    let branch = text_of(src, tp, "branch");
    let src_dir = text_of(src, tp, "src_dir");
    let src_name = text_of(src, tp, "src_name");
    let dest = text_of(src, tp, "dest");
    let sha = text_of(src, tp, "sha256");
    let prov_dest = text_of(src, tp, "provenance_dest");
    if gate_task.path_ok(checkout) == false || gate_task.path_ok(src_dir) == false {
        return answer_failed(heap, io, publish_plan.rule_checkout_invalid(), "the checkout and the artifact directory must be absolute plain paths");
    }
    if publish_plan.repo_ok(repo) == false || script_name(repo) == false {
        return answer_failed(heap, io, publish_plan.rule_repo_not_allowed(), "the repository is not on the allow-list");
    }
    if publish_plan.branch_ok(branch) == false {
        return answer_failed(heap, io, publish_plan.rule_branch_invalid(), "the branch name is not one Forge creates");
    }
    if publish_plan.dest_ok(dest) == false || publish_plan.dest_ok(prov_dest) == false || publish_plan.dest_ok(src_name) == false || bytes.find(src_name, "/") >= 0 || bytes.equal(dest, prov_dest) {
        return answer_failed(heap, io, publish_plan.rule_dest_invalid(), "a destination is not a plain path inside the checkout");
    }
    let prov_text = decoded_of(heap, src, tp, "provenance");
    let message_text = decoded_of(heap, src, tp, "message");
    var code = 0;
    borrow prov_text as &pv in {
        borrow message_text as &mg in {
            code = publish_texts(heap, io, fs, clock, exec, checkout, repo, branch, src_dir, src_name, dest, sha, prov_dest, buffer.bytes(pv), buffer.bytes(mg));
        }
    }
    buffer.drop(heap, prov_text);
    buffer.drop(heap, message_text);
    return code;
}

// The texts are decoded: the rest of the checks, then the publish.
fn publish_texts[&h, &i, &f, &c, &x, &k, &r, &b, &d, &n, &y, &z, &p, &v, &m](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), clock: &c Clock, exec: &x Exec("/bin/sh"), checkout: &k [byte], repo: &r [byte], branch: &b [byte], src_dir: &d [byte], src_name: &n [byte], dest: &y [byte], sha: &z [byte], prov_dest: &p [byte], prov: &v [byte], message: &m [byte]) -> [heap, io_write, fs_read(""), fs_write(""), dir_read, file_read, file_write, exec("/bin/sh"), clock, poll] int {
    if hex64(sha) == false || len(prov) > publish_plan.text_cap() || len(message) > publish_plan.text_cap() || len(message) == 0 {
        return answer_failed(heap, io, publish_plan.rule_worker_failed(), "the request is malformed");
    }
    // Step 1: the checkout.
    var orig = buffer.empty(heap, 1);
    var refused = 0;
    let check = checks_script(heap, checkout, repo, branch, dest, prov_dest);
    borrow check as &cb in {
        let (status, out) = run_sh(heap, exec, clock, buffer.bytes(cb), "");
        refused = status;
        borrow out as &ob in {
            buffer.drop(heap, orig);
            orig = buffer.append(heap, buffer.empty(heap, 64), first_line(buffer.bytes(ob)));
        }
        buffer.drop(heap, out);
    }
    buffer.drop(heap, check);
    if refused != 0 {
        buffer.drop(heap, orig);
        if refused == 13 {
            return answer_failed(heap, io, publish_plan.rule_repo_not_allowed(), "the origin of the checkout is not the allow-listed repository on github.com");
        }
        if refused == 14 {
            return answer_failed(heap, io, publish_plan.rule_checkout_dirty(), "the checkout has modified or untracked files");
        }
        if refused == 15 {
            return answer_failed(heap, io, publish_plan.rule_branch_exists(), "a branch of that name exists");
        }
        if refused == 16 {
            return answer_failed(heap, io, publish_plan.rule_dest_invalid(), "a link or a directory is where a file goes");
        }
        return answer_failed(heap, io, publish_plan.rule_checkout_invalid(), "the checkout is not the toplevel of a git repository with a commit");
    }
    var code = 0;
    borrow orig as &og in {
        if script_name(buffer.bytes(og)) == false {
            code = answer_failed(heap, io, publish_plan.rule_checkout_invalid(), "the checkout is on a branch whose name is not a plain name");
        } else {
            code = publish_checked(heap, io, fs, clock, exec, checkout, branch, src_dir, src_name, dest, sha, prov_dest, prov, message, buffer.bytes(og));
        }
    }
    buffer.drop(heap, orig);
    return code;
}

// The checkout is as it should be: step 2 (the artifact) and step 3 (the branch, the files, the commit).
fn publish_checked[&h, &i, &f, &c, &x, &k, &b, &d, &n, &y, &z, &p, &v, &m, &o](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), clock: &c Clock, exec: &x Exec("/bin/sh"), checkout: &k [byte], branch: &b [byte], src_dir: &d [byte], src_name: &n [byte], dest: &y [byte], sha: &z [byte], prov_dest: &p [byte], prov: &v [byte], message: &m [byte], orig: &o [byte]) -> [heap, io_write, fs_read(""), fs_write(""), dir_read, file_read, file_write, exec("/bin/sh"), clock, poll] int {
    let (data, why) = company_files.read_artifact(heap, fs, src_dir, src_name);
    var same = false;
    if why == 0 {
        borrow data as &db in {
            let digest = snapshot.hex_digest(heap, buffer.bytes(db));
            borrow digest as &gb in {
                same = bytes.equal(buffer.bytes(gb), sha);
            }
            buffer.drop(heap, digest);
        }
    }
    if same == false {
        buffer.drop(heap, data);
        return answer_failed(heap, io, publish_plan.rule_artifact_changed(), "the artifact is not the one that was accepted");
    }
    var status = 0;
    let made = branch_script(heap, checkout, branch, dest, prov_dest);
    borrow made as &mb in {
        let (st, out) = run_sh(heap, exec, clock, buffer.bytes(mb), "");
        status = st;
        buffer.drop(heap, out);
    }
    buffer.drop(heap, made);
    if status != 0 {
        buffer.drop(heap, data);
        return undo_and_fail(heap, io, exec, clock, checkout, branch, dest, prov_dest, orig, publish_plan.rule_commit_failed(), "the branch or its directories could not be made");
    }
    var rc = 0 - 1;
    let dpath = under(heap, checkout, dest);
    borrow dpath as &dp in {
        borrow data as &db in {
            rc = write_file(fs, buffer.bytes(dp), buffer.bytes(db));
        }
    }
    buffer.drop(heap, dpath);
    buffer.drop(heap, data);
    if rc == 0 {
        let ppath = under(heap, checkout, prov_dest);
        borrow ppath as &pp in {
            rc = write_file(fs, buffer.bytes(pp), prov);
        }
        buffer.drop(heap, ppath);
    }
    if rc != 0 {
        return undo_and_fail(heap, io, exec, clock, checkout, branch, dest, prov_dest, orig, publish_plan.rule_commit_failed(), "a file could not be written in the checkout");
    }
    let commit = commit_script(heap, checkout, dest, prov_dest, orig);
    var hash = buffer.empty(heap, 1);
    borrow commit as &cb in {
        let (st, out) = run_sh(heap, exec, clock, buffer.bytes(cb), message);
        status = st;
        borrow out as &ob in {
            buffer.drop(heap, hash);
            hash = buffer.append(heap, buffer.empty(heap, 64), first_line(buffer.bytes(ob)));
        }
        buffer.drop(heap, out);
    }
    buffer.drop(heap, commit);
    var code = 0;
    borrow hash as &hb in {
        if status == 0 && hex64_40(buffer.bytes(hb)) {
            code = answer_ok(heap, io, buffer.bytes(hb));
        } else {
            code = undo_and_fail(heap, io, exec, clock, checkout, branch, dest, prov_dest, orig, publish_plan.rule_commit_failed(), "git could not stage or commit (no identity, an ignored path, or a hook)");
        }
    }
    buffer.drop(heap, hash);
    return code;
}

fn serve[&h, &i, &f, &c, &x](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), clock: &c Clock, exec: &x Exec("/bin/sh")) -> [heap, io_read, io_write, fs_read(""), fs_write(""), dir_read, file_read, file_write, exec("/bin/sh"), clock, poll] int {
    let (request, whole) = read_request(heap, io);
    var code = 0;
    if whole == false {
        code = answer_failed(heap, io, publish_plan.rule_worker_failed(), "the request is over its size limit");
    } else {
        borrow request as &rb in {
            let src = buffer.bytes(rb);
            let tape = box_slice(heap, json.tape_len(src), 0);
            var parsed = false;
            borrow mut tape as &!tw in {
                parsed = json.parse(src, contents(tw)) > 0;
            }
            borrow tape as &tr in {
                if parsed && json.is_object(contents(tr), 0) {
                    code = publish(heap, io, fs, clock, exec, src, contents(tr));
                } else {
                    code = answer_failed(heap, io, publish_plan.rule_worker_failed(), "the request is not a JSON object");
                }
            }
            unbox_slice(heap, tape);
        }
    }
    buffer.drop(heap, request);
    return code;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(net);
    release(signals);
    release(tty);
    release(args);
    let sh = narrow(exec, "/bin/sh");
    var console = io;
    var memory = heap;
    var code = 0;
    borrow fs as &f in {
        borrow clock as &c in {
            borrow sh as &x in {
                borrow mut console as &!i in {
                    borrow mut memory as &!h in {
                        code = serve(h, i, f, c, x);
                    }
                }
            }
        }
    }
    release(fs);
    release(clock);
    release(sh);
    release(console);
    release(memory);
    return code;
}
