edition 9;

import std.buffer;
import std.bytes;
import std.io;
import std.json;
import std.process;
import forge.company_files;
import forge.gate_task;
import forge.journal_io;
import forge.patch_apply;
import forge.publish_plan;
import forge.repo_vcs;
import forge.repo_vcs_write;
import forge.snapshot;

// The publish worker (docs/company.md, section 15): one JSON request on standard input, one JSON line on standard output, exit 0. It
// is started by `forge company publish` and by nothing else. The request names a checkout of the operator's, a repository of the
// allow-list, a branch to create, the accepted artifact (a directory and a name in it, and the SHA-256 Forge accepted it with), where
// it goes in the checkout, the text of `docs/provenance.md` and of the commit message. The worker
//
//   1. checks the request again (Forge checked it first; a worker trusts no caller) and the checkout: the toplevel of a git
//      repository whose `origin` is the allow-listed repository on github.com, with nothing modified or untracked, with no branch of
//      that name, and with no link on the way to where the artifact goes;
//   2. reads the artifact beneath its directory (no link followed, at most 16 MiB), hashes it and compares: another digest is
//      `publish-artifact-changed`, and nothing has been touched;
//   3. creates the branch, writes the artifact and the provenance, commits them (hooks off, no signing) with the message, and goes
//      back to the branch the checkout was on, so the working tree the operator left is the working tree it finds;
//   4. answers `{"ok":true,"commit":"<40 hex>"}`, or `{"ok":false,"rule":"<tag>","message":"..."}`. A failure after the branch was
//      made undoes it: reset, the files this publish added removed, back to the first branch, the new branch deleted.
//
// It never pushes: its shell is `/bin/sh` and the commands it builds name no remote but `git remote get-url`.
//
// A request with `"vcs":"cancho"` (docs/repo-vcs.md section 7) is a patch publish to a checkout kept by `cancho vcs`: the same steps, by
// `cancho vcs branch`, `switch`, `record` (the message is the intent's prompt, `session` and `issue` its session and issue) and `restore`. The
// request names the `compiler`, and the shell's `PATH` starts with its directory; the commit of the answer is a change id of 64 digits. A tree the
// gate of `cancho vcs` refuses is `publish-gate-failed`. There is no origin to hold to the allow-list.
//
// Authority (`cancho authority`, docs/authority-repo-publish.txt): `Exec` narrowed to `/bin/sh`; `Fs("")` for the checkout, the
// artifact and the evidence (every path has passed `gate_task.path_ok`, or is the fixed `.git`-free name beneath one); a clock for the
// deadline; no network.

fn request_cap() -> [] int {
    return 1048576;
}

fn deadline_ms() -> [] int {
    return 60000;
}

fn read_request[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_read] (buffer.Buffer, bool) {
    var all = buffer.empty(heap, 1024);
    var c = getchar(io);
    var n = 0;
    while c >= 0 {
        if n >= request_cap() {
            return (all, false);
        }
        all = buffer.push(heap, all, byte_of(c));
        n = n + 1;
        c = getchar(io);
    }
    return (all, true);
}

fn shell_args[&h, &s](heap: &!h Heap, script: &s [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 64), "-c");
    b = buffer.push(heap, b, byte_of(0));
    b = buffer.append(heap, b, script);
    return buffer.push(heap, b, byte_of(0));
}

// `/bin/sh -c script` with `input` on its standard input, its output captured under 64 KiB and the deadline. The exit status of the
// shell as 0 or more, -1 for a run that did not end with one (a signal, the deadline, too much output, no shell), and what it wrote.
fn run_sh[&h, &x, &c, &s, &n, &v](heap: &!h Heap, exec: &x Exec("/bin/sh"), clock: &c Clock, env: &v [byte], script: &s [byte], input: &n [byte]) -> [heap, exec("/bin/sh"), clock, poll] (int, buffer.Buffer) {
    match process.channels() {
        process.Channels::Failed(e) => {
            return (0 - 1, buffer.empty(heap, 1));
        }
        process.Channels::Ok(to_child, child_in, from_child, child_out) => {
            let args = shell_args(heap, script);
            var status = 0 - 1;
            var out = buffer.empty(heap, 1);
            borrow args as &ab in {
                match exec_spawn(exec, "/bin/sh", buffer.bytes(ab), env, Stdio::Pipe(child_in), Stdio::Pipe(child_out), Stdio::Null) {
                    Spawned::Failed(e) => {
                        process.close(to_child, from_child);
                    }
                    Spawned::Ok(child) => {
                        let (got, ran) = process.capture(heap, clock, child, to_child, from_child, input, 65536, deadline_ms());
                        buffer.drop(heap, out);
                        out = got;
                        match ran {
                            process.Ran::Code(n) => {
                                status = n;
                            }
                            process.Ran::Signaled(s) => {
                                status = 0 - 1;
                            }
                            process.Ran::TimedOut => {
                                status = 0 - 1;
                            }
                            process.Ran::TooMuch => {
                                status = 0 - 1;
                            }
                            process.Ran::Failed(e) => {
                                status = 0 - 1;
                            }
                        }
                    }
                }
            }
            buffer.drop(heap, args);
            return (status, out);
        }
    }
}

fn answer_failed[&h, &i](heap: &!h Heap, io: &!i Io, rule: &static [byte], message: &static [byte]) -> [heap, io_write] int {
    var w = json.writer(heap, 256);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "ok");
    w = json.put_bool(heap, w, false);
    w = json.put_key(heap, w, "rule");
    w = json.put_string(heap, w, rule);
    w = json.put_key(heap, w, "message");
    w = json.put_string(heap, w, message);
    w = json.end_object(heap, w);
    let out = json.finish(w);
    borrow out as &o in {
        buffer.write(io, o);
    }
    io.newline(io);
    buffer.drop(heap, out);
    return 0;
}

fn answer_ok[&h, &i, &c](heap: &!h Heap, io: &!i Io, commit: &c [byte]) -> [heap, io_write] int {
    var w = json.writer(heap, 128);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "ok");
    w = json.put_bool(heap, w, true);
    w = json.put_key(heap, w, "commit");
    w = json.put_string(heap, w, commit);
    w = json.end_object(heap, w);
    let out = json.finish(w);
    borrow out as &o in {
        buffer.write(io, o);
    }
    io.newline(io);
    buffer.drop(heap, out);
    return 0;
}

// The string `name` of the request when it is written plain (no escape), else empty: a field that goes into a path or a script is
// either plain or refused by the check that follows.
fn text_of[&s, &t](src: &s [byte], tape: &t [int], name: &static [byte]) -> [] &s [byte] {
    let node = json.get(src, tape, 0, name);
    if node >= 0 && json.is_string(tape, node) && json.string_plain(tape, node) {
        return json.string_view(src, tape, node);
    }
    return src[0..0];
}

// The decoded text of the string `name` (escapes resolved): the provenance and the message, which are data, never a path or a word.
fn decoded_of[&h, &s, &t](heap: &!h Heap, src: &s [byte], tape: &t [int], name: &static [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 256);
    let node = json.get(src, tape, 0, name);
    if node < 0 || json.is_string(tape, node) == false {
        return out;
    }
    let n = json.string_length(src, tape, node);
    if n < 0 {
        return out;
    }
    let room = box_slice(heap, n, byte_of(0));
    borrow mut room as &!rw in {
        json.string_into(src, tape, node, contents(rw));
    }
    borrow room as &rr in {
        out = buffer.append(heap, out, contents(rr));
    }
    unbox_slice(heap, room);
    return out;
}

fn hex64[&t](text: &t [byte]) -> [] bool {
    if len(text) != 64 {
        return false;
    }
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if (c < 48 || c > 57) && (c < 97 || c > 102) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn write_file[&f, &p, &b](fs: &f Fs(""), path: &p [byte], contents: &b [byte]) -> [fs_write(""), file_write] int {
    if journal_io.path_ok(fs, path) == false {
        return 0 - 2;
    }
    match open_write(fs, path) {
        Opened::Failed(e) => {
            return e;
        }
        Opened::Ok(opened) => {
            var file = opened;
            var rc = 0;
            borrow mut file as &!x in {
                rc = journal_io.write_all(x, contents);
            }
            file_close(file);
            return rc;
        }
    }
}

fn under[&h, &d, &n](heap: &!h Heap, dir: &d [byte], name: &n [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 64), dir);
    b = buffer.push(heap, b, byte_of(47));
    return buffer.append(heap, b, name);
}

// A name the worker may put in a script: letters, digits and `._/-`, 1 to 200 bytes.
fn script_name[&t](text: &t [byte]) -> [] bool {
    if len(text) < 1 || len(text) > 200 {
        return false;
    }
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        let letter = c >= 65 && c <= 90 || c >= 97 && c <= 122;
        let digit = c >= 48 && c <= 57;
        if !letter && !digit && c != 46 && c != 47 && c != 45 && c != 95 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn first_line[&t](text: &t [byte]) -> [] &t [byte] {
    var e = 0;
    while e < len(text) && int_of(text[e]) != 10 {
        e = e + 1;
    }
    return text[0..e];
}

// The answer for a tree the gate of `cancho vcs` refused: the compiler's rule (a name of lower-case letters and `-`, or nothing) after the reason.
fn answer_gate[&h, &i, &r](heap: &!h Heap, io: &!i Io, rule: &r [byte]) -> [heap, io_write] int {
    var text = buffer.append(heap, buffer.empty(heap, 128), "the gate of cancho vcs refused the change: a file of it does not check");
    var plain = len(rule) > 0 && len(rule) <= 64;
    var k = 0;
    while k < len(rule) && plain {
        let c = int_of(rule[k]);
        plain = c >= 97 && c <= 122 || c == 45;
        k = k + 1;
    }
    if plain {
        text = buffer.append(heap, buffer.append(heap, buffer.append(heap, text, " ("), rule), ")");
    }
    var w = json.writer(heap, 256);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "ok");
    w = json.put_bool(heap, w, false);
    w = json.put_key(heap, w, "rule");
    w = json.put_string(heap, w, publish_plan.rule_gate_failed());
    w = json.put_key(heap, w, "message");
    borrow text as &tb in {
        w = json.put_string(heap, w, buffer.bytes(tb));
    }
    w = json.end_object(heap, w);
    buffer.drop(heap, text);
    let out = json.finish(w);
    borrow out as &o in {
        buffer.write(io, o);
    }
    io.newline(io);
    buffer.drop(heap, out);
    return 0;
}

// Undo, then answer `rule`.
fn undo_and_fail[&h, &i, &x, &c, &v, &k, &b, &d, &e, &o](heap: &!h Heap, io: &!i Io, exec: &x Exec("/bin/sh"), clock: &c Clock, kind: int, env: &v [byte], checkout: &k [byte], branch: &b [byte], dest: &d [byte], prov: &e [byte], orig: &o [byte], rule: &static [byte], message: &static [byte]) -> [heap, io_write, exec("/bin/sh"), clock, poll] int {
    let script = repo_vcs_write.undo_script(heap, kind, checkout, branch, dest, prov, orig);
    borrow script as &sb in {
        let (status, out) = run_sh(heap, exec, clock, env, buffer.bytes(sb), "");
        buffer.drop(heap, out);
    }
    buffer.drop(heap, script);
    return answer_failed(heap, io, rule, message);
}

// The request has been parsed into `src`/`tp`: check it, then do the publish.
fn publish[&h, &i, &f, &c, &x, &s, &t](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), clock: &c Clock, exec: &x Exec("/bin/sh"), src: &s [byte], tp: &t [int]) -> [heap, io_write, fs_read(""), fs_write(""), dir_read, file_read, file_write, exec("/bin/sh"), clock, poll] int {
    // The destination. A file publish names one path, written plain. A patch publish names the files the patch touches, one to a line: the line feed
    // between two of them is an escape in the request, so the text is decoded, and `patch_dests_ok` then holds every line to a plain path.
    if json.get(src, tp, 0, "patch_base") < 0 {
        return publish_to(heap, io, fs, clock, exec, src, tp, text_of(src, tp, "dest"));
    }
    let dests = decoded_of(heap, src, tp, "dest");
    var code = 0;
    borrow dests as &db in {
        code = publish_to(heap, io, fs, clock, exec, src, tp, buffer.bytes(db));
    }
    buffer.drop(heap, dests);
    return code;
}

// The request has been parsed and its destination read: check it, then do the publish.
fn publish_to[&h, &i, &f, &c, &x, &s, &t, &j](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), clock: &c Clock, exec: &x Exec("/bin/sh"), src: &s [byte], tp: &t [int], dest: &j [byte]) -> [heap, io_write, fs_read(""), fs_write(""), dir_read, file_read, file_write, exec("/bin/sh"), clock, poll] int {
    let checkout = text_of(src, tp, "checkout");
    let repo = text_of(src, tp, "repo");
    let branch = text_of(src, tp, "branch");
    let src_dir = text_of(src, tp, "src_dir");
    let src_name = text_of(src, tp, "src_name");
    let sha = text_of(src, tp, "sha256");
    let prov_dest = text_of(src, tp, "provenance_dest");
    if gate_task.path_ok(checkout) == false || gate_task.path_ok(src_dir) == false {
        return answer_failed(heap, io, publish_plan.rule_checkout_invalid(), "the checkout and the artifact directory must be absolute plain paths");
    }
    if publish_plan.repo_ok(repo) == false || script_name(repo) == false {
        return answer_failed(heap, io, publish_plan.rule_repo_not_allowed(), "the repository is not on the allow-list");
    }
    if publish_plan.branch_ok(branch) == false {
        return answer_failed(heap, io, publish_plan.rule_branch_invalid(), "the branch name is not one Forge creates");
    }
    let patch_base = text_of(src, tp, "patch_base");
    let patching = json.get(src, tp, 0, "patch_base") >= 0;
    // The kind of version control: git when the request does not say. For `cancho` the request is a patch publish that names the compiler (the file
    // `cancho` in a plain directory) and the session and the issue of the intent, each a plain name.
    var kind = repo_vcs.git();
    let compiler = text_of(src, tp, "compiler");
    let session = text_of(src, tp, "session");
    let issue = text_of(src, tp, "issue");
    if json.get(src, tp, 0, "vcs") >= 0 {
        kind = repo_vcs.kind_of(text_of(src, tp, "vcs"));
        if kind < 0 || len(text_of(src, tp, "vcs")) == 0 {
            return answer_failed(heap, io, publish_plan.rule_worker_failed(), "the request names a version control that is not git or cancho");
        }
    }
    if kind == repo_vcs.cancho() && (patching == false || gate_task.path_ok(compiler) == false || bytes.equal(name_of(compiler), "cancho") == false || script_name(session) == false || script_name(issue) == false || bytes.find(session, "/") >= 0 || bytes.find(issue, "/") >= 0) {
        return answer_failed(heap, io, publish_plan.rule_worker_failed(), "a publish on cancho vcs is a patch publish that names the compiler, the session and the issue");
    }
    if patching && (repo_vcs.revision_ok(kind, patch_base) == false || json.get(src, tp, 0, "more") >= 0 || patch_dests_ok(dest, prov_dest) == false) {
        return answer_failed(heap, io, publish_plan.rule_dest_invalid(), "a patch publish names its base commit and the plain files the patch touches, and no other file");
    }
    if publish_plan.dest_ok(prov_dest) == false || publish_plan.dest_ok(src_name) == false || bytes.find(src_name, "/") >= 0 || bytes.equal(dest, prov_dest) || patching == false && publish_plan.dest_ok(dest) == false {
        return answer_failed(heap, io, publish_plan.rule_dest_invalid(), "a destination is not a plain path inside the checkout");
    }
    // `more`: up to three more artifacts, each with its own directory, source name, destination and digest. Every destination is a
    // name the checks above would accept, and no two files of this publish go to the same place.
    var alld = buffer.append(heap, buffer.empty(heap, 128), dest);
    var extras = buffer.empty(heap, 256);
    var more_ok = true;
    let more = json.get(src, tp, 0, "more");
    if more >= 0 {
        if json.is_array(tp, more) == false || json.count(tp, more) > 3 {
            more_ok = false;
        } else {
            let n = json.count(tp, more);
            var j = 0;
            while j < n && more_ok {
                let ent = json.at(tp, more, j);
                if json.is_object(tp, ent) == false {
                    more_ok = false;
                } else {
                    let esd = text_in(src, tp, ent, "src_dir");
                    let esn = text_in(src, tp, ent, "src_name");
                    let ede = text_in(src, tp, ent, "dest");
                    let esh = text_in(src, tp, ent, "sha256");
                    var seen = false;
                    borrow alld as &ab in {
                        seen = has_line(buffer.bytes(ab), ede);
                    }
                    if gate_task.path_ok(esd) == false || publish_plan.dest_ok(ede) == false || publish_plan.dest_ok(esn) == false || bytes.find(esn, "/") >= 0 || bytes.equal(ede, prov_dest) || seen || hex64(esh) == false {
                        more_ok = false;
                    } else {
                        alld = buffer.push(heap, alld, byte_of(10));
                        alld = buffer.append(heap, alld, ede);
                        extras = buffer.append(heap, extras, esd);
                        extras = buffer.push(heap, extras, byte_of(0));
                        extras = buffer.append(heap, extras, esn);
                        extras = buffer.push(heap, extras, byte_of(0));
                        extras = buffer.append(heap, extras, ede);
                        extras = buffer.push(heap, extras, byte_of(0));
                        extras = buffer.append(heap, extras, esh);
                        extras = buffer.push(heap, extras, byte_of(0));
                    }
                }
                j = j + 1;
            }
        }
    }
    var adopt = false;
    let adopt_at = json.get(src, tp, 0, "adopt");
    if adopt_at >= 0 {
        adopt = patching && json.to_bool(tp, adopt_at);
    }
    var code = 0;
    if more_ok == false {
        code = answer_failed(heap, io, publish_plan.rule_dest_invalid(), "an extra file is not a plain accepted artifact with a plain destination");
    } else {
        let prov_text = decoded_of(heap, src, tp, "provenance");
        let message_text = decoded_of(heap, src, tp, "message");
        // The shell's environment: none for git (as it was), and for `cancho` a `PATH` that starts with the compiler's directory.
        var envb = buffer.empty(heap, 64);
        var intentb = buffer.empty(heap, 64);
        if kind == repo_vcs.cancho() {
            buffer.drop(heap, envb);
            envb = repo_vcs_write.tool_env(heap, compiler);
            intentb = buffer.append(heap, buffer.push(heap, buffer.append(heap, intentb, session), byte_of(10)), issue);
        }
        borrow envb as &nv in {
            borrow intentb as &nt in {
                borrow prov_text as &pv in {
                    borrow message_text as &mg in {
                        borrow alld as &ab2 in {
                            borrow extras as &xb in {
                                code = publish_texts(heap, io, fs, clock, exec, kind, buffer.bytes(nv), buffer.bytes(nt), checkout, repo, branch, src_dir, src_name, dest, sha, prov_dest, buffer.bytes(pv), buffer.bytes(mg), buffer.bytes(ab2), buffer.bytes(xb), patch_base, adopt);
                            }
                        }
                    }
                }
            }
        }
        buffer.drop(heap, envb);
        buffer.drop(heap, intentb);
        buffer.drop(heap, prov_text);
        buffer.drop(heap, message_text);
    }
    buffer.drop(heap, alld);
    buffer.drop(heap, extras);
    return code;
}

// The texts are decoded: the rest of the checks, then the publish.
fn publish_texts[&h, &i, &f, &c, &x, &e, &q, &k, &r, &b, &d, &n, &y, &z, &p, &v, &m, &a, &t, &u](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), clock: &c Clock, exec: &x Exec("/bin/sh"), kind: int, env: &e [byte], intent: &q [byte], checkout: &k [byte], repo: &r [byte], branch: &b [byte], src_dir: &d [byte], src_name: &n [byte], dest: &y [byte], sha: &z [byte], prov_dest: &p [byte], prov: &v [byte], message: &m [byte], alld: &a [byte], extras: &t [byte], base: &u [byte], adopt: bool) -> [heap, io_write, fs_read(""), fs_write(""), dir_read, file_read, file_write, exec("/bin/sh"), clock, poll] int {
    if hex64(sha) == false || len(prov) > publish_plan.text_cap() || len(message) > publish_plan.text_cap() || len(message) == 0 {
        return answer_failed(heap, io, publish_plan.rule_worker_failed(), "the request is malformed");
    }
    // Step 1: the checkout.
    var orig = buffer.empty(heap, 1);
    var refused = 0;
    // A request to adopt takes the branch that is there; with none, it publishes as any request does.
    var adopting = false;
    if adopt {
        let probe = repo_vcs_write.exists_script(heap, kind, checkout, branch);
        borrow probe as &pr in {
            let (found, shown) = run_sh(heap, exec, clock, env, buffer.bytes(pr), "");
            adopting = found == 0;
            buffer.drop(heap, shown);
        }
        buffer.drop(heap, probe);
    }
    let check = repo_vcs_write.checks_script(heap, kind, checkout, repo, branch, alld, prov_dest, base, adopting);
    borrow check as &cb in {
        let (status, out) = run_sh(heap, exec, clock, env, buffer.bytes(cb), "");
        refused = status;
        borrow out as &ob in {
            buffer.drop(heap, orig);
            orig = buffer.append(heap, buffer.empty(heap, 64), first_line(buffer.bytes(ob)));
        }
        buffer.drop(heap, out);
    }
    buffer.drop(heap, check);
    if refused != 0 {
        buffer.drop(heap, orig);
        if refused == 13 {
            return answer_failed(heap, io, publish_plan.rule_repo_not_allowed(), "the origin of the checkout is not the allow-listed repository on github.com");
        }
        if refused == 14 {
            return answer_failed(heap, io, publish_plan.rule_checkout_dirty(), "the checkout has modified or untracked files");
        }
        if refused == 15 {
            return answer_failed(heap, io, publish_plan.rule_branch_exists(), "a branch of that name exists");
        }
        if refused == 16 {
            return answer_failed(heap, io, publish_plan.rule_dest_invalid(), "a link or a directory is where a file goes");
        }
        if refused == 23 {
            return answer_failed(heap, io, publish_plan.rule_patch_base_stale(), "the checkout is not at the commit the patch was made against");
        }
        if kind == repo_vcs.cancho() {
            return answer_failed(heap, io, publish_plan.rule_checkout_invalid(), "the checkout is not the toplevel of a repository kept by cancho vcs with a change, or the compiler of the request is not there");
        }
        return answer_failed(heap, io, publish_plan.rule_checkout_invalid(), "the checkout is not the toplevel of a git repository with a commit");
    }
    var code = 0;
    borrow orig as &og in {
        if script_name(buffer.bytes(og)) == false {
            code = answer_failed(heap, io, publish_plan.rule_checkout_invalid(), "the checkout is on a branch whose name is not a plain name");
        } else {
            code = publish_checked(heap, io, fs, clock, exec, kind, env, intent, checkout, branch, src_dir, src_name, dest, sha, prov_dest, prov, message, buffer.bytes(og), alld, extras, base, adopting);
        }
    }
    buffer.drop(heap, orig);
    return code;
}

// The extra artifacts (`more` of the request), as `src_dir NUL src_name NUL dest NUL sha NUL` for each. Each is read again here, hashed,
// compared with the digest it was accepted with, and written beneath the checkout. 0; 1 a file is not the one that was accepted; 2 a file
// could not be written.
// The files of a patch publish (`dest`: one per line): 1 to 64 plain paths, each once, none the provenance file's.
fn patch_dests_ok[&d, &p](dest: &d [byte], prov_dest: &p [byte]) -> [] bool {
    var at = 0;
    var n = 0;
    while at < len(dest) {
        let e = repo_vcs_write.line_end(dest, at);
        let one = dest[at..e];
        if publish_plan.dest_ok(one) == false || bytes.equal(one, prov_dest) || n >= 64 {
            return false;
        }
        var seen = 0;
        var back = 0;
        while back < at {
            let be = repo_vcs_write.line_end(dest, back);
            if bytes.equal(dest[back..be], one) {
                seen = 1;
            }
            back = be + 1;
        }
        if seen == 1 {
            return false;
        }
        n = n + 1;
        at = e + 1;
    }
    return n >= 1;
}

// The file name after the last slash of `path`.
fn name_of[&d](path: &d [byte]) -> [] &d [byte] {
    var k = len(path);
    while k > 0 {
        if int_of(path[k - 1]) == 47 {
            return path[k..len(path)];
        }
        k = k - 1;
    }
    return path;
}

// Apply `patch` to the files of the checkout, in cancho (src/patch_apply.cho): every file of the patch must be one of `dests` (and each of `dests` must
// be in the patch), each is read beneath the checkout with no link followed, patched strictly, and written back. 0 applied; 1 a hunk does not apply
// (or a creation over a file that is there); 2 a file could not be written; 3 the patch's files are not the request's, or it deletes one.
fn apply_patch[&h, &f, &k, &p, &d](heap: &!h Heap, fs: &f Fs(""), checkout: &k [byte], patch: &p [byte], dests: &d [byte]) -> [heap, fs_read(""), fs_write(""), dir_read, file_read, file_write] int {
    var pos = 0;
    var files = 0;
    var wanted = 0;
    var at = 0;
    while at < len(dests) {
        wanted = wanted + 1;
        at = repo_vcs_write.line_end(dests, at) + 1;
    }
    while pos < len(patch) {
        let sec = patch_apply.next_section(patch, pos);
        if sec.found == false {
            pos = len(patch);
        } else {
            let path = patch[sec.path_at..sec.path_at + sec.path_len];
            if has_line(dests, path) == false {
                return 3;
            }
            files = files + 1;
            let hunks = patch[sec.body..sec.end];
            var folder = under(heap, checkout, repo_vcs_write.dir_of(path));
            if len(repo_vcs_write.dir_of(path)) == 0 {
                buffer.drop(heap, folder);
                folder = buffer.append(heap, buffer.empty(heap, 64), checkout);
            }
            var rc = 0;
            borrow folder as &fb in {
                let (original, why) = company_files.read_artifact(heap, fs, buffer.bytes(fb), name_of(path));
                var empty = false;
                borrow original as &ob in {
                    empty = why != 0 || len(buffer.bytes(ob)) == 0;
                    if why != 0 && patch_apply.creates(hunks) == false || why == 0 && len(buffer.bytes(ob)) > 0 && patch_apply.creates(hunks) {
                        rc = 1;
                    } else {
                        let (result, code) = patch_apply.apply_section(heap, hunks, buffer.bytes(ob));
                        if code == 3 {
                            rc = 3;
                        } else if code != 0 {
                            rc = 1;
                        } else {
                            let full = under(heap, checkout, path);
                            borrow full as &fp in {
                                borrow result as &rb in {
                                    if write_file(fs, buffer.bytes(fp), buffer.bytes(rb)) != 0 {
                                        rc = 2;
                                    }
                                }
                            }
                            buffer.drop(heap, full);
                        }
                        buffer.drop(heap, result);
                    }
                }
                buffer.drop(heap, original);
            }
            buffer.drop(heap, folder);
            if rc != 0 {
                return rc;
            }
            pos = sec.end;
        }
    }
    if files != wanted {
        return 3;
    }
    return 0;
}

fn write_extras[&h, &f, &k, &t](heap: &!h Heap, fs: &f Fs(""), checkout: &k [byte], extras: &t [byte]) -> [heap, fs_read(""), fs_write(""), dir_read, file_read, file_write] int {
    var pos = 0;
    while pos < len(extras) {
        let a = nul_end(extras, pos);
        let b = nul_end(extras, a + 1);
        let c = nul_end(extras, b + 1);
        let d = nul_end(extras, c + 1);
        let src_dir = extras[pos..a];
        let src_name = extras[a + 1..b];
        let dest = extras[b + 1..c];
        let sha = extras[c + 1..d];
        pos = d + 1;
        let (data, why) = company_files.read_artifact(heap, fs, src_dir, src_name);
        var same = false;
        if why == 0 {
            borrow data as &db in {
                let digest = snapshot.hex_digest(heap, buffer.bytes(db));
                borrow digest as &gb in {
                    same = bytes.equal(buffer.bytes(gb), sha);
                }
                buffer.drop(heap, digest);
            }
        }
        if same == false {
            buffer.drop(heap, data);
            return 1;
        }
        var rc = 0 - 1;
        let path = under(heap, checkout, dest);
        borrow path as &pb in {
            borrow data as &db2 in {
                rc = write_file(fs, buffer.bytes(pb), buffer.bytes(db2));
            }
        }
        buffer.drop(heap, path);
        buffer.drop(heap, data);
        if rc != 0 {
            return 2;
        }
    }
    return 0;
}

// The index of the NUL at or after `from`, or the length.
fn nul_end[&t](text: &t [byte], from: int) -> [] int {
    var e = from;
    while e < len(text) && int_of(text[e]) != 0 {
        e = e + 1;
    }
    return e;
}

// Is `name` one of the newline-separated lines of `names`?
fn has_line[&t, &n](names: &t [byte], name: &n [byte]) -> [] bool {
    var pos = 0;
    while pos < len(names) {
        let e = repo_vcs_write.line_end(names, pos);
        if bytes.equal(names[pos..e], name) {
            return true;
        }
        pos = e + 1;
    }
    return false;
}

// The string `name` of the object at `node`, when it is written plain, else empty.
fn text_in[&s, &t](src: &s [byte], tape: &t [int], node: int, name: &static [byte]) -> [] &s [byte] {
    let v = json.get(src, tape, node, name);
    if v >= 0 && json.is_string(tape, v) && json.string_plain(tape, v) {
        return json.string_view(src, tape, v);
    }
    return src[0..0];
}

// The checkout is as it should be: step 2 (the artifact) and step 3 (the branch, the files, the commit).
fn publish_checked[&h, &i, &f, &c, &x, &e, &q, &k, &b, &d, &n, &y, &z, &p, &v, &m, &o, &a, &t, &u](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), clock: &c Clock, exec: &x Exec("/bin/sh"), kind: int, env: &e [byte], intent: &q [byte], checkout: &k [byte], branch: &b [byte], src_dir: &d [byte], src_name: &n [byte], dest: &y [byte], sha: &z [byte], prov_dest: &p [byte], prov: &v [byte], message: &m [byte], orig: &o [byte], alld: &a [byte], extras: &t [byte], base: &u [byte], adopting: bool) -> [heap, io_write, fs_read(""), fs_write(""), dir_read, file_read, file_write, exec("/bin/sh"), clock, poll] int {
    // An undo never deletes a branch that was there before this publish: adopting names none to delete.
    var keep = len(branch);
    if adopting {
        keep = 0;
    }
    let undo_to = branch[0..keep];
    let (data, why) = company_files.read_artifact(heap, fs, src_dir, src_name);
    var same = false;
    if why == 0 {
        borrow data as &db in {
            let digest = snapshot.hex_digest(heap, buffer.bytes(db));
            borrow digest as &gb in {
                same = bytes.equal(buffer.bytes(gb), sha);
            }
            buffer.drop(heap, digest);
        }
    }
    if same == false {
        buffer.drop(heap, data);
        return answer_failed(heap, io, publish_plan.rule_artifact_changed(), "the artifact is not the one that was accepted");
    }
    var status = 0;
    let made = repo_vcs_write.branch_script(heap, kind, checkout, branch, alld, prov_dest, adopting == false);
    borrow made as &mb in {
        let (st, out) = run_sh(heap, exec, clock, env, buffer.bytes(mb), "");
        status = st;
        buffer.drop(heap, out);
    }
    buffer.drop(heap, made);
    if status != 0 {
        buffer.drop(heap, data);
        return undo_and_fail(heap, io, exec, clock, kind, env, checkout, undo_to, alld, prov_dest, orig, publish_plan.rule_commit_failed(), "the branch or its directories could not be made");
    }
    var rc = 0 - 1;
    if len(base) > 0 {
        // A patch publish: the artifact is a patch, applied here, in cancho, to the files of the checkout (no `patch`).
        var applied = 0;
        borrow data as &db in {
            applied = apply_patch(heap, fs, checkout, buffer.bytes(db), dest);
        }
        buffer.drop(heap, data);
        if applied == 1 {
            return undo_and_fail(heap, io, exec, clock, kind, env, checkout, undo_to, alld, prov_dest, orig, publish_plan.rule_patch_not_applicable(), "the patch does not apply to the files of the checkout");
        }
        if applied == 3 {
            return undo_and_fail(heap, io, exec, clock, kind, env, checkout, undo_to, alld, prov_dest, orig, publish_plan.rule_patch_not_applicable(), "the patch touches files other than the ones the request names, or deletes one");
        }
        rc = applied;
    } else {
        let dpath = under(heap, checkout, dest);
        borrow dpath as &dp in {
            borrow data as &db in {
                rc = write_file(fs, buffer.bytes(dp), buffer.bytes(db));
            }
        }
        buffer.drop(heap, dpath);
        buffer.drop(heap, data);
    }
    if rc == 0 && len(base) == 0 {
        let more = write_extras(heap, fs, checkout, extras);
        if more == 1 {
            return undo_and_fail(heap, io, exec, clock, kind, env, checkout, undo_to, alld, prov_dest, orig, publish_plan.rule_artifact_changed(), "an artifact is not the one that was accepted");
        }
        rc = more;
    }
    if rc == 0 {
        let ppath = under(heap, checkout, prov_dest);
        borrow ppath as &pp in {
            rc = write_file(fs, buffer.bytes(pp), prov);
        }
        buffer.drop(heap, ppath);
    }
    if rc != 0 {
        return undo_and_fail(heap, io, exec, clock, kind, env, checkout, undo_to, alld, prov_dest, orig, publish_plan.rule_commit_failed(), "a file could not be written in the checkout");
    }
    if adopting {
        return adopt_branch(heap, io, exec, clock, kind, env, intent, checkout, branch, alld, prov_dest, message, orig, base);
    }
    let commit = repo_vcs_write.commit_script(heap, kind, checkout, alld, prov_dest, orig, intent);
    var hash = buffer.empty(heap, 1);
    borrow commit as &cb in {
        let (st, out) = run_sh(heap, exec, clock, env, buffer.bytes(cb), message);
        status = st;
        borrow out as &ob in {
            buffer.drop(heap, hash);
            hash = buffer.append(heap, buffer.empty(heap, 64), first_line(buffer.bytes(ob)));
        }
        buffer.drop(heap, out);
    }
    buffer.drop(heap, commit);
    var code = 0;
    borrow hash as &hb in {
        if status == 0 && repo_vcs.revision_ok(kind, buffer.bytes(hb)) {
            code = answer_ok(heap, io, buffer.bytes(hb));
        } else if kind == repo_vcs.cancho() && status == 24 {
            let script = repo_vcs_write.undo_script(heap, kind, checkout, undo_to, alld, prov_dest, orig);
            borrow script as &sb in {
                let (rs, shown) = run_sh(heap, exec, clock, env, buffer.bytes(sb), "");
                buffer.drop(heap, shown);
            }
            buffer.drop(heap, script);
            code = answer_gate(heap, io, buffer.bytes(hb));
        } else if kind == repo_vcs.cancho() {
            code = undo_and_fail(heap, io, exec, clock, kind, env, checkout, undo_to, alld, prov_dest, orig, publish_plan.rule_commit_failed(), "cancho vcs could not record the change or go back to the branch the checkout was on");
        } else {
            code = undo_and_fail(heap, io, exec, clock, kind, env, checkout, undo_to, alld, prov_dest, orig, publish_plan.rule_commit_failed(), "git could not stage or commit (no identity, an ignored path, or a hook)");
        }
    }
    buffer.drop(heap, hash);
    return code;
}

// The files of the publish are in the working tree; ask whether the branch that is there is what they would have made. Either way the
// working tree goes back to the checkout's own state and the branch is left as it was.
fn adopt_branch[&h, &i, &x, &c, &v, &q, &k, &b, &d, &e, &m, &o, &a](heap: &!h Heap, io: &!i Io, exec: &x Exec("/bin/sh"), clock: &c Clock, kind: int, env: &v [byte], intent: &q [byte], checkout: &k [byte], branch: &b [byte], dest: &d [byte], prov: &e [byte], message: &m [byte], orig: &o [byte], base: &a [byte]) -> [heap, io_write, exec("/bin/sh"), clock, poll] int {
    let script = repo_vcs_write.adopt_script(heap, kind, checkout, branch, dest, prov, base, intent);
    var status = 0 - 1;
    var hash = buffer.empty(heap, 1);
    borrow script as &sb in {
        let (st, out) = run_sh(heap, exec, clock, env, buffer.bytes(sb), message);
        status = st;
        borrow out as &ob in {
            buffer.drop(heap, hash);
            hash = buffer.append(heap, buffer.empty(heap, 64), first_line(buffer.bytes(ob)));
        }
        buffer.drop(heap, out);
    }
    buffer.drop(heap, script);
    var code = 0;
    borrow hash as &hb in {
        if status == 0 && repo_vcs.revision_ok(kind, buffer.bytes(hb)) {
            let back = repo_vcs_write.undo_script(heap, kind, checkout, dest[0..0], dest, prov, orig);
            borrow back as &bk in {
                let (rs, shown) = run_sh(heap, exec, clock, env, buffer.bytes(bk), "");
                buffer.drop(heap, shown);
            }
            buffer.drop(heap, back);
            code = answer_ok(heap, io, buffer.bytes(hb));
        } else {
            code = undo_and_fail(heap, io, exec, clock, kind, env, checkout, branch[0..0], dest, prov, orig, publish_plan.rule_branch_exists(), "a branch of that name exists and is not what this publish would make");
        }
    }
    buffer.drop(heap, hash);
    return code;
}

fn serve[&h, &i, &f, &c, &x](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), clock: &c Clock, exec: &x Exec("/bin/sh")) -> [heap, io_read, io_write, fs_read(""), fs_write(""), dir_read, file_read, file_write, exec("/bin/sh"), clock, poll] int {
    let (request, whole) = read_request(heap, io);
    var code = 0;
    if whole == false {
        code = answer_failed(heap, io, publish_plan.rule_worker_failed(), "the request is over its size limit");
    } else {
        borrow request as &rb in {
            let src = buffer.bytes(rb);
            let tape = box_slice(heap, json.tape_len(src), 0);
            var parsed = false;
            borrow mut tape as &!tw in {
                parsed = json.parse(src, contents(tw)) > 0;
            }
            borrow tape as &tr in {
                if parsed && json.is_object(contents(tr), 0) {
                    code = publish(heap, io, fs, clock, exec, src, contents(tr));
                } else {
                    code = answer_failed(heap, io, publish_plan.rule_worker_failed(), "the request is not a JSON object");
                }
            }
            unbox_slice(heap, tape);
        }
    }
    buffer.drop(heap, request);
    return code;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(net);
    release(signals);
    release(tty);
    release(args);
    let sh = narrow(exec, "/bin/sh");
    var console = io;
    var memory = heap;
    var code = 0;
    borrow fs as &f in {
        borrow clock as &c in {
            borrow sh as &x in {
                borrow mut console as &!i in {
                    borrow mut memory as &!h in {
                        code = serve(h, i, f, c, x);
                    }
                }
            }
        }
    }
    release(fs);
    release(clock);
    release(sh);
    release(console);
    release(memory);
    return code;
}
