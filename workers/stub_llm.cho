edition 9;

import std.buffer;
import std.bytes;
import std.io;
import std.json;
import std.option;
import forge.journal_io;
import forge.snapshot;
import forge.stub_script;

// The stub LLM worker (docs/stub-llm.md): a `sync` worker of the contract (docs/worker-contract.md, section 3.2) that
// answers the way a model-backed worker would, from a script instead of a model, so that every flow of Forge that ends
// in a worker can be run end to end, deterministically, with no model, no network and no key. One `execute` request on
// stdin, one response on stdout, exit 0.
//
// What it answers is chosen by the SCRIPT, `stub_script.json` in `grants.execution_dir` (the way the brief of the
// process-and-directory binding, worker-contract section 9, is a file in the execution directory): the first rule whose
// `match` is a substring of `task.input.prompt`, and whose `type` (if it has one) is the task's, says what the stub does
// (`forge.stub_script`, the pure half). The ways a real worker misbehaves are among them, because the flows that must
// survive a real one are what this stub is for:
//
//   ok                    reply.md, `succeeded`
//   propose               proposal.patch and report.md, `succeeded` (a Stage 3 proposal, docs/self-hosting.md)
//   refuse                `failed`, an error code of the rule's choosing, no evidence
//   malformed             exit 0 having written text that is not JSON
//   truncated             a valid reply cut off in the middle
//   liar / liar_size      evidence whose hash / size is not the file's
//   slow                  waits `delay_ms`, then `ok`: Forge's deadline decides whether it is heard
//   crash_after_progress  writes progress.txt, then dies by a signal
//   oversize              one byte more than `limits.max_output_bytes` (at most 8 MiB + 1)
//
// Its own refusals are valid `failed` replies with a code of its own (stub_script.code_*): no script, a script that is
// not well formed, no rule that takes the prompt, a request without a prompt. A request that is not an `execute` of the
// contract, or has no request or task id, is not answered (exit 4), as the mock and the gate runner do not.
//
// Authority (`cancho authority`): `Fs("")` for the script and the evidence (every path has passed
// `journal_io.path_ok`), a clock and a poller to wait, standard input and output; no `Exec`, no network, no arguments.
// It starts nothing, and a model is not among its ingredients (docs/stub-llm.md, section 6).

fn read_request[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_read] (buffer.Buffer, bool) {
    var all = buffer.empty(heap, 1024);
    var c = getchar(io);
    var n = 0;
    while c >= 0 {
        if n >= 1048576 {
            return (all, false);
        }
        all = buffer.push(heap, all, byte_of(c));
        n = n + 1;
        c = getchar(io);
    }
    return (all, true);
}

fn write_file[&f, &p, &b](fs: &f Fs(""), path: &p [byte], contents: &b [byte]) -> [fs_write(""), file_write] int {
    if journal_io.path_ok(fs, path) == false {
        return 0 - 2;
    }
    match open_write(fs, path) {
        Opened::Failed(e) => {
            return e;
        }
        Opened::Ok(opened) => {
            var file = opened;
            var rc = 0;
            borrow mut file as &!x in {
                rc = journal_io.write_all(x, contents);
            }
            file_close(file);
            return rc;
        }
    }
}

fn under[&h, &d, &n](heap: &!h Heap, dir: &d [byte], name: &n [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 64), dir);
    b = buffer.push(heap, b, byte_of(47));
    return buffer.append(heap, b, name);
}

// Write `contents` as `name` beneath `dir`: 0 or an errno.
fn put[&h, &f, &d, &c](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], name: &static [byte], contents: &c [byte]) -> [heap, fs_write(""), file_write] int {
    let path = under(heap, dir, name);
    var rc = 0;
    borrow path as &pb in {
        rc = write_file(fs, buffer.bytes(pb), contents);
    }
    buffer.drop(heap, path);
    return rc;
}

// The text of a field when it is a string with no escapes, else empty.
fn text_of[&s, &t](src: &s [byte], tape: &t [int], node: int) -> [] &s [byte] {
    if node >= 0 && json.is_string(tape, node) && json.string_plain(tape, node) {
        return json.string_view(src, tape, node);
    }
    return "";
}

fn is[&s, &t](src: &s [byte], tape: &t [int], node: int, text: &static [byte]) -> [] bool {
    return node >= 0 && json.is_string(tape, node) && json.string_equals(src, tape, node, text);
}

// The string at `node` decoded, or `fallback` when there is none.
fn decoded[&h, &s, &t](heap: &!h Heap, src: &s [byte], tape: &t [int], node: int, fallback: &static [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 64);
    var found = false;
    if node >= 0 && json.is_string(tape, node) {
        let n = json.string_length(src, tape, node);
        if n >= 0 {
            let space = box_slice(heap, n + 1, byte_of(0));
            borrow mut space as &!sb in {
                let view = contents(sb);
                let wrote = json.string_into(src, tape, node, view);
                if wrote >= 0 {
                    out = buffer.append(heap, out, view[0..wrote]);
                    found = true;
                }
            }
            unbox_slice(heap, space);
        }
    }
    if !found {
        out = buffer.append(heap, out, fallback);
    }
    return out;
}

// One evidence entry.
fn entry[&h, &p, &s](heap: &!h Heap, w: json.Writer, id: &static [byte], kind: &static [byte], path: &p [byte], sha: &s [byte], size: int) -> [heap] json.Writer {
    var x = json.begin_object(heap, w);
    x = json.put_key(heap, x, "id");
    x = json.put_string(heap, x, id);
    x = json.put_key(heap, x, "kind");
    x = json.put_string(heap, x, kind);
    x = json.put_key(heap, x, "ref");
    x = json.put_string(heap, x, path);
    x = json.put_key(heap, x, "sha256");
    x = json.put_string(heap, x, sha);
    x = json.put_key(heap, x, "bytes");
    x = json.put_int(heap, x, size);
    return json.end_object(heap, x);
}

// The `evidence` array: nothing, one entry, or two (the second is present when `second_ref` is not empty).
fn evidence_array[&h, &a, &b, &c, &d](heap: &!h Heap, first_kind: &static [byte], first_ref: &a [byte], first_sha: &b [byte], first_size: int, second_kind: &static [byte], second_ref: &c [byte], second_sha: &d [byte], second_size: int) -> [heap] buffer.Buffer {
    var w = json.writer(heap, 256);
    w = json.begin_array(heap, w);
    if len(first_ref) > 0 {
        w = entry(heap, w, "ev-1", first_kind, first_ref, first_sha, first_size);
    }
    if len(second_ref) > 0 {
        w = entry(heap, w, "ev-2", second_kind, second_ref, second_sha, second_size);
    }
    w = json.end_array(heap, w);
    return json.finish(w);
}

// The whole response. `code` empty means `succeeded`; otherwise `failed` with that error code and message (not
// retryable). `evidence` is a finished array.
fn response_json[&h, &r, &k, &s, &e, &c, &m](heap: &!h Heap, request_id: &r [byte], task_id: &k [byte], summary: &s [byte], evidence: &e [byte], code: &c [byte], message: &m [byte]) -> [heap] buffer.Buffer {
    var w = json.writer(heap, 512);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "contract");
    w = json.put_string(heap, w, "forge-worker/1");
    w = json.put_key(heap, w, "request_id");
    w = json.put_string(heap, w, request_id);
    w = json.put_key(heap, w, "state");
    if len(code) == 0 {
        w = json.put_string(heap, w, "succeeded");
    } else {
        w = json.put_string(heap, w, "failed");
    }
    w = json.put_key(heap, w, "task_id");
    w = json.put_string(heap, w, task_id);
    w = json.put_key(heap, w, "summary");
    w = json.put_string(heap, w, summary);
    w = json.put_key(heap, w, "evidence");
    w = json.put_fragment(heap, w, evidence);
    w = json.put_key(heap, w, "error");
    if len(code) == 0 {
        w = json.put_null(heap, w);
    } else {
        w = json.begin_object(heap, w);
        w = json.put_key(heap, w, "code");
        w = json.put_string(heap, w, code);
        w = json.put_key(heap, w, "message");
        w = json.put_string(heap, w, message);
        w = json.put_key(heap, w, "retryable");
        w = json.put_bool(heap, w, false);
        w = json.end_object(heap, w);
    }
    w = json.end_object(heap, w);
    return json.finish(w);
}

// A `failed` response with no evidence.
fn failure[&h, &r, &k, &c, &m](heap: &!h Heap, request_id: &r [byte], task_id: &k [byte], code: &c [byte], message: &m [byte]) -> [heap] buffer.Buffer {
    let none = evidence_array(heap, "file", "", "", 0, "file", "", "", 0);
    var out = buffer.empty(heap, 1);
    borrow none as &nb in {
        buffer.drop(heap, out);
        out = response_json(heap, request_id, task_id, message, buffer.bytes(nb), code, message);
    }
    buffer.drop(heap, none);
    return out;
}

// The response written to stdout, and its newline.
fn send[&i, &b](io: &!i Io, reply: &b [byte]) -> [io_write] int {
    io.write_all(io, reply);
    io.newline(io);
    return 0;
}

// Wait `ms` milliseconds on an empty poller (nothing registered: only the timeout can end the wait).
fn nap[&h, &c](heap: &!h Heap, clock: &c Clock, ms: int) -> [heap, clock, poll] int {
    match poller_new() {
        Polling::Failed(e) => {
            return e;
        }
        Polling::Ok(p) => {
            var poller = p;
            let events = box_slice(heap, 4, 0);
            let until = clock_ms(clock) + ms;
            var left = ms;
            while left > 0 {
                borrow mut poller as &!ph in {
                    borrow mut events as &!eb in {
                        let n = poller_wait(ph, contents(eb), left);
                    }
                }
                left = until - clock_ms(clock);
            }
            unbox_slice(heap, events);
            poller_close(poller);
            return 0;
        }
    }
}

// The hash a reply claims: the file's own, or (`lie`) the first hex digit flipped, so that it is still a hash and is
// not the file's.
fn claimed_sha[&h, &s](heap: &!h Heap, sha: &s [byte], lie: bool) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 64);
    if lie && len(sha) > 0 {
        var first = byte_of(48);
        if int_of(sha[0]) == 48 {
            first = byte_of(49);
        }
        out = buffer.push(heap, out, first);
        return buffer.append(heap, out, sha[1..len(sha)]);
    }
    return buffer.append(heap, out, sha);
}

// One file of evidence written and described: the response for `ok`, `liar`, `liar_size`, `slow` and `truncated`
// (`liar_mode` 1 gives a hash that is not the file's, 2 a size that is not). A file that cannot be written is the
// stub's own `failed` with `evidence-unwritable`.
fn reply_with_file[&h, &f, &r, &k, &d, &s, &c](heap: &!h Heap, fs: &f Fs(""), request_id: &r [byte], task_id: &k [byte], exec_dir: &d [byte], summary: &s [byte], contents: &c [byte], liar_mode: int) -> [heap, fs_write(""), file_write] buffer.Buffer {
    let rc = put(heap, fs, exec_dir, "reply.md", contents);
    if rc != 0 {
        return failure(heap, request_id, task_id, "evidence-unwritable", "the reply could not be written in the execution directory");
    }
    let sha = snapshot.hex_digest(heap, contents);
    var out = buffer.empty(heap, 1);
    borrow sha as &shb in {
        let claimed = claimed_sha(heap, buffer.bytes(shb), liar_mode == 1);
        var size = len(contents);
        if liar_mode == 2 {
            size = size + 1;
        }
        borrow claimed as &cb in {
            let ev = evidence_array(heap, "report", "reply.md", buffer.bytes(cb), size, "file", "", "", 0);
            borrow ev as &eb in {
                buffer.drop(heap, out);
                out = response_json(heap, request_id, task_id, summary, buffer.bytes(eb), "", "");
            }
            buffer.drop(heap, ev);
        }
        buffer.drop(heap, claimed);
    }
    buffer.drop(heap, sha);
    return out;
}

// `propose`: the patch and a report, both described, a claim and nothing more.
fn reply_proposal[&h, &f, &r, &k, &d, &s, &p](heap: &!h Heap, fs: &f Fs(""), request_id: &r [byte], task_id: &k [byte], exec_dir: &d [byte], summary: &s [byte], patch: &p [byte]) -> [heap, fs_write(""), file_write] buffer.Buffer {
    let report = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), "Proposal: "), summary);
    var rc = put(heap, fs, exec_dir, "proposal.patch", patch);
    var out = buffer.empty(heap, 1);
    borrow report as &rb in {
        if rc == 0 {
            rc = put(heap, fs, exec_dir, "report.md", buffer.bytes(rb));
        }
        if rc != 0 {
            buffer.drop(heap, out);
            out = failure(heap, request_id, task_id, "evidence-unwritable", "the proposal could not be written in the execution directory");
        } else {
            let patch_sha = snapshot.hex_digest(heap, patch);
            let report_sha = snapshot.hex_digest(heap, buffer.bytes(rb));
            borrow patch_sha as &ps in {
                borrow report_sha as &rs in {
                    let ev = evidence_array(heap, "patch", "proposal.patch", buffer.bytes(ps), len(patch), "report", "report.md", buffer.bytes(rs), buffer.size(rb));
                    borrow ev as &eb in {
                        buffer.drop(heap, out);
                        out = response_json(heap, request_id, task_id, summary, buffer.bytes(eb), "", "");
                    }
                    buffer.drop(heap, ev);
                }
            }
            buffer.drop(heap, patch_sha);
            buffer.drop(heap, report_sha);
        }
    }
    buffer.drop(heap, report);
    return out;
}

fn default_patch() -> [] &static [byte] {
    return "--- a/README.md\n+++ b/README.md\n@@ -1 +1,2 @@\n # project\n+A line added by the stub.\n";
}

// `n` bytes of `x` to stdout.
fn flood[&i](io: &!i Io, n: int) -> [io_write] int {
    var left = n;
    while left > 0 {
        if left >= 64 {
            io.write_all(io, "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
            left = left - 64;
        } else {
            io.write_all(io, "x");
            left = left - 1;
        }
    }
    return 0;
}

// What the rule at `rule` makes the stub do.
fn act[&h, &i, &f, &c, &s, &t, &r, &k, &d](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), clock: &c Clock, src: &s [byte], tape: &t [int], rule: int, request_id: &r [byte], task_id: &k [byte], exec_dir: &d [byte], max_output: int) -> [heap, io_write, fs_write(""), file_write, clock, poll] int {
    let summary = decoded(heap, src, tape, json.get(src, tape, rule, "summary"), "stub reply");
    let text = decoded(heap, src, tape, json.get(src, tape, rule, "text"), "stub reply\n");
    var code = 0;
    borrow summary as &sm in {
        borrow text as &tx in {
            var action = stub_script.Do::Ok;
            match stub_script.do_of(text_of(src, tape, json.get(src, tape, rule, "do"))) {
                option.Option::Some(d2) => {
                    action = d2;
                }
                option.Option::None => {
                }
            }
            match action {
                stub_script.Do::Ok => {
                    let reply = reply_with_file(heap, fs, request_id, task_id, exec_dir, buffer.bytes(sm), buffer.bytes(tx), 0);
                    borrow reply as &rb in {
                        send(io, buffer.bytes(rb));
                    }
                    buffer.drop(heap, reply);
                }
                stub_script.Do::Liar => {
                    let reply = reply_with_file(heap, fs, request_id, task_id, exec_dir, buffer.bytes(sm), buffer.bytes(tx), 1);
                    borrow reply as &rb in {
                        send(io, buffer.bytes(rb));
                    }
                    buffer.drop(heap, reply);
                }
                stub_script.Do::LiarSize => {
                    let reply = reply_with_file(heap, fs, request_id, task_id, exec_dir, buffer.bytes(sm), buffer.bytes(tx), 2);
                    borrow reply as &rb in {
                        send(io, buffer.bytes(rb));
                    }
                    buffer.drop(heap, reply);
                }
                stub_script.Do::Slow => {
                    var ms = 0;
                    let node = json.get(src, tape, rule, "delay_ms");
                    if node >= 0 {
                        ms = json.to_int(src, tape, node);
                    }
                    nap(heap, clock, ms);
                    let reply = reply_with_file(heap, fs, request_id, task_id, exec_dir, buffer.bytes(sm), buffer.bytes(tx), 0);
                    borrow reply as &rb in {
                        send(io, buffer.bytes(rb));
                    }
                    buffer.drop(heap, reply);
                }
                stub_script.Do::Truncated => {
                    let reply = reply_with_file(heap, fs, request_id, task_id, exec_dir, buffer.bytes(sm), buffer.bytes(tx), 0);
                    borrow reply as &rb in {
                        let whole = buffer.bytes(rb);
                        io.write_all(io, whole[0..len(whole) / 2]);
                    }
                    buffer.drop(heap, reply);
                }
                stub_script.Do::Refuse => {
                    let failing = decoded(heap, src, tape, json.get(src, tape, rule, "code"), "model-refused");
                    var reply = buffer.empty(heap, 1);
                    borrow failing as &fb in {
                        buffer.drop(heap, reply);
                        reply = failure(heap, request_id, task_id, buffer.bytes(fb), buffer.bytes(sm));
                    }
                    buffer.drop(heap, failing);
                    borrow reply as &rb in {
                        send(io, buffer.bytes(rb));
                    }
                    buffer.drop(heap, reply);
                }
                stub_script.Do::Malformed => {
                    io.write_all(io, "Sure! Here is the JSON you asked for: {\"state\": \"succ\n");
                }
                stub_script.Do::CrashAfterProgress => {
                    put(heap, fs, exec_dir, "progress.txt", "step 1 of 3\n");
                    // An index that is out of bounds traps: the worker ends by a signal, having left its progress.
                    code = int_of(src[len(src)]);
                }
                stub_script.Do::Oversize => {
                    var n = max_output;
                    if n > 8388608 {
                        n = 8388608;
                    }
                    flood(io, n + 1);
                }
                stub_script.Do::Propose => {
                    let patch = decoded(heap, src, tape, json.get(src, tape, rule, "patch"), default_patch());
                    borrow patch as &pb in {
                        let reply = reply_proposal(heap, fs, request_id, task_id, exec_dir, buffer.bytes(sm), buffer.bytes(pb));
                        borrow reply as &rb in {
                            send(io, buffer.bytes(rb));
                        }
                        buffer.drop(heap, reply);
                    }
                    buffer.drop(heap, patch);
                }
            }
        }
    }
    buffer.drop(heap, summary);
    buffer.drop(heap, text);
    return code;
}

// The script is read, checked and applied to the prompt; anything wrong with it is the stub's own `failed`.
fn run_script[&h, &i, &f, &c, &r, &k, &d, &p, &y](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), clock: &c Clock, request_id: &r [byte], task_id: &k [byte], exec_dir: &d [byte], prompt: &p [byte], task_type: &y [byte], max_output: int) -> [heap, io_write, fs_read(""), file_read, fs_write(""), file_write, clock, poll] int {
    let path = under(heap, exec_dir, "stub_script.json");
    var code = 0;
    var script = buffer.empty(heap, 1);
    var errno = 0;
    borrow path as &pb in {
        // `read_all` answers an empty journal for a file that is not there; a script that is not there is its own refusal.
        if !journal_io.exists(fs, buffer.bytes(pb)) {
            errno = 2;
        }
        let (data, e) = journal_io.read_all(heap, fs, buffer.bytes(pb));
        buffer.drop(heap, script);
        script = data;
        if errno == 0 {
            errno = e;
        }
    }
    buffer.drop(heap, path);
    if errno != 0 {
        let reply = failure(heap, request_id, task_id, stub_script.code_script_missing(), "the script stub_script.json could not be read in the execution directory");
        borrow reply as &rb in {
            send(io, buffer.bytes(rb));
        }
        buffer.drop(heap, reply);
    } else {
        borrow script as &sb in {
            let src = buffer.bytes(sb);
            let tape = box_slice(heap, json.tape_len(src), 0);
            borrow mut tape as &!t in {
                let tp = contents(t);
                if json.parse(src, tp) > 0 && stub_script.valid(src, tp) {
                    let rule = stub_script.pick(src, tp, prompt, task_type);
                    if rule < 0 {
                        let reply = failure(heap, request_id, task_id, stub_script.code_no_rule(), "no rule of the script takes this prompt");
                        borrow reply as &rb in {
                            send(io, buffer.bytes(rb));
                        }
                        buffer.drop(heap, reply);
                    } else {
                        code = act(heap, io, fs, clock, src, tp, rule, request_id, task_id, exec_dir, max_output);
                    }
                } else {
                    let reply = failure(heap, request_id, task_id, stub_script.code_script_invalid(), "the script is not well formed");
                    borrow reply as &rb in {
                        send(io, buffer.bytes(rb));
                    }
                    buffer.drop(heap, reply);
                }
            }
            unbox_slice(heap, tape);
        }
    }
    buffer.drop(heap, script);
    return code;
}

fn serve[&h, &i, &f, &c](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), clock: &c Clock) -> [heap, io_read, io_write, fs_read(""), file_read, fs_write(""), file_write, clock, poll] int {
    let (request, whole) = read_request(heap, io);
    var code = 0;
    if !whole {
        code = 4;
    }
    borrow request as &rb in {
        let src = buffer.bytes(rb);
        let tape = box_slice(heap, json.tape_len(src), 0);
        borrow mut tape as &!t in {
            let tp = contents(t);
            if whole && json.parse(src, tp) > 0 && json.is_object(tp, 0) {
                let task = json.get(src, tp, 0, "task");
                let input = json.get(src, tp, task, "input");
                let limits = json.get(src, tp, 0, "limits");
                let grants = json.get(src, tp, 0, "grants");
                let rid = text_of(src, tp, json.get(src, tp, 0, "request_id"));
                let tid = text_of(src, tp, json.get(src, tp, task, "id"));
                let ttype = text_of(src, tp, json.get(src, tp, task, "type"));
                let exec_dir = text_of(src, tp, json.get(src, tp, grants, "execution_dir"));
                let prompt_node = json.get(src, tp, input, "prompt");
                var max_output = 1048576;
                let cap = json.get(src, tp, limits, "max_output_bytes");
                if cap >= 0 && json.is_int(tp, cap) && json.fits_int(src, tp, cap) && json.to_int(src, tp, cap) > 0 {
                    max_output = json.to_int(src, tp, cap);
                }
                // A request that is not an `execute` of this contract, or that names no request and no task, is not
                // answered: the worker has nothing to say that Forge could match to a call.
                if !is(src, tp, json.get(src, tp, 0, "contract"), "forge-worker/1") || !is(src, tp, json.get(src, tp, 0, "verb"), "execute") || len(rid) == 0 || len(tid) == 0 {
                    code = 4;
                } else if prompt_node < 0 || !json.is_string(tp, prompt_node) || len(exec_dir) == 0 || !journal_io.path_ok(fs, exec_dir) {
                    let reply = failure(heap, rid, tid, stub_script.code_bad_request(), "the request has no prompt, or no usable execution directory");
                    borrow reply as &yb in {
                        send(io, buffer.bytes(yb));
                    }
                    buffer.drop(heap, reply);
                } else {
                    code = run_script(heap, io, fs, clock, rid, tid, exec_dir, json.string_view(src, tp, prompt_node), ttype, max_output);
                }
            } else {
                code = 4;
            }
        }
        unbox_slice(heap, tape);
    }
    buffer.drop(heap, request);
    return code;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(net);
    release(signals);
    release(exec);
    release(tty);
    release(args);
    var console = io;
    var memory = heap;
    var code = 0;
    borrow fs as &f in {
        borrow clock as &c in {
            borrow mut console as &!i in {
                borrow mut memory as &!h in {
                    code = serve(h, i, f, c);
                }
            }
        }
    }
    release(fs);
    release(clock);
    release(console);
    release(memory);
    return code;
}
