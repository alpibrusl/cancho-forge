edition 9;

import std.buffer;
import std.bytes;
import std.dirs;
import std.io;
import std.json;
import std.option;
import std.process;
import forge.build_task;
import forge.gate_task;
import forge.journal_io;
import forge.lock;
import forge.run_files;
import forge.snapshot;
import forge.snapshot_io;
import forge.supervise;
import forge.task;
import forge.verbs;

// The Cancho Code adapter (docs/cancho-code-adapter.md; issue #16): a `sync` worker of the contract (worker-contract
// section 9, the process-and-directory binding). One `execute` request on stdin, one response on stdout, exit 0. The task
// is `project.build`: a brief becomes a verified new project. The adapter writes the brief to `brief.txt` in the
// execution directory, starts `cancho-build` (Cancho Code's build tool) with that directory as its work directory,
// waits for it, reads what it wrote, and answers with the contract's state for how it ended and the files it left as
// evidence:
//
//   build.json   kind `report`  the tool's own record: stage, units, verdict (a CLAIM)
//   build.out    kind `log`     the tool's standard output, up to 1 MiB (untrusted text, never read for a verdict)
//   run.log      kind `log`     the tool's run log
//   project.cho  kind `file`    the product, when it exists
//
// The tool is a name beneath the operator's tools directory (`grants.tools_dir`), started with
// `exec_spawn_detached_under` (cancho #562, #588): the program is found beneath a directory chosen at run time and
// leads a session and a process group of its own, so that the adapter, which has a deadline, can kill the build's whole
// group when it passes (spike S12; spike S7 measured what a kill of the pid alone leaves running). Where and with what
// the build runs (checker, agent command, provider, model, ceilings) is `grants.build`, the operator's, built by Forge
// from configuration and never from `task.input`; the task supplies the brief and nothing else.
//
// The verdict is a CLAIM: `state` is `succeeded` only for the tool's `done` (a claim, which Forge moves to
// `verification` and never to acceptance), `partial` for a `stuck` build with verified units or a failed final gate,
// and `failed` for the rest. The tool's exit code and the verdict in `build.json` must agree (`build_task.ended`).
//
// Authority (`cancho authority`): `Exec("")` and a `Dir` for the tool (the report names no path), `Fs("")` for the
// evidence, a clock for the deadline, no network, no signals. What the build does once started is the build's authority
// (docs/architecture.md, G2): `cancho-build` itself holds `exec("")`.

fn default_attempts() -> [] int {
    return 4;
}

fn default_agent_seconds() -> [] int {
    return 30;
}

fn default_rounds() -> [] int {
    return 3;
}

fn default_plan_seconds() -> [] int {
    return 900;
}

fn default_jobs() -> [] int {
    return 4;
}

fn read_request[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_read] (buffer.Buffer, bool) {
    var all = buffer.empty(heap, 1024);
    var c = getchar(io);
    var n = 0;
    while c >= 0 {
        if n >= 1048576 {
            return (all, false);
        }
        all = buffer.push(heap, all, byte_of(c));
        n = n + 1;
        c = getchar(io);
    }
    return (all, true);
}

fn begin[&x, &d, &a](exec: &x Exec(""), tools: &d Dir, args: &a [byte], child_in: ChildEnd, child_out: ChildEnd) -> [exec_under, exec_detached] Spawned {
    return exec_spawn_detached_under(exec, tools, build_task.tool_name(), args, "", Stdio::Pipe(child_in), Stdio::Pipe(child_out), Stdio::Null);
}

fn write_file[&f, &p, &b](fs: &f Fs(""), path: &p [byte], contents: &b [byte]) -> [fs_write(""), file_write] int {
    if journal_io.path_ok(fs, path) == false {
        return 0 - 2;
    }
    match open_write(fs, path) {
        Opened::Failed(e) => {
            return e;
        }
        Opened::Ok(opened) => {
            var file = opened;
            var rc = 0;
            borrow mut file as &!x in {
                rc = journal_io.write_all(x, contents);
            }
            file_close(file);
            return rc;
        }
    }
}

fn under[&h, &d, &n](heap: &!h Heap, dir: &d [byte], name: &n [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 64), dir);
    b = buffer.push(heap, b, byte_of(47));
    return buffer.append(heap, b, name);
}

// A file beneath the execution directory, opened one component at a time and following no link (spike S10: a build,
// which is untrusted, can leave a symlink in its own directory), read up to `cap` bytes: the bytes and 0, or an errno
// (2 absent), or -3 for a file past the cap (the buffer then holds the first `cap` bytes).
fn read_beneath[&h, &d, &n](heap: &!h Heap, dir: &d Dir, name: &n [byte], cap: int) -> [heap, dir_read, file_read] (buffer.Buffer, int) {
    var data = buffer.empty(heap, 256);
    match dirs.open_file(dir, name) {
        Opened::Failed(e) => {
            return (data, e);
        }
        Opened::Ok(opened) => {
            var file = opened;
            var errno = 0;
            borrow mut file as &!x in {
                let (got, e) = journal_io.drain(heap, x, data, cap);
                data = got;
                errno = e;
            }
            file_close(file);
            return (data, errno);
        }
    }
}

// What `build.json` says, or nothing usable: the verdict word as `build_task.verdict_id` numbers it (0 when the file is
// absent, over the cap, not an object, or has no string `verdict`) and the number of verified units (0 when it is not an
// integer from 0 to 2^31).
fn read_report[&h, &d](heap: &!h Heap, dir: &d Dir) -> [heap, dir_read, file_read] (int, int) {
    let (data, errno) = read_beneath(heap, dir, "build.json", 1048576);
    var verdict = 0;
    var verified = 0;
    if errno == 0 {
        borrow data as &db in {
            let src = buffer.bytes(db);
            let tape = box_slice(heap, json.tape_len(src), 0);
            borrow mut tape as &!t in {
                let tp = contents(t);
                if json.parse(src, tp) > 0 && json.is_object(tp, 0) {
                    let v = json.get(src, tp, 0, "verdict");
                    if v >= 0 && json.is_string(tp, v) && json.string_plain(tp, v) {
                        verdict = build_task.verdict_id(json.string_view(src, tp, v));
                    }
                    let u = json.get(src, tp, 0, "units_verified");
                    if u >= 0 && json.is_int(tp, u) && json.fits_int(src, tp, u) {
                        let n = json.to_int(src, tp, u);
                        if n >= 0 && n <= 2147483648 {
                            verified = n;
                        }
                    }
                }
            }
            unbox_slice(heap, tape);
        }
    }
    buffer.drop(heap, data);
    return (verdict, verified);
}

fn entry[&h, &p, &s](heap: &!h Heap, w: json.Writer, id: &p [byte], kind: &static [byte], path: &static [byte], sha: &s [byte], size: int) -> [heap] json.Writer {
    var x = json.begin_object(heap, w);
    x = json.put_key(heap, x, "id");
    x = json.put_string(heap, x, id);
    x = json.put_key(heap, x, "kind");
    x = json.put_string(heap, x, kind);
    x = json.put_key(heap, x, "ref");
    x = json.put_string(heap, x, path);
    x = json.put_key(heap, x, "sha256");
    x = json.put_string(heap, x, sha);
    x = json.put_key(heap, x, "bytes");
    x = json.put_int(heap, x, size);
    return json.end_object(heap, x);
}

// The evidence array (JSON text): each of `build_task.evidence_name` that exists beneath `dir` as an ordinary file of at
// most `file_cap` bytes, in order, hashed. A name that is absent, a link, a directory or too big is left out: the
// evidence is what exists, and Forge recomputes it against the files anyway.
fn evidence_array[&h, &d](heap: &!h Heap, dir: &d Dir) -> [heap, dir_read, file_read] buffer.Buffer {
    var w = json.writer(heap, 512);
    w = json.begin_array(heap, w);
    var i = 0;
    var n = 0;
    while i < build_task.evidence_count() {
        let (data, errno) = read_beneath(heap, dir, build_task.evidence_name(i), build_task.file_cap());
        if errno == 0 {
            n = n + 1;
            let id = buffer.push_nat(heap, buffer.append(heap, buffer.empty(heap, 8), "ev-"), n);
            borrow data as &db in {
                let sha = snapshot.hex_digest(heap, buffer.bytes(db));
                borrow id as &ib in {
                    borrow sha as &sb in {
                        w = entry(heap, w, buffer.bytes(ib), build_task.evidence_kind(i), build_task.evidence_name(i), buffer.bytes(sb), buffer.size(db));
                    }
                }
                buffer.drop(heap, sha);
            }
            buffer.drop(heap, id);
        }
        buffer.drop(heap, data);
        i = i + 1;
    }
    w = json.end_array(heap, w);
    return json.finish(w);
}

// The response. `state` is 0 `succeeded`, 1 `partial`, 2 `failed`, 3 `cancelled`, 4 `accepted`; `code` is empty when there is
// no error. `evidence` is the text of a JSON array. The reply as bytes, not yet written anywhere: `execute` prints it, the
// supervisor stores it as `result.json` (docs/async-level.md section 4).
fn answer[&h, &r, &k, &e](heap: &!h Heap, request_id: &r [byte], task_id: &k [byte], state: int, code: &static [byte], message: &static [byte], retryable: bool, evidence: &e [byte]) -> [heap] buffer.Buffer {
    var w = json.writer(heap, 512);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "contract");
    w = json.put_string(heap, w, "forge-worker/1");
    w = json.put_key(heap, w, "request_id");
    w = json.put_string(heap, w, request_id);
    w = json.put_key(heap, w, "state");
    if state == 0 {
        w = json.put_string(heap, w, "succeeded");
    } else if state == 1 {
        w = json.put_string(heap, w, "partial");
    } else if state == 3 {
        w = json.put_string(heap, w, "cancelled");
    } else if state == 4 {
        w = json.put_string(heap, w, "accepted");
    } else {
        w = json.put_string(heap, w, "failed");
    }
    w = json.put_key(heap, w, "task_id");
    w = json.put_string(heap, w, task_id);
    w = json.put_key(heap, w, "summary");
    w = json.put_string(heap, w, message);
    w = json.put_key(heap, w, "evidence");
    w = json.put_fragment(heap, w, evidence);
    w = json.put_key(heap, w, "error");
    if len(code) == 0 {
        w = json.put_null(heap, w);
    } else {
        w = json.begin_object(heap, w);
        w = json.put_key(heap, w, "code");
        w = json.put_string(heap, w, code);
        w = json.put_key(heap, w, "message");
        w = json.put_string(heap, w, message);
        w = json.put_key(heap, w, "retryable");
        w = json.put_bool(heap, w, retryable);
        w = json.end_object(heap, w);
    }
    w = json.end_object(heap, w);
    return json.finish(w);
}

// A refusal or an ending that has no evidence.
fn refuse[&h, &r, &k](heap: &!h Heap, request_id: &r [byte], task_id: &k [byte], code: &static [byte], message: &static [byte]) -> [heap] buffer.Buffer {
    return answer(heap, request_id, task_id, 2, code, message, false, "[]");
}

// Write a reply and a newline on standard output, and give the buffer back to the heap.
fn emit[&h, &i](heap: &!h Heap, io: &!i Io, reply: buffer.Buffer) -> [heap, io_write] int {
    borrow reply as &o in {
        buffer.write(io, o);
    }
    io.newline(io);
    buffer.drop(heap, reply);
    return 0;
}

// The text of a field when it is a plain string, else empty (`build_task.check` then refuses it).
fn text_of[&s, &t](src: &s [byte], tape: &t [int], node: int) -> [] &s [byte] {
    if node >= 0 && json.is_string(tape, node) && json.string_plain(tape, node) {
        return json.string_view(src, tape, node);
    }
    return "";
}

fn is[&s, &t](src: &s [byte], tape: &t [int], node: int, text: &static [byte]) -> [] bool {
    return node >= 0 && json.is_string(tape, node) && json.string_equals(src, tape, node, text);
}

// An optional integer field of an object: `fallback` when it is absent, the value when it is an integer that fits, and -1
// (which no ceiling accepts) otherwise.
fn int_or[&s, &t](src: &s [byte], tape: &t [int], node: int, fallback: int) -> [] int {
    if node < 0 {
        return fallback;
    }
    if json.is_int(tape, node) && json.fits_int(src, tape, node) {
        return json.to_int(src, tape, node);
    }
    return 0 - 1;
}

// Is the build tool a name the `Exec` bound covers, by the rule the spawn traps on? (A name the capability would not take
// must be refused, not attempted: a trap is how a bound is enforced, never what stops Forge.)
fn tool_ok[&x](exec: &x Exec("")) -> [] bool {
    return exec_covers(exec, build_task.tool_name());
}

// The lock of the execution directory is held and the tool has been found: write the brief, start the build detached beneath
// `tools`, wait for it under the deadline and for a request to cancel it (`cancel_path`, naming `request_id`), write its
// standard output, and give the reply of `execute`: how it ended and the files it left. `args` is the argument vector
// (`build_task.build_args`), whose brief path and work directory are beneath `exec_dir`.
fn run_locked[&h, &f, &c, &x, &d, &r, &k, &b, &e, &a, &q](heap: &!h Heap, fs: &f Fs(""), clock: &c Clock, exec: &x Exec(""), tools: &d Dir, request_id: &r [byte], task_id: &k [byte], brief: &b [byte], exec_dir: &e [byte], args: &a [byte], timeout_ms: int, cancel_path: &q [byte]) -> [heap, fs_read(""), fs_write(""), dir_read, file_read, file_write, exec_under, exec_detached, clock, poll] buffer.Buffer {
    if !tool_ok(exec) {
        return refuse(heap, request_id, task_id, build_task.rule_name(build_task.Refusal::ToolUnusable), "the build tool is not a name the Exec bound covers");
    }
    let brief_path = under(heap, exec_dir, "brief.txt");
    var rc = 0;
    borrow brief_path as &bp in {
        rc = write_file(fs, buffer.bytes(bp), brief);
    }
    buffer.drop(heap, brief_path);
    if rc != 0 {
        return refuse(heap, request_id, task_id, build_task.rule_name(build_task.Refusal::WorkdirUnwritable), "the brief could not be written in the execution directory");
    }
    let start = clock_ms(clock);
    var deadline = build_task.runner_deadline_ms(timeout_ms);
    var out = buffer.empty(heap, 1);
    var ended = process.Ran::Failed(0 - 1);
    var cancelled = false;
    match process.channels() {
        process.Channels::Failed(e) => {
            ended = process.Ran::Failed(e);
        }
        process.Channels::Ok(to_child, child_in, from_child, child_out) => {
            match begin(exec, tools, args, child_in, child_out) {
                Spawned::Failed(e) => {
                    process.close(to_child, from_child);
                    ended = process.Ran::Failed(e);
                }
                Spawned::Ok(child) => {
                    let (got, ran, was_cancelled) = supervise.wait(heap, clock, fs, child, to_child, from_child, build_task.out_cap(), deadline, cancel_path, request_id);
                    buffer.drop(heap, out);
                    out = got;
                    ended = ran;
                    cancelled = was_cancelled;
                }
            }
        }
    }
    var spawned = true;
    match ended {
        process.Ran::Failed(e) => {
            spawned = false;
        }
        _ => {
        }
    }
    if spawned == false {
        buffer.drop(heap, out);
        return refuse(heap, request_id, task_id, "build-unavailable", "the build tool could not be started");
    }
    // The tool's standard output is evidence `build.out`; it is written whatever the ending was (it is what the tool said
    // before it was stopped), and never read for a verdict.
    let out_path = under(heap, exec_dir, "build.out");
    borrow out_path as &op in {
        borrow out as &ob in {
            rc = write_file(fs, buffer.bytes(op), buffer.bytes(ob));
        }
    }
    buffer.drop(heap, out_path);
    buffer.drop(heap, out);
    if rc != 0 {
        return refuse(heap, request_id, task_id, build_task.rule_name(build_task.Refusal::WorkdirUnwritable), "the build output could not be written in the execution directory");
    }
    match open_dir(fs, exec_dir) {
        DirOpened::Failed(e) => {
            return refuse(heap, request_id, task_id, build_task.rule_name(build_task.Refusal::WorkdirUnwritable), "the execution directory could not be opened to list the evidence");
        }
        DirOpened::Ok(opened) => {
            var wd = opened;
            var done = buffer.empty(heap, 1);
            borrow wd as &w in {
                buffer.drop(heap, done);
                done = settle(heap, w, request_id, task_id, ended, cancelled);
            }
            dir_close(wd);
            return done;
        }
    }
}

// The ending of a build that was started, the work directory open: read `build.json` when the tool exited, name the
// ending, list the evidence, answer.
fn settle[&h, &d, &r, &k](heap: &!h Heap, wd: &d Dir, request_id: &r [byte], task_id: &k [byte], ran: process.Ran, cancelled: bool) -> [heap, dir_read, file_read] buffer.Buffer {
    var state = 2;
    var code = "build-unavailable";
    var message = "the build tool could not be started";
    var retryable = false;
    match ran {
        process.Ran::Code(n) => {
            let (verdict, verified) = read_report(heap, wd);
            let e = build_task.ended(n, verdict, verified);
            state = build_task.state_of(e);
            code = build_task.code_of(e);
            message = build_task.message_of(e);
            retryable = build_task.retryable_of(e);
        }
        process.Ran::Signaled(s) => {
            code = "build-crashed";
            message = "the build tool was ended by a signal it did not expect; its group is gone";
        }
        process.Ran::TimedOut => {
            code = "build-timeout";
            message = "the build did not finish inside the adapter's deadline; its group was killed and the directory is kept, so the same request resumes it";
        }
        process.Ran::TooMuch => {
            code = "build-output-overflow";
            message = "the build wrote more standard output than the cap; its group was killed";
        }
        process.Ran::Failed(e) => {
            code = "build-unavailable";
        }
    }
    if cancelled {
        // Asked for by a `cancel` (docs/async-level.md section 4): the whole group was killed, the directory is kept, no error.
        state = 3;
        code = "";
        message = "the build was cancelled; its group was killed and the directory is kept, so a new request resumes it";
        retryable = false;
    }
    let evidence = evidence_array(heap, wd);
    var reply = buffer.empty(heap, 1);
    borrow evidence as &eb in {
        buffer.drop(heap, reply);
        reply = answer(heap, request_id, task_id, state, code, message, retryable, buffer.bytes(eb));
    }
    buffer.drop(heap, evidence);
    return reply;
}

// Wait `ms` milliseconds on a poller with nothing registered (the program has no sleep; spike S14 measured 256 ms for 250).
fn nap[&h](heap: &!h Heap, ms: int) -> [heap, poll] int {
    var slept = 0 - 1;
    match poller_new() {
        Polling::Failed(e) => {
            slept = 0 - e;
        }
        Polling::Ok(p) => {
            var poller = p;
            var events = box_slice(heap, 4, 0);
            borrow mut poller as &!ph in {
                borrow mut events as &!eb in {
                    slept = poller_wait(ph, contents(eb), ms);
                }
            }
            unbox_slice(heap, events);
            poller_close(poller);
        }
    }
    return slept;
}

// A file of the execution directory read up to `cap` bytes through the path (the build cannot be trusted with its own
// directory, so what is read here is only ever compared, never obeyed): the bytes and 0, or an errno (2 absent).
fn read_in[&h, &f, &d, &n](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], name: &n [byte], cap: int) -> [heap, fs_read(""), file_read] (buffer.Buffer, int) {
    var data = buffer.empty(heap, 64);
    var errno = 0;
    let path = under(heap, dir, name);
    borrow path as &pb in {
        match open_read(fs, buffer.bytes(pb)) {
            Opened::Failed(e) => {
                errno = e;
            }
            Opened::Ok(opened) => {
                var file = opened;
                borrow mut file as &!x in {
                    let (got, e) = journal_io.drain(heap, x, data, cap);
                    data = got;
                    errno = e;
                }
                file_close(file);
            }
        }
    }
    buffer.drop(heap, path);
    return (data, errno);
}

// Remove a file of the execution directory; an absent file is not an error here.
fn remove_in[&h, &f, &d, &n](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], name: &n [byte]) -> [heap, fs_write("")] int {
    let path = under(heap, dir, name);
    borrow path as &pb in {
        if journal_io.path_ok(fs, buffer.bytes(pb)) {
            fs_remove(fs, buffer.bytes(pb));
        }
    }
    buffer.drop(heap, path);
    return 0;
}

// `result.json`, written whole to a temporary name and renamed into place: a reader sees all of it or none. 0 or an errno.
fn store_result[&h, &f, &d, &b](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], reply: &b [byte]) -> [heap, fs_write(""), file_write] int {
    let tmp = under(heap, dir, run_files.result_tmp_name());
    let final_path = under(heap, dir, run_files.result_name());
    var rc = 0;
    borrow tmp as &tb in {
        borrow final_path as &fb in {
            rc = write_file(fs, buffer.bytes(tb), reply);
            if rc == 0 {
                rc = snapshot_io.publish(fs, buffer.bytes(tb), buffer.bytes(fb));
            }
        }
    }
    buffer.drop(heap, tmp);
    buffer.drop(heap, final_path);
    return rc;
}

// The supervisor, the lock held: clear what an earlier run left, say who is running (`run.json`, with the start token
// `execute` chose), run the build, and keep the reply as `result.json`. 0, 5 when the directory cannot be written, 6 when the
// result could not be kept (the lock is let go all the same, and `result` then says the supervisor was lost).
fn work_locked[&h, &f, &c, &x, &d, &r, &k, &b, &e, &a](heap: &!h Heap, fs: &f Fs(""), clock: &c Clock, exec: &x Exec(""), tools: &d Dir, request_id: &r [byte], task_id: &k [byte], brief: &b [byte], exec_dir: &e [byte], args: &a [byte], timeout_ms: int, token: int) -> [heap, fs_read(""), fs_write(""), dir_read, file_read, file_write, exec_under, exec_detached, clock, poll] int {
    remove_in(heap, fs, exec_dir, run_files.run_name());
    remove_in(heap, fs, exec_dir, run_files.result_name());
    remove_in(heap, fs, exec_dir, run_files.result_tmp_name());
    remove_in(heap, fs, exec_dir, run_files.cancel_name());
    let rec = run_files.run_record(heap, request_id, task_id, token);
    let run_path = under(heap, exec_dir, run_files.run_name());
    var rc = 0;
    borrow run_path as &rp in {
        borrow rec as &rb in {
            rc = write_file(fs, buffer.bytes(rp), buffer.bytes(rb));
        }
    }
    buffer.drop(heap, run_path);
    buffer.drop(heap, rec);
    if rc != 0 {
        return 5;
    }
    let cancel_path = under(heap, exec_dir, run_files.cancel_name());
    var code = 6;
    borrow cancel_path as &cp in {
        let reply = run_locked(heap, fs, clock, exec, tools, request_id, task_id, brief, exec_dir, args, timeout_ms, buffer.bytes(cp));
        borrow reply as &yb in {
            if store_result(heap, fs, exec_dir, buffer.bytes(yb)) == 0 {
                code = 0;
            }
        }
        buffer.drop(heap, reply);
    }
    buffer.drop(heap, cancel_path);
    return code;
}

// The supervisor (docs/async-level.md section 2): take the lock of the execution directory (a held one is tried three times,
// 100 ms apart, because `status` and `result` hold it for an instant to find out that nobody does), then `work_locked`.
// The exit code is what `execute` reads: 0 the run ended and its result is kept, 3 another run holds the directory, 4 the
// path cannot be locked, 5 the directory cannot be written, 6 the result could not be kept.
fn supervised[&h, &f, &c, &x, &d, &r, &k, &b, &e, &a](heap: &!h Heap, fs: &f Fs(""), clock: &c Clock, exec: &x Exec(""), tools: &d Dir, request_id: &r [byte], task_id: &k [byte], brief: &b [byte], exec_dir: &e [byte], args: &a [byte], timeout_ms: int, token: int) -> [heap, fs_read(""), fs_write(""), dir_read, file_read, file_write, exec_under, exec_detached, clock, poll] int {
    let lock_path = under(heap, exec_dir, build_task.lock_name());
    var code = 3;
    var tries = 0;
    var finished = false;
    while !finished && tries < 3 {
        borrow lock_path as &lp in {
            match lock.acquire(fs, buffer.bytes(lp)) {
                lock.Lock::Refused(rule) => {
                    if rule == task.rule_code(task.Rule::WorkspaceLocked) {
                        tries = tries + 1;
                        if tries < 3 {
                            nap(heap, 100);
                        }
                    } else {
                        code = 4;
                        finished = true;
                    }
                }
                lock.Lock::Failed(e2) => {
                    code = 5;
                    finished = true;
                }
                lock.Lock::Held(file) => {
                    code = work_locked(heap, fs, clock, exec, tools, request_id, task_id, brief, exec_dir, args, timeout_ms, token);
                    lock.let_go(file);
                    finished = true;
                }
            }
        }
    }
    buffer.drop(heap, lock_path);
    return code;
}

// Wait for the supervisor `child` in slices of 20 ms for at most `limit_ms`: 0 it ended, 1 `run.json` names this request and
// this token (it holds the directory and the build is starting), 2 neither in time.
fn await_start[&h, &f, &k, &p, &r](heap: &!h Heap, fs: &f Fs(""), child: &k Child, run_path: &p [byte], request_id: &r [byte], token: int, limit_ms: int) -> [heap, fs_read(""), file_read, poll] int {
    var state = 2;
    match poller_new() {
        Polling::Failed(e) => {
            state = 2;
        }
        Polling::Ok(po) => {
            var poller = po;
            var events = box_slice(heap, 4, 0);
            borrow mut poller as &!ph in {
                poller_add_child(ph, child, 3);
                var i = 0;
                var running = true;
                while running && i * 20 < limit_ms {
                    var n = 0;
                    borrow mut events as &!eb in {
                        n = poller_wait(ph, contents(eb), 20);
                    }
                    if n > 0 {
                        state = 0;
                        running = false;
                    } else {
                        let (data, errno) = read_in_path(heap, fs, run_path, 4096);
                        borrow data as &db in {
                            if errno == 0 && run_files.run_is(heap, buffer.bytes(db), request_id, token) {
                                state = 1;
                                running = false;
                            }
                        }
                        buffer.drop(heap, data);
                    }
                    i = i + 1;
                }
            }
            unbox_slice(heap, events);
            poller_close(poller);
        }
    }
    return state;
}

fn read_in_path[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], cap: int) -> [heap, fs_read(""), file_read] (buffer.Buffer, int) {
    var data = buffer.empty(heap, 64);
    var errno = 0;
    match open_read(fs, path) {
        Opened::Failed(e) => {
            errno = e;
        }
        Opened::Ok(opened) => {
            var file = opened;
            borrow mut file as &!x in {
                let (got, e) = journal_io.drain(heap, x, data, cap);
                data = got;
                errno = e;
            }
            file_close(file);
        }
    }
    return (data, errno);
}

// The supervisor's name beneath the workers directory: the adapter itself.
fn supervisor_name() -> [] &static [byte] {
    return "cancho_code";
}

// `execute`: the task has passed its checks. Start the supervisor (this program, `supervise`, detached and released), give
// it the request on its standard input, and answer `accepted` once `run.json` names this start; or what the supervisor
// answered by ending first (docs/async-level.md section 4). Nothing is written to the execution directory here.
fn start_supervisor[&h, &f, &c, &x, &r, &k, &q, &e, &w, &t](heap: &!h Heap, fs: &f Fs(""), clock: &c Clock, exec: &x Exec(""), request_id: &r [byte], task_id: &k [byte], request: &q [byte], exec_dir: &e [byte], workers_dir: &w [byte], tools_dir: &t [byte]) -> [heap, fs_read(""), file_read, exec_under, exec_detached, child_signal, pipe_write, clock, poll] buffer.Buffer {
    if !tool_ok(exec) || !exec_covers(exec, supervisor_name()) {
        return refuse(heap, request_id, task_id, build_task.rule_name(build_task.Refusal::ToolUnusable), "the build tool is not a name the Exec bound covers");
    }
    var tools_ok = false;
    match open_dir(fs, tools_dir) {
        DirOpened::Failed(e2) => {
        }
        DirOpened::Ok(td) => {
            tools_ok = true;
            dir_close(td);
        }
    }
    if !tools_ok {
        return refuse(heap, request_id, task_id, build_task.rule_name(build_task.Refusal::ToolUnusable), "the tools directory could not be opened");
    }
    let token = clock_ms(clock);
    var header = buffer.append(heap, buffer.empty(heap, 32), "supervise ");
    header = buffer.push_nat(heap, header, token);
    header = buffer.push(heap, header, byte_of(10));
    let payload = buffer.append(heap, header, request);
    var reply = buffer.empty(heap, 1);
    match open_dir(fs, workers_dir) {
        DirOpened::Failed(e2) => {
            buffer.drop(heap, reply);
            reply = refuse(heap, request_id, task_id, build_task.rule_name(build_task.Refusal::SupervisorUnavailable), "the workers directory could not be opened");
        }
        DirOpened::Ok(wd) => {
            var workers = wd;
            match pipe_open() {
                Piped::Failed(e2) => {
                    buffer.drop(heap, reply);
                    reply = refuse(heap, request_id, task_id, build_task.rule_name(build_task.Refusal::SupervisorUnavailable), "the supervisor's input could not be opened");
                }
                Piped::Ok(to_child, child_in) => {
                    borrow workers as &wq in {
                        borrow payload as &ab in {
                            match exec_spawn_detached_under(exec, wq, supervisor_name(), "", "", Stdio::Pipe(child_in), Stdio::Null, Stdio::Null) {
                                Spawned::Failed(e2) => {
                                    pipe_close(to_child);
                                    buffer.drop(heap, reply);
                                    reply = refuse(heap, request_id, task_id, build_task.rule_name(build_task.Refusal::SupervisorUnavailable), "the supervisor could not be started");
                                }
                                Spawned::Ok(child) => {
                                    var written = 0;
                                    var spins = 0;
                                    var writing = true;
                                    var tw = to_child;
                                    let sent = buffer.bytes(ab);
                                    while writing && written < len(sent) && spins < 2000 {
                                        borrow mut tw as &!twb in {
                                            match pipe_write(twb, sent[written..len(sent)]) {
                                                Sent::Wrote(m) => {
                                                    written = written + m;
                                                }
                                                Sent::Again => {
                                                    spins = spins + 1;
                                                }
                                                Sent::Failed(e2) => {
                                                    writing = false;
                                                }
                                            }
                                        }
                                        if writing && written < len(sent) {
                                            nap(heap, 5);
                                        }
                                    }
                                    pipe_close(tw);
                                    let run_path = under(heap, exec_dir, run_files.run_name());
                                    var how = 2;
                                    borrow run_path as &rp in {
                                        borrow child as &cw in {
                                            how = await_start(heap, fs, cw, buffer.bytes(rp), request_id, token, 10000);
                                        }
                                        if how == 2 {
                                            // Silent for ten seconds: stop it (its group is its own) and say so.
                                            borrow child as &ck in {
                                                child_kill_group(ck, 256);
                                                child_kill(ck, 256);
                                            }
                                        }
                                        if how == 1 {
                                            child_release(child);
                                            buffer.drop(heap, reply);
                                            reply = answer(heap, request_id, task_id, 4, "", "the build was accepted; poll status and result", false, "[]");
                                        } else {
                                            var code = 0 - 1;
                                            match child_wait(child) {
                                                Exited::Code(n2) => {
                                                    code = n2;
                                                }
                                                Exited::Signaled(s2) => {
                                                    code = 0 - 2;
                                                }
                                                Exited::Failed(e2) => {
                                                    code = 0 - 3;
                                                }
                                            }
                                            // It may have ended after writing `run.json`: a start that finished is still a start.
                                            let (data, errno) = read_in_path(heap, fs, buffer.bytes(rp), 4096);
                                            var started = false;
                                            borrow data as &db in {
                                                started = errno == 0 && run_files.run_is(heap, buffer.bytes(db), request_id, token);
                                            }
                                            buffer.drop(heap, data);
                                            buffer.drop(heap, reply);
                                            if started && how == 0 {
                                                reply = answer(heap, request_id, task_id, 4, "", "the build was accepted; poll status and result", false, "[]");
                                            } else if code == 3 {
                                                reply = refuse(heap, request_id, task_id, build_task.rule_name(build_task.Refusal::ExecutionLocked), "another build holds this execution directory; nothing was written");
                                            } else if code == 5 {
                                                reply = refuse(heap, request_id, task_id, build_task.rule_name(build_task.Refusal::WorkdirUnwritable), "the execution directory could not be written");
                                            } else {
                                                reply = refuse(heap, request_id, task_id, build_task.rule_name(build_task.Refusal::SupervisorUnavailable), "the supervisor ended or stayed silent without taking the directory");
                                            }
                                        }
                                    }
                                    buffer.drop(heap, run_path);
                                }
                            }
                        }
                    }
                }
            }
            dir_close(workers);
        }
    }
    buffer.drop(heap, payload);
    return reply;
}

// ---- status, result, cancel: calls about a run that an earlier call started (docs/async-level.md section 4) -----------

// The `stage` word of `build.json`, when it is a plain word of letters and underscores of at most 32 bytes (advisory
// progress; never a verdict). Empty otherwise.
fn stage_of[&h, &f, &e](heap: &!h Heap, fs: &f Fs(""), exec_dir: &e [byte]) -> [heap, fs_read(""), dir_read, file_read] buffer.Buffer {
    var stage = buffer.empty(heap, 16);
    match open_dir(fs, exec_dir) {
        DirOpened::Failed(e2) => {
        }
        DirOpened::Ok(opened) => {
            var wd = opened;
            borrow wd as &w in {
                let (data, errno) = read_beneath(heap, w, "build.json", 1048576);
                if errno == 0 {
                    borrow data as &db in {
                        let src = buffer.bytes(db);
                        let tape = box_slice(heap, json.tape_len(src), 0);
                        borrow mut tape as &!t in {
                            let tp = contents(t);
                            if json.parse(src, tp) > 0 && json.is_object(tp, 0) {
                                let v = json.get(src, tp, 0, "stage");
                                if v >= 0 && json.is_string(tp, v) && json.string_plain(tp, v) {
                                    let word = json.string_view(src, tp, v);
                                    var plain = len(word) >= 1 && len(word) <= 32;
                                    var j = 0;
                                    while plain && j < len(word) {
                                        let ch = int_of(word[j]);
                                        if !(ch >= 97 && ch <= 122 || ch == 95) {
                                            plain = false;
                                        }
                                        j = j + 1;
                                    }
                                    if plain {
                                        stage = buffer.append(heap, stage, word);
                                    }
                                }
                            }
                        }
                        unbox_slice(heap, tape);
                    }
                }
                buffer.drop(heap, data);
            }
            dir_close(wd);
        }
    }
    return stage;
}

// Is there a run in `exec_dir` for `target`? Its task id, or an empty buffer.
fn run_task[&h, &f, &e, &t](heap: &!h Heap, fs: &f Fs(""), exec_dir: &e [byte], target: &t [byte]) -> [heap, fs_read(""), file_read] buffer.Buffer {
    let (data, errno) = read_in(heap, fs, exec_dir, run_files.run_name(), 4096);
    var task_id = buffer.empty(heap, 1);
    if errno == 0 {
        borrow data as &db in {
            if run_files.run_is(heap, buffer.bytes(db), target, 0 - 1) {
                buffer.drop(heap, task_id);
                task_id = run_files.run_task_id(heap, buffer.bytes(db));
            }
        }
    }
    buffer.drop(heap, data);
    return task_id;
}

// The stored result for `target`, and its state word (1 to 4; see `run_files.result_state`), or nothing and 0 when there is
// none, it is for another request, or it is not a result of this adapter.
fn result_of[&h, &f, &e, &t](heap: &!h Heap, fs: &f Fs(""), exec_dir: &e [byte], target: &t [byte]) -> [heap, fs_read(""), file_read] (buffer.Buffer, int) {
    let (data, errno) = read_in(heap, fs, exec_dir, run_files.result_name(), run_files.max_file_bytes());
    var state = 0;
    if errno == 0 {
        borrow data as &db in {
            if bytes.equal(run_files.stored_id(buffer.bytes(db)), target) {
                state = run_files.result_state(heap, buffer.bytes(db));
            }
        }
    }
    if state == 0 {
        buffer.drop(heap, data);
        return (buffer.empty(heap, 1), 0);
    }
    return (data, state);
}

fn control_status[&h, &f, &r, &t, &e](heap: &!h Heap, fs: &f Fs(""), request_id: &r [byte], target: &t [byte], exec_dir: &e [byte]) -> [heap, fs_read(""), fs_write(""), dir_read, file_read, file_write] buffer.Buffer {
    let task_id = run_task(heap, fs, exec_dir, target);
    var known = false;
    borrow task_id as &kb in {
        known = len(buffer.bytes(kb)) > 0;
    }
    buffer.drop(heap, task_id);
    if !known {
        return verbs.status_reply(heap, request_id, target, "unknown", "");
    }
    let (stored, state) = result_of(heap, fs, exec_dir, target);
    buffer.drop(heap, stored);
    if state > 0 {
        return verbs.status_reply(heap, request_id, target, "finished", "");
    }
    // No result yet: whether anybody holds the directory is whether the lock is taken.
    var reply = buffer.empty(heap, 1);
    let lock_path = under(heap, exec_dir, build_task.lock_name());
    borrow lock_path as &lp in {
        match lock.acquire(fs, buffer.bytes(lp)) {
            lock.Lock::Held(file) => {
                lock.let_go(file);
                buffer.drop(heap, reply);
                reply = verbs.status_reply(heap, request_id, target, "finished", "");
            }
            lock.Lock::Refused(rule) => {
                buffer.drop(heap, reply);
                if rule == task.rule_code(task.Rule::WorkspaceLocked) {
                    let stage = stage_of(heap, fs, exec_dir);
                    borrow stage as &sb in {
                        reply = verbs.status_reply(heap, request_id, target, "running", buffer.bytes(sb));
                    }
                    buffer.drop(heap, stage);
                } else {
                    reply = verbs.status_reply(heap, request_id, target, "unknown", "");
                }
            }
            lock.Lock::Failed(e2) => {
                buffer.drop(heap, reply);
                reply = verbs.status_reply(heap, request_id, target, "unknown", "");
            }
        }
    }
    buffer.drop(heap, lock_path);
    return reply;
}

fn control_result[&h, &f, &r, &t, &e](heap: &!h Heap, fs: &f Fs(""), request_id: &r [byte], target: &t [byte], exec_dir: &e [byte]) -> [heap, fs_read(""), fs_write(""), dir_read, file_read, file_write] buffer.Buffer {
    let task_id = run_task(heap, fs, exec_dir, target);
    var known = false;
    borrow task_id as &kb in {
        known = len(buffer.bytes(kb)) > 0;
    }
    if !known {
        buffer.drop(heap, task_id);
        return verbs.not_ready_reply(heap, request_id);
    }
    let (stored, state) = result_of(heap, fs, exec_dir, target);
    var reply = buffer.empty(heap, 1);
    if state > 0 {
        borrow stored as &sb in {
            buffer.drop(heap, reply);
            reply = run_files.rebind(heap, buffer.bytes(sb), request_id);
        }
    }
    buffer.drop(heap, stored);
    var have = false;
    borrow reply as &yb in {
        have = len(buffer.bytes(yb)) > 0;
    }
    if have {
        buffer.drop(heap, task_id);
        return reply;
    }
    // No result: running, or the supervisor is gone. The lock tells which; a lost one is settled here, once, under the lock,
    // so that the answer is the same every time and a new run cannot start in between.
    let lock_path = under(heap, exec_dir, build_task.lock_name());
    borrow lock_path as &lp in {
        match lock.acquire(fs, buffer.bytes(lp)) {
            lock.Lock::Held(file) => {
                let evidence = lost_evidence(heap, fs, exec_dir);
                borrow task_id as &kb2 in {
                    borrow evidence as &eb in {
                        let lost = answer(heap, target, buffer.bytes(kb2), 2, "build-supervisor-lost", "the process that supervised this build is gone and left no result; the build may still be running (it is not stopped by anything here), and the directory is kept", false, buffer.bytes(eb));
                        borrow lost as &lb in {
                            store_result(heap, fs, exec_dir, buffer.bytes(lb));
                            buffer.drop(heap, reply);
                            reply = run_files.rebind(heap, buffer.bytes(lb), request_id);
                        }
                        buffer.drop(heap, lost);
                    }
                }
                buffer.drop(heap, evidence);
                lock.let_go(file);
            }
            lock.Lock::Refused(rule) => {
                buffer.drop(heap, reply);
                reply = verbs.not_ready_reply(heap, request_id);
            }
            lock.Lock::Failed(e2) => {
                buffer.drop(heap, reply);
                reply = verbs.not_ready_reply(heap, request_id);
            }
        }
    }
    buffer.drop(heap, lock_path);
    buffer.drop(heap, task_id);
    return reply;
}

// The evidence that exists in a directory whose supervisor is gone: the array of `evidence_array`, or `[]` when the
// directory cannot be opened.
fn lost_evidence[&h, &f, &e](heap: &!h Heap, fs: &f Fs(""), exec_dir: &e [byte]) -> [heap, fs_read(""), dir_read, file_read] buffer.Buffer {
    var evidence = buffer.append(heap, buffer.empty(heap, 4), "[]");
    match open_dir(fs, exec_dir) {
        DirOpened::Failed(e2) => {
        }
        DirOpened::Ok(opened) => {
            var wd = opened;
            borrow wd as &w in {
                buffer.drop(heap, evidence);
                evidence = evidence_array(heap, w);
            }
            dir_close(wd);
        }
    }
    return evidence;
}

// `cancel`: ask the supervisor of a live run to stop its build, and say what came of it. No answer (the caller gets `None`)
// when the supervisor did not write its result in ten seconds.
fn control_cancel[&h, &f, &r, &t, &e](heap: &!h Heap, fs: &f Fs(""), request_id: &r [byte], target: &t [byte], exec_dir: &e [byte]) -> [heap, fs_read(""), fs_write(""), file_read, file_write, poll] option.Option[buffer.Buffer] {
    let task_id = run_task(heap, fs, exec_dir, target);
    var known = false;
    borrow task_id as &kb in {
        known = len(buffer.bytes(kb)) > 0;
    }
    buffer.drop(heap, task_id);
    if !known {
        return option.Option::Some(verbs.cancel_reply(heap, request_id, target, "not_running"));
    }
    let (first, state) = result_of(heap, fs, exec_dir, target);
    buffer.drop(heap, first);
    if state == 4 {
        return option.Option::Some(verbs.cancel_reply(heap, request_id, target, "cancelled"));
    }
    if state > 0 {
        return option.Option::Some(verbs.cancel_reply(heap, request_id, target, "too_late"));
    }
    // Alive? A free lock means nobody is running it.
    var alive = false;
    let lock_path = under(heap, exec_dir, build_task.lock_name());
    borrow lock_path as &lp in {
        match lock.acquire(fs, buffer.bytes(lp)) {
            lock.Lock::Held(file) => {
                lock.let_go(file);
            }
            lock.Lock::Refused(rule) => {
                alive = rule == task.rule_code(task.Rule::WorkspaceLocked);
            }
            lock.Lock::Failed(e2) => {
            }
        }
    }
    buffer.drop(heap, lock_path);
    if !alive {
        return option.Option::Some(verbs.cancel_reply(heap, request_id, target, "not_running"));
    }
    let cancel_path = under(heap, exec_dir, run_files.cancel_name());
    var rc = 0;
    borrow cancel_path as &cp in {
        rc = write_file(fs, buffer.bytes(cp), target);
    }
    buffer.drop(heap, cancel_path);
    if rc != 0 {
        return option.Option::None;
    }
    var waited = 0;
    var answered = 0;
    while answered == 0 && waited < 200 {
        let (got, st) = result_of(heap, fs, exec_dir, target);
        buffer.drop(heap, got);
        if st > 0 {
            answered = st;
        } else {
            nap(heap, 50);
            waited = waited + 1;
        }
    }
    if answered == 4 {
        return option.Option::Some(verbs.cancel_reply(heap, request_id, target, "cancelled"));
    }
    if answered > 0 {
        return option.Option::Some(verbs.cancel_reply(heap, request_id, target, "too_late"));
    }
    return option.Option::None;
}

// The brief, decoded: the bytes of `input.brief` when it is a string of 1 to 16 KiB, else empty (then
// `build_task.check` refuses it as `input-invalid`).
fn decode_brief[&h, &s, &t](heap: &!h Heap, src: &s [byte], tape: &t [int], node: int) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 1);
    if node < 0 || !json.is_string(tape, node) {
        return out;
    }
    let n = json.string_length(src, tape, node);
    if n < 1 || n > build_task.max_brief_bytes() {
        return out;
    }
    let raw = box_slice(heap, n, byte_of(0));
    borrow mut raw as &!rw in {
        let written = json.string_into(src, tape, node, contents(rw));
        if written == n {
            out = buffer.append(heap, out, contents(rw));
        }
    }
    unbox_slice(heap, raw);
    return out;
}

// Open the tools directory and run the build as the supervisor (docs/async-level.md section 2). The exit code of `supervised`,
// or 6 when the tools directory cannot be opened (the starter checked it already).
fn supervise_task[&h, &f, &c, &x, &r, &k, &b, &e, &t, &a](heap: &!h Heap, fs: &f Fs(""), clock: &c Clock, exec: &x Exec(""), request_id: &r [byte], task_id: &k [byte], brief: &b [byte], exec_dir: &e [byte], tools_dir: &t [byte], args: &a [byte], timeout_ms: int, token: int) -> [heap, fs_read(""), fs_write(""), dir_read, file_read, file_write, exec_under, exec_detached, clock, poll] int {
    match open_dir(fs, tools_dir) {
        DirOpened::Failed(e2) => {
            return 6;
        }
        DirOpened::Ok(opened) => {
            var tools = opened;
            var code = 6;
            borrow tools as &td in {
                code = supervised(heap, fs, clock, exec, td, request_id, task_id, brief, exec_dir, args, timeout_ms, token);
            }
            dir_close(tools);
            return code;
        }
    }
}

// One call. A request that begins with the line `supervise <token>` is the one `start_supervisor` hands to its supervisor (the
// token is the start token of that run, the rest of the input is the request of `execute`): this call is the supervisor, it
// prints nothing, and its exit code is `supervised`'s. Anything else is a call of a verb, and its reply goes to standard
// output. (The header is on standard input and not in the arguments so that the adapter reads no command line.)
fn serve[&h, &i, &f, &c, &x](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), clock: &c Clock, exec: &x Exec("")) -> [heap, io_read, io_write, fs_read(""), fs_write(""), dir_read, file_read, file_write, exec_under, exec_detached, child_signal, pipe_write, clock, poll] int {
    let (request, whole) = read_request(heap, io);
    var code = 0;
    if !whole {
        code = 4;
    }
    borrow request as &rb in {
        let all = buffer.bytes(rb);
        let (token, offset) = header_of(all);
        let src = all[offset..len(all)];
        let tape = box_slice(heap, json.tape_len(src), 0);
        borrow mut tape as &!t in {
            let tp = contents(t);
            if whole && json.parse(src, tp) > 0 && json.is_object(tp, 0) {
                let task = json.get(src, tp, 0, "task");
                let input = json.get(src, tp, task, "input");
                let limits = json.get(src, tp, 0, "limits");
                let grants = json.get(src, tp, 0, "grants");
                let build = json.get(src, tp, grants, "build");
                let rid = json.get(src, tp, 0, "request_id");
                let tid = json.get(src, tp, task, "id");
                let timeout = json.get(src, tp, limits, "timeout_ms");
                var timeout_ms = 0;
                if timeout >= 0 && json.is_int(tp, timeout) && json.fits_int(src, tp, timeout) {
                    timeout_ms = json.to_int(src, tp, timeout);
                }
                let verb = json.get(src, tp, 0, "verb");
                let contract_ok = is(src, tp, json.get(src, tp, 0, "contract"), "forge-worker/1");
                let control = is(src, tp, verb, "status") || is(src, tp, verb, "result") || is(src, tp, verb, "cancel");
                // A request that is not a verb of this contract, or that names no request (and, for `execute`, no task), is
                // not answered: the worker has nothing to say that Forge could match to a call.
                if token < 0 && contract_ok && is(src, tp, verb, "capabilities") && len(text_of(src, tp, rid)) > 0 {
                    let reply = verbs.capabilities_reply(heap, text_of(src, tp, rid), "cancho-code-adapter", "0.2.0", "async", "project.build", build_task.max_timeout_ms(), 1048576);
                    emit(heap, io, reply);
                } else if token < 0 && contract_ok && control {
                    let target = text_of(src, tp, json.get(src, tp, 0, "target"));
                    let exec_dir = text_of(src, tp, json.get(src, tp, grants, "execution_dir"));
                    if len(text_of(src, tp, rid)) == 0 || len(target) == 0 || !gate_task.path_ok(exec_dir) {
                        code = 4;
                    } else if is(src, tp, verb, "status") {
                        emit(heap, io, control_status(heap, fs, text_of(src, tp, rid), target, exec_dir));
                    } else if is(src, tp, verb, "result") {
                        emit(heap, io, control_result(heap, fs, text_of(src, tp, rid), target, exec_dir));
                    } else {
                        match control_cancel(heap, fs, text_of(src, tp, rid), target, exec_dir) {
                            option.Option::Some(reply) => {
                                emit(heap, io, reply);
                            }
                            option.Option::None => {
                                code = 4;
                            }
                        }
                    }
                } else if !contract_ok || !is(src, tp, verb, "execute") || len(text_of(src, tp, rid)) == 0 || len(text_of(src, tp, tid)) == 0 {
                    code = 4;
                } else {
                    let brief = decode_brief(heap, src, tp, json.get(src, tp, input, "brief"));
                    let exec_dir = text_of(src, tp, json.get(src, tp, grants, "execution_dir"));
                    let tools_dir = text_of(src, tp, json.get(src, tp, grants, "tools_dir"));
                    let workers_dir = text_of(src, tp, json.get(src, tp, grants, "workers_dir"));
                    let kind = text_of(src, tp, json.get(src, tp, task, "type"));
                    let checker = text_of(src, tp, json.get(src, tp, build, "checker"));
                    let guide = text_of(src, tp, json.get(src, tp, build, "guide"));
                    // `input.contract`: absent is none; present but empty or not a plain string is read as empty and refused
                    let contract_node = json.get(src, tp, input, "contract");
                    let contract = text_of(src, tp, contract_node);
                    let provider = text_of(src, tp, json.get(src, tp, build, "provider"));
                    let model = text_of(src, tp, json.get(src, tp, build, "model"));
                    let agent = text_of(src, tp, json.get(src, tp, build, "agent"));
                    let attempts = int_or(src, tp, json.get(src, tp, build, "attempts"), default_attempts());
                    let agent_seconds = int_or(src, tp, json.get(src, tp, build, "agent_seconds"), default_agent_seconds());
                    let rounds = int_or(src, tp, json.get(src, tp, build, "rounds"), default_rounds());
                    let plan_seconds = int_or(src, tp, json.get(src, tp, build, "plan_seconds"), default_plan_seconds());
                    let jobs = int_or(src, tp, json.get(src, tp, build, "jobs"), default_jobs());
                    borrow brief as &bb in {
                        var refusal = build_task.check(kind, buffer.bytes(bb), exec_dir, tools_dir, timeout_ms);
                        match refusal {
                            build_task.Checked::Held => {
                                refusal = build_task.contract_checked(contract_node >= 0, contract, exec_dir);
                            }
                            build_task.Checked::Refused(why) => {
                            }
                        }
                        match refusal {
                            build_task.Checked::Held => {
                                refusal = build_task.operator_checked(checker, guide, provider, model, agent, attempts, agent_seconds, rounds, plan_seconds, jobs);
                            }
                            build_task.Checked::Refused(why) => {
                            }
                        }
                        match refusal {
                            build_task.Checked::Refused(why) => {
                                if token < 0 {
                                    emit(heap, io, refuse(heap, text_of(src, tp, rid), text_of(src, tp, tid), build_task.rule_name(why), "the task was refused before anything ran"));
                                } else {
                                    code = 4;
                                }
                            }
                            build_task.Checked::Held => {
                                if token < 0 {
                                    if !build_task.workers_dir_ok(workers_dir) {
                                        emit(heap, io, refuse(heap, text_of(src, tp, rid), text_of(src, tp, tid), build_task.rule_name(build_task.Refusal::PathInvalid), "the workers directory is not a path the adapter will use"));
                                    } else {
                                        emit(heap, io, start_supervisor(heap, fs, clock, exec, text_of(src, tp, rid), text_of(src, tp, tid), src, exec_dir, workers_dir, tools_dir));
                                    }
                                } else {
                                    let brief_path = under(heap, exec_dir, "brief.txt");
                                    var contract_path = buffer.empty(heap, 1);
                                    if contract_node >= 0 {
                                        buffer.drop(heap, contract_path);
                                        contract_path = build_task.contract_resolved(heap, contract, exec_dir);
                                    }
                                    borrow brief_path as &bp in {
                                        borrow contract_path as &cp in {
                                            let args = build_task.build_args(heap, checker, buffer.bytes(bp), exec_dir, agent, provider, model, guide, buffer.bytes(cp), attempts, agent_seconds, rounds, plan_seconds, jobs);
                                            borrow args as &ab in {
                                                code = supervise_task(heap, fs, clock, exec, text_of(src, tp, rid), text_of(src, tp, tid), buffer.bytes(bb), exec_dir, tools_dir, buffer.bytes(ab), timeout_ms, token);
                                            }
                                            buffer.drop(heap, args);
                                        }
                                    }
                                    buffer.drop(heap, contract_path);
                                    buffer.drop(heap, brief_path);
                                }
                            }
                        }
                    }
                    buffer.drop(heap, brief);
                }
            } else {
                code = 4;
            }
        }
        unbox_slice(heap, tape);
    }
    buffer.drop(heap, request);
    return code;
}

// The header of a supervisor's input: `supervise <digits>\n`. The token and the offset of the request that follows, or (-1, 0)
// when the input has no well-formed header: a call of a verb. (An input that begins `supervise` and is not well formed is no
// JSON either, so it ends as every input that is not a request does: exit 4, nothing written.)
fn header_of[&a](all: &a [byte]) -> [] (int, int) {
    let mark = "supervise ";
    if len(all) < len(mark) || !bytes.starts_with(all, mark) {
        return (0 - 1, 0);
    }
    var n = 0;
    var i = len(mark);
    while i < len(all) && i < len(mark) + 19 && int_of(all[i]) != 10 {
        let d = int_of(all[i]) - 48;
        if d < 0 || d > 9 {
            return (0 - 1, 0);
        }
        n = n * 10 + d;
        i = i + 1;
    }
    if i == len(mark) || i >= len(all) || int_of(all[i]) != 10 {
        return (0 - 1, 0);
    }
    return (n, i + 1);
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(net);
    release(signals);
    release(tty);
    release(args);
    var console = io;
    var memory = heap;
    var code = 0;
    borrow fs as &f in {
        borrow clock as &c in {
            borrow exec as &x in {
                borrow mut console as &!i in {
                    borrow mut memory as &!h in {
                        code = serve(h, i, f, c, x);
                    }
                }
            }
        }
    }
    release(fs);
    release(clock);
    release(exec);
    release(console);
    release(memory);
    return code;
}
