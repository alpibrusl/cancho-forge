edition 9;
module forge.company_state;

import std.buffer;
import std.bytes;
import std.json;
import std.map;
import std.option;
import forge.company_graph;
import forge.company_manifest;
import forge.event;
import forge.journal;
import forge.task;

// The company journal (docs/superpowers/specs/2026-10-27-forge-company-layer-design.md, section 4.3): the events a company run
// writes, and the replay of them into what the run knows. The file is `company.journal` in the company directory, one JSON object
// per line, framed by `event.record` (v, seq, kind, task) and read by the task journal's own rules (src/journal.cho): bytes after
// the last newline are a torn tail, which recovery may cut (`journal.recovery_cut` on `report`) and which replay does not read; a
// COMPLETE line that is not the next record (not JSON, wrong `v`, `seq` not exactly next) is `journal-corrupt` and replay stops
// there. Pure: its rows are `[heap]` at most, so it opens no file; the append wrapper is a later task's.
//
// The kinds, and what each carries beyond the four fixed fields (`task` is the step id, except for `company.gate.decided`, where
// it is the gate name):
//
//   company.step.admitted       forge_task   the id of the Forge task the step became
//   company.step.accepted       artifact, sha256   Forge's own check passed against the artifact it hashed
//   company.step.check_failed   score, total       the check ran and did not pass
//   company.gate.decided        gate, verdict (approved | rejected), user, reason
//   company.spend.recorded      input, output, cache_write, cache_read   tokens one call used
//
// Replay keeps: which steps are accepted (by step number in the manifest, the shape `company_graph.ready` reads), the last
// decision of each gate (0 open, 1 approved, 2 rejected; the last record wins), how many times each step id was admitted, and the
// total tokens spent per class. A kind this build does not know is passed over, as the task journal does for the kinds it only
// records, so a later build can add some. A known kind whose fields are not the ones above is `event-malformed`.

pub res struct CompanyState {
    accepted: Box[[bool]],
    spend: Box[[int]],
    gates: map.Map[int],
    admitted: map.Map[int],
    report: journal.Report,
}

pub fn kind_admitted() -> [] &static [byte] {
    return "company.step.admitted";
}

pub fn kind_accepted() -> [] &static [byte] {
    return "company.step.accepted";
}

pub fn kind_check_failed() -> [] &static [byte] {
    return "company.step.check_failed";
}

pub fn kind_gate_decided() -> [] &static [byte] {
    return "company.gate.decided";
}

pub fn kind_spend_recorded() -> [] &static [byte] {
    return "company.spend.recorded";
}

// ---- the event builders ---------------------------------------------------------------------------------------------------

// The fixed fields, the object still open.
fn opened[&h, &k, &t](heap: &!h Heap, seq: int, kind: &k [byte], name: &t [byte]) -> [heap] json.Writer {
    var w = json.writer(heap, 192);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "v");
    w = json.put_int(heap, w, event.schema_version());
    w = json.put_key(heap, w, "seq");
    w = json.put_int(heap, w, seq);
    w = json.put_key(heap, w, "kind");
    w = json.put_string(heap, w, kind);
    w = json.put_key(heap, w, "task");
    return json.put_string(heap, w, name);
}

fn closed[&h](heap: &!h Heap, w: json.Writer) -> [heap] buffer.Buffer {
    let done = json.end_object(heap, w);
    return buffer.push(heap, json.finish(done), byte_of(10));
}

// Step `step` became the Forge task `task_id`.
pub fn admitted[&h, &s, &t](heap: &!h Heap, seq: int, step: &s [byte], task_id: &t [byte]) -> [heap] buffer.Buffer {
    var w = opened(heap, seq, kind_admitted(), step);
    w = json.put_key(heap, w, "forge_task");
    w = json.put_string(heap, w, task_id);
    return closed(heap, w);
}

// Step `step` passed Forge's check against the artifact at `artifact`, whose SHA-256 Forge computed.
pub fn accepted[&h, &s, &a, &x](heap: &!h Heap, seq: int, step: &s [byte], artifact: &a [byte], sha256: &x [byte]) -> [heap] buffer.Buffer {
    var w = opened(heap, seq, kind_accepted(), step);
    w = json.put_key(heap, w, "artifact");
    w = json.put_string(heap, w, artifact);
    w = json.put_key(heap, w, "sha256");
    w = json.put_string(heap, w, sha256);
    return closed(heap, w);
}

// Step `step`'s check ran and scored `score` of `total`.
pub fn check_failed[&h, &s](heap: &!h Heap, seq: int, step: &s [byte], score: int, total: int) -> [heap] buffer.Buffer {
    var w = opened(heap, seq, kind_check_failed(), step);
    w = json.put_key(heap, w, "score");
    w = json.put_int(heap, w, score);
    w = json.put_key(heap, w, "total");
    w = json.put_int(heap, w, total);
    return closed(heap, w);
}

// `user` decided `gate`: `verdict` is "approved" or "rejected" (anything else is refused on replay).
pub fn gate_decided[&h, &g, &v, &u, &r](heap: &!h Heap, seq: int, gate: &g [byte], verdict: &v [byte], user: &u [byte], reason: &r [byte]) -> [heap] buffer.Buffer {
    var w = opened(heap, seq, kind_gate_decided(), gate);
    w = json.put_key(heap, w, "gate");
    w = json.put_string(heap, w, gate);
    w = json.put_key(heap, w, "verdict");
    w = json.put_string(heap, w, verdict);
    w = json.put_key(heap, w, "user");
    w = json.put_string(heap, w, user);
    w = json.put_key(heap, w, "reason");
    w = json.put_string(heap, w, reason);
    return closed(heap, w);
}

// One call of step `step` used these tokens.
pub fn spend_recorded[&h, &s](heap: &!h Heap, seq: int, step: &s [byte], input: int, output: int, cache_write: int, cache_read: int) -> [heap] buffer.Buffer {
    var w = opened(heap, seq, kind_spend_recorded(), step);
    w = json.put_key(heap, w, "input");
    w = json.put_int(heap, w, input);
    w = json.put_key(heap, w, "output");
    w = json.put_int(heap, w, output);
    w = json.put_key(heap, w, "cache_write");
    w = json.put_int(heap, w, cache_write);
    w = json.put_key(heap, w, "cache_read");
    w = json.put_int(heap, w, cache_read);
    return closed(heap, w);
}

// ---- replay ---------------------------------------------------------------------------------------------------------------

// One count never passes this, and a total saturates at it, so no sum of journal numbers can overflow.
fn cap() -> [] int {
    return 1000000000000000;
}

fn spend_ok[&t](tp: &t [int], node: int) -> [] bool {
    return json.is_int(tp, node);
}

fn clamp_add(total: int, n: int) -> [] int {
    if n > cap() - total {
        return cap();
    }
    return total + n;
}

// Read one spend field: its value, or -1 when it is absent, not an integer, negative or over the cap.
fn field[&s, &t, &n](src: &s [byte], tp: &t [int], obj: int, name: &n [byte]) -> [] int {
    let node = json.get(src, tp, obj, name);
    if node < 0 || spend_ok(tp, node) == false {
        return 0 - 1;
    }
    if json.fits_int(src, tp, node) == false {
        return 0 - 1;
    }
    let n = json.to_int(src, tp, node);
    if n < 0 || n > cap() {
        return 0 - 1;
    }
    return n;
}

// Apply one complete line (no newline) that must carry `expect` as its `seq`. Answers the two maps and 0, or a rule code.
fn apply[&h, &l, &m, &a, &s](heap: &!h Heap, line: &l [byte], expect: int, man: &m company_manifest.Manifest, accepted: &!a [bool], spend: &!s [int], gates: map.Map[int], admitted: map.Map[int]) -> [heap] (map.Map[int], map.Map[int], int) {
    var gs = gates;
    var ad = admitted;
    var rule = 0;
    let tape = box_slice(heap, json.tape_len(line), 0);
    borrow mut tape as &!tw in {
        let tp = contents(tw);
        if json.parse(line, tp) > 0 && json.is_object(tp, 0) {
            let version = json.get(line, tp, 0, "v");
            let seqn = json.get(line, tp, 0, "seq");
            let kindn = json.get(line, tp, 0, "kind");
            let taskn = json.get(line, tp, 0, "task");
            let shaped = json.is_int(tp, version) && json.is_int(tp, seqn) && json.is_string(tp, kindn);
            if shaped == false || json.to_int(line, tp, version) != event.schema_version() || json.to_int(line, tp, seqn) != expect {
                rule = task.rule_code(task.Rule::JournalCorrupt);
            } else {
                let kind = json.string_view(line, tp, kindn);
                let named = json.is_string(tp, taskn);
                let id = json.string_view(line, tp, taskn);
                let bad = task.rule_code(task.Rule::EventMalformed);
                if bytes.equal(kind, kind_admitted()) {
                    let forge_task = json.get(line, tp, 0, "forge_task");
                    if named == false || json.is_string(tp, forge_task) == false {
                        rule = bad;
                    } else {
                        var seen = 0;
                        borrow ad as &ab in {
                            seen = map.get(ab, id, 0);
                        }
                        ad = map.put(heap, ad, id, seen + 1);
                    }
                } else if bytes.equal(kind, kind_accepted()) {
                    let artifact = json.get(line, tp, 0, "artifact");
                    let sha = json.get(line, tp, 0, "sha256");
                    if named == false || json.is_string(tp, artifact) == false || json.is_string(tp, sha) == false {
                        rule = bad;
                    } else {
                        let at = company_graph.index_of(man, id);
                        if at >= 0 && at < len(accepted) {
                            accepted[at] = true;
                        }
                    }
                } else if bytes.equal(kind, kind_check_failed()) {
                    if named == false || field(line, tp, 0, "score") < 0 || field(line, tp, 0, "total") < 0 {
                        rule = bad;
                    }
                } else if bytes.equal(kind, kind_gate_decided()) {
                    let gate = json.get(line, tp, 0, "gate");
                    let verdict = json.get(line, tp, 0, "verdict");
                    let user = json.get(line, tp, 0, "user");
                    let reason = json.get(line, tp, 0, "reason");
                    let strings = json.is_string(tp, gate) && json.is_string(tp, verdict) && json.is_string(tp, user) && json.is_string(tp, reason);
                    if strings == false {
                        rule = bad;
                    } else if json.string_equals(line, tp, verdict, "approved") {
                        gs = map.put(heap, gs, json.string_view(line, tp, gate), 1);
                    } else if json.string_equals(line, tp, verdict, "rejected") {
                        gs = map.put(heap, gs, json.string_view(line, tp, gate), 2);
                    } else {
                        rule = bad;
                    }
                } else if bytes.equal(kind, kind_spend_recorded()) {
                    let a = field(line, tp, 0, "input");
                    let b = field(line, tp, 0, "output");
                    let c = field(line, tp, 0, "cache_write");
                    let d = field(line, tp, 0, "cache_read");
                    if named == false || a < 0 || b < 0 || c < 0 || d < 0 {
                        rule = bad;
                    } else {
                        spend[0] = clamp_add(spend[0], a);
                        spend[1] = clamp_add(spend[1], b);
                        spend[2] = clamp_add(spend[2], c);
                        spend[3] = clamp_add(spend[3], d);
                    }
                }
            }
        } else {
            rule = task.rule_code(task.Rule::JournalCorrupt);
        }
    }
    unbox_slice(heap, tape);
    return (gs, ad, rule);
}

// Replay `journal_text`, the whole company journal, against manifest `m` (whose steps number the accepted flags). A torn tail is
// not read and is counted in `report.torn_bytes`; on a refusal the state holds what replayed before the failing line, and
// `report.rule` / `report.line` say which. End the state with `drop`.
pub fn replay[&h, &t, &m](heap: &!h Heap, journal_text: &t [byte], m: &m company_manifest.Manifest) -> [heap] CompanyState {
    var steps = company_manifest.step_count(m);
    if steps < 1 {
        steps = 1;
    }
    let accepted = box_slice(heap, steps, false);
    let spend = box_slice(heap, 4, 0);
    var gates = map.empty(heap, 16, 0, 0);
    var admitted = map.empty(heap, 16, 0, 0);
    var records = 0;
    var good = 0;
    var start = 0;
    var rule = 0;
    var bad_line = 0;
    var k = 0;
    borrow mut accepted as &!aw in {
        borrow mut spend as &!sw in {
            let acc = contents(aw);
            let sp = contents(sw);
            while k < len(journal_text) && rule == 0 {
                if int_of(journal_text[k]) == 10 {
                    let (g, a, r) = apply(heap, journal_text[start..k], records + 1, m, acc, sp, gates, admitted);
                    gates = g;
                    admitted = a;
                    if r == 0 {
                        records = records + 1;
                        good = k + 1;
                    } else {
                        rule = r;
                        bad_line = records + 1;
                    }
                    start = k + 1;
                }
                k = k + 1;
            }
        }
    }
    let torn = len(journal_text) - journal.after_last_newline(journal_text);
    let report = journal.Report { records: records, valid_bytes: good, total_bytes: len(journal_text), torn_bytes: torn, tasks: 0, rule: rule, line: bad_line };
    return CompanyState { accepted: accepted, spend: spend, gates: gates, admitted: admitted, report: report };
}

pub fn drop[&h](heap: &!h Heap, s: CompanyState) -> [heap] int {
    let CompanyState { accepted, spend, gates, admitted, report } = s;
    unbox_slice(heap, accepted);
    unbox_slice(heap, spend);
    map.drop(heap, gates);
    map.drop(heap, admitted);
    return 0;
}

// ---- reading a replayed state ---------------------------------------------------------------------------------------------

// What the replay found of the file itself: records read, bytes valid and torn, and the refusal (`rule`, `line`) if one ended it.
// `journal.recovery_cut` takes it.
pub fn report_of[&s](s: &s CompanyState) -> [] journal.Report {
    return s.report;
}

// The accepted flags, one per step of the manifest, in step order: what `company_graph.ready` takes.
pub fn accepted_flags[&s](s: &s CompanyState) -> [] &s [bool] {
    return contents(s.accepted);
}

// Is step number `i` accepted? An `i` outside the manifest is not.
pub fn accepted_at[&s](s: &s CompanyState, i: int) -> [] bool {
    if i < 0 || i >= len(contents(s.accepted)) {
        return false;
    }
    return contents(s.accepted)[i];
}

// 0 the gate is open (no decision), 1 approved, 2 rejected; the last decision wins.
pub fn gate_state[&g, &s](s: &s CompanyState, gate: &g [byte]) -> [] int {
    return map.get(s.gates, gate, 0);
}

// How many times step `step` was admitted (the resume assertion: an accepted step is not admitted again).
pub fn admitted_count[&i, &s](s: &s CompanyState, step: &i [byte]) -> [] int {
    return map.get(s.admitted, step, 0);
}

pub fn spend_input[&s](s: &s CompanyState) -> [] int {
    return contents(s.spend)[0];
}

pub fn spend_output[&s](s: &s CompanyState) -> [] int {
    return contents(s.spend)[1];
}

pub fn spend_cache_write[&s](s: &s CompanyState) -> [] int {
    return contents(s.spend)[2];
}

pub fn spend_cache_read[&s](s: &s CompanyState) -> [] int {
    return contents(s.spend)[3];
}

// ---- human gates ----------------------------------------------------------------------------------------------------------

// Does the human gate of step number `step` keep it from running? 0 free (no gate, an approved gate, or a step outside the
// manifest), 1 the gate is open (`gate-open`, no decision yet), 2 the gate was rejected (`gate-rejected`; the last decision wins).
// A step that needs a rejected-gated step is not blocked by it directly: it is not ready because that step is not accepted.
pub fn step_blocked_by_gate[&m, &s](m: &m company_manifest.Manifest, s: &s CompanyState, step: int) -> [] int {
    if step < 0 || step >= company_manifest.step_count(m) {
        return 0;
    }
    let gate = company_manifest.step_gate(m, company_manifest.step_at(m, step));
    if len(gate) == 0 {
        return 0;
    }
    let g = gate_state(s, gate);
    if g == 0 {
        return 1;
    }
    if g == 2 {
        return 2;
    }
    return 0;
}

// The number of the first step that may run now: not accepted, every need accepted, and not blocked by its gate. A step whose gate is
// open or rejected is skipped, and so is everything behind it (its dependents are not ready, `company_graph.ready`). None when there
// is no such step.
pub fn next_runnable[&m, &s](m: &m company_manifest.Manifest, s: &s CompanyState) -> [] option.Option[int] {
    let n = company_manifest.step_count(m);
    var i = 0;
    while i < n {
        if accepted_at(s, i) == false && step_blocked_by_gate(m, s, i) == 0 {
            let step = company_manifest.step_at(m, i);
            let k = company_manifest.step_needs_count(m, step);
            var met = true;
            var j = 0;
            while j < k {
                let at = company_graph.index_of(m, company_manifest.step_need(m, step, j));
                if at < 0 || accepted_at(s, at) == false {
                    met = false;
                }
                j = j + 1;
            }
            if met {
                return option.Option::Some(i);
            }
        }
        i = i + 1;
    }
    return option.Option::None;
}
