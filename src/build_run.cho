edition 9;
module forge.build_run;

import std.buffer;
import std.bytes;
import std.json;
import std.map;
import std.option;
import forge.await_run;
import forge.build_task;
import forge.dispatch;
import forge.event;
import forge.flow;
import forge.gate_run;
import forge.journal;
import forge.journal_io;
import forge.retry;
import forge.task;
import forge.worker;

// The second dispatched task (issue #34; docs/cancho-code-adapter.md section 10): a `project.build` run by the Cancho Code
// adapter, taken from nothing to a state in the journal, the way `forge.gate_run` takes a gate:
//
//   task.proposed, task.approved   (human: the operator who ran the command)
//   the task is checked            (forge.build_task: type, brief, paths, limits, then the operator's configuration; a
//                                   refusal is a `refusal` record and the task stays `approved`)
//   task.ready, task.running       (forge)
//   execution.started              (forge: the intent, written before the worker is started)
//   the adapter is started         (forge.worker.execute: a real child process, a deadline, an output cap, the evidence
//                                   recomputed against the files, a symlink not followed)
//   a refusal record               (when the ending is a refusal: its rule tag)
//   execution.finished             (worker, basis "claimed": the verdict of build.json, when the run succeeded)
//   task.verification | blocked    (forge: forge.flow.target_of)
//
// What is shared with `forge.gate_run` is the writing of those records (`move_to`, `note`, `note_execution`, `note_retry`,
// `request_id_of`, `succeeded`: one function each, used by both). What is not is the loop around them, because each thing it
// decides differs: the checks, the id, the request (the operator's configuration, not a repository), the claim (`build.json`,
// not `report.json`), and the retry policy.
//
// **A build is a task that writes, so it is never retried by itself** (`forge.retry`: `retry-write-refused`). A
// `provider-error` (the adapter's one `retryable: true` ending) ends the task `blocked` with that tag, and the operator runs
// `forge build` again on the same execution directory, which resumes the build (worker-contract 9.4): a new task, the same
// work. The reason is money: every attempt spends a model's tokens, and the decision to spend more is not Forge's.
//
// The verdict is a CLAIM. Nothing in this file moves a task to `accepted`, and nothing could.
//
// The journal is written with the single-writer lock held by the caller; one record at a time, synced.

// What a run of the task came to.
pub enum Outcome {
    // Refused before anything ran, by `forge.build_task`: the task stays `approved`.
    Refused(build_task.Refusal),
    // The journal is not usable (a rule code of `forge.task`, from the replay at start) or could not be written (-1).
    Journal(int),
    // The run ended. The ending, and the claimed verdict of `build.json` (`build_task.verdict_id`; 0 none).
    Ended(dispatch.Ending, int),
}

pub struct Finished {
    outcome: Outcome,
    // `task.state_code` of the task in the journal at the end (0: it never got that far).
    state: int,
    // The number the task was given, 0 when the journal was not usable.
    number: int,
    // How many records the journal holds at the end.
    records: int,
    // How many times the worker was started for the task (0: it never was).
    attempts: int,
    // A signal the caller claimed asked the run to stop while the build ran: the build was cancelled (task 9).
    stopped: bool,
}

// The brief file the operator named, read up to the brief's limit: its bytes and 0, or an errno (the file is not there, a
// directory, unreadable), or -3 for a file over 16 KiB (the buffer then holds the first 16 KiB). A file of exactly 16 KiB is
// taken.
// `path` must have passed `journal_io.path_ok`. An empty file is read as empty and refused later, as `input-invalid`.
pub fn read_brief[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte]) -> [heap, fs_read(""), file_read] (buffer.Buffer, int) {
    var data = buffer.empty(heap, 256);
    match open_read(fs, path) {
        Opened::Failed(e) => {
            return (data, e);
        }
        Opened::Ok(opened) => {
            var file = opened;
            var errno = 0;
            borrow mut file as &!x in {
                let (got, e) = journal_io.drain(heap, x, data, build_task.max_brief_bytes());
                data = got;
                errno = e;
            }
            file_close(file);
            return (data, errno);
        }
    }
}

// The verdict `build.json` carries, as `build_task.verdict_id` numbers it, read after the evidence was recomputed, so the file
// is the one the reply described (a link in its place would have been refused, `evidence_io`).
fn claimed_verdict[&h, &f, &d](heap: &!h Heap, fs: &f Fs(""), execution_dir: &d [byte]) -> [heap, fs_read(""), file_read] int {
    let path = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), execution_dir), "/build.json");
    var code = 0;
    borrow path as &pb in {
        let (data, errno) = journal_io.read_all(heap, fs, buffer.bytes(pb));
        if errno == 0 {
            borrow data as &db in {
                let src = buffer.bytes(db);
                let tape = box_slice(heap, json.tape_len(src), 0);
                borrow mut tape as &!t in {
                    let tp = contents(t);
                    if json.parse(src, tp) > 0 && json.is_object(tp, 0) {
                        let v = json.get(src, tp, 0, "verdict");
                        if v >= 0 && json.is_string(tp, v) && json.string_plain(tp, v) {
                            code = build_task.verdict_id(json.string_view(src, tp, v));
                        }
                    }
                }
                unbox_slice(heap, tape);
            }
        }
        buffer.drop(heap, data);
    }
    buffer.drop(heap, path);
    return code;
}

// The claimed verdict of the run that ended with `e`: 0 unless it was a `succeeded` reply.
pub fn claimed_of[&h, &f, &d](heap: &!h Heap, fs: &f Fs(""), e: dispatch.Ending, execution_dir: &d [byte]) -> [heap, fs_read(""), file_read] int {
    if gate_run.succeeded(e) {
        return claimed_verdict(heap, fs, execution_dir);
    }
    return 0;
}

// The `execution.finished` of a `succeeded` run, written with the verdict it claimed; nothing for any other ending.
pub fn finish_attempt[&h, &f, &p, &i, &d](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], seq: int, id: &i [byte], e: dispatch.Ending, execution_dir: &d [byte]) -> [heap, fs_read(""), fs_write(""), file_read, file_write] int {
    if gate_run.succeeded(e) {
        return gate_run.note_execution(heap, fs, path, seq, "execution.finished", id, build_task.verdict_name(claimed_verdict(heap, fs, execution_dir)));
    }
    return seq;
}

// How often a run that was accepted is asked whether it is done: once a second (each ask is a process start).
pub fn poll_interval_ms() -> [] int {
    return 1000;
}

// Run the task. `journal_path` is the journal of the workspace (the caller holds the lock); `workers` is the directory
// holding `cancho_code`; `tools` is the operator's directory holding `cancho-build`; `brief` is the brief's text;
// `execution_dir` an existing directory for the build (the work directory of the tool, and where the evidence is); the rest
// is the operator's configuration. `timeout_ms` is Forge's deadline for the run.
pub fn run[&h, &f, &x, &w, &c, &j, &b, &e, &t, &y, &k, &g, &p, &m, &a, &s](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), workers: &w Dir, clock: &c Clock, journal_path: &j [byte], brief: &b [byte], execution_dir: &e [byte], tools_dir: &t [byte], workers_dir: &y [byte], checker: &k [byte], guide: &g [byte], provider: &p [byte], model: &m [byte], agent: &a [byte], attempts_ceiling: int, agent_seconds: int, rounds: int, plan_seconds: int, jobs: int, timeout_ms: int, stop: &!s option.Option[SignalWatch]) -> [heap, fs_read(""), fs_write(""), dir_read, file_read, file_write, exec_under, clock, poll, signals_read] Finished {
    let (existing, report, recovered) = journal_io.recover(heap, fs, journal_path);
    if report.rule != 0 || recovered.errno != 0 {
        map.drop(heap, existing);
        var rule = report.rule;
        if rule == 0 {
            rule = 0 - 1;
        }
        return Finished { outcome: Outcome::Journal(rule), state: 0, number: 0, records: report.records, attempts: 0, stopped: false };
    }
    let id = build_task.task_id(heap, report.tasks + 1);
    var state = 0;
    var records = report.records;
    var attempts = 0;
    var outcome = Outcome::Journal(0 - 1);
    var stopped = false;
    borrow id as &ib in {
        let tid = buffer.bytes(ib);
        let fresh = report.records == 0;
        var seq = report.records + 1;
        var tasks = existing;
        let (t1, s1) = gate_run.move_to(heap, fs, journal_path, tasks, seq, tid, task.State::Proposed, task.Actor::Human, fresh);
        let (t2, s2) = gate_run.move_to(heap, fs, journal_path, t1, s1, tid, task.State::Approved, task.Actor::Human, false);
        tasks = t2;
        seq = s2;
        var checked = build_task.check(build_task.task_type(), brief, execution_dir, tools_dir, timeout_ms);
        match checked {
            build_task.Checked::Held => {
                checked = build_task.operator_checked(checker, guide, provider, model, agent, attempts_ceiling, agent_seconds, rounds, plan_seconds, jobs);
            }
            build_task.Checked::Refused(why) => {
            }
        }
        match checked {
            build_task.Checked::Refused(why) => {
                seq = gate_run.note(heap, fs, journal_path, seq, tid, build_task.rule_name(why), false);
                outcome = Outcome::Refused(why);
            }
            build_task.Checked::Held => {
                let (t3, s3) = gate_run.move_to(heap, fs, journal_path, tasks, seq, tid, task.State::Ready, task.Actor::Forge, false);
                let (t4, s4) = gate_run.move_to(heap, fs, journal_path, t3, s3, tid, task.State::Running, task.Actor::Forge, false);
                tasks = t4;
                seq = gate_run.note_execution(heap, fs, journal_path, s4, "execution.started", tid, "");
                if seq < 0 {
                    outcome = Outcome::Journal(0 - 1);
                } else {
                    // One attempt only: a build writes, and `forge.retry` refuses to retry a task that writes. The loop of
                    // the gate is a loop because a read-only task may be started again; this one is started once, and the
                    // decision is still asked of `forge.retry` so that the policy is one function, not a copy of it here.
                    attempts = attempts + 1;
                    let request_id = gate_run.request_id_of(heap, tid, attempts);
                    borrow request_id as &rb in {
                        let req = build_task.request(heap, buffer.bytes(rb), attempts, tid, brief, timeout_ms, 1048576, execution_dir, tools_dir, workers_dir, checker, guide, provider, model, agent, attempts_ceiling, agent_seconds, rounds, plan_seconds, jobs);
                        borrow req as &qb in {
                            let began = clock_ms(clock);
                            var ending = worker.execute(heap, exec, workers, fs, clock, "cancho_code", buffer.bytes(qb), buffer.bytes(rb), tid, execution_dir, 1048576, timeout_ms, true);
                            if dispatch.accepted(ending) {
                                // The worker took the job and the build goes on elsewhere (docs/async-level.md): write down what a
                                // later Forge needs to ask about it, then wait for it. Forge's deadline is the total of the run.
                                seq = gate_run.note_accepted(heap, fs, journal_path, seq, tid, buffer.bytes(rb), execution_dir);
                                if seq >= 0 {
                                    var left = timeout_ms - (clock_ms(clock) - began);
                                    if left < 1000 {
                                        left = 1000;
                                    }
                                    let (got, asked) = await_run.finish_or_stop(heap, exec, workers, fs, clock, "cancho_code", buffer.bytes(rb), tid, execution_dir, left, poll_interval_ms(), stop);
                                    ending = got;
                                    stopped = asked;
                                }
                            }
                            let consequence = dispatch.consequence(ending);
                            let decision = retry.decide(consequence, attempts, false);
                            let tag = dispatch.rule_tag(ending);
                            if len(tag) > 0 {
                                seq = gate_run.note(heap, fs, journal_path, seq, tid, tag, false);
                            }
                            let again = retry.rule_tag(decision);
                            if len(again) > 0 {
                                seq = gate_run.note(heap, fs, journal_path, seq, tid, again, false);
                            }
                            seq = finish_attempt(heap, fs, journal_path, seq, tid, ending, execution_dir);
                            if bytes.equal(dispatch.consequence_name(consequence), "cancelled") {
                                seq = gate_run.note_execution(heap, fs, journal_path, seq, "execution.cancelled", tid, "");
                            }
                            let (t5, s5) = gate_run.move_to(heap, fs, journal_path, tasks, seq, tid, retry.target_after(consequence, decision), task.Actor::Forge, false);
                            tasks = t5;
                            seq = s5;
                            outcome = Outcome::Ended(ending, claimed_of(heap, fs, ending, execution_dir));
                        }
                        buffer.drop(heap, req);
                    }
                    buffer.drop(heap, request_id);
                }
            }
        }
        if seq < 0 {
            outcome = Outcome::Journal(0 - 1);
        }
        borrow tasks as &tb in {
            state = journal.state_of(tb, tid);
        }
        map.drop(heap, tasks);
        records = seq - 1;
    }
    buffer.drop(heap, id);
    return Finished { outcome: outcome, state: state, number: report.tasks + 1, records: records, attempts: attempts, stopped: stopped };
}
