edition 9;
module forge.step_run;

import std.buffer;
import std.io;
import std.option;
import forge.build_run;
import forge.build_task;
import forge.dispatch;
import forge.gate_run;
import forge.gate_task;
import forge.journal_io;
import forge.lock;
import forge.retry;
import forge.task;

// One run of a worker task, taken out of `forge gate` and `forge build` (src/main.cho) so that something other than a command line
// can start it: `forge company run` (docs/superpowers/specs/2026-10-27-forge-company-layer-design.md, section 4.3) runs each
// step of a company as the same build or gate, with a different caller and nothing else. The body is what `forge gate` and
// `forge build` did after they read their arguments, unchanged: the same refusals, the same lock, the same printing and exit status
// (the head of src/main.cho describes both). The rows are theirs less `args`: the caller reads the arguments, this module reads none.
//
// A spec holds the numbers of a run. The texts of a run (paths, revision, provider, ...) are passed beside it as slices, because a
// struct cannot be generic in a region and a field cannot be `[T]`.

// What `forge gate` takes besides its texts: the deadline of the run, in milliseconds (900000 by default).
pub struct GateSpec {
    timeout: int,
}

// What `forge build` takes besides its texts: the deadline of the run in milliseconds and the tool's ceilings.
pub struct BuildSpec {
    timeout: int,
    attempts: int,
    agent_seconds: int,
    rounds: int,
    plan_seconds: int,
    jobs: int,
}

// The defaults of `forge gate`: a deadline of 900000 ms.
pub fn gate_spec() -> [] GateSpec {
    return GateSpec { timeout: 900000 };
}

// The defaults of `forge build`: a deadline of 3600000 ms, `attempts` 4, `agent_seconds` 30, `rounds` 3, `plan_seconds` 900, `jobs` 4.
pub fn build_spec() -> [] BuildSpec {
    return BuildSpec { timeout: 3600000, attempts: 4, agent_seconds: 30, rounds: 3, plan_seconds: 900, jobs: 4 };
}

fn concat[&h, &d, &n](heap: &!h Heap, dir: &d [byte], name: &n [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 64), dir);
    return buffer.append(heap, b, name);
}

fn line[&i, &l, &v](io: &!i Io, label: &l [byte], value: &v [byte]) -> [io_write] int {
    io.write_all(io, label);
    io.write_all(io, value);
    io.newline(io);
    return 0;
}

// What a run of `forge gate` came to, printed, and the exit status (see the head of this file).
fn show_gate[&h, &i, &r](heap: &!h Heap, io: &!i Io, revision: &r [byte], done: gate_run.Finished) -> [heap, io_write, err_write] int {
    var code = 4;
    var id = gate_run.task_id(heap, revision, done.number);
    borrow id as &ib in {
        if done.number > 0 {
            line(io, "task: ", buffer.bytes(ib));
            line(io, "state: ", task.code_name(done.state));
        }
        match done.outcome {
            gate_run.Outcome::Journal(rule) => {
                if rule > 0 {
                    io.error_all(io, "forge: the journal is refused: ");
                    io.error_all(io, task.rule_code_name(rule));
                    io.error_all(io, "\n");
                    code = 1;
                } else {
                    io.error_all(io, "forge: the journal cannot be read or written\n");
                    code = 3;
                }
            }
            gate_run.Outcome::Refused(why) => {
                line(io, "refused: ", gate_task.rule_name(why));
                code = 1;
            }
            gate_run.Outcome::Ended(ending, claim) => {
                let tag = dispatch.rule_tag(ending);
                if len(tag) > 0 {
                    line(io, "refusal: ", tag);
                }
                line(io, "ending: ", dispatch.consequence_name(dispatch.consequence(ending)));
                if done.attempts > 1 {
                    io.write_all(io, "attempts: ");
                    var n = buffer.push_nat(heap, buffer.empty(heap, 4), done.attempts);
                    borrow n as &nb in {
                        io.write_all(io, buffer.bytes(nb));
                    }
                    buffer.drop(heap, n);
                    io.newline(io);
                }
                let again = retry.rule_tag(retry.decide(dispatch.consequence(ending), done.attempts, true));
                if len(again) > 0 {
                    line(io, "refusal: ", again);
                }
                if claim > 0 {
                    line(io, "claimed verdict: ", gate_run.verdict_name(claim));
                    io.write_all(io, "(a worker's claim: the task is in verification, not accepted)\n");
                    code = 0;
                }
            }
        }
    }
    buffer.drop(heap, id);
    return code;
}

// What a run of `forge build` came to, printed, and the exit status (see the head of this file).
fn show_build[&h, &i](heap: &!h Heap, io: &!i Io, done: build_run.Finished) -> [heap, io_write, err_write] int {
    var code = 4;
    var id = build_task.task_id(heap, done.number);
    borrow id as &ib in {
        if done.number > 0 {
            line(io, "task: ", buffer.bytes(ib));
            line(io, "state: ", task.code_name(done.state));
        }
        match done.outcome {
            build_run.Outcome::Journal(rule) => {
                if rule > 0 {
                    io.error_all(io, "forge: the journal is refused: ");
                    io.error_all(io, task.rule_code_name(rule));
                    io.error_all(io, "\n");
                    code = 1;
                } else {
                    io.error_all(io, "forge: the journal cannot be read or written\n");
                    code = 3;
                }
            }
            build_run.Outcome::Refused(why) => {
                line(io, "refused: ", build_task.rule_name(why));
                code = 1;
            }
            build_run.Outcome::Ended(ending, claim) => {
                let tag = dispatch.rule_tag(ending);
                if len(tag) > 0 {
                    line(io, "refusal: ", tag);
                }
                line(io, "ending: ", dispatch.consequence_name(dispatch.consequence(ending)));
                let again = retry.rule_tag(retry.decide(dispatch.consequence(ending), done.attempts, false));
                if len(again) > 0 {
                    line(io, "refusal: ", again);
                }
                if claim > 0 {
                    line(io, "claimed verdict: ", build_task.verdict_name(claim));
                    io.write_all(io, "(a worker's claim: the task is in verification, not accepted)\n");
                    code = 0;
                }
            }
        }
    }
    buffer.drop(heap, id);
    return code;
}

// `forge gate` after its arguments: report the gate of <repo> at <revision> (`env` is the text of the JSON array of the operator's
// `NAME=value` entries, or empty). Exit status as in the head of src/main.cho.
pub fn run_gate[&h, &f, &x, &c, &i, &d, &w, &r, &v, &k, &e, &n](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, spec: GateSpec, dir: &d [byte], workers: &w [byte], repo: &r [byte], revision: &v [byte], checkout: &k [byte], execution_dir: &e [byte], env: &n [byte]) -> [heap, exec_under, clock, poll, fs_read(""), fs_write(""), dir_read, file_read, file_write, io_write, err_write] int {
    let jpath = concat(heap, dir, "/journal.jsonl");
    let lpath = concat(heap, dir, "/lock");
    var code = 0;
    borrow jpath as &jb in {
        borrow lpath as &lb in {
            if journal_io.path_ok(fs, buffer.bytes(jb)) == false || journal_io.path_ok(fs, workers) == false {
                io.error_all(io, "forge: path-invalid: <dir> and <workers> must be absolute, with no .. component\n");
                code = 2;
            } else {
                match lock.acquire(fs, buffer.bytes(lb)) {
                    lock.Lock::Refused(rule) => {
                        io.error_all(io, "forge: ");
                        io.error_all(io, task.rule_code_name(rule));
                        io.error_all(io, ": the workspace cannot be written\n");
                        code = 3;
                    }
                    lock.Lock::Failed(errno) => {
                        io.error_all(io, "forge: the lock of the workspace could not be taken\n");
                        code = 3;
                    }
                    lock.Lock::Held(held) => {
                        match open_dir(fs, workers) {
                            DirOpened::Failed(errno) => {
                                io.error_all(io, "forge: cannot open the workers directory\n");
                                code = 3;
                            }
                            DirOpened::Ok(opened) => {
                                var wdir = opened;
                                borrow wdir as &w in {
                                    let done = gate_run.run(heap, fs, exec, w, clock, buffer.bytes(jb), repo, revision, checkout, execution_dir, env, spec.timeout);
                                    code = show_gate(heap, io, revision, done);
                                }
                                dir_close(wdir);
                            }
                        }
                        lock.let_go(held);
                    }
                }
            }
        }
    }
    buffer.drop(heap, jpath);
    buffer.drop(heap, lpath);
    return code;
}

// `forge build` after its arguments: build from the brief file with the Cancho Code adapter (`guide` is the optional guide path, or
// empty). Exit status as in the head of src/main.cho, and whether a signal claimed in `stop` cancelled the build (`forge company
// run` claims one, task 9; `forge build` passes `None`).
pub fn run_build[&h, &f, &x, &c, &i, &d, &w, &t, &b, &e, &k, &p, &m, &a, &g, &q, &s](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, spec: BuildSpec, dir: &d [byte], workers: &w [byte], tools: &t [byte], brief_file: &b [byte], execution_dir: &e [byte], checker: &k [byte], provider: &p [byte], model: &m [byte], agent: &a [byte], guide: &g [byte], contract: &q [byte], stop: &!s option.Option[SignalWatch]) -> [heap, exec_under, clock, poll, fs_read(""), fs_write(""), dir_read, file_read, file_write, io_write, err_write, signals_read] (int, bool) {
    let jpath = concat(heap, dir, "/journal.jsonl");
    let lpath = concat(heap, dir, "/lock");
    var code = 0;
    var stopped = false;
    borrow jpath as &jb in {
        borrow lpath as &lb in {
            if journal_io.path_ok(fs, buffer.bytes(jb)) == false || journal_io.path_ok(fs, workers) == false || journal_io.path_ok(fs, brief_file) == false {
                io.error_all(io, "forge: path-invalid: <dir>, <workers> and <brief-file> must be absolute, with no .. component\n");
                code = 2;
            } else {
                let (brief, errno) = build_run.read_brief(heap, fs, brief_file);
                if errno != 0 {
                    io.error_all(io, "forge: ");
                    io.error_all(io, build_task.rule_name(build_task.Refusal::BriefUnreadable));
                    io.error_all(io, ": the brief file cannot be read, or is over 16 KiB; nothing was journalled\n");
                    code = 1;
                } else {
                    match lock.acquire(fs, buffer.bytes(lb)) {
                        lock.Lock::Refused(rule) => {
                            io.error_all(io, "forge: ");
                            io.error_all(io, task.rule_code_name(rule));
                            io.error_all(io, ": the workspace cannot be written\n");
                            code = 3;
                        }
                        lock.Lock::Failed(errno2) => {
                            io.error_all(io, "forge: the lock of the workspace could not be taken\n");
                            code = 3;
                        }
                        lock.Lock::Held(held) => {
                            match open_dir(fs, workers) {
                                DirOpened::Failed(errno3) => {
                                    io.error_all(io, "forge: cannot open the workers directory\n");
                                    code = 3;
                                }
                                DirOpened::Ok(opened) => {
                                    var wdir = opened;
                                    borrow wdir as &w in {
                                        borrow brief as &bb in {
                                            let done = build_run.run(heap, fs, exec, w, clock, buffer.bytes(jb), buffer.bytes(bb), execution_dir, tools, workers, checker, guide, contract, provider, model, agent, spec.attempts, spec.agent_seconds, spec.rounds, spec.plan_seconds, spec.jobs, spec.timeout, stop);
                                            stopped = done.stopped;
                                            code = show_build(heap, io, done);
                                        }
                                    }
                                    dir_close(wdir);
                                }
                            }
                            lock.let_go(held);
                        }
                    }
                }
                buffer.drop(heap, brief);
            }
        }
    }
    buffer.drop(heap, jpath);
    buffer.drop(heap, lpath);
    return (code, stopped);
}
