edition 9;
module forge.company_publish;

import std.buffer;
import std.bytes;
import std.crypto;
import std.dirs;
import std.io;
import std.json;
import std.process;
import forge.company_cmd;
import forge.company_files;
import forge.company_graph;
import forge.company_manifest;
import forge.company_state;
import forge.company_step;
import forge.journal_io;
import forge.lock;
import forge.publish_plan;
import forge.snapshot;
import forge.task;
import forge.worker;

// `forge company publish <company-dir> <operator-file> <step id> <branch>` (docs/company.md, section 15): put the artifact an ACCEPTED
// builder step left into a fresh branch of a checkout the operator named, with `docs/provenance.md` written from the company journal,
// committed locally; write the pull request's title and body to `steps/<id>/pr.md`; print them. It does not push and does not open the
// pull request: a seventh word `push` is `publish-push-not-granted`.
//
// The order of its checks is the order of its refusals, so a request with two faults is always refused for the same one: the branch
// name, the lock, the manifest, the step (is it accepted), the journal, the operator file and its `publish` entry for the step, the
// `files` map, the repository and the checkout, the artifact (recomputed, against the digest the journal recorded), and then the worker,
// which checks the checkout again (`publish-checkout-invalid`, `publish-checkout-dirty`, `publish-branch-exists`) before it touches it.
// Nothing is written in the company directory except `steps/<id>/pr.md`, and that only after the commit exists.
//
// The company directory is locked for the whole publish, as `decide` and `run` lock it. Authority: the rows the forge binary holds
// already (`worker.run` as the tool runner uses it, the artifact reader, the lock); the new worker has its own report
// (docs/authority-repo-publish.txt).

fn is_build(r: company_step.Runner) -> [] bool {
    match r {
        company_step.Runner::Build => {
            return true;
        }
        company_step.Runner::Gate => {
            return false;
        }
        company_step.Runner::Person => {
            return false;
        }
        company_step.Runner::Unsupported => {
            return false;
        }
        company_step.Runner::Tool => {
            return false;
        }
    }
}

fn worker_name() -> [] &static [byte] {
    return "repo_publish";
}

fn publish_deadline_ms() -> [] int {
    return 120000;
}

fn journal_cap() -> [] int {
    return 67108864;
}

fn hex_of[&h, &b](heap: &!h Heap, data: &b [byte]) -> [heap] buffer.Buffer {
    return snapshot.hex_digest(heap, data);
}

pub fn publish_cmd[&h, &f, &x, &c, &i, &g](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, args: &g Args) -> [args, heap, exec_under, clock, poll, fs_read(""), fs_write(""), dir_read, dir_write, file_read, file_write, io_write] int {
    if arg_count(args) != 7 && arg_count(args) != 8 {
        return company_step.exit_usage();
    }
    let dir = arg(args, 3);
    let opath = arg(args, 4);
    let step = arg(args, 5);
    let branch = arg(args, 6);
    let mpath = company_cmd.under(heap, dir, "company.json");
    let jpath = company_cmd.under(heap, dir, "company.journal");
    let lpath = company_cmd.under(heap, dir, "lock");
    var code = company_step.exit_refused();
    borrow mpath as &mp in {
        borrow jpath as &jp in {
            borrow lpath as &lp in {
                if journal_io.path_ok(fs, buffer.bytes(mp)) == false || journal_io.path_ok(fs, buffer.bytes(jp)) == false || journal_io.path_ok(fs, buffer.bytes(lp)) == false || journal_io.path_ok(fs, opath) == false {
                    company_cmd.refuse(io, task.rule_name(task.Rule::PathInvalid));
                    code = company_step.exit_usage();
                } else if arg_count(args) == 8 {
                    company_cmd.refuse(io, publish_plan.rule_push_not_granted());
                    company_cmd.line(io, "reason: ", "forge company publish only commits; pushing and opening the pull request are a person's act");
                } else if publish_plan.branch_ok(branch) == false {
                    company_cmd.refuse(io, publish_plan.rule_branch_invalid());
                } else if company_step.inside(dir, opath) {
                    company_cmd.refuse(io, "operator-invalid");
                    company_cmd.line(io, "reason: ", "the operator file is inside the company directory");
                } else {
                    match lock.acquire(fs, buffer.bytes(lp)) {
                        lock.Lock::Refused(rule) => {
                            company_cmd.refuse(io, task.rule_code_name(rule));
                        }
                        lock.Lock::Failed(errno) => {
                            company_cmd.line(io, "error: ", "cannot take the lock of the company directory");
                            code = company_step.exit_io();
                        }
                        lock.Lock::Held(held) => {
                            code = with_manifest(heap, fs, exec, clock, io, dir, buffer.bytes(mp), buffer.bytes(jp), opath, step, branch);
                            lock.let_go(held);
                        }
                    }
                }
            }
        }
    }
    buffer.drop(heap, mpath);
    buffer.drop(heap, jpath);
    buffer.drop(heap, lpath);
    return code;
}

fn with_manifest[&h, &f, &x, &c, &i, &d, &m, &j, &o, &s, &b](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, dir: &d [byte], mpath: &m [byte], jpath: &j [byte], opath: &o [byte], step: &s [byte], branch: &b [byte]) -> [heap, exec_under, clock, poll, fs_read(""), dir_read, dir_write, file_read, file_write, io_write] int {
    let (text, errno) = company_cmd.read_limited(heap, fs, mpath, company_manifest.max_bytes() + 1);
    var code = company_step.exit_refused();
    if errno != 0 {
        company_cmd.refuse(io, company_manifest.rule_name(company_manifest.Refusal::ManifestMalformed));
    } else {
        borrow text as &tb in {
            match company_manifest.parse(heap, buffer.bytes(tb)) {
                company_manifest.ManifestResult::Refused(why) => {
                    company_cmd.refuse(io, company_manifest.rule_name(why));
                }
                company_manifest.ManifestResult::Held(held) => {
                    borrow held as &hm in {
                        code = with_journal(heap, fs, exec, clock, io, hm, dir, jpath, opath, step, branch);
                    }
                    company_manifest.drop(heap, held);
                }
            }
        }
    }
    buffer.drop(heap, text);
    return code;
}

// The journal, replayed; the step must be accepted, and be a step that leaves an artifact (a builder or a writer).
fn with_journal[&h, &f, &x, &c, &i, &m, &d, &j, &o, &s, &b](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, hm: &m company_manifest.Manifest, dir: &d [byte], jpath: &j [byte], opath: &o [byte], step: &s [byte], branch: &b [byte]) -> [heap, exec_under, clock, poll, fs_read(""), dir_read, dir_write, file_read, file_write, io_write] int {
    let (journal, errno) = company_cmd.read_limited(heap, fs, jpath, journal_cap());
    var code = company_step.exit_refused();
    if errno != 0 {
        company_cmd.refuse(io, publish_plan.rule_journal_unreadable());
    } else {
        borrow journal as &jb in {
            let state = company_state.replay(heap, buffer.bytes(jb), hm);
            borrow state as &st in {
                let report = company_state.report_of(st);
                let at = company_graph.index_of(hm, step);
                if report.rule != 0 {
                    company_cmd.refuse(io, task.rule_code_name(report.rule));
                    company_cmd.line(io, "reason: ", "the company journal is refused; publish reads only a journal that replays");
                } else if at < 0 || company_state.accepted_at(st, at) == false {
                    company_cmd.refuse(io, publish_plan.rule_not_accepted());
                } else if is_build(company_step.runner_of(company_manifest.step_at(hm, at).role)) == false {
                    company_cmd.refuse(io, publish_plan.rule_not_accepted());
                    company_cmd.line(io, "reason: ", "only a builder or writer step leaves an artifact to publish");
                } else {
                    code = with_operator(heap, fs, exec, clock, io, hm, st, buffer.bytes(jb), at, dir, opath, step, branch);
                }
            }
            company_state.drop(heap, state);
        }
    }
    buffer.drop(heap, journal);
    return code;
}

// The operator file: read, parsed, checked for its shape.
fn with_operator[&h, &f, &x, &c, &i, &m, &s, &j, &d, &o, &p, &b](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, hm: &m company_manifest.Manifest, st: &s company_state.CompanyState, journal: &j [byte], at: int, dir: &d [byte], opath: &o [byte], step: &p [byte], branch: &b [byte]) -> [heap, exec_under, clock, poll, fs_read(""), dir_read, dir_write, file_read, file_write, io_write] int {
    let (text, errno) = company_cmd.read_limited(heap, fs, opath, 65536);
    var code = company_step.exit_refused();
    if errno != 0 {
        company_cmd.refuse(io, "operator-invalid");
    } else {
        borrow text as &tb in {
            let src = buffer.bytes(tb);
            let tape = box_slice(heap, json.tape_len(src), 0);
            var parsed = false;
            borrow mut tape as &!tw in {
                parsed = json.parse(src, contents(tw)) > 0;
            }
            borrow tape as &tr in {
                let tp = contents(tr);
                if parsed == false || company_step.operator_ok(src, tp) == false {
                    company_cmd.refuse(io, "operator-invalid");
                } else {
                    code = with_entry(heap, fs, exec, clock, io, hm, st, journal, at, dir, src, tp, step, branch);
                }
            }
            unbox_slice(heap, tape);
        }
    }
    buffer.drop(heap, text);
    return code;
}

// The `publish` entry of the step: its repository and checkout, and where the artifact goes. The `files` map names the step's
// artifact and nothing else: Forge hashed that one, and publishes only what it hashed.
fn with_entry[&h, &f, &x, &c, &i, &m, &s, &j, &d, &o, &t, &p, &b](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, hm: &m company_manifest.Manifest, st: &s company_state.CompanyState, journal: &j [byte], at: int, dir: &d [byte], src: &o [byte], tp: &t [int], step: &p [byte], branch: &b [byte]) -> [heap, exec_under, clock, poll, fs_read(""), dir_read, dir_write, file_read, file_write, io_write] int {
    let repo = company_step.op_publish(src, tp, step, "repo");
    let checkout = company_step.op_publish(src, tp, step, "checkout");
    let files = company_step.op_publish_files(src, tp, step);
    let artifact = company_step.artifact_name(company_step.Runner::Build);
    if len(repo) == 0 || len(checkout) == 0 || files < 0 {
        company_cmd.refuse(io, publish_plan.rule_not_configured());
        return company_step.exit_refused();
    }
    var dest = src[0..0];
    var extra = false;
    let n = json.count(tp, files);
    var k = files + 1;
    var j = 0;
    while j < n {
        let name = json.string_view(src, tp, k);
        if bytes.equal(name, artifact) {
            dest = json.string_view(src, tp, k + 1);
        } else {
            extra = true;
        }
        k = json.skip(tp, k + 1);
        j = j + 1;
    }
    if len(dest) == 0 || extra {
        company_cmd.refuse(io, publish_plan.rule_file_unaccepted());
        company_cmd.line(io, "reason: ", "files may name only the step's accepted artifact");
        return company_step.exit_refused();
    }
    if publish_plan.dest_ok(dest) == false || bytes.equal(dest, publish_plan.provenance_dest()) {
        company_cmd.refuse(io, publish_plan.rule_dest_invalid());
        return company_step.exit_refused();
    }
    if publish_plan.repo_ok(repo) == false {
        company_cmd.refuse(io, publish_plan.rule_repo_not_allowed());
        return company_step.exit_refused();
    }
    if journal_io.path_ok(fs, checkout) == false {
        company_cmd.refuse(io, publish_plan.rule_checkout_invalid());
        return company_step.exit_refused();
    }
    let workers = company_step.op_text(src, tp, "workers");
    let trailer = company_step.op_text(src, tp, "commit_trailer");
    if publish_plan.trailer_ok(trailer) == false {
        company_cmd.refuse(io, "operator-invalid");
        return company_step.exit_refused();
    }
    return with_artifact(heap, fs, exec, clock, io, hm, st, journal, at, dir, workers, step, branch, repo, checkout, dest, trailer);
}

// The artifact is hashed again, here, against the digest the journal accepted it with: a file that changed since is
// `publish-artifact-changed` and nothing else has happened.
fn with_artifact[&h, &f, &x, &c, &i, &m, &s, &j, &d, &w, &p, &b, &r, &k, &y, &z](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, hm: &m company_manifest.Manifest, st: &s company_state.CompanyState, journal: &j [byte], at: int, dir: &d [byte], workers: &w [byte], step: &p [byte], branch: &b [byte], repo: &r [byte], checkout: &k [byte], dest: &y [byte], trailer: &z [byte]) -> [heap, exec_under, clock, poll, fs_read(""), dir_read, dir_write, file_read, file_write, io_write] int {
    let (rel, sha) = company_state.artifact_of(st, at);
    let expected = company_step.artifact_rel(heap, step, company_step.Runner::Build);
    var code = company_step.exit_refused();
    var same = false;
    borrow expected as &eb in {
        same = bytes.equal(rel, buffer.bytes(eb));
    }
    buffer.drop(heap, expected);
    let evdir = buffer.append(heap, buffer.append(heap, buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), dir), "/steps/"), step), "/ev");
    borrow evdir as &ed in {
        if same {
            let (data, why) = company_files.read_artifact(heap, fs, buffer.bytes(ed), company_step.artifact_name(company_step.Runner::Build));
            var held = false;
            if why == 0 {
                borrow data as &db in {
                    let hex = hex_of(heap, buffer.bytes(db));
                    borrow hex as &hb in {
                        held = bytes.equal(buffer.bytes(hb), sha);
                    }
                    buffer.drop(heap, hex);
                }
            }
            buffer.drop(heap, data);
            same = held;
        }
        if same == false {
            company_cmd.refuse(io, publish_plan.rule_artifact_changed());
        } else {
            code = hand_over(heap, fs, exec, clock, io, hm, st, journal, at, dir, workers, buffer.bytes(ed), step, branch, repo, checkout, dest, sha, trailer);
        }
    }
    buffer.drop(heap, evdir);
    return code;
}

// Everything is checked on Forge's side: build the texts and ask the worker.
fn hand_over[&h, &f, &x, &c, &i, &m, &s, &j, &d, &w, &e, &p, &b, &r, &k, &y, &a, &z](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, hm: &m company_manifest.Manifest, st: &s company_state.CompanyState, journal: &j [byte], at: int, dir: &d [byte], workers: &w [byte], evdir: &e [byte], step: &p [byte], branch: &b [byte], repo: &r [byte], checkout: &k [byte], dest: &y [byte], sha: &a [byte], trailer: &z [byte]) -> [heap, exec_under, clock, poll, fs_read(""), dir_write, file_write, io_write] int {
    let prov = publish_plan.provenance(heap, hm, st, journal, at, sha, dest);
    let message = publish_plan.commit_message(heap, hm, step, dest, trailer);
    var code = company_step.exit_refused();
    borrow prov as &pb in {
        borrow message as &mb in {
            if len(buffer.bytes(pb)) > publish_plan.text_cap() {
                company_cmd.refuse(io, publish_plan.rule_worker_failed());
                company_cmd.line(io, "reason: ", "the provenance is over its size limit");
            } else {
                let req = publish_plan.request(heap, checkout, repo, branch, evdir, company_step.artifact_name(company_step.Runner::Build), dest, sha, buffer.bytes(pb), buffer.bytes(mb));
                borrow req as &qb in {
                    code = ask_worker(heap, fs, exec, clock, io, hm, st, at, dir, workers, step, branch, dest, sha, buffer.bytes(qb));
                }
                buffer.drop(heap, req);
            }
        }
    }
    buffer.drop(heap, prov);
    buffer.drop(heap, message);
    return code;
}

// The workers directory is the operator file's `workers`: the worker is started beneath it, given the request, and answers one JSON line.
fn ask_worker[&h, &f, &x, &c, &i, &m, &s, &d, &w, &p, &b, &y, &a, &q](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, hm: &m company_manifest.Manifest, st: &s company_state.CompanyState, at: int, dir: &d [byte], workers: &w [byte], step: &p [byte], branch: &b [byte], dest: &y [byte], sha: &a [byte], request: &q [byte]) -> [heap, exec_under, clock, poll, fs_read(""), dir_write, file_write, io_write] int {
    var code = company_step.exit_refused();
    if journal_io.path_ok(fs, workers) == false {
        company_cmd.refuse(io, publish_plan.rule_worker_failed());
        return code;
    }
    match open_dir(fs, workers) {
        DirOpened::Failed(errno) => {
            company_cmd.refuse(io, publish_plan.rule_worker_failed());
            company_cmd.line(io, "reason: ", "the workers directory cannot be opened");
        }
        DirOpened::Ok(opened) => {
            var wdir = opened;
            borrow wdir as &wd in {
                let (out, ran) = worker.run(heap, exec, wd, clock, worker_name(), request, 1048576, publish_deadline_ms());
                borrow out as &ob in {
                    code = settle(heap, fs, io, hm, st, at, dir, step, branch, dest, sha, ran, buffer.bytes(ob));
                }
                buffer.drop(heap, out);
            }
            dir_close(wdir);
        }
    }
    return code;
}

// How the worker ended and what it said: a commit, a refusal of its own, or nothing usable.
fn settle[&h, &f, &i, &m, &s, &d, &p, &b, &y, &a, &o](heap: &!h Heap, fs: &f Fs(""), io: &!i Io, hm: &m company_manifest.Manifest, st: &s company_state.CompanyState, at: int, dir: &d [byte], step: &p [byte], branch: &b [byte], dest: &y [byte], sha: &a [byte], ran: process.Ran, out: &o [byte]) -> [heap, fs_read(""), dir_write, file_write, io_write] int {
    var ended = false;
    match ran {
        process.Ran::Code(n) => {
            ended = n == 0;
        }
        process.Ran::Signaled(s) => {
            ended = false;
        }
        process.Ran::TimedOut => {
            ended = false;
        }
        process.Ran::TooMuch => {
            ended = false;
        }
        process.Ran::Failed(e) => {
            ended = false;
        }
    }
    var code = company_step.exit_refused();
    if ended == false {
        company_cmd.refuse(io, publish_plan.rule_worker_failed());
        company_cmd.line(io, "reason: ", "the worker did not end with a reply");
        return code;
    }
    let tape = box_slice(heap, json.tape_len(out), 0);
    var parsed = false;
    borrow mut tape as &!tw in {
        parsed = json.parse(out, contents(tw)) > 0;
    }
    borrow tape as &tr in {
        let tp = contents(tr);
        if parsed == false || json.is_object(tp, 0) == false || json.is_bool(tp, json.get(out, tp, 0, "ok")) == false {
            company_cmd.refuse(io, publish_plan.rule_worker_failed());
            company_cmd.line(io, "reason: ", "the worker's reply is not what the request asked for");
        } else if json.to_bool(tp, json.get(out, tp, 0, "ok")) {
            let commit = json.get(out, tp, 0, "commit");
            if json.is_string(tp, commit) == false || len(json.string_view(out, tp, commit)) != 40 {
                company_cmd.refuse(io, publish_plan.rule_worker_failed());
                company_cmd.line(io, "reason: ", "the worker's reply names no commit");
            } else {
                code = written(heap, fs, io, hm, st, at, dir, step, branch, dest, sha, json.string_view(out, tp, commit));
            }
        } else {
            let rule = json.get(out, tp, 0, "rule");
            var tag = publish_plan.rule_worker_failed();
            if json.is_string(tp, rule) {
                tag = publish_plan.worker_tag(json.string_view(out, tp, rule));
            }
            company_cmd.refuse(io, tag);
            let message = json.get(out, tp, 0, "message");
            if json.is_string(tp, message) {
                let clean = publish_plan.put_clean(heap, buffer.empty(heap, 128), json.string_view(out, tp, message));
                borrow clean as &cb in {
                    company_cmd.line(io, "reason: ", buffer.bytes(cb));
                }
                buffer.drop(heap, clean);
            }
        }
    }
    unbox_slice(heap, tape);
    return code;
}

// The commit exists: write `steps/<id>/pr.md` beneath the step's directory (the name replaced, never written through a link) and print
// the branch, the commit and the text.
fn written[&h, &f, &i, &m, &s, &d, &p, &b, &y, &a, &k](heap: &!h Heap, fs: &f Fs(""), io: &!i Io, hm: &m company_manifest.Manifest, st: &s company_state.CompanyState, at: int, dir: &d [byte], step: &p [byte], branch: &b [byte], dest: &y [byte], sha: &a [byte], commit: &k [byte]) -> [heap, fs_read(""), dir_write, file_write, io_write] int {
    let text = publish_plan.pr_text(heap, hm, st, at, sha, dest, branch, commit);
    let sdir = buffer.append(heap, buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), dir), "/steps/"), step);
    var code = company_step.exit_io();
    var rc = 0 - 1;
    borrow sdir as &sb in {
        if journal_io.path_ok(fs, buffer.bytes(sb)) {
            match open_dir(fs, buffer.bytes(sb)) {
                DirOpened::Failed(errno) => {
                    rc = errno;
                }
                DirOpened::Ok(opened) => {
                    var d = opened;
                    borrow d as &dr in {
                        borrow text as &tb in {
                            rc = company_files.put_beneath(dr, "pr.md", buffer.bytes(tb));
                        }
                    }
                    dir_close(d);
                }
            }
        }
    }
    buffer.drop(heap, sdir);
    company_cmd.line(io, "published: ", branch);
    company_cmd.line(io, "commit: ", commit);
    if rc == 0 {
        company_cmd.line(io, "pr: ", "steps/pr.md written (steps/<id>/pr.md)");
        code = 0;
    } else {
        company_cmd.line(io, "error: ", "the commit exists, but steps/<id>/pr.md could not be written");
    }
    borrow text as &tb in {
        io.write_all(io, buffer.bytes(tb));
    }
    buffer.drop(heap, text);
    return code;
}
