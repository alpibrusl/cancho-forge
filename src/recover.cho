edition 9;
module forge.recover;

import std.buffer;
import std.bytes;
import std.json;
import std.map;
import forge.event;
import forge.retry;
import forge.task;

// Recovery of work that was in flight (docs/architecture.md section 4.4; issue #15, `execution.lost`). Pure: the rows
// are `[heap]`, so nothing here can touch a file; `forge recover` (src/main.cho) reads the journal, hands its bytes in
// and appends what this answers.
//
// A crash can stop Forge between the records of a run. The journal then says a task is `running` and the run it was in
// has no ending. This module reads where each running task stopped, from the records alone:
//
//   phase 1  `task.running`, and no `execution.started` after it: the intent was never written, so no worker was started
//   phase 2  `execution.started` and nothing after it: the worker may have run, and what it did is not known
//   phase 3  `execution.finished`, and no move after it: the worker's claim is recorded, the move was not
//   phase 4  `execution.lost` and no move after it: a recovery that was itself cut short
//   phase 5  `execution.accepted` and nothing after it: an `async` worker took the job and may still be running
//   phase 6  `execution.cancelled` and no move after it: the worker stopped it because it was asked to
//
// and answers the records that put each of them where the run would have:
//
//   phase 1  refusal `execution-unstarted`, then `task.ready`
//   phase 2  `execution.lost`, then as phase 4
//   phase 4  the task has started the worker `retry.max_attempts()` times or more: refusal `retry-exhausted`, then
//            `task.blocked`; else refusal `execution-lost`, then `task.ready`
//   phase 3  `task.verification` (a finished record is written only for a `succeeded` reply, and it is a claim)
//   phase 5  NOTHING: the worker is not known to be gone. It is not lost, and re-dispatching it would start a second build in
//            a directory the first may still be writing. The caller asks the worker (`forge.await_task`); with no worker to
//            ask the task stays `running` and is counted as awaiting (docs/async-level.md section 5)
//   phase 6  `task.cancelled`
//
// Forge never re-dispatches by itself: `ready` is where the budget and the policy are consulted again (section 6). Every
// record is written by Forge (actor forge). Running it twice on a journal it has already recovered finds nothing.

// What a plan holds, by phase. `exhausted` counts the tasks of phase 2 or 4 that are blocked rather than ready.
pub struct Counts {
    unstarted: int,
    lost: int,
    finished: int,
    exhausted: int,
    awaiting: int,
}

fn phase_of[&m, &i](phase: &m map.Map[int], id: &i [byte]) -> [] int {
    return map.get(phase, id, 0);
}

// The phase each task is in once `line` (a complete record, no newline) is read. A move of the task ends the phase; a
// record about an execution counts only while the task is running. A line that is not a record is passed over (the
// caller replayed the journal first).
fn scan_line[&h, &l](heap: &!h Heap, phase: map.Map[int], starts: map.Map[int], line: &l [byte]) -> [heap] (map.Map[int], map.Map[int]) {
    var ph = phase;
    var st = starts;
    let tape = box_slice(heap, json.tape_len(line), 0);
    borrow mut tape as &!tw in {
        let tp = contents(tw);
        if json.parse(line, tp) > 0 && json.is_object(tp, 0) {
            let kindn = json.get(line, tp, 0, "kind");
            let taskn = json.get(line, tp, 0, "task");
            if kindn >= 0 && taskn >= 0 && json.is_string(tp, kindn) && json.is_string(tp, taskn) {
                let kind = json.string_view(line, tp, kindn);
                let id = json.string_view(line, tp, taskn);
                var current = 0;
                borrow ph as &pb in {
                    current = phase_of(pb, id);
                }
                if bytes.equal(kind, "task.running") {
                    ph = map.put(heap, ph, id, 1);
                } else if bytes.starts_with(kind, "task.") {
                    ph = map.put(heap, ph, id, 0);
                } else if current > 0 && bytes.equal(kind, "execution.started") {
                    ph = map.put(heap, ph, id, 2);
                    var seen = 0;
                    borrow st as &sb in {
                        seen = map.get(sb, id, 0);
                    }
                    st = map.put(heap, st, id, seen + 1);
                } else if current > 0 && bytes.equal(kind, "execution.accepted") {
                    ph = map.put(heap, ph, id, 5);
                } else if current > 0 && bytes.equal(kind, "execution.cancelled") {
                    ph = map.put(heap, ph, id, 6);
                } else if current > 0 && bytes.equal(kind, "execution.finished") {
                    ph = map.put(heap, ph, id, 3);
                } else if current > 0 && bytes.equal(kind, "execution.lost") {
                    ph = map.put(heap, ph, id, 4);
                }
            }
        }
    }
    unbox_slice(heap, tape);
    return (ph, st);
}

fn add[&h](heap: &!h Heap, out: buffer.Buffer, record: buffer.Buffer) -> [heap] buffer.Buffer {
    var next = out;
    borrow record as &rb in {
        next = buffer.append(heap, next, buffer.bytes(rb));
    }
    buffer.drop(heap, record);
    return next;
}

fn say[&h, &i, &w](heap: &!h Heap, text: buffer.Buffer, id: &i [byte], what: &w [byte]) -> [heap] buffer.Buffer {
    var t = buffer.append(heap, text, id);
    t = buffer.append(heap, t, ": ");
    t = buffer.append(heap, t, what);
    return buffer.push(heap, t, byte_of(10));
}

// The records for one task that stopped in phase `p` after `started` starts of the worker. Answers the records so far,
// the text so far, the next `seq` and the counts.
fn settle[&h, &i](heap: &!h Heap, out: buffer.Buffer, text: buffer.Buffer, seq: int, id: &i [byte], p: int, started: int, counts: Counts) -> [heap] (buffer.Buffer, buffer.Buffer, int, Counts) {
    var o = out;
    var t = text;
    var s = seq;
    var c = counts;
    if p == 1 {
        o = add(heap, o, event.refusal(heap, s, id, "execution-unstarted"));
        o = add(heap, o, event.transition(heap, s + 1, task.kind_of_state(task.State::Ready), id, "forge", ""));
        t = say(heap, t, id, "execution-unstarted, no worker was started: running -> ready");
        return (o, t, s + 2, Counts { unstarted: c.unstarted + 1, lost: c.lost, finished: c.finished, exhausted: c.exhausted, awaiting: c.awaiting });
    }
    if p == 5 {
        t = say(heap, t, id, "awaiting: an async worker took the job and is not known to be gone; nothing is written (forge await, or forge recover with the workers directory, asks it)");
        return (o, t, s, Counts { unstarted: c.unstarted, lost: c.lost, finished: c.finished, exhausted: c.exhausted, awaiting: c.awaiting + 1 });
    }
    if p == 6 {
        o = add(heap, o, event.transition(heap, s, task.kind_of_state(task.State::Cancelled), id, "forge", ""));
        t = say(heap, t, id, "the worker stopped the run because it was asked to and the move was not recorded: running -> cancelled");
        return (o, t, s + 1, Counts { unstarted: c.unstarted, lost: c.lost, finished: c.finished, exhausted: c.exhausted, awaiting: c.awaiting });
    }
    if p == 3 {
        o = add(heap, o, event.transition(heap, s, task.kind_of_state(task.State::Verification), id, "forge", ""));
        t = say(heap, t, id, "the worker's claim was recorded and the move was not: running -> verification");
        return (o, t, s + 1, Counts { unstarted: c.unstarted, lost: c.lost, finished: c.finished + 1, exhausted: c.exhausted, awaiting: c.awaiting });
    }
    if p == 2 {
        o = add(heap, o, event.execution(heap, s, "execution.lost", id, ""));
        s = s + 1;
    }
    if started >= retry.max_attempts() {
        o = add(heap, o, event.refusal(heap, s, id, "retry-exhausted"));
        o = add(heap, o, event.transition(heap, s + 1, task.kind_of_state(task.State::Blocked), id, "forge", ""));
        t = say(heap, t, id, "retry-exhausted, the worker was started the whole budget and no run ended: running -> blocked");
        return (o, t, s + 2, Counts { unstarted: c.unstarted, lost: c.lost + 1, finished: c.finished, exhausted: c.exhausted + 1, awaiting: c.awaiting });
    }
    o = add(heap, o, event.refusal(heap, s, id, "execution-lost"));
    o = add(heap, o, event.transition(heap, s + 1, task.kind_of_state(task.State::Ready), id, "forge", ""));
    t = say(heap, t, id, "execution-lost, the worker's run has no ending and is not re-dispatched: running -> ready");
    return (o, t, s + 2, Counts { unstarted: c.unstarted, lost: c.lost + 1, finished: c.finished, exhausted: c.exhausted, awaiting: c.awaiting });
}

// The plan for a journal `data` that replayed cleanly and holds `records` records (the caller checked both): the bytes
// to append, each record starting at `seq` `records + 1`, a line of text for each task, and the counts. Nothing to
// append is an empty buffer. The tasks come in the order of the table the scan builds.
pub fn plan[&h, &d](heap: &!h Heap, data: &d [byte], records: int) -> [heap] (buffer.Buffer, buffer.Buffer, Counts) {
    var phase = map.empty(heap, 16, 0, 0);
    var starts = map.empty(heap, 16, 0, 0);
    var start = 0;
    var k = 0;
    while k < len(data) {
        if int_of(data[k]) == 10 {
            let (p, s) = scan_line(heap, phase, starts, data[start..k]);
            phase = p;
            starts = s;
            start = k + 1;
        }
        k = k + 1;
    }
    var out = buffer.empty(heap, 256);
    var text = buffer.empty(heap, 128);
    var seq = records + 1;
    var counts = Counts { unstarted: 0, lost: 0, finished: 0, exhausted: 0, awaiting: 0 };
    borrow phase as &pb in {
        borrow starts as &sb in {
            var e = 0;
            while e < map.entries(pb) {
                if map.is_live(pb, e) && map.value_at(pb, e) > 0 {
                    let id = map.key_at(pb, e);
                    let (o, t, s, c) = settle(heap, out, text, seq, id, map.value_at(pb, e), map.get(sb, id, 0), counts);
                    out = o;
                    text = t;
                    seq = s;
                    counts = c;
                }
                e = e + 1;
            }
        }
    }
    map.drop(heap, phase);
    map.drop(heap, starts);
    return (out, text, counts);
}

// Where a task that is `running` stopped, read from the journal `data` (complete lines): the phase of the table above (0 when
// the task is not running), and, when it is 5, the request the worker was given and the directory it works in, from the
// `execution.accepted` record. Empty buffers otherwise. This is what `forge await`, `forge cancel` and `forge recover` need
// to ask the worker about a run.
pub fn accepted_of[&h, &d, &i](heap: &!h Heap, data: &d [byte], id: &i [byte]) -> [heap] (int, buffer.Buffer, buffer.Buffer) {
    var phase = 0;
    var request = buffer.empty(heap, 1);
    var dir = buffer.empty(heap, 1);
    var start = 0;
    var k = 0;
    while k < len(data) {
        if int_of(data[k]) == 10 {
            let line = data[start..k];
            let tape = box_slice(heap, json.tape_len(line), 0);
            borrow mut tape as &!tw in {
                let tp = contents(tw);
                if json.parse(line, tp) > 0 && json.is_object(tp, 0) {
                    let kindn = json.get(line, tp, 0, "kind");
                    let taskn = json.get(line, tp, 0, "task");
                    if kindn >= 0 && taskn >= 0 && json.is_string(tp, kindn) && json.is_string(tp, taskn) && json.string_equals(line, tp, taskn, id) {
                        let kind = json.string_view(line, tp, kindn);
                        if bytes.equal(kind, "task.running") {
                            phase = 1;
                            buffer.drop(heap, request);
                            buffer.drop(heap, dir);
                            request = buffer.empty(heap, 1);
                            dir = buffer.empty(heap, 1);
                        } else if bytes.starts_with(kind, "task.") {
                            phase = 0;
                        } else if phase > 0 && bytes.equal(kind, "execution.started") {
                            phase = 2;
                        } else if phase > 0 && bytes.equal(kind, "execution.accepted") {
                            let rq = json.get(line, tp, 0, "request");
                            let dr = json.get(line, tp, 0, "dir");
                            if rq >= 0 && dr >= 0 && json.is_string(tp, rq) && json.is_string(tp, dr) && json.string_plain(tp, rq) && json.string_plain(tp, dr) {
                                phase = 5;
                                buffer.drop(heap, request);
                                buffer.drop(heap, dir);
                                request = buffer.append(heap, buffer.empty(heap, 16), json.string_view(line, tp, rq));
                                dir = buffer.append(heap, buffer.empty(heap, 16), json.string_view(line, tp, dr));
                            }
                        } else if phase > 0 && bytes.equal(kind, "execution.finished") {
                            phase = 3;
                        } else if phase > 0 && bytes.equal(kind, "execution.lost") {
                            phase = 4;
                        } else if phase > 0 && bytes.equal(kind, "execution.cancelled") {
                            phase = 6;
                        }
                    }
                }
            }
            unbox_slice(heap, tape);
            start = k + 1;
        }
        k = k + 1;
    }
    return (phase, request, dir);
}

// The ids of the tasks in phase 5 (an `async` worker took the job and nothing ended it), one per line, in the order of the
// table the scan builds. What `forge recover <dir> <workers>` goes on to ask the worker about.
pub fn awaiting[&h, &d](heap: &!h Heap, data: &d [byte]) -> [heap] buffer.Buffer {
    return in_phases(heap, data, 5, 5);
}

// The ids of the tasks whose worker may still be running: phase 2 (the intent was written, nothing after it: the worker may have
// been started) and phase 5 (an `async` worker took the job). What `forge company run` asks to stop before it starts a step of an
// earlier run again (task 9, src/company_runner.cho `reap_stale`).
pub fn in_flight[&h, &d](heap: &!h Heap, data: &d [byte]) -> [heap] buffer.Buffer {
    return in_phases(heap, data, 2, 5);
}

fn in_phases[&h, &d](heap: &!h Heap, data: &d [byte], one: int, other: int) -> [heap] buffer.Buffer {
    var phase = map.empty(heap, 16, 0, 0);
    var starts = map.empty(heap, 16, 0, 0);
    var start = 0;
    var k = 0;
    while k < len(data) {
        if int_of(data[k]) == 10 {
            let (p, s) = scan_line(heap, phase, starts, data[start..k]);
            phase = p;
            starts = s;
            start = k + 1;
        }
        k = k + 1;
    }
    var out = buffer.empty(heap, 32);
    borrow phase as &pb in {
        var e = 0;
        while e < map.entries(pb) {
            if map.is_live(pb, e) {
                let v = map.value_at(pb, e);
                if v == one || v == other {
                    out = buffer.push(heap, buffer.append(heap, out, map.key_at(pb, e)), byte_of(10));
                }
            }
            e = e + 1;
        }
    }
    map.drop(heap, phase);
    map.drop(heap, starts);
    return out;
}
