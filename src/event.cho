edition 9;
module forge.event;

import std.buffer;
import std.json;

// A journal record is one JSON object on one line (docs/architecture.md,
// "The journal is the source of truth"). The first fields are fixed:
//   v    schema version, 1
//   seq  position in the journal, starting at 1, no gaps
//   kind a dotted event name
//   task the task id the event is about
// Readers ignore fields they do not know, so a later version can add some.

pub fn schema_version() -> [] int {
    return 1;
}

// The record and the newline that ends it. A reader treats bytes after the
// last newline as a torn write, so the newline is part of the record.
pub fn record[&h, &k, &t](heap: &!h Heap, seq: int, kind: &k [byte], task: &t [byte]) -> [heap] buffer.Buffer {
    var w = json.writer(heap, 96);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "v");
    w = json.put_int(heap, w, schema_version());
    w = json.put_key(heap, w, "seq");
    w = json.put_int(heap, w, seq);
    w = json.put_key(heap, w, "kind");
    w = json.put_string(heap, w, kind);
    w = json.put_key(heap, w, "task");
    w = json.put_string(heap, w, task);
    w = json.end_object(heap, w);
    return buffer.push(heap, json.finish(w), byte_of(10));
}

// The `seq` of one complete line, or -1 when the line is not a record: not
// JSON, not an object, no integer `seq`, or a `v` this build does not know.
pub fn seq_of[&h, &s](heap: &!h Heap, line: &s [byte]) -> [heap] int {
    let tape = box_slice(heap, json.tape_len(line), 0);
    var seq = 0 - 1;
    borrow mut tape as &!t in {
        let tp = contents(t);
        if json.parse(line, tp) > 0 && json.is_object(tp, 0) {
            let version = json.get(line, tp, 0, "v");
            let node = json.get(line, tp, 0, "seq");
            if json.is_int(tp, node) && json.is_int(tp, version) && json.to_int(line, tp, version) == schema_version() {
                seq = json.to_int(line, tp, node);
            }
        }
    }
    unbox_slice(heap, tape);
    return seq;
}

// A record for a task event (docs/architecture.md, sections 4.1 and 6): the
// fixed fields, then `actor` (forge, worker or human) and, when `basis` is
// not empty, `basis`. `basis` is "observed" only for a fact Forge itself
// checked; the state machine reads it for `task.accepted`.
pub fn transition[&h, &k, &t, &a, &b](heap: &!h Heap, seq: int, kind: &k [byte], task: &t [byte], actor: &a [byte], basis: &b [byte]) -> [heap] buffer.Buffer {
    var w = json.writer(heap, 128);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "v");
    w = json.put_int(heap, w, schema_version());
    w = json.put_key(heap, w, "seq");
    w = json.put_int(heap, w, seq);
    w = json.put_key(heap, w, "kind");
    w = json.put_string(heap, w, kind);
    w = json.put_key(heap, w, "task");
    w = json.put_string(heap, w, task);
    w = json.put_key(heap, w, "actor");
    w = json.put_string(heap, w, actor);
    if len(basis) > 0 {
        w = json.put_key(heap, w, "basis");
        w = json.put_string(heap, w, basis);
    }
    w = json.end_object(heap, w);
    return buffer.push(heap, json.finish(w), byte_of(10));
}

// The record of a refusal (kind "refusal"): what was declined is written down
// with its rule tag, so "why is it in this state" has an answer. It changes
// no state when replayed.
pub fn refusal[&h, &t, &r](heap: &!h Heap, seq: int, task: &t [byte], rule: &r [byte]) -> [heap] buffer.Buffer {
    var w = json.writer(heap, 128);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "v");
    w = json.put_int(heap, w, schema_version());
    w = json.put_key(heap, w, "seq");
    w = json.put_int(heap, w, seq);
    w = json.put_key(heap, w, "kind");
    w = json.put_string(heap, w, "refusal");
    w = json.put_key(heap, w, "task");
    w = json.put_string(heap, w, task);
    w = json.put_key(heap, w, "rule");
    w = json.put_string(heap, w, rule);
    w = json.end_object(heap, w);
    return buffer.push(heap, json.finish(w), byte_of(10));
}
