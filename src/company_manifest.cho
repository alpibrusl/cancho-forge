edition 9;
module forge.company_manifest;

import std.buffer;
import std.bytes;
import std.json;

// The company manifest (docs/superpowers/specs/2026-10-27-forge-company-layer-design.md, sections 4.1, 4.2 and 4.4): a JSON file
// parsed against a closed shape. This module is pure: it opens no file and starts nothing. `parse` takes the text and answers
// either a `Manifest` that has passed every check here, or the first refusal, with a rule tag. A manifest declares requirements
// only; it cannot widen what a worker can reach (section 4.1), so nothing here grants anything.
//
//   { "id", "mission",
//     "model":  { "provider", "name" },
//     "budget": { "input", "output", "cache_write", "cache_read", "max_cost", "price_table",
//                 "rolling"?: { "days", "max_cost" }, "per_change"?: { "max_cost"?, "max_attempts"? } },
//     "human_gates": [name...], "roles": [role...],
//     "repos": [ { "id", "kind": "library" | "program" | "service" } ... ]?,
//     "intake": { "max_per_window"?, "max_open_per_repo"? }?,
//     "flows": { "<flow name>": [ step... ] ... }?,
//     "steps": [ { "id", "role", "task_type", "needs": [id...], "input", "check"?, "contract"?, "library"?, "gate"?,
//                  "repo"?, "change_kind"? } ... ] }
//
// The order the checks run in, so that a manifest with two faults is always refused for the same one:
//   1. size (over 1 MiB), JSON, the root an object                                       manifest-malformed
//   2. the keys of the root, `model`, `budget` and each step: a name outside the shape   manifest-unknown-field
//      (a key twice, or a key written with an escape, is manifest-malformed)
//   3. the shape and types of everything but the budget's presence                       manifest-malformed
//   4. `budget` missing, a budget number missing / `price_table` missing                 budget-missing / price-table-missing
//   5. `roles` names a role outside the six                                               role-unknown
//   5b. `repos`: a kind outside library, program, service                                 repo-kind-invalid
//       a repository id twice                                                            repo-duplicate
//   6. step ids twice                                                                    step-id-duplicate
//   7. per step, in order: role (not one of the six, or not in `roles`)                  role-unknown
//      task type (not the one the role offers)                                           task-type-unsupported
//      check (a builder or writer without one)                                           check-missing
//      repo (a `repo.change` step without one)                                           repo-required
//      repo / change_kind on another task type, contract / library on `repo.change`      repo-task-invalid
//      repo (names no entry of `repos`)                                                  repo-unknown
//      change_kind (not bug, feature, refactor or rename)                                repo-change-kind-invalid
//      contract (a step that is neither a builder nor a writer names one)                contract-role-invalid
//      library (a step that is neither a builder nor a writer names one)                 library-role-invalid
//      library (not a module name: `build_task.library_ok`)                              library-name-invalid
//      library (a step with a library and no contract)                                   library-needs-contract
//      gate (not in `human_gates`)                                                       gate-unknown
//   8. a `needs` entry that is no step id                                                step-needs-unknown
//   9. a step that needs itself, or any cycle                                            step-cycle
//  10. `flows` (docs/company-lifecycle.md section 3): each flow is an array of at most 16 steps in the shape of `steps`, held to the same
//      rules (5, 6, 7, 8, 9 above, with its own ids); and to these, in order:
//      a flow longer than 16 steps                                                      flow-too-long
//      a `repo` key in a flow step (a derived step takes the change's repository)       flow-repo-forbidden
//      a `needs` entry that is no step of the same flow                                 flow-needs-foreign
//
// Names (a step id, a gate, a role) are 1 to 64 bytes of letters, digits, `-`, `_` and `.`, written without an escape: a control
// character or a space in an id is `manifest-malformed`, a value like any other, never a trap. A step id is also a directory name
// of the run (`steps/<id>`), so one that starts with a dot (`.`, `..`, `.x`) or holds two dots in a row is `manifest-malformed`
// (gates and roles are never paths). Text (`mission`, `input`) is a
// string of at most 16 KiB that does not spell a NUL (`\u0000`). File names (`check`, `price_table`) are 1 to 128 bytes of
// letters, digits, `-`, `_` and `.`, not starting with `.`: a name in the company directory, never a path.

// What a manifest is refused for. Each has a rule tag and a test that reaches it (tests/company_manifest_test.cho).
pub enum Refusal {
    // Not JSON, over 1 MiB, the wrong type or a missing required field, an empty `steps`, a name that is not a name, a key twice.
    ManifestMalformed,
    // A key in the root, `model`, `budget` or a step that the shape does not have.
    ManifestUnknownField,
    // Two steps with the same `id`.
    StepIdDuplicate,
    // A `needs` entry that names no step.
    StepNeedsUnknown,
    // A step needs itself, or the steps need each other in a ring.
    StepCycle,
    // A role outside `builder, qa, analyst, reviewer, writer, product`, or a step's role that `roles` does not list.
    RoleUnknown,
    // A `task_type` that is not one of `project.build, repo.gate, tool.run, none`, or not the one the step's role offers.
    TaskTypeUnsupported,
    // A builder or writer step with no `check` (absent or empty).
    CheckMissing,
    // A `contract` on a step that is neither a builder nor a writer: only a build is given a contract file.
    ContractRoleInvalid,
    // A `library` on a step that is neither a builder nor a writer: only a build is given a library name.
    LibraryRoleInvalid,
    // A `library` that is not a module name (`build_task.library_ok`: lowercase letters, digits and `_`, not starting with a digit, at
    // most 64 bytes, not `std` or `test`).
    LibraryNameInvalid,
    // A `library` on a step with no `contract`: `cancho-build --library` needs the contract to know which functions are public.
    LibraryNeedsContract,
    // A step's `gate` that is not in `human_gates`.
    GateUnknown,
    // A `repos` entry whose `kind` is not `library`, `program` or `service` (docs/company-lifecycle.md section 2.1).
    RepoKindInvalid,
    // Two `repos` entries with the same `id`.
    RepoDuplicate,
    // A step's `repo` that no `repos` entry has.
    RepoUnknown,
    // A `repo.change` step with no `repo`.
    RepoRequired,
    // A `repo` or `change_kind` on a step whose task type is not `repo.change`, or a `contract` or `library` on one that is.
    RepoTaskInvalid,
    // A step's `change_kind` that is not `bug`, `feature`, `refactor` or `rename` (the kinds of `cancho-build --kind`).
    RepoChangeKindInvalid,
    // A flow of `flows` with more than 16 steps.
    FlowTooLong,
    // A flow step that names a `repo`: a derived `repo.change` step takes the repository of its change.
    FlowRepoForbidden,
    // A flow step whose `needs` names a step that is not of the same flow.
    FlowNeedsForeign,
    // No `budget` object, or one of its five numbers is absent.
    BudgetMissing,
    // No `budget.price_table`, or an empty one.
    PriceTableMissing,
}

pub fn rule_name(r: Refusal) -> [] &static [byte] {
    match r {
        Refusal::ManifestMalformed => {
            return "manifest-malformed";
        }
        Refusal::ManifestUnknownField => {
            return "manifest-unknown-field";
        }
        Refusal::StepIdDuplicate => {
            return "step-id-duplicate";
        }
        Refusal::StepNeedsUnknown => {
            return "step-needs-unknown";
        }
        Refusal::StepCycle => {
            return "step-cycle";
        }
        Refusal::RoleUnknown => {
            return "role-unknown";
        }
        Refusal::TaskTypeUnsupported => {
            return "task-type-unsupported";
        }
        Refusal::CheckMissing => {
            return "check-missing";
        }
        Refusal::ContractRoleInvalid => {
            return "contract-role-invalid";
        }
        Refusal::LibraryRoleInvalid => {
            return "library-role-invalid";
        }
        Refusal::LibraryNameInvalid => {
            return "library-name-invalid";
        }
        Refusal::LibraryNeedsContract => {
            return "library-needs-contract";
        }
        Refusal::GateUnknown => {
            return "gate-unknown";
        }
        Refusal::RepoKindInvalid => {
            return "repo-kind-invalid";
        }
        Refusal::RepoDuplicate => {
            return "repo-duplicate";
        }
        Refusal::RepoUnknown => {
            return "repo-unknown";
        }
        Refusal::RepoRequired => {
            return "repo-required";
        }
        Refusal::RepoTaskInvalid => {
            return "repo-task-invalid";
        }
        Refusal::RepoChangeKindInvalid => {
            return "repo-change-kind-invalid";
        }
        Refusal::FlowTooLong => {
            return "flow-too-long";
        }
        Refusal::FlowRepoForbidden => {
            return "flow-repo-forbidden";
        }
        Refusal::FlowNeedsForeign => {
            return "flow-needs-foreign";
        }
        Refusal::BudgetMissing => {
            return "budget-missing";
        }
        Refusal::PriceTableMissing => {
            return "price-table-missing";
        }
    }
}

// The six roles of section 4.2.
pub enum Role {
    Builder,
    Qa,
    Analyst,
    Reviewer,
    Writer,
    Product,
}

// The task types of section 4.2. `None` is the product role's: a person, no worker.
pub enum TaskType {
    ProjectBuild,
    RepoGate,
    ToolRun,
    None,
    RepoChange,
}

// The kind of a repository (docs/company-lifecycle.md section 2.1): a closed set. `Library` is a module other programs import, `Program` an
// executable, `Service` a program that runs somewhere and answers. Slice 1 uses the kind to hold the operator's row to the manifest's.
pub enum RepoKind {
    Library,
    Program,
    Service,
}

// A step, as the nodes of the manifest's tape: read the text of a field with `step_id`, `step_input`, `step_check`, `step_contract`,
// `step_library`, `step_gate` and `step_need`. `check`, `contract`, `library` and `gate` are -1 when the step has none.
pub struct Step {
    id: int,
    role: Role,
    task_type: TaskType,
    needs: int,
    input: int,
    check: int,
    contract: int,
    library: int,
    gate: int,
    repo: int,
    change_kind: int,
    src: int,
}

// A manifest that passed every check. It owns its text and the tape over it, so it is `res`: end it with `drop`.
pub res struct Manifest {
    text: buffer.Buffer,
    tape: Box[[int]],
    id: int,
    provider: int,
    price_table: int,
    steps: int,
    gates: int,
    repos: int,
    flows: int,
    dtext: buffer.Buffer,
    dtape: Box[[int]],
    dsteps: int,
    dcount: int,
    step_count: int,
    input: int,
    output: int,
    cache_write: int,
    cache_read: int,
    max_cost: int,
    rolling_days: int,
    rolling_cost: int,
    change_cost: int,
    change_attempts: int,
    intake_window: int,
    intake_open: int,
}

pub enum ManifestResult {
    Held(Manifest),
    Refused(Refusal),
}

// The longest manifest, in bytes. A longer text is `manifest-malformed` before it is parsed.
pub fn max_bytes() -> [] int {
    return 1048576;
}

// The most steps, `needs` entries of one step, gates, and keys of one object. Beyond them the manifest is malformed: bounds
// on what the checks below walk, so no input makes them slow.
pub fn max_steps() -> [] int {
    return 256;
}

pub fn max_needs() -> [] int {
    return 64;
}

pub fn max_gates() -> [] int {
    return 64;
}

pub fn max_keys() -> [] int {
    return 32;
}

pub fn max_text() -> [] int {
    return 16384;
}

// The most `repos` entries.
pub fn max_repos() -> [] int {
    return 64;
}

// ---- the checks -----------------------------------------------------------------------------------------------------------
// Each answers 0 for held, else a code: 1 malformed, 2 unknown field, 3 duplicate, 4 needs unknown, 5 cycle, 6 role unknown, 7 task
// type, 8 check missing, 9 gate unknown, 10 budget missing, 11 price table missing, 12 contract on a role that builds nothing, 13 library on a role that builds nothing, 14 library that is not a module name, 15 library without a contract,
// 16 repo kind, 17 repo duplicate, 18 repo unknown, 19 repo required, 20 repo on the wrong task type, 21 change kind, 22 flow too long, 23 repo in a flow step,
// 24 flow needs a step of another flow.

fn refusal_of(code: int) -> [] Refusal {
    if code == 2 {
        return Refusal::ManifestUnknownField;
    }
    if code == 3 {
        return Refusal::StepIdDuplicate;
    }
    if code == 4 {
        return Refusal::StepNeedsUnknown;
    }
    if code == 5 {
        return Refusal::StepCycle;
    }
    if code == 6 {
        return Refusal::RoleUnknown;
    }
    if code == 7 {
        return Refusal::TaskTypeUnsupported;
    }
    if code == 8 {
        return Refusal::CheckMissing;
    }
    if code == 9 {
        return Refusal::GateUnknown;
    }
    if code == 10 {
        return Refusal::BudgetMissing;
    }
    if code == 11 {
        return Refusal::PriceTableMissing;
    }
    if code == 12 {
        return Refusal::ContractRoleInvalid;
    }
    if code == 13 {
        return Refusal::LibraryRoleInvalid;
    }
    if code == 14 {
        return Refusal::LibraryNameInvalid;
    }
    if code == 15 {
        return Refusal::LibraryNeedsContract;
    }
    if code == 16 {
        return Refusal::RepoKindInvalid;
    }
    if code == 17 {
        return Refusal::RepoDuplicate;
    }
    if code == 18 {
        return Refusal::RepoUnknown;
    }
    if code == 19 {
        return Refusal::RepoRequired;
    }
    if code == 20 {
        return Refusal::RepoTaskInvalid;
    }
    if code == 21 {
        return Refusal::RepoChangeKindInvalid;
    }
    if code == 22 {
        return Refusal::FlowTooLong;
    }
    if code == 23 {
        return Refusal::FlowRepoForbidden;
    }
    if code == 24 {
        return Refusal::FlowNeedsForeign;
    }
    return Refusal::ManifestMalformed;
}

fn name_char_ok(c: int) -> [] bool {
    let letter = c >= 65 && c <= 90 || c >= 97 && c <= 122;
    let digit = c >= 48 && c <= 57;
    return letter || digit || c == 45 || c == 95 || c == 46;
}

// 1 to `limit` bytes of letters, digits, `-`, `_`, `.`.
fn name_ok[&v](view: &v [byte], limit: int) -> [] bool {
    if len(view) < 1 || len(view) > limit {
        return false;
    }
    var i = 0;
    while i < len(view) {
        if !name_char_ok(int_of(view[i])) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// A file name of the company directory: a name that does not start with `.`.
fn file_ok[&v](view: &v [byte]) -> [] bool {
    return name_ok(view, 128) && int_of(view[0]) != 46;
}

// Is node `i` a string written without an escape, whose bytes are a name?
// A step id names a directory of the run (`steps/<id>`): beyond a name, it does not start with a dot (`.`, `..`, a hidden name) and
// has no two dots in a row (a path the file capability refuses). Called on a name, so `id` is not empty.
fn step_id_ok[&v](id: &v [byte]) -> [] bool {
    if len(id) == 0 {
        return false;
    }
    if int_of(id[0]) == 46 {
        return false;
    }
    var k = 1;
    while k < len(id) {
        if int_of(id[k]) == 46 {
            if int_of(id[k - 1]) == 46 {
                return false;
            }
        }
        k = k + 1;
    }
    return true;
}

fn is_name[&s, &t](src: &s [byte], tp: &t [int], i: int) -> [] bool {
    return json.string_plain(tp, i) && name_ok(json.string_view(src, tp, i), 64);
}

// Is node `i` a string of at most 16 KiB that does not spell `\u0000`? An escaped string is allowed (a brief has newlines).
fn is_text[&s, &t](src: &s [byte], tp: &t [int], i: int) -> [] bool {
    if !json.is_string(tp, i) {
        return false;
    }
    let view = json.string_view(src, tp, i);
    if len(view) > max_text() {
        return false;
    }
    var k = 0;
    while k + 5 < len(view) {
        if int_of(view[k]) == 92 && int_of(view[k + 1]) == 117 && int_of(view[k + 2]) == 48 && int_of(view[k + 3]) == 48 && int_of(view[k + 4]) == 48 && int_of(view[k + 5]) == 48 {
            return false;
        }
        k = k + 1;
    }
    return true;
}

fn is_count[&s, &t](src: &s [byte], tp: &t [int], i: int) -> [] bool {
    return json.is_int(tp, i) && json.fits_int(src, tp, i) && json.to_int(src, tp, i) >= 0;
}

// Is `key` one of the space-separated `names`?
fn listed[&k](key: &k [byte], names: &static [byte]) -> [] bool {
    var start = 0;
    var i = 0;
    while i <= len(names) {
        if i == len(names) || int_of(names[i]) == 32 {
            if bytes.equal(key, names[start..i]) {
                return true;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

// The keys of object `obj` against `names`: at most `max_keys`, each written without an escape, none twice (malformed), none
// outside the list (unknown field). Malformed is reported before unknown.
fn keys_code[&s, &t](src: &s [byte], tp: &t [int], obj: int, names: &static [byte]) -> [] int {
    let n = json.count(tp, obj);
    if n > max_keys() {
        return 1;
    }
    var unknown = false;
    var j = obj + 1;
    var k = 0;
    while k < n {
        if !json.string_plain(tp, j) {
            return 1;
        }
        let key = json.string_view(src, tp, j);
        if !listed(key, names) {
            unknown = true;
        }
        var e = obj + 1;
        var q = 0;
        while q < k {
            if bytes.equal(key, json.string_view(src, tp, e)) {
                return 1;
            }
            e = json.skip(tp, e + 1);
            q = q + 1;
        }
        j = json.skip(tp, j + 1);
        k = k + 1;
    }
    if unknown {
        return 2;
    }
    return 0;
}

// A role name as a number 0 to 5, or -1.
fn role_code[&v](name: &v [byte]) -> [] int {
    if bytes.equal(name, "builder") {
        return 0;
    }
    if bytes.equal(name, "qa") {
        return 1;
    }
    if bytes.equal(name, "analyst") {
        return 2;
    }
    if bytes.equal(name, "reviewer") {
        return 3;
    }
    if bytes.equal(name, "writer") {
        return 4;
    }
    if bytes.equal(name, "product") {
        return 5;
    }
    return 0 - 1;
}

// A task type name as a number 0 to 4, or -1.
fn type_code[&v](name: &v [byte]) -> [] int {
    if bytes.equal(name, "project.build") {
        return 0;
    }
    if bytes.equal(name, "repo.gate") {
        return 1;
    }
    if bytes.equal(name, "tool.run") {
        return 2;
    }
    if bytes.equal(name, "none") {
        return 3;
    }
    if bytes.equal(name, "repo.change") {
        return 4;
    }
    return 0 - 1;
}

// The task type each role offers (section 4.2): builder and writer `project.build`, qa and reviewer `repo.gate`, analyst
// `tool.run`, product `none`.
fn type_of_role(role: int) -> [] int {
    if role == 0 || role == 4 {
        return 0;
    }
    if role == 1 || role == 3 {
        return 1;
    }
    if role == 2 {
        return 2;
    }
    return 3;
}

fn role_of(code: int) -> [] Role {
    if code == 0 {
        return Role::Builder;
    }
    if code == 1 {
        return Role::Qa;
    }
    if code == 2 {
        return Role::Analyst;
    }
    if code == 3 {
        return Role::Reviewer;
    }
    if code == 4 {
        return Role::Writer;
    }
    return Role::Product;
}

fn type_of(code: int) -> [] TaskType {
    if code == 4 {
        return TaskType::RepoChange;
    }
    if code == 0 {
        return TaskType::ProjectBuild;
    }
    if code == 1 {
        return TaskType::RepoGate;
    }
    if code == 2 {
        return TaskType::ToolRun;
    }
    return TaskType::None;
}

// The `model` object: `provider` and `name`, both names.
fn model_code[&s, &t](src: &s [byte], tp: &t [int], model: int) -> [] int {
    if !json.is_object(tp, model) {
        return 1;
    }
    let keys = keys_code(src, tp, model, "provider name");
    if keys != 0 {
        return keys;
    }
    let provider = json.get(src, tp, model, "provider");
    let name = json.get(src, tp, model, "name");
    if !is_name(src, tp, provider) || !is_name(src, tp, name) {
        return 1;
    }
    return 0;
}

// The `budget` object when present: its keys and types (malformed, unknown field), then the presence of its numbers.
fn budget_shape_code[&s, &t](src: &s [byte], tp: &t [int], budget: int) -> [] int {
    if !json.is_object(tp, budget) {
        return 1;
    }
    let keys = keys_code(src, tp, budget, "input output cache_write cache_read max_cost price_table rolling per_change");
    if keys != 0 {
        return keys;
    }
    let names = "input output cache_write cache_read max_cost";
    var start = 0;
    var i = 0;
    while i <= len(names) {
        if i == len(names) || int_of(names[i]) == 32 {
            let v = json.get(src, tp, budget, names[start..i]);
            if v >= 0 && !is_count(src, tp, v) {
                return 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    let price = json.get(src, tp, budget, "price_table");
    if price >= 0 && (!json.string_plain(tp, price) || len(json.string_view(src, tp, price)) > 0 && !file_ok(json.string_view(src, tp, price))) {
        return 1;
    }
    return caps_shape_code(src, tp, budget);
}

// `intake` (docs/company.md section 24): a closed object of `max_per_window` and `max_open_per_repo`, each 1 to 1000, at least one. The limits of
// `forge company change add`.
fn intake_shape_code[&s, &t](src: &s [byte], tp: &t [int], intake: int) -> [] int {
    if !json.is_object(tp, intake) {
        return 1;
    }
    let k = keys_code(src, tp, intake, "max_per_window max_open_per_repo");
    if k != 0 {
        return k;
    }
    if json.count(tp, intake) < 1 {
        return 1;
    }
    let a = json.get(src, tp, intake, "max_per_window");
    let b = json.get(src, tp, intake, "max_open_per_repo");
    if a >= 0 && (!is_count(src, tp, a) || json.to_int(src, tp, a) < 1 || json.to_int(src, tp, a) > 1000) {
        return 1;
    }
    if b >= 0 && (!is_count(src, tp, b) || json.to_int(src, tp, b) < 1 || json.to_int(src, tp, b) > 1000) {
        return 1;
    }
    return 0;
}

// `rolling` (`days` 1 to 3660 and `max_cost`, both required) and `per_change` (`max_cost` and `max_attempts` 1 to 1000, at least one): closed objects of
// whole numbers (docs/company.md section 23).
fn caps_shape_code[&s, &t](src: &s [byte], tp: &t [int], budget: int) -> [] int {
    let rolling = json.get(src, tp, budget, "rolling");
    if rolling >= 0 {
        if !json.is_object(tp, rolling) {
            return 1;
        }
        let rk = keys_code(src, tp, rolling, "days max_cost");
        if rk != 0 {
            return rk;
        }
        let days = json.get(src, tp, rolling, "days");
        let cost = json.get(src, tp, rolling, "max_cost");
        if days < 0 || cost < 0 || !is_count(src, tp, days) || !is_count(src, tp, cost) || json.to_int(src, tp, days) < 1 || json.to_int(src, tp, days) > 3660 {
            return 1;
        }
    }
    let each = json.get(src, tp, budget, "per_change");
    if each >= 0 {
        if !json.is_object(tp, each) {
            return 1;
        }
        let ek = keys_code(src, tp, each, "max_cost max_attempts");
        if ek != 0 {
            return ek;
        }
        if json.count(tp, each) < 1 {
            return 1;
        }
        let cost = json.get(src, tp, each, "max_cost");
        let tries = json.get(src, tp, each, "max_attempts");
        if cost >= 0 && !is_count(src, tp, cost) {
            return 1;
        }
        if tries >= 0 && (!is_count(src, tp, tries) || json.to_int(src, tp, tries) < 1 || json.to_int(src, tp, tries) > 1000) {
            return 1;
        }
    }
    return 0;
}

// The presence rules of the budget, after every shape rule held: a missing number is `budget-missing`, a missing or empty
// `price_table` is `price-table-missing`.
fn budget_presence_code[&s, &t](src: &s [byte], tp: &t [int], budget: int) -> [] int {
    if budget < 0 {
        return 10;
    }
    if json.get(src, tp, budget, "input") < 0 || json.get(src, tp, budget, "output") < 0 || json.get(src, tp, budget, "cache_write") < 0 || json.get(src, tp, budget, "cache_read") < 0 || json.get(src, tp, budget, "max_cost") < 0 {
        return 10;
    }
    let price = json.get(src, tp, budget, "price_table");
    if price < 0 || len(json.string_view(src, tp, price)) == 0 {
        return 11;
    }
    return 0;
}

// A list of names (`human_gates`, `roles`): an array of at most `limit` names.
fn names_ok[&s, &t](src: &s [byte], tp: &t [int], arr: int, limit: int) -> [] bool {
    if !json.is_array(tp, arr) || json.count(tp, arr) > limit {
        return false;
    }
    var k = 0;
    while k < json.count(tp, arr) {
        if !is_name(src, tp, json.at(tp, arr, k)) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

// Is the string at node `i` one of the names in the array at node `arr`?
fn in_names[&s, &t](src: &s [byte], tp: &t [int], arr: int, i: int) -> [] bool {
    let view = json.string_view(src, tp, i);
    var k = 0;
    while k < json.count(tp, arr) {
        if json.string_equals(src, tp, json.at(tp, arr, k), view) {
            return true;
        }
        k = k + 1;
    }
    return false;
}

// The shape of one step: keys, and the type of every field. Presence of `check` and `gate` is judged later; a `contract`, unlike a `check`, is a file name or malformed (an empty one is not none).
fn step_shape_code[&s, &t](src: &s [byte], tp: &t [int], step: int) -> [] int {
    if !json.is_object(tp, step) {
        return 1;
    }
    let keys = keys_code(src, tp, step, "id role task_type needs input check contract library gate repo change_kind");
    if keys != 0 {
        return keys;
    }
    let role = json.get(src, tp, step, "role");
    let task_type = json.get(src, tp, step, "task_type");
    let input = json.get(src, tp, step, "input");
    let check = json.get(src, tp, step, "check");
    let contract = json.get(src, tp, step, "contract");
    let library = json.get(src, tp, step, "library");
    let gate = json.get(src, tp, step, "gate");
    let repo = json.get(src, tp, step, "repo");
    let change_kind = json.get(src, tp, step, "change_kind");
    if !is_name(src, tp, json.get(src, tp, step, "id")) || !json.string_plain(tp, role) || !json.string_plain(tp, task_type) {
        return 1;
    }
    if !step_id_ok(json.string_view(src, tp, json.get(src, tp, step, "id"))) {
        return 1;
    }
    if !is_text(src, tp, input) || len(json.string_view(src, tp, input)) == 0 {
        return 1;
    }
    if !names_ok(src, tp, json.get(src, tp, step, "needs"), max_needs()) {
        return 1;
    }
    if check >= 0 && (!json.string_plain(tp, check) || len(json.string_view(src, tp, check)) > 0 && !file_ok(json.string_view(src, tp, check))) {
        return 1;
    }
    if contract >= 0 && (!json.string_plain(tp, contract) || !file_ok(json.string_view(src, tp, contract))) {
        return 1;
    }
    if library >= 0 && !json.string_plain(tp, library) {
        return 1;
    }
    if gate >= 0 && !is_name(src, tp, gate) {
        return 1;
    }
    if repo >= 0 && !is_name(src, tp, repo) {
        return 1;
    }
    if change_kind >= 0 && !json.string_plain(tp, change_kind) {
        return 1;
    }
    return 0;
}

// The kinds of `cancho-build --kind`, which a `repo.change` step's `change_kind` names.
fn change_kind_ok[&v](name: &v [byte]) -> [] bool {
    return bytes.equal(name, "bug") || bytes.equal(name, "feature") || bytes.equal(name, "refactor") || bytes.equal(name, "rename");
}

// Is `name` the `id` of an entry of the `repos` array at node `repos` (-1: none)?
fn repo_listed[&s, &t, &n](src: &s [byte], tp: &t [int], repos: int, name: &n [byte]) -> [] bool {
    if repos < 0 {
        return false;
    }
    var k = 0;
    while k < json.count(tp, repos) {
        let id = json.get(src, tp, json.at(tp, repos, k), "id");
        if bytes.equal(json.string_view(src, tp, id), name) {
            return true;
        }
        k = k + 1;
    }
    return false;
}

// The `repo` and `change_kind` of one step (docs/company-lifecycle.md section 8.1): a `repo.change` step names a repository of `repos`
// (19 without one, 18 for one that is not listed), may name a `change_kind`, and takes no `contract` or `library`; any other task type
// names neither (20).
fn repo_rules_code[&s, &t](src: &s [byte], tp: &t [int], step: int, tcode: int, repos: int, in_flow: bool) -> [] int {
    let repo = json.get(src, tp, step, "repo");
    let kind = json.get(src, tp, step, "change_kind");
    if tcode != 4 {
        if repo >= 0 || kind >= 0 {
            return 20;
        }
        return 0;
    }
    if json.get(src, tp, step, "contract") >= 0 || json.get(src, tp, step, "library") >= 0 {
        return 20;
    }
    if in_flow {
        if kind >= 0 && !change_kind_ok(json.string_view(src, tp, kind)) {
            return 21;
        }
        return 0;
    }
    if repo < 0 {
        return 19;
    }
    if !repo_listed(src, tp, repos, json.string_view(src, tp, repo)) {
        return 18;
    }
    if kind >= 0 && !change_kind_ok(json.string_view(src, tp, kind)) {
        return 21;
    }
    return 0;
}

// The shape of `repos`: an array of at most 64 objects of exactly `id` (a name, as a step id is) and `kind` (a plain string).
fn repos_shape_code[&s, &t](src: &s [byte], tp: &t [int], repos: int) -> [] int {
    if !json.is_array(tp, repos) || json.count(tp, repos) > max_repos() {
        return 1;
    }
    var k = 0;
    while k < json.count(tp, repos) {
        let entry = json.at(tp, repos, k);
        if !json.is_object(tp, entry) {
            return 1;
        }
        let keys = keys_code(src, tp, entry, "id kind");
        if keys != 0 {
            return keys;
        }
        let id = json.get(src, tp, entry, "id");
        let kind = json.get(src, tp, entry, "kind");
        if !is_name(src, tp, id) || !step_id_ok(json.string_view(src, tp, id)) || !json.string_plain(tp, kind) {
            return 1;
        }
        k = k + 1;
    }
    return 0;
}

// A repository kind name as a number 0 to 2, or -1.
fn repo_kind_code[&v](name: &v [byte]) -> [] int {
    if bytes.equal(name, "library") {
        return 0;
    }
    if bytes.equal(name, "program") {
        return 1;
    }
    if bytes.equal(name, "service") {
        return 2;
    }
    return 0 - 1;
}

// The rules of `repos` once its shape held: a kind outside the three (16), then an id twice (17).
fn repos_rules_code[&s, &t](src: &s [byte], tp: &t [int], repos: int) -> [] int {
    var k = 0;
    while k < json.count(tp, repos) {
        let entry = json.at(tp, repos, k);
        if repo_kind_code(json.string_view(src, tp, json.get(src, tp, entry, "kind"))) < 0 {
            return 16;
        }
        k = k + 1;
    }
    k = 0;
    while k < json.count(tp, repos) {
        let a = json.string_view(src, tp, json.get(src, tp, json.at(tp, repos, k), "id"));
        var j = k + 1;
        while j < json.count(tp, repos) {
            if bytes.equal(a, json.string_view(src, tp, json.get(src, tp, json.at(tp, repos, j), "id"))) {
                return 17;
            }
            j = j + 1;
        }
        k = k + 1;
    }
    return 0;
}

// Role, task type, check and gate of one step, against the roles in use and the human gates.
fn step_rules_code[&s, &t](src: &s [byte], tp: &t [int], step: int, roles: int, gates: int, repos: int, in_flow: bool) -> [] int {
    let role_node = json.get(src, tp, step, "role");
    let role = role_code(json.string_view(src, tp, role_node));
    if role < 0 || !in_names(src, tp, roles, role_node) {
        return 6;
    }
    let tcode = type_code(json.string_view(src, tp, json.get(src, tp, step, "task_type")));
    if tcode < 0 || tcode != type_of_role(role) && !(tcode == 4 && role == 0) {
        return 7;
    }
    let check = json.get(src, tp, step, "check");
    if (role == 0 || role == 4) && (check < 0 || len(json.string_view(src, tp, check)) == 0) {
        return 8;
    }
    let repo_code = repo_rules_code(src, tp, step, tcode, repos, in_flow);
    if repo_code != 0 {
        return repo_code;
    }
    if json.get(src, tp, step, "contract") >= 0 && role != 0 && role != 4 {
        return 12;
    }
    let library = json.get(src, tp, step, "library");
    if library >= 0 && role != 0 && role != 4 {
        return 13;
    }
    if library >= 0 && !library_name_ok(json.string_view(src, tp, library)) {
        return 14;
    }
    if library >= 0 && json.get(src, tp, step, "contract") < 0 {
        return 15;
    }
    let gate = json.get(src, tp, step, "gate");
    if gate >= 0 && !in_names(src, tp, gates, gate) {
        return 9;
    }
    return 0;
}

// Step ids twice. Steps are at most 256, so the pairs are at most about 33,000.
fn duplicate_code[&s, &t](src: &s [byte], tp: &t [int], steps: int) -> [] int {
    let n = json.count(tp, steps);
    var a = 0;
    while a < n {
        let ida = json.string_view(src, tp, json.get(src, tp, json.at(tp, steps, a), "id"));
        var b = a + 1;
        while b < n {
            if bytes.equal(ida, json.string_view(src, tp, json.get(src, tp, json.at(tp, steps, b), "id"))) {
                return 3;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return 0;
}

// Every `needs` entry names a step (4), and the steps can be ordered so that each comes after what it needs (5 when they cannot,
// a step needing itself included). The needs are resolved to step numbers into one work slice -- step nodes, starts, the flat needs,
// then a done flag per step -- and the steps are then settled in passes: a step is settled once everything it needs is. A pass that
// settles nothing, with a step left, is a cycle. At most 256 passes over at most 16,384 needs.
fn graph_code[&h, &s, &t](heap: &!h Heap, src: &s [byte], tp: &t [int], steps: int) -> [heap] int {
    let n = json.count(tp, steps);
    var total = 0;
    var i = 0;
    while i < n {
        total = total + json.count(tp, json.get(src, tp, json.at(tp, steps, i), "needs"));
        i = i + 1;
    }
    let starts = n;
    let flat = 2 * n + 1;
    let done = flat + total;
    let work = box_slice(heap, done + n, 0);
    var code = 0;
    borrow mut work as &!w in {
        let ws = contents(w);
        i = 0;
        while i < n {
            ws[i] = json.at(tp, steps, i);
            i = i + 1;
        }
        i = 0;
        var at = 0;
        while i < n {
            let step = ws[i];
            ws[starts + i] = at;
            let needs = json.get(src, tp, step, "needs");
            var k = 0;
            while k < json.count(tp, needs) {
                let want = json.string_view(src, tp, json.at(tp, needs, k));
                var found = 0 - 1;
                var j = 0;
                while j < n {
                    if bytes.equal(want, json.string_view(src, tp, json.get(src, tp, ws[j], "id"))) {
                        found = j;
                    }
                    j = j + 1;
                }
                if found < 0 {
                    code = 4;
                } else {
                    ws[flat + at] = found;
                }
                at = at + 1;
                k = k + 1;
            }
            i = i + 1;
        }
        ws[starts + n] = at;
        if code == 0 {
            var changed = true;
            var settled = 0;
            while changed {
                changed = false;
                i = 0;
                while i < n {
                    if ws[done + i] == 0 {
                        var ready = true;
                        var e = ws[starts + i];
                        while e < ws[starts + i + 1] {
                            if ws[done + ws[flat + e]] == 0 {
                                ready = false;
                            }
                            e = e + 1;
                        }
                        if ready {
                            ws[done + i] = 1;
                            settled = settled + 1;
                            changed = true;
                        }
                    }
                    i = i + 1;
                }
            }
            if settled < n {
                code = 5;
            }
        }
    }
    unbox_slice(heap, work);
    return code;
}

// The most flows, and the most steps of one (docs/company-lifecycle.md section 3).
pub fn max_flows() -> [] int {
    return 16;
}

pub fn max_flow_steps() -> [] int {
    return 16;
}

// `flows`: an object of at most 16 flows, each a name and an array of 1 to 16 steps. The shape of every flow, then its rules, in the order of the header.
fn flows_code[&h, &s, &t](heap: &!h Heap, src: &s [byte], tp: &t [int], flows: int, roles: int, gates: int) -> [heap] int {
    if !json.is_object(tp, flows) || json.count(tp, flows) > max_flows() {
        return 1;
    }
    let n = json.count(tp, flows);
    var j = flows + 1;
    var k = 0;
    while k < n {
        if !json.string_plain(tp, j) || !name_ok(json.string_view(src, tp, j), 64) {
            return 1;
        }
        var e = flows + 1;
        var q = 0;
        while q < k {
            if bytes.equal(json.string_view(src, tp, j), json.string_view(src, tp, e)) {
                return 1;
            }
            e = json.skip(tp, e + 1);
            q = q + 1;
        }
        let arr = j + 1;
        if !json.is_array(tp, arr) || json.count(tp, arr) < 1 {
            return 1;
        }
        if json.count(tp, arr) > max_flow_steps() {
            return 22;
        }
        var i = 0;
        while i < json.count(tp, arr) {
            let c = step_shape_code(src, tp, json.at(tp, arr, i));
            if c != 0 {
                return c;
            }
            i = i + 1;
        }
        j = json.skip(tp, arr);
        k = k + 1;
    }
    j = flows + 1;
    k = 0;
    while k < n {
        let arr = j + 1;
        let dup = duplicate_code(src, tp, arr);
        if dup != 0 {
            return dup;
        }
        var i = 0;
        while i < json.count(tp, arr) {
            let step = json.at(tp, arr, i);
            if json.get(src, tp, step, "repo") >= 0 {
                return 23;
            }
            let c = step_rules_code(src, tp, step, roles, gates, 0 - 1, true);
            if c != 0 {
                return c;
            }
            i = i + 1;
        }
        var g = graph_code(heap, src, tp, arr);
        if g == 4 {
            g = 24;
        }
        if g != 0 {
            return g;
        }
        j = json.skip(tp, arr);
        k = k + 1;
    }
    return 0;
}

// Everything but the size and the JSON: the root object `0` of the tape over `src`.
fn validate[&h, &s, &t](heap: &!h Heap, src: &s [byte], tp: &t [int]) -> [heap] int {
    let keys = keys_code(src, tp, 0, "id mission model budget human_gates roles repos flows intake steps");
    if keys != 0 {
        return keys;
    }
    let model = json.get(src, tp, 0, "model");
    let budget = json.get(src, tp, 0, "budget");
    let gates = json.get(src, tp, 0, "human_gates");
    let roles = json.get(src, tp, 0, "roles");
    let steps = json.get(src, tp, 0, "steps");
    let repos = json.get(src, tp, 0, "repos");
    if !is_name(src, tp, json.get(src, tp, 0, "id")) || !is_text(src, tp, json.get(src, tp, 0, "mission")) {
        return 1;
    }
    let m = model_code(src, tp, model);
    if m != 0 {
        return m;
    }
    if budget >= 0 {
        let b = budget_shape_code(src, tp, budget);
        if b != 0 {
            return b;
        }
    }
    if !names_ok(src, tp, gates, max_gates()) || !names_ok(src, tp, roles, 6) {
        return 1;
    }
    if !json.is_array(tp, steps) || json.count(tp, steps) < 1 || json.count(tp, steps) > max_steps() {
        return 1;
    }
    if repos >= 0 {
        let r = repos_shape_code(src, tp, repos);
        if r != 0 {
            return r;
        }
    }
    let intake = json.get(src, tp, 0, "intake");
    if intake >= 0 {
        let k = intake_shape_code(src, tp, intake);
        if k != 0 {
            return k;
        }
    }
    var i = 0;
    while i < json.count(tp, steps) {
        let c = step_shape_code(src, tp, json.at(tp, steps, i));
        if c != 0 {
            return c;
        }
        i = i + 1;
    }
    let presence = budget_presence_code(src, tp, budget);
    if presence != 0 {
        return presence;
    }
    i = 0;
    while i < json.count(tp, roles) {
        if role_code(json.string_view(src, tp, json.at(tp, roles, i))) < 0 {
            return 6;
        }
        i = i + 1;
    }
    if repos >= 0 {
        let r = repos_rules_code(src, tp, repos);
        if r != 0 {
            return r;
        }
    }
    let dup = duplicate_code(src, tp, steps);
    if dup != 0 {
        return dup;
    }
    i = 0;
    while i < json.count(tp, steps) {
        let c = step_rules_code(src, tp, json.at(tp, steps, i), roles, gates, repos, false);
        if c != 0 {
            return c;
        }
        i = i + 1;
    }
    let g = graph_code(heap, src, tp, steps);
    if g != 0 {
        return g;
    }
    let flows = json.get(src, tp, 0, "flows");
    if flows >= 0 {
        return flows_code(heap, src, tp, flows, roles, gates);
    }
    return 0;
}

// ---- parse ----------------------------------------------------------------------------------------------------------------

// Parse and validate `text`. A manifest that passes owns a copy of the text and the tape over it; end it with `drop`. Nothing a
// text can say reaches a trap: the size is checked before the tape is made, every walk is bounded, every index is a node the
// tape answered.
pub fn parse[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] ManifestResult {
    if len(text) < 1 || len(text) > max_bytes() {
        return ManifestResult::Refused(Refusal::ManifestMalformed);
    }
    let tape = box_slice(heap, json.tape_len(text), 0);
    var code = 1;
    borrow mut tape as &!w in {
        let tp = contents(w);
        if json.parse(text, tp) > 0 && json.is_object(tp, 0) {
            code = validate(heap, text, tp);
        }
    }
    if code != 0 {
        unbox_slice(heap, tape);
        return ManifestResult::Refused(refusal_of(code));
    }
    var id = 0 - 1;
    var provider = 0 - 1;
    var price_table = 0 - 1;
    var steps = 0 - 1;
    var gates = 0 - 1;
    var repos = 0 - 1;
    var flows = 0 - 1;
    var count = 0;
    var input = 0;
    var output = 0;
    var cache_write = 0;
    var cache_read = 0;
    var max_cost = 0;
    var rolling_days = 0;
    var rolling_cost = 0;
    var change_cost = 0 - 1;
    var change_attempts = 0;
    var intake_window = 0;
    var intake_open = 0;
    borrow tape as &r in {
        let tp = contents(r);
        id = json.get(text, tp, 0, "id");
        provider = json.get(text, tp, json.get(text, tp, 0, "model"), "provider");
        let budget = json.get(text, tp, 0, "budget");
        price_table = json.get(text, tp, budget, "price_table");
        steps = json.get(text, tp, 0, "steps");
        gates = json.get(text, tp, 0, "human_gates");
        repos = json.get(text, tp, 0, "repos");
        flows = json.get(text, tp, 0, "flows");
        count = json.count(tp, steps);
        input = json.to_int(text, tp, json.get(text, tp, budget, "input"));
        output = json.to_int(text, tp, json.get(text, tp, budget, "output"));
        cache_write = json.to_int(text, tp, json.get(text, tp, budget, "cache_write"));
        cache_read = json.to_int(text, tp, json.get(text, tp, budget, "cache_read"));
        max_cost = json.to_int(text, tp, json.get(text, tp, budget, "max_cost"));
        let rolling = json.get(text, tp, budget, "rolling");
        if rolling >= 0 {
            rolling_days = json.to_int(text, tp, json.get(text, tp, rolling, "days"));
            rolling_cost = json.to_int(text, tp, json.get(text, tp, rolling, "max_cost"));
        }
        let intake = json.get(text, tp, 0, "intake");
        if intake >= 0 {
            intake_window = 20;
            intake_open = 5;
            if json.get(text, tp, intake, "max_per_window") >= 0 {
                intake_window = json.to_int(text, tp, json.get(text, tp, intake, "max_per_window"));
            }
            if json.get(text, tp, intake, "max_open_per_repo") >= 0 {
                intake_open = json.to_int(text, tp, json.get(text, tp, intake, "max_open_per_repo"));
            }
        }
        let each = json.get(text, tp, budget, "per_change");
        if json.get(text, tp, each, "max_cost") >= 0 {
            change_cost = json.to_int(text, tp, json.get(text, tp, each, "max_cost"));
        }
        if json.get(text, tp, each, "max_attempts") >= 0 {
            change_attempts = json.to_int(text, tp, json.get(text, tp, each, "max_attempts"));
        }
    }
    return ManifestResult::Held(Manifest { text: buffer.append(heap, buffer.empty(heap, len(text)), text), tape: tape, id: id, provider: provider, price_table: price_table, steps: steps, gates: gates, repos: repos, flows: flows, dtext: buffer.empty(heap, 1), dtape: box_slice(heap, 1, 0), dsteps: 0 - 1, dcount: 0, step_count: count, input: input, output: output, cache_write: cache_write, cache_read: cache_read, max_cost: max_cost, rolling_days: rolling_days, rolling_cost: rolling_cost, change_cost: change_cost, change_attempts: change_attempts, intake_window: intake_window, intake_open: intake_open });
}

pub fn drop[&h](heap: &!h Heap, m: Manifest) -> [heap] int {
    let Manifest { text, tape, id, provider, price_table, steps, gates, repos, flows, dtext, dtape, dsteps, dcount, step_count, input, output, cache_write, cache_read, max_cost, rolling_days, rolling_cost, change_cost, change_attempts, intake_window, intake_open } = m;
    buffer.drop(heap, text);
    unbox_slice(heap, tape);
    buffer.drop(heap, dtext);
    unbox_slice(heap, dtape);
    return 0;
}

// ---- reading a held manifest ----------------------------------------------------------------------------------------------

fn text_at[&m](m: &m Manifest, node: int) -> [] &m [byte] {
    if node < 0 {
        return buffer.bytes(m.text)[0..0];
    }
    return json.string_view(buffer.bytes(m.text), contents(m.tape), node);
}

pub fn id_of[&m](m: &m Manifest) -> [] &m [byte] {
    return text_at(m, m.id);
}

pub fn provider_of[&m](m: &m Manifest) -> [] &m [byte] {
    return text_at(m, m.provider);
}

// The model's `name` (a name, 1 to 64 bytes, as `parse` checked it).
pub fn model_of[&m](m: &m Manifest) -> [] &m [byte] {
    let src = buffer.bytes(m.text);
    let tp = contents(m.tape);
    return text_at(m, json.get(src, tp, json.get(src, tp, 0, "model"), "name"));
}

pub fn price_table_of[&m](m: &m Manifest) -> [] &m [byte] {
    return text_at(m, m.price_table);
}

pub fn budget_input[&m](m: &m Manifest) -> [] int {
    return m.input;
}

pub fn budget_output[&m](m: &m Manifest) -> [] int {
    return m.output;
}

pub fn budget_cache_write[&m](m: &m Manifest) -> [] int {
    return m.cache_write;
}

pub fn budget_cache_read[&m](m: &m Manifest) -> [] int {
    return m.cache_read;
}

pub fn budget_max_cost[&m](m: &m Manifest) -> [] int {
    return m.max_cost;
}

// The rolling cap (`budget.rolling`): the days of its window and its ceiling in whole dollars; both 0 for a manifest without one.
pub fn budget_rolling_days[&m](m: &m Manifest) -> [] int {
    return m.rolling_days;
}

pub fn budget_rolling_cost[&m](m: &m Manifest) -> [] int {
    return m.rolling_cost;
}

// The per-change caps (`budget.per_change`): the cost one change's steps may reach, in whole dollars (-1 for none; 0 is a cap of nothing), and how many
// times its model steps may be admitted (0 for none).
pub fn budget_change_cost[&m](m: &m Manifest) -> [] int {
    return m.change_cost;
}

pub fn budget_change_attempts[&m](m: &m Manifest) -> [] int {
    return m.change_attempts;
}

// The intake limits (`intake`): proposals accepted per window, and changes open per repository; 0 for both when the manifest has no `intake`, else the
// key's value, or its default (20 and 5) when the key is left out.
pub fn intake_per_window[&m](m: &m Manifest) -> [] int {
    return m.intake_window;
}

pub fn intake_open_per_repo[&m](m: &m Manifest) -> [] int {
    return m.intake_open;
}

// Is `name` one of the manifest's `human_gates`? An empty name is not.
pub fn has_gate[&m, &n](m: &m Manifest, name: &n [byte]) -> [] bool {
    if len(name) == 0 {
        return false;
    }
    let tp = contents(m.tape);
    var k = 0;
    while k < json.count(tp, m.gates) {
        if bytes.equal(text_at(m, json.at(tp, m.gates, k)), name) {
            return true;
        }
        k = k + 1;
    }
    return false;
}

// How many names `human_gates` lists.
pub fn gate_count[&m](m: &m Manifest) -> [] int {
    return json.count(contents(m.tape), m.gates);
}

// The `k`th name of `human_gates` (0-based); empty outside the list.
pub fn gate_at[&m](m: &m Manifest, k: int) -> [] &m [byte] {
    if k < 0 || k >= gate_count(m) {
        return buffer.bytes(m.text)[0..0];
    }
    return text_at(m, json.at(contents(m.tape), m.gates, k));
}

// All the steps: the manifest's own, then the derived ones (`extend`).
pub fn step_count[&m](m: &m Manifest) -> [] int {
    return m.step_count + m.dcount;
}

// The manifest's own steps, the ones before the derived ones.
pub fn own_step_count[&m](m: &m Manifest) -> [] int {
    return m.step_count;
}

// Is `name` a module name `cancho-build --library` accepts? The same rule as `build_task.library_ok` (a copy, so that this module imports
// nothing; tests/company_step_test.cho holds the two to the same answer): lowercase letters, digits and `_`, not starting with a digit,
// 1 to 64 bytes, and not `std` or `test`.
pub fn library_name_ok[&n](name: &n [byte]) -> [] bool {
    if len(name) == 0 || len(name) > 64 {
        return false;
    }
    if bytes.equal(name, "std") || bytes.equal(name, "test") {
        return false;
    }
    var i = 0;
    while i < len(name) {
        let c = int_of(name[i]);
        let letter = c >= 97 && c <= 122;
        let digit = c >= 48 && c <= 57;
        if !(letter || c == 95 || digit && i > 0) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Step `i`, 0-based; an `i` outside 0 to `step_count - 1` is the first step.
pub fn step_at[&m](m: &m Manifest, i: int) -> [] Step {
    if i >= m.step_count && i < m.step_count + m.dcount {
        return step_of(m, 1, json.at(contents(m.dtape), m.dsteps, i - m.step_count));
    }
    var at = i;
    if at < 0 || at >= m.step_count {
        at = 0;
    }
    return step_of(m, 0, json.at(contents(m.tape), m.steps, at));
}

// The step whose object is node `node` of the tape of source `src` (0 the manifest's own text, 1 the derived steps').
fn step_of[&m](m: &m Manifest, src: int, node: int) -> [] Step {
    var tp = contents(m.tape);
    var text = buffer.bytes(m.text);
    if src == 1 {
        tp = contents(m.dtape);
        text = buffer.bytes(m.dtext);
    }
    let role = role_code(json.string_view(text, tp, json.get(text, tp, node, "role")));
    let tcode = type_code(json.string_view(text, tp, json.get(text, tp, node, "task_type")));
    return Step { id: json.get(text, tp, node, "id"), role: role_of(role), task_type: type_of(tcode), needs: json.get(text, tp, node, "needs"), input: json.get(text, tp, node, "input"), check: json.get(text, tp, node, "check"), contract: json.get(text, tp, node, "contract"), library: json.get(text, tp, node, "library"), gate: json.get(text, tp, node, "gate"), repo: json.get(text, tp, node, "repo"), change_kind: json.get(text, tp, node, "change_kind"), src: src };
}

// The text of node `node` of the source a step came from.
fn text_of[&m](m: &m Manifest, src: int, node: int) -> [] &m [byte] {
    if src == 1 {
        if node < 0 {
            return buffer.bytes(m.dtext)[0..0];
        }
        return json.string_view(buffer.bytes(m.dtext), contents(m.dtape), node);
    }
    return text_at(m, node);
}

// ---- flows ----------------------------------------------------------------------------------------------------------------

// The key node of flow number `k` of `flows` (the array is the next node), or -1.
fn flow_key[&m](m: &m Manifest, k: int) -> [] int {
    let tp = contents(m.tape);
    if m.flows < 0 || k < 0 || k >= json.count(tp, m.flows) {
        return 0 - 1;
    }
    var j = m.flows + 1;
    var q = 0;
    while q < k {
        j = json.skip(tp, j + 1);
        q = q + 1;
    }
    return j;
}

// How many flows the manifest declares (0 for a manifest with no `flows`).
pub fn flow_count[&m](m: &m Manifest) -> [] int {
    if m.flows < 0 {
        return 0;
    }
    return json.count(contents(m.tape), m.flows);
}

pub fn flow_name_at[&m](m: &m Manifest, k: int) -> [] &m [byte] {
    return text_at(m, flow_key(m, k));
}

// The number of the flow called `name`, or -1.
pub fn flow_index[&m, &n](m: &m Manifest, name: &n [byte]) -> [] int {
    var k = 0;
    while k < flow_count(m) {
        if bytes.equal(flow_name_at(m, k), name) {
            return k;
        }
        k = k + 1;
    }
    return 0 - 1;
}

// The steps of flow `k`; 0 for none.
pub fn flow_step_count[&m](m: &m Manifest, k: int) -> [] int {
    let key = flow_key(m, k);
    if key < 0 {
        return 0;
    }
    return json.count(contents(m.tape), key + 1);
}

// Step `i` of flow `k` (the first step of the manifest's `steps` for an index outside the flow: callers check the counts).
pub fn flow_step_at[&m](m: &m Manifest, k: int, i: int) -> [] Step {
    let key = flow_key(m, k);
    if key < 0 || i < 0 || i >= flow_step_count(m, k) {
        return step_at(m, 0);
    }
    return step_of(m, 0, json.at(contents(m.tape), key + 1, i));
}

pub fn step_id[&m](m: &m Manifest, s: Step) -> [] &m [byte] {
    return text_of(m, s.src, s.id);
}

// The step's input as written (an escape in it is still escaped).
pub fn step_input[&m](m: &m Manifest, s: Step) -> [] &m [byte] {
    return text_of(m, s.src, s.input);
}

// The step's check file name, empty when it has none.
pub fn step_check[&m](m: &m Manifest, s: Step) -> [] &m [byte] {
    return text_of(m, s.src, s.check);
}

// The step's contract file name (a builder's or writer's), empty when it has none.
pub fn step_contract[&m](m: &m Manifest, s: Step) -> [] &m [byte] {
    return text_of(m, s.src, s.contract);
}

// The step's library name (a builder's or writer's), empty when it has none.
pub fn step_library[&m](m: &m Manifest, s: Step) -> [] &m [byte] {
    return text_of(m, s.src, s.library);
}

// The step's gate, empty when it has none.
pub fn step_gate[&m](m: &m Manifest, s: Step) -> [] &m [byte] {
    return text_of(m, s.src, s.gate);
}

pub fn step_needs_count[&m](m: &m Manifest, s: Step) -> [] int {
    if s.src == 1 {
        return json.count(contents(m.dtape), s.needs);
    }
    return json.count(contents(m.tape), s.needs);
}

// The id of what the step needs, `k`th (0-based); empty outside the list.
pub fn step_need[&m](m: &m Manifest, s: Step, k: int) -> [] &m [byte] {
    if s.src == 1 {
        return text_of(m, 1, json.at(contents(m.dtape), s.needs, k));
    }
    return text_at(m, json.at(contents(m.tape), s.needs, k));
}

// Is the step a derived one (from a flow, for a change)?
pub fn step_is_derived(s: Step) -> [] bool {
    return s.src == 1;
}

// The step's role and task type as written in a manifest, for the writer of derived steps.
pub fn step_role_name(s: Step) -> [] &static [byte] {
    match s.role {
        Role::Builder => {
            return "builder";
        }
        Role::Qa => {
            return "qa";
        }
        Role::Analyst => {
            return "analyst";
        }
        Role::Reviewer => {
            return "reviewer";
        }
        Role::Writer => {
            return "writer";
        }
        Role::Product => {
            return "product";
        }
    }
}

pub fn step_task_name(s: Step) -> [] &static [byte] {
    match s.task_type {
        TaskType::ProjectBuild => {
            return "project.build";
        }
        TaskType::RepoGate => {
            return "repo.gate";
        }
        TaskType::ToolRun => {
            return "tool.run";
        }
        TaskType::None => {
            return "none";
        }
        TaskType::RepoChange => {
            return "repo.change";
        }
    }
}

// ---- derived steps ----------------------------------------------------------------------------------------------------------

// Add derived steps (docs/company.md section 19): `derived` is a JSON array of step objects in the shape of `steps`, written by Forge from a
// flow and a change (src/company_derive.cho). They are read after the manifest's own steps, by step number, with the same readers. 0 when added;
// 1 when the text is not an array of steps (or the manifest already has derived steps), 2 when the steps would pass the 256 of `max_steps`.
// The manifest is handed back either way.
pub fn extend[&h, &t](heap: &!h Heap, m: Manifest, derived: &t [byte]) -> [heap] (Manifest, int) {
    var have = 0;
    var own_count = 0;
    borrow m as &mr in {
        have = mr.dcount;
        own_count = mr.step_count;
    }
    if have > 0 {
        return (m, 1);
    }
    let dt = box_slice(heap, json.tape_len(derived), 0);
    var code = 1;
    var count = 0;
    var node = 0 - 1;
    borrow mut dt as &!w in {
        let tp = contents(w);
        if json.parse(derived, tp) > 0 && json.is_array(tp, 0) {
            code = 0;
            node = 0;
            count = json.count(tp, 0);
            var i = 0;
            while i < count && code == 0 {
                code = step_shape_code(derived, tp, json.at(tp, 0, i));
                i = i + 1;
            }
        }
    }
    if code == 0 && own_count + count > max_steps() {
        code = 2;
    }
    if code != 0 {
        unbox_slice(heap, dt);
        return (m, code);
    }
    let Manifest { text, tape, id, provider, price_table, steps, gates, repos, flows, dtext, dtape, dsteps, dcount, step_count, input, output, cache_write, cache_read, max_cost, rolling_days, rolling_cost, change_cost, change_attempts, intake_window, intake_open } = m;
    buffer.drop(heap, dtext);
    unbox_slice(heap, dtape);
    return (Manifest { text: text, tape: tape, id: id, provider: provider, price_table: price_table, steps: steps, gates: gates, repos: repos, flows: flows, dtext: buffer.append(heap, buffer.empty(heap, len(derived) + 1), derived), dtape: dt, dsteps: node, dcount: count, step_count: step_count, input: input, output: output, cache_write: cache_write, cache_read: cache_read, max_cost: max_cost, rolling_days: rolling_days, rolling_cost: rolling_cost, change_cost: change_cost, change_attempts: change_attempts, intake_window: intake_window, intake_open: intake_open }, 0);
}

// The step's repository id (a `repo.change` step's), empty when it has none.
pub fn step_repo[&m](m: &m Manifest, s: Step) -> [] &m [byte] {
    return text_of(m, s.src, s.repo);
}

// The step's `change_kind` as written, empty when it has none (`cancho-build`'s default, `feature`, is then used).
pub fn step_change_kind[&m](m: &m Manifest, s: Step) -> [] &m [byte] {
    return text_of(m, s.src, s.change_kind);
}

// Does the step run as a `repo.change` task?
pub fn is_repo_change(s: Step) -> [] bool {
    match s.task_type {
        TaskType::RepoChange => {
            return true;
        }
        TaskType::ProjectBuild => {
            return false;
        }
        TaskType::RepoGate => {
            return false;
        }
        TaskType::ToolRun => {
            return false;
        }
        TaskType::None => {
            return false;
        }
    }
}

// How many entries `repos` lists (0 for a manifest without one).
pub fn repo_count[&m](m: &m Manifest) -> [] int {
    if m.repos < 0 {
        return 0;
    }
    return json.count(contents(m.tape), m.repos);
}

// The `id` of the `k`th `repos` entry (0-based); empty outside the list.
pub fn repo_id_at[&m](m: &m Manifest, k: int) -> [] &m [byte] {
    if k < 0 || k >= repo_count(m) {
        return buffer.bytes(m.text)[0..0];
    }
    let tp = contents(m.tape);
    return text_at(m, json.get(buffer.bytes(m.text), tp, json.at(tp, m.repos, k), "id"));
}

// The `kind` of the `k`th `repos` entry (a held manifest: one of the three); `Library` outside the list.
pub fn repo_kind_at[&m](m: &m Manifest, k: int) -> [] RepoKind {
    if k < 0 || k >= repo_count(m) {
        return RepoKind::Library;
    }
    let tp = contents(m.tape);
    let src = buffer.bytes(m.text);
    let code = repo_kind_code(json.string_view(src, tp, json.get(src, tp, json.at(tp, m.repos, k), "kind")));
    if code == 1 {
        return RepoKind::Program;
    }
    if code == 2 {
        return RepoKind::Service;
    }
    return RepoKind::Library;
}

// The index in `repos` of the repository `name`, or -1.
pub fn repo_index[&m, &n](m: &m Manifest, name: &n [byte]) -> [] int {
    var k = 0;
    while k < repo_count(m) {
        if bytes.equal(repo_id_at(m, k), name) {
            return k;
        }
        k = k + 1;
    }
    return 0 - 1;
}

// The kind's name as the manifest and the operator file spell it.
pub fn repo_kind_name(k: RepoKind) -> [] &static [byte] {
    match k {
        RepoKind::Library => {
            return "library";
        }
        RepoKind::Program => {
            return "program";
        }
        RepoKind::Service => {
            return "service";
        }
    }
}
