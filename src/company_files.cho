edition 9;
module forge.company_files;

import std.buffer;
import std.bytes;
import std.crypto;
import forge.company_step;
import forge.journal_io;

// The company runner's two file operations on a directory it does not trust (task 8c, task 10), and the contract file of a builder
// step (task 10; spec section on the contract arms). Split from `forge.company_runner` so that module stays under its size mark.
//
// `read_artifact` reads a file beneath a directory by the rules an artifact is accepted by (a regular file, at most 16 MiB, no
// link followed). `put_beneath` replaces a name beneath a directory without ever writing through a link.
//
// THE CONTRACT. A builder or writer step may name a `contract` (company_manifest: a plain file name in the company directory, the
// manifest author's). Forge does not hand the build tool that file's path. It reads the file with `read_artifact` and WRITES its own
// copy, `contract.txt`, in the step's execution directory with `put_beneath`; the build tool is then given the path of the copy
// (`build_task.contract_ok`: a path beneath the execution directory, so `contract-path-invalid` stays meaningful). The build tool
// reads a copy that Forge wrote and verified, never a path the manifest author or a step chose; and because the build can write in
// its execution directory, Forge reads the copy again when the build ends and compares it with the company directory's file
// (`contract_intact`): a build that changed its contract is refused (`artifact-invalid`, `reason: contract-changed`), not accepted.

// The bytes of the artifact `name` beneath the directory `dir`, and 0, or why it is refused (`company_step.artifact_reason`: 1 not
// there, 2 not a regular file, 3 too large, 4 unreadable). `dir_stat` never follows a link and never opens, so a link, a directory
// or a FIFO is refused before any open (a FIFO would block it); the open is `dir_open_read`, beneath the directory with O_NOFOLLOW,
// so a link put there between the two is refused too. The same rules at acceptance and when a dependent step is given it.
pub fn read_artifact[&h, &f, &d, &n](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], name: &n [byte]) -> [heap, fs_read(""), dir_read, file_read] (buffer.Buffer, int) {
    var data = buffer.empty(heap, 256);
    var why = 4;
    if journal_io.path_ok(fs, dir) == false {
        return (data, why);
    }
    match open_dir(fs, dir) {
        DirOpened::Failed(e) => {
            why = 4;
        }
        DirOpened::Ok(opened) => {
            var d = opened;
            borrow d as &dr in {
                match dir_stat(dr, name) {
                    DirStat::Failed(e) => {
                        why = 4;
                        if e == 2 {
                            why = 1;
                        }
                    }
                    DirStat::Ok(kind, size, mtime) => {
                        if kind != 1 {
                            why = 2;
                        } else if size > company_step.artifact_cap() {
                            why = 3;
                        } else {
                            match dir_open_read(dr, name) {
                                Opened::Failed(e) => {
                                    why = 2;
                                    if e == 2 {
                                        why = 1;
                                    }
                                }
                                Opened::Ok(file_opened) => {
                                    var file = file_opened;
                                    var errno = 0;
                                    borrow mut file as &!x in {
                                        let (got, e2) = journal_io.drain(heap, x, data, company_step.artifact_cap());
                                        data = got;
                                        errno = e2;
                                    }
                                    file_close(file);
                                    if errno == 0 - 3 {
                                        why = 3;
                                    } else if errno != 0 {
                                        why = 4;
                                    } else {
                                        why = 0;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            dir_close(d);
        }
    }
    return (data, why);
}

// Replace `name` beneath the directory `d` with `data`: written to `needs.tmp` (a stale one removed first), created with O_EXCL and
// O_NOFOLLOW, then renamed over `name`. A link at either name is never written through: `unlinkat` removes the link, `O_EXCL`
// refuses one, `renameat` replaces one. 0 or an errno (a directory at `name` cannot be replaced).
pub fn put_beneath[&d, &n, &b](d: &d Dir, name: &n [byte], data: &b [byte]) -> [dir_write, file_write] int {
    // A stale temporary (a run killed between the open and the rename, or anything left there) is removed; none is fine.
    var removed = 0;
    match dir_remove(d, "needs.tmp") {
        Done::Ok(n) => {
            removed = 0;
        }
        Done::Failed(e) => {
            removed = e;
        }
    }
    match dir_open_new(d, "needs.tmp") {
        Opened::Failed(e) => {
            return e;
        }
        Opened::Ok(opened) => {
            var file = opened;
            var rc = 0;
            borrow mut file as &!x in {
                rc = journal_io.write_all(x, data);
            }
            file_close(file);
            if rc != 0 {
                return rc;
            }
            match dir_rename(d, "needs.tmp", name) {
                Done::Ok(n) => {
                    return 0;
                }
                Done::Failed(e) => {
                    return e;
                }
            }
        }
    }
}

// The name the contract is given in the execution directory.
pub fn contract_name() -> [] &static [byte] {
    return "contract.txt";
}

// Give the step its contract: the file `name` of the company directory `dir` is read (`read_artifact`; the reason it is refused is
// returned: 1 not there, 2 not a regular file, 3 too large, 4 unreadable) and written as `contract.txt` beneath `evdir`, replacing
// anything there (a link included). 0, or the reason, or 6 when the execution directory cannot be opened or written.
pub fn deliver_contract[&h, &f, &d, &n, &e](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], name: &n [byte], evdir: &e [byte]) -> [heap, fs_read(""), dir_read, dir_write, file_read, file_write] int {
    let (data, why) = read_artifact(heap, fs, dir, name);
    var code = why;
    var size = 0;
    borrow data as &sb in {
        size = buffer.size(sb);
    }
    if why == 0 && size > company_step.contract_cap() {
        code = 3;
    } else if why == 0 {
        code = 6;
        if journal_io.path_ok(fs, evdir) {
            match open_dir(fs, evdir) {
                DirOpened::Failed(e2) => {
                    code = 6;
                }
                DirOpened::Ok(opened) => {
                    var ed = opened;
                    borrow ed as &edr in {
                        borrow data as &db in {
                            if put_beneath(edr, contract_name(), buffer.bytes(db)) == 0 {
                                code = 0;
                            }
                        }
                    }
                    dir_close(ed);
                }
            }
        }
    }
    buffer.drop(heap, data);
    return code;
}

// A step that names no contract: a `contract.txt` an earlier start (an earlier manifest) left in `evdir` is Forge's and is removed, so
// a build never meets a contract it was not given. Nothing there is fine.
pub fn clear_contract[&f, &e](fs: &f Fs(""), evdir: &e [byte]) -> [fs_read(""), dir_write] int {
    if !journal_io.path_ok(fs, evdir) {
        return 0;
    }
    match open_dir(fs, evdir) {
        DirOpened::Failed(e2) => {
            return 0;
        }
        DirOpened::Ok(opened) => {
            var ed = opened;
            var removed = 0;
            borrow ed as &edr in {
                match dir_remove(edr, contract_name()) {
                    Done::Ok(n) => {
                        removed = 1;
                    }
                    Done::Failed(e3) => {
                        removed = 0;
                    }
                }
            }
            dir_close(ed);
            return removed;
        }
    }
}

// After the build: is `contract.txt` in `evdir` still, byte for byte, the file `name` of the company directory? True when both can
// be read and are equal.
pub fn contract_intact[&h, &f, &d, &n, &e](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], name: &n [byte], evdir: &e [byte]) -> [heap, fs_read(""), dir_read, file_read] bool {
    let (want, w) = read_artifact(heap, fs, dir, name);
    let (have, h2) = read_artifact(heap, fs, evdir, contract_name());
    var same = false;
    if w == 0 && h2 == 0 {
        borrow want as &wb in {
            borrow have as &hb in {
                same = bytes.equal(buffer.bytes(wb), buffer.bytes(hb));
            }
        }
    }
    buffer.drop(heap, want);
    buffer.drop(heap, have);
    return same;
}

// ---- the library of a library step (docs/library-steps.md) -----------------------------------------------------------------

// The file of the execution directory that names the module (the same name `build_task.library_file` gives the adapter).
pub fn library_name_file() -> [] &static [byte] {
    return "library.txt";
}

// Give a library step its module name: written as `library.txt` beneath `evdir`, replacing anything there (a link included), the way
// `deliver_contract` writes `contract.txt`. 0, or 6 when the execution directory cannot be opened or written.
pub fn deliver_library[&f, &n, &e](fs: &f Fs(""), name: &n [byte], evdir: &e [byte]) -> [fs_read(""), dir_write, file_write] int {
    if !journal_io.path_ok(fs, evdir) {
        return 6;
    }
    match open_dir(fs, evdir) {
        DirOpened::Failed(e2) => {
            return 6;
        }
        DirOpened::Ok(opened) => {
            var ed = opened;
            var code = 6;
            borrow ed as &edr in {
                if put_beneath(edr, library_name_file(), name) == 0 {
                    code = 0;
                }
            }
            dir_close(ed);
            return code;
        }
    }
}

// A step that names no library: a `library.txt` an earlier start left in `evdir` is Forge's and is removed, so a build never meets a
// library name it was not given. Nothing there is fine.
pub fn clear_library[&f, &e](fs: &f Fs(""), evdir: &e [byte]) -> [fs_read(""), dir_write] int {
    if !journal_io.path_ok(fs, evdir) {
        return 0;
    }
    match open_dir(fs, evdir) {
        DirOpened::Failed(e2) => {
            return 0;
        }
        DirOpened::Ok(opened) => {
            var ed = opened;
            var removed = 0;
            borrow ed as &edr in {
                match dir_remove(edr, library_name_file()) {
                    Done::Ok(n) => {
                        removed = 1;
                    }
                    Done::Failed(e3) => {
                        removed = 0;
                    }
                }
            }
            dir_close(ed);
            return removed;
        }
    }
}

// The SHA-256 of `data` as lowercase hex.
pub fn hex_of[&h, &b](heap: &!h Heap, data: &b [byte]) -> [heap] buffer.Buffer {
    let digest = box_slice(heap, 32, byte_of(0));
    borrow mut digest as &!dw in {
        crypto.sha256(data, contents(dw));
    }
    var hex = buffer.empty(heap, 64);
    borrow digest as &dg in {
        hex = company_step.put_hex(heap, hex, contents(dg));
    }
    unbox_slice(heap, digest);
    return hex;
}

// `<dir>/<sub>` as a path.
fn beneath[&h, &d, &s](heap: &!h Heap, dir: &d [byte], sub: &s [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 64), dir);
    b = buffer.push(heap, b, byte_of(47));
    return buffer.append(heap, b, sub);
}

// The hex digest of the file `name` beneath `evdir/sub` (`read_artifact`'s rules: a regular file, no link followed, at most 16 MiB),
// and 0, or why it is refused (1 not there, 2 not a regular file, 3 too large, 4 unreadable).
pub fn hash_in[&h, &f, &e, &s, &n](heap: &!h Heap, fs: &f Fs(""), evdir: &e [byte], sub: &s [byte], name: &n [byte]) -> [heap, fs_read(""), dir_read, file_read] (buffer.Buffer, int) {
    let d = beneath(heap, evdir, sub);
    var hex = buffer.empty(heap, 1);
    var why = 4;
    borrow d as &db in {
        // A directory that is not there is "not there" (1), as a missing file is: `read_artifact` calls both an unreadable file.
        var there = journal_io.path_ok(fs, buffer.bytes(db));
        if there {
            match open_dir(fs, buffer.bytes(db)) {
                DirOpened::Failed(e) => {
                    there = false;
                    why = 4;
                    if e == 2 {
                        why = 1;
                    }
                }
                DirOpened::Ok(opened) => {
                    dir_close(opened);
                }
            }
        }
        if there {
            let (data, w) = read_artifact(heap, fs, buffer.bytes(db), name);
            why = w;
            if w == 0 {
                buffer.drop(heap, hex);
                borrow data as &dd in {
                    hex = hex_of(heap, buffer.bytes(dd));
                }
            }
            buffer.drop(heap, data);
        }
    }
    buffer.drop(heap, d);
    return (hex, why);
}

// `<name>.cho` and `<name>_test.cho`: the names of a library's two files beneath `src` and `tests` (docs/library.md of cancho-code).
pub fn library_src_name[&h, &n](heap: &!h Heap, name: &n [byte]) -> [heap] buffer.Buffer {
    return buffer.append(heap, buffer.append(heap, buffer.empty(heap, 32), name), ".cho");
}

pub fn library_tests_name[&h, &n](heap: &!h Heap, name: &n [byte]) -> [heap] buffer.Buffer {
    return buffer.append(heap, buffer.append(heap, buffer.empty(heap, 32), name), "_test.cho");
}

// Both files of the library `name` hashed: (source hex, tests hex, why, which). `why` 0 when both are regular files, else the reason
// (`read_artifact`'s) and `which` 1 for the source file, 2 for the tests file; the hex of a refused file is empty.
pub fn library_digests[&h, &f, &e, &n](heap: &!h Heap, fs: &f Fs(""), evdir: &e [byte], name: &n [byte]) -> [heap, fs_read(""), dir_read, file_read] (buffer.Buffer, buffer.Buffer, int, int) {
    let sn = library_src_name(heap, name);
    let tn = library_tests_name(heap, name);
    var a = buffer.empty(heap, 1);
    var b = buffer.empty(heap, 1);
    var why = 0;
    var which = 0;
    borrow sn as &snb in {
        let (ha, wa) = hash_in(heap, fs, evdir, "src", buffer.bytes(snb));
        buffer.drop(heap, a);
        a = ha;
        if wa != 0 {
            why = wa;
            which = 1;
        }
    }
    if why == 0 {
        borrow tn as &tnb in {
            let (hb, wb) = hash_in(heap, fs, evdir, "tests", buffer.bytes(tnb));
            buffer.drop(heap, b);
            b = hb;
            if wb != 0 {
                why = wb;
                which = 2;
            }
        }
    }
    buffer.drop(heap, sn);
    buffer.drop(heap, tn);
    return (a, b, why, which);
}
