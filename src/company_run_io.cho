// The helpers of the company runner and of its step runners that more than one of them uses: what a step prints, the refusal line, a journal record, a file written, an artifact hashed.
// Moved out of `company_runner.cho` unchanged (a pure move: no behaviour change; the 2,000-line ceiling of crates/cancho/tests/files.rs).

pub fn rule_step_dir_missing() -> [] &static [byte] {
    return "step-dir-missing";
}

pub fn rule_operator_invalid() -> [] &static [byte] {
    return "operator-invalid";
}

pub fn say[&i, &l, &v](io: &!i Io, label: &l [byte], value: &v [byte]) -> [io_write] int {
    return company_cmd.line(io, label, value);
}

pub fn refuse[&i, &t](io: &!i Io, tag: &t [byte]) -> [io_write] int {
    return company_cmd.refuse(io, tag);
}

pub fn say_nat[&h, &i, &l](heap: &!h Heap, io: &!i Io, label: &l [byte], n: int) -> [heap, io_write] int {
    var b = buffer.push_nat(heap, buffer.empty(heap, 8), n);
    borrow b as &bb in {
        say(io, label, buffer.bytes(bb));
    }
    buffer.drop(heap, b);
    return 0;
}

pub fn glue[&h, &a, &b](heap: &!h Heap, first: &a [byte], second: &b [byte]) -> [heap] buffer.Buffer {
    return buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), first), second);
}

// Append one record to the journal (a new file is made durable in its directory). 0, or the exit status of the failure (printed).
pub fn record[&f, &i, &j, &r](fs: &f Fs(""), io: &!i Io, jpath: &j [byte], line: &r [byte], new_file: bool) -> [fs_read(""), fs_write(""), file_write, io_write] int {
    if journal_io.append(fs, jpath, line, new_file) != 0 {
        say(io, "error: cannot write company.journal", "");
        return company_step.exit_io();
    }
    return 0;
}

pub fn record_buffer[&h, &f, &i, &j](heap: &!h Heap, fs: &f Fs(""), io: &!i Io, jpath: &j [byte], ev: buffer.Buffer, new_file: bool) -> [heap, fs_read(""), fs_write(""), file_write, io_write] int {
    var status = 0;
    borrow ev as &eb in {
        status = record(fs, io, jpath, buffer.bytes(eb), new_file);
    }
    buffer.drop(heap, ev);
    return status;
}

// Is there a directory at `path`?
// Is the step's `ev` directory there? A DERIVED step's is made when it is not (`company_provision`: the operator could not have made it); a step of the
// manifest's own never is, and its absence is `step-dir-missing` as ever.
pub fn ev_ready[&h, &f, &d, &i, &e](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], id: &i [byte], derived: bool, evdir: &e [byte]) -> [heap, fs_read(""), dir_read, dir_write] bool {
    if dir_present(fs, evdir) {
        return true;
    }
    if derived == false {
        return false;
    }
    var made = false;
    let steps = company_cmd.under(heap, dir, "steps");
    borrow steps as &sb in {
        made = company_provision.make_ev(fs, buffer.bytes(sb), id);
    }
    buffer.drop(heap, steps);
    return made && dir_present(fs, evdir);
}

pub fn dir_present[&f, &p](fs: &f Fs(""), path: &p [byte]) -> [fs_read("")] bool {
    if journal_io.path_ok(fs, path) == false {
        return false;
    }
    match open_dir(fs, path) {
        DirOpened::Failed(e) => {
            return false;
        }
        DirOpened::Ok(d) => {
            dir_close(d);
            return true;
        }
    }
}

pub fn write_file[&f, &p, &b](fs: &f Fs(""), path: &p [byte], contents: &b [byte]) -> [fs_write(""), file_write] int {
    if journal_io.path_ok(fs, path) == false {
        return 0 - 2;
    }
    match open_write(fs, path) {
        Opened::Failed(e) => {
            return e;
        }
        Opened::Ok(opened) => {
            var file = opened;
            var rc = 0;
            borrow mut file as &!x in {
                rc = journal_io.write_all(x, contents);
            }
            file_close(file);
            return rc;
        }
    }
}

// The SHA-256 of `data` as lower-case hex.
pub fn hex_of[&h, &b](heap: &!h Heap, data: &b [byte]) -> [heap] buffer.Buffer {
    let digest = box_slice(heap, 32, byte_of(0));
    borrow mut digest as &!dw in {
        crypto.sha256(data, contents(dw));
    }
    var hex = buffer.empty(heap, 64);
    borrow digest as &dg in {
        hex = company_step.put_hex(heap, hex, contents(dg));
    }
    unbox_slice(heap, digest);
    return hex;
}

// The SHA-256 of the artifact `name` beneath the directory `dir` as hex, and 0, or why it is refused (`read_artifact`).
pub fn hash_artifact[&h, &f, &d, &n](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], name: &n [byte]) -> [heap, fs_read(""), dir_read, file_read] (buffer.Buffer, int) {
    let (data, why) = company_files.read_artifact(heap, fs, dir, name);
    var hex = buffer.empty(heap, 64);
    if why == 0 {
        buffer.drop(heap, hex);
        borrow data as &db in {
            hex = hex_of(heap, buffer.bytes(db));
        }
    }
    buffer.drop(heap, data);
    return (hex, why);
}

// The artifact of step `id` is refused (`why`, `company_step.artifact_reason`): print it and record it as an unavailable check,
// which holds the step. The exit status.
pub fn refuse_artifact[&h, &f, &i, &j, &n, &w](heap: &!h Heap, fs: &f Fs(""), io: &!i Io, jpath: &j [byte], id: &n [byte], shown: &w [byte], why: int, seq: int) -> [heap, fs_read(""), fs_write(""), file_write, io_write] int {
    let wrote = record_buffer(heap, fs, io, jpath, company_state.check_unavailable(heap, seq, id, company_step.rule_artifact_invalid()), false);
    if wrote != 0 {
        return wrote;
    }
    refuse(io, company_step.rule_artifact_invalid());
    say(io, "step: ", id);
    say(io, "artifact: ", shown);
    say(io, "reason: ", company_step.artifact_reason(why));
    return company_step.exit_check_unavailable();
}

// The build's `usage.jsonl` (none is no usage), priced call by call, less what was recorded for the step: appended as one priced
// spend record when anything is new. (0 or the exit status of a failure, the next record).
pub fn record_spend[&h, &f, &i, &j, &n, &e](heap: &!h Heap, fs: &f Fs(""), io: &!i Io, jpath: &j [byte], id: &n [byte], evdir: &e [byte], prices: company_budget.Prices, before: company_budget.Usage, before_cost: int, seq: int) -> [heap, fs_read(""), fs_write(""), dir_read, file_read, file_write, io_write] (int, int) {
    var code = 0;
    var next = seq;
    // Read like an artifact (final review, I1): beneath the execution directory, no link followed, a regular file of at most 16 MiB,
    // a FIFO never opened. Not there is no usage (1); anything else is `usage-invalid`, recorded, and the step held.
    let (text, why) = company_files.read_artifact(heap, fs, evdir, "usage.jsonl");
    if why != 0 && why != 1 {
        code = record_buffer(heap, fs, io, jpath, company_state.check_unavailable(heap, seq, id, company_step.rule_usage_invalid()), false);
        if code == 0 {
            refuse(io, company_step.rule_usage_invalid());
            say(io, "step: ", id);
            say(io, "reason: the build's usage.jsonl is ", company_step.artifact_reason(why));
            code = company_step.exit_check_unavailable();
            next = seq + 1;
        }
    } else {
        borrow text as &tb in {
            let after = company_budget.parse_usage_for(buffer.bytes(tb), prices);
            let delta = company_step.usage_delta(after, before);
            let cost = company_step.cost_delta(company_budget.cost_micro(after, prices), before_cost);
            if company_step.any_tokens(delta) || cost > 0 {
                code = record_buffer(heap, fs, io, jpath, company_state.spend_priced(heap, seq, id, delta.input, delta.output, delta.cache_write, delta.cache_read, cost), false);
                next = seq + 1;
            }
        }
    }
    buffer.drop(heap, text);
    return (code, next);
}

// The step's `input`, decoded, written to `<dir><name>` (`name` begins with `/`; a `repo.change` step's request text is `change.txt` in
// its execution directory).
pub fn write_decoded[&h, &f, &m, &w, &z](heap: &!h Heap, fs: &f Fs(""), hm: &m company_manifest.Manifest, step: company_manifest.Step, stepdir: &w [byte], name: &z [byte]) -> [heap, fs_write(""), file_write] int {
    let text = company_manifest.step_input(hm, step);
    let quoted = glue(heap, "\"", text);
    var q = buffer.append(heap, quoted, "\"");
    var rc = 0 - 2;
    borrow q as &qb in {
        let src = buffer.bytes(qb);
        let tape = box_slice(heap, json.tape_len(src), 0);
        borrow mut tape as &!tw in {
            let tp = contents(tw);
            if json.parse(src, tp) > 0 {
                if json.is_string(tp, 0) {
                    let n = json.string_length(src, tp, 0);
                    if n >= 0 {
                        let out = box_slice(heap, n, byte_of(0));
                        borrow mut out as &!ow in {
                            json.string_into(src, tp, 0, contents(ow));
                        }
                        let path = glue(heap, stepdir, name);
                        borrow path as &pb in {
                            borrow out as &or in {
                                rc = write_file(fs, buffer.bytes(pb), contents(or));
                            }
                        }
                        buffer.drop(heap, path);
                        unbox_slice(heap, out);
                    }
                }
            }
        }
        unbox_slice(heap, tape);
    }
    buffer.drop(heap, q);
    return rc;
}

// A repository or patch refusal: `refusal: <tag>`, `step:`, recorded as an unavailable check (held; `retry:<id>` frees it), exit 14.
pub fn change_refused[&h, &f, &i, &j, &n](heap: &!h Heap, fs: &f Fs(""), io: &!i Io, jpath: &j [byte], id: &n [byte], tag: &static [byte], seq: int) -> [heap, fs_read(""), fs_write(""), file_write, io_write] int {
    let wrote = record_buffer(heap, fs, io, jpath, company_state.check_unavailable(heap, seq, id, tag), false);
    if wrote != 0 {
        return wrote;
    }
    refuse(io, tag);
    say(io, "step: ", id);
    return company_step.exit_check_unavailable();
}
