edition 9;

import std.buffer;
import std.bytes;
import std.io;
import std.json;
import forge.await_run;
import forge.await_task;
import forge.build_run;
import forge.build_task;
import forge.company_cmd;
import forge.dispatch;
import forge.gate_env;
import forge.gate_run;
import forge.gate_task;
import forge.journal_io;
import forge.recover;
import forge.recover_io;
import forge.retry;
import forge.lock;
import forge.report;
import forge.task;
import forge.verbs;

// The operator's view of a workspace, read-only (docs/architecture.md section
// 4.9):
//
//   forge status  <dir>            records, tasks by state, the snapshot's fate
//   forge history <dir> [task-id]  every record in order, or one task's
//
// <dir> is an absolute path holding `journal.jsonl` (and, if there is one,
// `snapshot.json`). Looking changes nothing: no tail is cut, no snapshot is
// written, the lock is not taken (a writer may be running; a record it is in
// the middle of writing shows as a torn tail).
//
// Exit status: 0 the journal replayed cleanly; 1 the journal is refused (the
// output names the rule and the line); 2 bad usage or a path that is not
// absolute or has a `..`; 3 no journal there, or an I/O error.
//
// The one verb that acts:
//
//   forge gate <dir> <workers> <repo> <revision> <checkout> <execution-dir> [timeout-ms] [NAME=value ...]
//
// reports a repository's gate at a revision (docs/self-hosting.md section 3.1): it takes the lock of the workspace
// <dir>, records the task, starts `gate_runner` from the directory <workers> on the working copy <checkout> of <repo>
// (a key of the allow-list), keeps the evidence in the existing, empty directory <execution-dir>, and writes what
// happened in the journal. The verdict it prints is a CLAIM of the worker; the task is left in `verification`, never
// accepted. Exit status: 0 a claim was recorded (the gate may have failed: that is the project telling the truth);
// 1 the task or the journal was refused (the rule tag is printed); 2 bad usage or a path that is not ok; 3 the
// workspace is locked, a directory cannot be opened, or an I/O error; 4 the run ended without a claim (a deadline, a
// crash, a refusal of the worker: the ending and the state are printed). The trailing `NAME=value` arguments are the
// operator's environment for the gate (docs/self-hosting.md, D7): `PATH`, `HOME`, `CANCHO_CACHE`, `CARGO_HOME`,
// `RUSTUP_HOME`, absolute paths, at most 5 (one for each); anything else is `env-invalid` (exit 1, the task stays approved).
//
//   forge build <dir> <workers> <tools> <brief-file> <execution-dir> <checker> <provider> <model> <agent> [timeout-ms] [NAME=value ...]
//
// builds a new project from a brief with the Cancho Code adapter (docs/cancho-code-adapter.md section 10; issue #34): it
// reads the brief file (at most 16 KiB), takes the lock of the workspace <dir>, records the task, starts `cancho_code` from
// the directory <workers>, which starts `cancho-build` from the directory <tools>, in the existing directory <execution-dir>,
// and writes what happened in the journal. Everything after <brief-file> is the OPERATOR'S: the compiler <checker> (an
// absolute path), the <provider> and <model> of the agent, and the <agent> command (one argument: a shell command line the
// tool runs); the optional trailing `guide=PATH`, `attempts=N`, `agent_seconds=N`, `rounds=N`, `plan_seconds=N`, `jobs=N` are
// the tool's ceilings (a name twice or not on the list is bad usage). A task carries only the brief. The ending of the
// build is a CLAIM of the worker: the task is left in `verification`, never accepted; a build that does not succeed ends
// `blocked`, and a `provider-error` is NOT retried by itself (a build writes: `retry-write-refused`): run the command again
// on the same <execution-dir> to resume it. Exit status: 0 a claim was recorded; 1 the task, the brief file or the journal
// was refused (the rule tag is printed; a refused task stays `approved`, an unreadable brief file journals nothing); 2 bad
// usage or a path that is not ok; 3 the workspace is locked, a directory cannot be opened, or an I/O error; 4 the run ended
// without a claim (the ending and the state are printed).
//
//   forge recover <dir> [<workers>]
//
// settles the tasks a crash left `running` (docs/architecture.md section 4.4): it takes the lock of the workspace <dir>,
// replays the journal (a torn tail is cut), and for each task that is `running` with no ending writes what happened to it
// and moves it out of `running`: `ready` for a run that was never started (`execution-unstarted`) or whose ending is lost
// (`execution.lost`, `execution-lost`), `blocked` once the worker was started `retry.max_attempts()` times
// (`retry-exhausted`), `verification` for a claim that was recorded and not acted on. It starts no worker. Exit status:
// 0 done (maybe nothing to do); 1 the journal is refused (the rule tag is printed, nothing is written); 2 bad usage or a
// path that is not ok; 3 the workspace is locked, no journal there, or an I/O error.
//
// Its authority is, with `gate`, exactly what `cancho authority src/*.cho --std` prints and docs/authority.txt checks:
// the journal and the evidence (`fs_read`, `fs_write`, `file_read`, `file_write`), one directory of workers
// (`dir_read`, `exec_under`: the program is a name beneath it, so the report names no path), a clock and a poller (the
// deadline), standard input and output, the command line. Not the network, signals, foreign code. The prefix of the
// file capability is empty because a library cannot be generic in it (gap G9, cancho #534).

fn concat[&h, &d, &n](heap: &!h Heap, dir: &d [byte], name: &n [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, 64), dir);
    return buffer.append(heap, b, name);
}

fn show[&i, &h](io: &!i Io, heap: &!h Heap, text: buffer.Buffer) -> [heap, io_write] int {
    borrow text as &tb in {
        buffer.write(io, tb);
    }
    buffer.drop(heap, text);
    return 0;
}

fn usage[&i](io: &!i Io) -> [err_write] int {
    io.error_all(io, "usage: forge status <dir> | forge history <dir> [task-id] | forge recover <dir> [<workers>]\n       forge await <dir> <workers> <task-id> [timeout-ms] | forge cancel <dir> <workers> <task-id>\n       forge gate <dir> <workers> <repo> <revision> <checkout> <execution-dir> [timeout-ms] [NAME=value ...]\n       forge build <dir> <workers> <tools> <brief-file> <execution-dir> <checker> <provider> <model> <agent> [timeout-ms] [NAME=value ...]\n       forge company check <manifest.json> | forge company status <company-dir>\n  <dir> is an absolute path holding journal.jsonl; the other paths are absolute too\n");
    return 2;
}

fn read_only[&h, &f, &i, &g](heap: &!h Heap, fs: &f Fs(""), io: &!i Io, args: &g Args) -> [args, heap, fs_read(""), file_read, io_write, err_write] int {
    let count = arg_count(args);
    if count < 3 || count > 4 {
        return usage(io);
    }
    let verb = arg(args, 1);
    let dir = arg(args, 2);
    let status_verb = bytes.equal(verb, "status");
    let history_verb = bytes.equal(verb, "history");
    if status_verb == false && history_verb == false {
        return usage(io);
    }
    if status_verb && count != 3 {
        return usage(io);
    }
    let jpath = concat(heap, dir, "/journal.jsonl");
    let spath = concat(heap, dir, "/snapshot.json");
    var code = 0;
    borrow jpath as &jb in {
        borrow spath as &sb in {
            if journal_io.path_ok(fs, buffer.bytes(jb)) == false {
                io.error_all(io, "forge: path-invalid: <dir> must be absolute, with no .. component\n");
                code = 2;
            } else if journal_io.exists(fs, buffer.bytes(jb)) == false {
                io.error_all(io, "forge: no journal.jsonl in that directory\n");
                code = 3;
            } else {
                let (data, errno) = journal_io.read_all(heap, fs, buffer.bytes(jb));
                let (snap, snap_errno) = journal_io.read_all(heap, fs, buffer.bytes(sb));
                if errno != 0 || snap_errno != 0 {
                    io.error_all(io, "forge: cannot read the workspace files\n");
                    code = 3;
                } else if status_verb {
                    borrow data as &db in {
                        borrow snap as &snb in {
                            let (text, rule) = report.status(heap, buffer.bytes(db), buffer.bytes(snb));
                            show(io, heap, text);
                            if rule != 0 {
                                code = 1;
                            }
                        }
                    }
                } else {
                    var only = "";
                    if count == 4 {
                        only = arg(args, 3);
                    }
                    borrow data as &db in {
                        let (text, rule) = report.history(heap, buffer.bytes(db), only);
                        show(io, heap, text);
                        if rule != 0 {
                            code = 1;
                        }
                    }
                }
                buffer.drop(heap, data);
                buffer.drop(heap, snap);
            }
        }
    }
    buffer.drop(heap, jpath);
    buffer.drop(heap, spath);
    return code;
}

// The number written in `text` (1 to 9 digits), or -1.
fn nat_of[&t](text: &t [byte]) -> [] int {
    if len(text) < 1 || len(text) > 9 {
        return 0 - 1;
    }
    var n = 0;
    var k = 0;
    while k < len(text) {
        let c = int_of(text[k]);
        if c < 48 || c > 57 {
            return 0 - 1;
        }
        n = n * 10 + (c - 48);
        k = k + 1;
    }
    return n;
}

fn line[&i, &l, &v](io: &!i Io, label: &l [byte], value: &v [byte]) -> [io_write] int {
    io.write_all(io, label);
    io.write_all(io, value);
    io.newline(io);
    return 0;
}

// What a run of `forge gate` came to, printed, and the exit status (see the head of this file).
fn show_gate[&h, &i, &r](heap: &!h Heap, io: &!i Io, revision: &r [byte], done: gate_run.Finished) -> [heap, io_write, err_write] int {
    var code = 4;
    var id = gate_run.task_id(heap, revision, done.number);
    borrow id as &ib in {
        if done.number > 0 {
            line(io, "task: ", buffer.bytes(ib));
            line(io, "state: ", task.code_name(done.state));
        }
        match done.outcome {
            gate_run.Outcome::Journal(rule) => {
                if rule > 0 {
                    io.error_all(io, "forge: the journal is refused: ");
                    io.error_all(io, task.rule_code_name(rule));
                    io.error_all(io, "\n");
                    code = 1;
                } else {
                    io.error_all(io, "forge: the journal cannot be read or written\n");
                    code = 3;
                }
            }
            gate_run.Outcome::Refused(why) => {
                line(io, "refused: ", gate_task.rule_name(why));
                code = 1;
            }
            gate_run.Outcome::Ended(ending, claim) => {
                let tag = dispatch.rule_tag(ending);
                if len(tag) > 0 {
                    line(io, "refusal: ", tag);
                }
                line(io, "ending: ", dispatch.consequence_name(dispatch.consequence(ending)));
                if done.attempts > 1 {
                    io.write_all(io, "attempts: ");
                    var n = buffer.push_nat(heap, buffer.empty(heap, 4), done.attempts);
                    borrow n as &nb in {
                        io.write_all(io, buffer.bytes(nb));
                    }
                    buffer.drop(heap, n);
                    io.newline(io);
                }
                let again = retry.rule_tag(retry.decide(dispatch.consequence(ending), done.attempts, true));
                if len(again) > 0 {
                    line(io, "refusal: ", again);
                }
                if claim > 0 {
                    line(io, "claimed verdict: ", gate_run.verdict_name(claim));
                    io.write_all(io, "(a worker's claim: the task is in verification, not accepted)\n");
                    code = 0;
                }
            }
        }
    }
    buffer.drop(heap, id);
    return code;
}

// The operator's `NAME=value` arguments from `first` on, as the text of a JSON array (empty when there are none). Nothing is
// checked here beyond the shape: an argument with no `=` after a name is not an entry (-1 in `bad`); `forge.gate_run` checks
// the entries.
fn env_json[&h, &g](heap: &!h Heap, args: &g Args, first: int) -> [args, heap] (buffer.Buffer, bool) {
    if first >= arg_count(args) {
        return (buffer.empty(heap, 1), true);
    }
    var w = json.writer(heap, 128);
    w = json.begin_array(heap, w);
    var k = first;
    var shaped = true;
    while k < arg_count(args) {
        if gate_env.equals_at(arg(args, k)) < 1 {
            shaped = false;
        }
        w = json.put_string(heap, w, arg(args, k));
        k = k + 1;
    }
    w = json.end_array(heap, w);
    return (json.finish(w), shaped);
}

fn gate[&h, &f, &x, &c, &i, &g](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, args: &g Args) -> [args, heap, exec_under, clock, poll, fs_read(""), fs_write(""), dir_read, file_read, file_write, io_write, err_write] int {
    let count = arg_count(args);
    if count < 8 || count > 32 {
        return usage(io);
    }
    let dir = arg(args, 2);
    let workers = arg(args, 3);
    let repo = arg(args, 4);
    let revision = arg(args, 5);
    let checkout = arg(args, 6);
    let execution_dir = arg(args, 7);
    var timeout = 900000;
    var first_env = 8;
    if count > 8 && gate_env.equals_at(arg(args, 8)) < 0 {
        timeout = nat_of(arg(args, 8));
        if timeout < 0 {
            return usage(io);
        }
        first_env = 9;
    }
    let (env, shaped) = env_json(heap, args, first_env);
    if !shaped {
        buffer.drop(heap, env);
        return usage(io);
    }
    let jpath = concat(heap, dir, "/journal.jsonl");
    let lpath = concat(heap, dir, "/lock");
    var code = 0;
    borrow jpath as &jb in {
        borrow lpath as &lb in {
            if journal_io.path_ok(fs, buffer.bytes(jb)) == false || journal_io.path_ok(fs, workers) == false {
                io.error_all(io, "forge: path-invalid: <dir> and <workers> must be absolute, with no .. component\n");
                code = 2;
            } else {
                match lock.acquire(fs, buffer.bytes(lb)) {
                    lock.Lock::Refused(rule) => {
                        io.error_all(io, "forge: ");
                        io.error_all(io, task.rule_code_name(rule));
                        io.error_all(io, ": the workspace cannot be written\n");
                        code = 3;
                    }
                    lock.Lock::Failed(errno) => {
                        io.error_all(io, "forge: the lock of the workspace could not be taken\n");
                        code = 3;
                    }
                    lock.Lock::Held(held) => {
                        match open_dir(fs, workers) {
                            DirOpened::Failed(errno) => {
                                io.error_all(io, "forge: cannot open the workers directory\n");
                                code = 3;
                            }
                            DirOpened::Ok(opened) => {
                                var wdir = opened;
                                borrow wdir as &w in {
                                    borrow env as &eb in {
                                        let done = gate_run.run(heap, fs, exec, w, clock, buffer.bytes(jb), repo, revision, checkout, execution_dir, buffer.bytes(eb), timeout);
                                        code = show_gate(heap, io, revision, done);
                                    }
                                }
                                dir_close(wdir);
                            }
                        }
                        lock.let_go(held);
                    }
                }
            }
        }
    }
    buffer.drop(heap, env);
    buffer.drop(heap, jpath);
    buffer.drop(heap, lpath);
    return code;
}

// What a run of `forge build` came to, printed, and the exit status (see the head of this file).
fn show_build[&h, &i](heap: &!h Heap, io: &!i Io, done: build_run.Finished) -> [heap, io_write, err_write] int {
    var code = 4;
    var id = build_task.task_id(heap, done.number);
    borrow id as &ib in {
        if done.number > 0 {
            line(io, "task: ", buffer.bytes(ib));
            line(io, "state: ", task.code_name(done.state));
        }
        match done.outcome {
            build_run.Outcome::Journal(rule) => {
                if rule > 0 {
                    io.error_all(io, "forge: the journal is refused: ");
                    io.error_all(io, task.rule_code_name(rule));
                    io.error_all(io, "\n");
                    code = 1;
                } else {
                    io.error_all(io, "forge: the journal cannot be read or written\n");
                    code = 3;
                }
            }
            build_run.Outcome::Refused(why) => {
                line(io, "refused: ", build_task.rule_name(why));
                code = 1;
            }
            build_run.Outcome::Ended(ending, claim) => {
                let tag = dispatch.rule_tag(ending);
                if len(tag) > 0 {
                    line(io, "refusal: ", tag);
                }
                line(io, "ending: ", dispatch.consequence_name(dispatch.consequence(ending)));
                let again = retry.rule_tag(retry.decide(dispatch.consequence(ending), done.attempts, false));
                if len(again) > 0 {
                    line(io, "refusal: ", again);
                }
                if claim > 0 {
                    line(io, "claimed verdict: ", build_task.verdict_name(claim));
                    io.write_all(io, "(a worker's claim: the task is in verification, not accepted)\n");
                    code = 0;
                }
            }
        }
    }
    buffer.drop(heap, id);
    return code;
}

// The value of `NAME=value` argument `entry`, or empty; `p` is the position of the `=` (`gate_env.equals_at`).
fn after_equals[&e](entry: &e [byte], p: int) -> [] &e [byte] {
    return entry[p + 1..len(entry)];
}

// Is the bit `bit` (a power of two) set in `seen`? A `bit` of 0 is never set: the division is not reached.
fn bit_set(seen: int, bit: int) -> [] bool {
    return bit > 0 && seen / bit % 2 == 1;
}

fn build[&h, &f, &x, &c, &i, &g](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, args: &g Args) -> [args, heap, exec_under, clock, poll, fs_read(""), fs_write(""), dir_read, file_read, file_write, io_write, err_write] int {
    let count = arg_count(args);
    if count < 11 || count > 32 {
        return usage(io);
    }
    let dir = arg(args, 2);
    let workers = arg(args, 3);
    let tools = arg(args, 4);
    let brief_file = arg(args, 5);
    let execution_dir = arg(args, 6);
    let checker = arg(args, 7);
    let provider = arg(args, 8);
    let model = arg(args, 9);
    let agent = arg(args, 10);
    var timeout = 3600000;
    var first_option = 11;
    if count > 11 && gate_env.equals_at(arg(args, 11)) < 0 {
        timeout = nat_of(arg(args, 11));
        if timeout < 0 {
            return usage(io);
        }
        first_option = 12;
    }
    var guide = "";
    var attempts = 4;
    var agent_seconds = 30;
    var rounds = 3;
    var plan_seconds = 900;
    var jobs = 4;
    var seen = 0;
    var k = first_option;
    while k < count {
        let entry = arg(args, k);
        let p = gate_env.equals_at(entry);
        if p < 1 {
            return usage(io);
        }
        let name = entry[0..p];
        let value = after_equals(entry, p);
        if !build_task.option_known(name) {
            return usage(io);
        }
        var bit = 0;
        if bytes.equal(name, "guide") {
            guide = value;
            bit = 1;
        } else {
            let n = nat_of(value);
            if n < 0 {
                return usage(io);
            }
            if bytes.equal(name, "attempts") {
                attempts = n;
                bit = 2;
            }
            if bytes.equal(name, "agent_seconds") {
                agent_seconds = n;
                bit = 4;
            }
            if bytes.equal(name, "rounds") {
                rounds = n;
                bit = 8;
            }
            if bytes.equal(name, "plan_seconds") {
                plan_seconds = n;
                bit = 16;
            }
            if bytes.equal(name, "jobs") {
                jobs = n;
                bit = 32;
            }
        }
        if bit_set(seen, bit) {
            return usage(io);
        }
        seen = seen + bit;
        k = k + 1;
    }
    let jpath = concat(heap, dir, "/journal.jsonl");
    let lpath = concat(heap, dir, "/lock");
    var code = 0;
    borrow jpath as &jb in {
        borrow lpath as &lb in {
            if journal_io.path_ok(fs, buffer.bytes(jb)) == false || journal_io.path_ok(fs, workers) == false || journal_io.path_ok(fs, brief_file) == false {
                io.error_all(io, "forge: path-invalid: <dir>, <workers> and <brief-file> must be absolute, with no .. component\n");
                code = 2;
            } else {
                let (brief, errno) = build_run.read_brief(heap, fs, brief_file);
                if errno != 0 {
                    io.error_all(io, "forge: ");
                    io.error_all(io, build_task.rule_name(build_task.Refusal::BriefUnreadable));
                    io.error_all(io, ": the brief file cannot be read, or is over 16 KiB; nothing was journalled\n");
                    code = 1;
                } else {
                    match lock.acquire(fs, buffer.bytes(lb)) {
                        lock.Lock::Refused(rule) => {
                            io.error_all(io, "forge: ");
                            io.error_all(io, task.rule_code_name(rule));
                            io.error_all(io, ": the workspace cannot be written\n");
                            code = 3;
                        }
                        lock.Lock::Failed(errno2) => {
                            io.error_all(io, "forge: the lock of the workspace could not be taken\n");
                            code = 3;
                        }
                        lock.Lock::Held(held) => {
                            match open_dir(fs, workers) {
                                DirOpened::Failed(errno3) => {
                                    io.error_all(io, "forge: cannot open the workers directory\n");
                                    code = 3;
                                }
                                DirOpened::Ok(opened) => {
                                    var wdir = opened;
                                    borrow wdir as &w in {
                                        borrow brief as &bb in {
                                            let done = build_run.run(heap, fs, exec, w, clock, buffer.bytes(jb), buffer.bytes(bb), execution_dir, tools, workers, checker, guide, provider, model, agent, attempts, agent_seconds, rounds, plan_seconds, jobs, timeout);
                                            code = show_build(heap, io, done);
                                        }
                                    }
                                    dir_close(wdir);
                                }
                            }
                            lock.let_go(held);
                        }
                    }
                }
                buffer.drop(heap, brief);
            }
        }
    }
    buffer.drop(heap, jpath);
    buffer.drop(heap, lpath);
    return code;
}

// The ending of an awaited run, printed, and the exit status: 0 a claim was recorded, 4 the run ended without one, 1 the task
// was refused or the journal is, 3 the journal cannot be read or written.
fn show_awaited[&i, &d](io: &!i Io, tid: &d [byte], done: await_task.Awaited) -> [io_write, err_write] int {
    var code = 4;
    match done.outcome {
        await_task.Outcome::Journal(rule) => {
            if rule > 0 {
                io.error_all(io, "forge: the journal is refused: ");
                io.error_all(io, task.rule_code_name(rule));
                io.error_all(io, "\n");
                code = 1;
            } else {
                io.error_all(io, "forge: the journal cannot be read or written\n");
                code = 3;
            }
        }
        await_task.Outcome::NotAwaiting => {
            io.error_all(io, "forge: ");
            io.error_all(io, await_task.not_awaiting_tag());
            io.error_all(io, ": the task is not running with an accepted run and no ending after it\n");
            code = 1;
        }
        await_task.Outcome::Running => {
            line(io, "task: ", tid);
            line(io, "state: ", "running");
            line(io, "awaiting: ", "the worker says the run is going on; nothing was written");
            code = 0;
        }
        await_task.Outcome::Ended(ending, claim) => {
            line(io, "task: ", tid);
            line(io, "state: ", task.code_name(done.state));
            let tag = dispatch.rule_tag(ending);
            if len(tag) > 0 {
                line(io, "refusal: ", tag);
            }
            line(io, "ending: ", dispatch.consequence_name(dispatch.consequence(ending)));
            let again = retry.rule_tag(retry.decide(dispatch.consequence(ending), 1, false));
            if len(again) > 0 {
                line(io, "refusal: ", again);
            }
            if claim > 0 {
                line(io, "claimed verdict: ", build_task.verdict_name(claim));
                io.write_all(io, "(a worker's claim: the task is in verification, not accepted)\n");
                code = 0;
            }
        }
    }
    return code;
}

// forge await <dir> <workers> <task-id> [timeout-ms]: go on with a task whose async worker accepted the job (the journal has
// its `execution.accepted` and no ending): wait for the run, then write its ending as `forge build` would have.
fn await_cmd[&h, &f, &x, &c, &i, &g](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, args: &g Args) -> [args, heap, exec_under, clock, poll, fs_read(""), fs_write(""), dir_read, file_read, file_write, io_write, err_write] int {
    let count = arg_count(args);
    if count < 5 || count > 6 {
        return usage(io);
    }
    let dir = arg(args, 2);
    let workers = arg(args, 3);
    let tid = arg(args, 4);
    var timeout = 3600000;
    if count == 6 {
        timeout = nat_of(arg(args, 5));
        if timeout < 1000 {
            return usage(io);
        }
    }
    let jpath = concat(heap, dir, "/journal.jsonl");
    let lpath = concat(heap, dir, "/lock");
    var code = 0;
    borrow jpath as &jb in {
        borrow lpath as &lb in {
            if journal_io.path_ok(fs, buffer.bytes(jb)) == false || journal_io.path_ok(fs, workers) == false || !task.id_ok(tid) {
                io.error_all(io, "forge: path-invalid: <dir> and <workers> must be absolute, with no .. component, and <task-id> a task id\n");
                code = 2;
            } else if journal_io.exists(fs, buffer.bytes(jb)) == false {
                io.error_all(io, "forge: no journal.jsonl in that directory\n");
                code = 3;
            } else {
                match lock.acquire(fs, buffer.bytes(lb)) {
                    lock.Lock::Refused(rule) => {
                        io.error_all(io, "forge: ");
                        io.error_all(io, task.rule_code_name(rule));
                        io.error_all(io, ": the workspace cannot be written\n");
                        code = 3;
                    }
                    lock.Lock::Failed(errno2) => {
                        io.error_all(io, "forge: the lock of the workspace could not be taken\n");
                        code = 3;
                    }
                    lock.Lock::Held(held) => {
                        match open_dir(fs, workers) {
                            DirOpened::Failed(errno3) => {
                                io.error_all(io, "forge: cannot open the workers directory\n");
                                code = 3;
                            }
                            DirOpened::Ok(opened) => {
                                var wdir = opened;
                                borrow wdir as &w in {
                                    let done = await_task.run(heap, fs, exec, w, clock, buffer.bytes(jb), tid, timeout, true);
                                    code = show_awaited(io, tid, done);
                                }
                                dir_close(wdir);
                            }
                        }
                        lock.let_go(held);
                    }
                }
            }
        }
    }
    buffer.drop(heap, jpath);
    buffer.drop(heap, lpath);
    return code;
}

// forge cancel <dir> <workers> <task-id>: ask the worker to stop the run of a task that is awaiting. READS the journal
// (as `status` does, without the lock: the Forge that is polling holds it) and writes nothing: the Forge that waits, or the
// next `forge await`, sees the run end `cancelled` and writes it. Exit status: 0 the worker stopped the run; 4 it did not
// (not running, too late, or the call failed: what it said is printed); 1 the task is not awaiting; 2 bad usage; 3 I/O.
fn cancel_cmd[&h, &f, &x, &c, &i, &g](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, args: &g Args) -> [args, heap, exec_under, clock, poll, fs_read(""), file_read, io_write, err_write] int {
    if arg_count(args) != 5 {
        return usage(io);
    }
    let dir = arg(args, 2);
    let workers = arg(args, 3);
    let tid = arg(args, 4);
    let jpath = concat(heap, dir, "/journal.jsonl");
    var code = 0;
    borrow jpath as &jb in {
        if journal_io.path_ok(fs, buffer.bytes(jb)) == false || journal_io.path_ok(fs, workers) == false || !task.id_ok(tid) {
            io.error_all(io, "forge: path-invalid: <dir> and <workers> must be absolute, with no .. component, and <task-id> a task id\n");
            code = 2;
        } else if journal_io.exists(fs, buffer.bytes(jb)) == false {
            io.error_all(io, "forge: no journal.jsonl in that directory\n");
            code = 3;
        } else {
            let (data, errno) = journal_io.read_all(heap, fs, buffer.bytes(jb));
            if errno != 0 {
                io.error_all(io, "forge: the journal cannot be read\n");
                code = 3;
            } else {
                borrow data as &db in {
                    let (phase, request, execution_dir) = recover.accepted_of(heap, buffer.bytes(db), tid);
                    if phase != 5 {
                        io.error_all(io, "forge: ");
                        io.error_all(io, await_task.not_awaiting_tag());
                        io.error_all(io, ": the task is not running with an accepted run and no ending after it\n");
                        code = 1;
                    } else {
                        match open_dir(fs, workers) {
                            DirOpened::Failed(errno3) => {
                                io.error_all(io, "forge: cannot open the workers directory\n");
                                code = 3;
                            }
                            DirOpened::Ok(opened) => {
                                var wdir = opened;
                                borrow wdir as &w in {
                                    borrow request as &rb in {
                                        borrow execution_dir as &eb in {
                                            code = show_cancel(io, await_run.cancel(heap, exec, w, clock, "cancho_code", buffer.bytes(rb), tid, buffer.bytes(eb)));
                                        }
                                    }
                                }
                                dir_close(wdir);
                            }
                        }
                    }
                    buffer.drop(heap, request);
                    buffer.drop(heap, execution_dir);
                }
            }
            buffer.drop(heap, data);
        }
    }
    buffer.drop(heap, jpath);
    return code;
}

// What the worker answered to a `cancel`, printed, and the exit status (0 only for `cancelled`).
fn show_cancel[&i](io: &!i Io, settled: verbs.Settled) -> [io_write] int {
    match settled {
        verbs.Settled::Ended(ending) => {
            line(io, "refusal: ", dispatch.rule_tag(ending));
            return 4;
        }
        verbs.Settled::Reply(judged) => {
            match judged {
                verbs.Judged::Cancel(c) => {
                    line(io, "cancel: ", verbs.cancel_name(c));
                    match c {
                        verbs.CancelState::Cancelled => {
                            return 0;
                        }
                        verbs.CancelState::NotRunning => {
                            return 4;
                        }
                        verbs.CancelState::TooLate => {
                            return 4;
                        }
                    }
                }
                verbs.Judged::Refused(rule, reason) => {
                    line(io, "refusal: ", verbs.rule_name(rule));
                    return 4;
                }
                verbs.Judged::Capabilities(level) => {
                    line(io, "refusal: ", "worker-protocol");
                    return 4;
                }
                verbs.Judged::Status(st) => {
                    line(io, "refusal: ", "worker-protocol");
                    return 4;
                }
                verbs.Judged::Result(r) => {
                    line(io, "refusal: ", "worker-protocol");
                    return 4;
                }
            }
        }
    }
}

// `forge recover <dir> <workers>`, the second half: for each task that is awaiting (an async worker took the job and nothing
// ended it), ask the worker ONCE. A run that is going on is left running; one that ended is written as `forge await` writes
// it. The exit status is that of the worst: 0 when every one is settled with a claim or is still running, else the first
// other status.
fn ask_awaiting[&h, &f, &x, &c, &i, &j, &w](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, journal_path: &j [byte], workers: &w [byte]) -> [heap, exec_under, clock, poll, fs_read(""), fs_write(""), dir_read, file_read, file_write, io_write, err_write] int {
    var code = 0;
    let (data, errno) = journal_io.read_all(heap, fs, journal_path);
    if errno != 0 {
        buffer.drop(heap, data);
        io.error_all(io, "forge: the journal cannot be read\n");
        return 3;
    }
    var ids = buffer.empty(heap, 1);
    borrow data as &db in {
        buffer.drop(heap, ids);
        ids = recover.awaiting(heap, buffer.bytes(db));
    }
    buffer.drop(heap, data);
    match open_dir(fs, workers) {
        DirOpened::Failed(errno3) => {
            io.error_all(io, "forge: cannot open the workers directory\n");
            code = 3;
        }
        DirOpened::Ok(opened) => {
            var wdir = opened;
            borrow wdir as &wq in {
                borrow ids as &ib in {
                    let all = buffer.bytes(ib);
                    var start = 0;
                    var k = 0;
                    while k < len(all) {
                        if int_of(all[k]) == 10 {
                            let one = show_awaited_quiet(heap, fs, exec, wq, clock, journal_path, all[start..k], io);
                            if one != 0 && code == 0 {
                                code = one;
                            }
                            start = k + 1;
                        }
                        k = k + 1;
                    }
                }
            }
            dir_close(wdir);
        }
    }
    buffer.drop(heap, ids);
    return code;
}

fn show_awaited_quiet[&h, &f, &x, &w, &c, &j, &d, &i](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), workers: &w Dir, clock: &c Clock, journal_path: &j [byte], tid: &d [byte], io: &!i Io) -> [heap, exec_under, clock, poll, fs_read(""), fs_write(""), dir_read, file_read, file_write, io_write, err_write] int {
    let done = await_task.run(heap, fs, exec, workers, clock, journal_path, tid, 1000, false);
    return show_awaited(io, tid, done);
}

fn recover[&h, &f, &x, &c, &i, &g](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, args: &g Args) -> [args, heap, exec_under, clock, poll, fs_read(""), fs_write(""), dir_read, file_read, file_write, io_write, err_write] int {
    if arg_count(args) != 3 && arg_count(args) != 4 {
        return usage(io);
    }
    var workers = "";
    if arg_count(args) == 4 {
        workers = arg(args, 3);
    }
    let jpath = concat(heap, arg(args, 2), "/journal.jsonl");
    let lpath = concat(heap, arg(args, 2), "/lock");
    var code = 0;
    borrow jpath as &jb in {
        borrow lpath as &lb in {
            if journal_io.path_ok(fs, buffer.bytes(jb)) == false || len(workers) > 0 && journal_io.path_ok(fs, workers) == false {
                io.error_all(io, "forge: path-invalid: <dir> and <workers> must be absolute, with no .. component\n");
                code = 2;
            } else if journal_io.exists(fs, buffer.bytes(jb)) == false {
                io.error_all(io, "forge: no journal.jsonl in that directory\n");
                code = 3;
            } else {
                match lock.acquire(fs, buffer.bytes(lb)) {
                    lock.Lock::Refused(rule) => {
                        io.error_all(io, "forge: ");
                        io.error_all(io, task.rule_code_name(rule));
                        io.error_all(io, ": the workspace cannot be written\n");
                        code = 3;
                    }
                    lock.Lock::Failed(errno) => {
                        io.error_all(io, "forge: the lock of the workspace could not be taken\n");
                        code = 3;
                    }
                    lock.Lock::Held(held) => {
                        let recover_io.Settled { rule, errno, text, counts } = recover_io.run(heap, fs, buffer.bytes(jb));
                        if rule != 0 {
                            io.error_all(io, "forge: the journal is refused: ");
                            io.error_all(io, task.rule_code_name(rule));
                            io.error_all(io, "\n");
                            code = 1;
                        } else if errno != 0 {
                            io.error_all(io, "forge: the journal cannot be read or written\n");
                            code = 3;
                        }
                        if code == 0 {
                            borrow text as &tb in {
                                buffer.write(io, tb);
                            }
                            io.write_all(io, "recovered: ");
                            var n = buffer.push_nat(heap, buffer.empty(heap, 4), counts.unstarted + counts.lost + counts.finished);
                            borrow n as &nb in {
                                io.write_all(io, buffer.bytes(nb));
                            }
                            buffer.drop(heap, n);
                            io.newline(io);
                            if counts.awaiting > 0 {
                                io.write_all(io, "awaiting: ");
                                var m = buffer.push_nat(heap, buffer.empty(heap, 4), counts.awaiting);
                                borrow m as &mb in {
                                    io.write_all(io, buffer.bytes(mb));
                                }
                                buffer.drop(heap, m);
                                io.newline(io);
                                if len(workers) > 0 {
                                    code = ask_awaiting(heap, fs, exec, clock, io, buffer.bytes(jb), workers);
                                }
                            }
                        }
                        buffer.drop(heap, text);
                        lock.let_go(held);
                    }
                }
            }
        }
    }
    buffer.drop(heap, jpath);
    buffer.drop(heap, lpath);
    return code;
}

// The company layer's two read-only verbs (src/company_cmd.cho): `forge company check <manifest.json>` and
// `forge company status <company-dir>`. A sub-verb that is neither, or none, is usage (exit 2). They write nothing and take no lock.
fn company[&h, &f, &i, &g](heap: &!h Heap, fs: &f Fs(""), io: &!i Io, args: &g Args) -> [args, heap, fs_read(""), file_read, io_write, err_write] int {
    if arg_count(args) == 4 && bytes.equal(arg(args, 2), "check") {
        return company_cmd.check_cmd(heap, fs, io, args);
    }
    if arg_count(args) == 4 && bytes.equal(arg(args, 2), "status") {
        return company_cmd.status_cmd(heap, fs, io, args);
    }
    return usage(io);
}

fn run[&h, &f, &x, &c, &i, &g](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, args: &g Args) -> [args, heap, exec_under, clock, poll, fs_read(""), fs_write(""), dir_read, file_read, file_write, io_write, err_write] int {
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "gate") {
        return gate(heap, fs, exec, clock, io, args);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "build") {
        return build(heap, fs, exec, clock, io, args);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "company") {
        return company(heap, fs, io, args);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "recover") {
        return recover(heap, fs, exec, clock, io, args);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "await") {
        return await_cmd(heap, fs, exec, clock, io, args);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "cancel") {
        return cancel_cmd(heap, fs, exec, clock, io, args);
    }
    return read_only(heap, fs, io, args);
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(net);
    release(signals);
    release(tty);
    var console = io;
    var memory = heap;
    var status = 2;
    borrow fs as &f in {
        borrow exec as &x in {
            borrow clock as &c in {
                borrow mut console as &!i in {
                    borrow mut memory as &!h in {
                        borrow args as &g in {
                            status = run(h, f, x, c, i, g);
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(exec);
    release(clock);
    release(console);
    release(memory);
    release(args);
    return status;
}
