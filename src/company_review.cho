edition 9;
module forge.company_review;

import std.buffer;
import std.dirs;
import std.io;
import std.json;
import forge.authority_call;
import forge.company_cmd;
import forge.company_provision;
import forge.company_step;
import forge.repo_row;

// One call of the authority worker for each entry of a repository row's `authority` (docs/company.md sections 25 and 26), for the verb `forge company
// authority` and the step `repo.authority`. `stepdir` is the directory the entries' execution directories go in, as `<stepdir>/authority-<n>`: made here, one
// `mkdirat`. For each entry it prints `authority: <ceiling>` and what `authority_call.run_step` prints (the task, its state, the verdict recomputed from the
// evidence, the rule tag), and it returns the worst status of the calls and a summary, one line per entry, `authority-<n> <ceiling> <status>`.
//
// A status is the call's: 0 for `equal` or `narrower`, 5 for a refusing verdict (`wider`, `ceiling-missing`, `unreadable`: the hold), else 1 refused, 3 journal or
// lock, 4 no verdict. The worst is 5 over the rest, then the larger.

fn deadline_ms() -> [] int {
    return 300000;
}

pub fn run_entries[&h, &f, &x, &c, &i, &s, &t, &d, &g, &k, &b, &w](heap: &!h Heap, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, io: &!i Io, src: &s [byte], tp: &t [int], row: int, stepdir: &d [byte], slug: &g [byte], commit: &k [byte], base: &b [byte], workers: &w [byte]) -> [heap, exec_under, clock, poll, fs_read(""), fs_write(""), dir_read, dir_write, file_read, file_write, io_write, err_write] (int, buffer.Buffer) {
    var summary = buffer.empty(heap, 128);
    let compiler = repo_row.field_text(src, tp, row, "compiler");
    let n = repo_row.authority_count(src, tp, row);
    var worst = 0;
    var j = 0;
    while j < n {
        let sub = buffer.push_nat(heap, buffer.append(heap, buffer.empty(heap, 16), "authority-"), j);
        var status = 0;
        let entry = repo_row.authority_entry(src, tp, row, j);
        let ceiling = json.string_view(src, tp, json.get(src, tp, entry, "ceiling"));
        company_cmd.line(io, "authority: ", ceiling);
        borrow sub as &sb in {
            if company_provision.make_sub(fs, stepdir, buffer.bytes(sb)) == false {
                company_cmd.line(io, "error: ", "cannot make the execution directory of the entry");
                status = company_step.exit_io();
            } else {
                let evdir = buffer.append(heap, buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), stepdir), "/"), buffer.bytes(sb));
                borrow evdir as &ed in {
                    let (ran, worker_code) = authority_call.run_step(heap, fs, exec, clock, io, deadline_ms(), stepdir, workers, slug, commit, base, src, tp, entry, compiler, repo_row.field_text(src, tp, row, "checkout"), buffer.bytes(ed));
                    status = ran;
                }
                buffer.drop(heap, evdir);
            }
            summary = buffer.append(heap, summary, buffer.bytes(sb));
        }
        summary = buffer.append(heap, summary, " ");
        summary = buffer.append(heap, summary, ceiling);
        summary = buffer.append(heap, summary, " ");
        summary = buffer.push_nat(heap, summary, status);
        summary = buffer.append(heap, summary, "\n");
        buffer.drop(heap, sub);
        worst = worse(worst, status);
        j = j + 1;
    }
    return (worst, summary);
}

// The worse of two statuses: 5 (a refusing verdict) over the rest, then the larger.
pub fn worse(a: int, b: int) -> [] int {
    if a == 5 || b == 5 {
        return 5;
    }
    if b > a {
        return b;
    }
    return a;
}
