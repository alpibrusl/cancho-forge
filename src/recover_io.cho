edition 9;
module forge.recover_io;

import std.buffer;
import std.map;
import forge.journal;
import forge.journal_io;
import forge.recover;

// The file half of `forge recover` (docs/architecture.md section 4.4): replay the journal of a workspace (cutting a
// torn tail, as every writer does), plan what recovery writes (`forge.recover`) and append it one record at a time, each
// synced, so a crash in the middle leaves a journal that replays to the last record written and a second run finishes
// the job. The caller holds the lock of the workspace.

pub struct Settled {
    // 0, or the `task.rule_code` that ended the replay: nothing was written.
    rule: int,
    // 0, or an errno (-1 for a short write): the journal could not be read or written.
    errno: int,
    // One line for each task that was settled.
    text: buffer.Buffer,
    counts: recover.Counts,
}

pub fn run[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte]) -> [heap, fs_read(""), fs_write(""), file_read, file_write] Settled {
    let (table, report, recovered) = journal_io.recover(heap, fs, path);
    map.drop(heap, table);
    let none = recover.Counts { unstarted: 0, lost: 0, finished: 0, exhausted: 0 };
    if report.rule != 0 {
        return Settled { rule: report.rule, errno: 0, text: buffer.empty(heap, 1), counts: none };
    }
    if recovered.errno != 0 {
        return Settled { rule: 0, errno: recovered.errno, text: buffer.empty(heap, 1), counts: none };
    }
    let (data, errno) = journal_io.read_all(heap, fs, path);
    if errno != 0 {
        buffer.drop(heap, data);
        return Settled { rule: 0, errno: errno, text: buffer.empty(heap, 1), counts: none };
    }
    var failure = 0;
    var text = buffer.empty(heap, 1);
    var counts = none;
    borrow data as &db in {
        let (records, said, found) = recover.plan(heap, buffer.bytes(db), report.records);
        buffer.drop(heap, text);
        text = said;
        counts = found;
        borrow records as &rb in {
            let all = buffer.bytes(rb);
            var start = 0;
            var k = 0;
            while k < len(all) && failure == 0 {
                if int_of(all[k]) == 10 {
                    failure = journal_io.append(fs, path, all[start..k + 1], false);
                    start = k + 1;
                }
                k = k + 1;
            }
        }
        buffer.drop(heap, records);
    }
    buffer.drop(heap, data);
    return Settled { rule: 0, errno: failure, text: text, counts: counts };
}
