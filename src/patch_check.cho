edition 9;
module forge.patch_check;

import std.bytes;
import std.buffer;
import forge.patch_apply;
import forge.repo_row;

// The bounds Forge puts on a patch a `repo.change` worker leaves (docs/company-lifecycle.md section 4.2 item 3, docs/company.md section 16).
// The worker's word is not the bound: Forge reads `change.patch` itself and answers from the bytes. This module is pure.
//
// The patch is `diff -ruN base tree` as `cancho-build --repo` writes it (cancho-code docs/repo-patch.md): per file a `diff` line (optional),
// `--- base/<path>`, `+++ tree/<path>` (a TAB and a time may follow the path), and hunks `@@ -a[,b] +c[,d] @@` whose bodies are counted
// by those numbers, so a line that looks like a header inside a hunk is a line of the hunk. Anything else outside a hunk (a rename, a mode
// change, a `Binary files` or `GIT binary patch` line, a prefix other than base/ and tree/, a truncated hunk, an empty patch) is
// `patch-kind-invalid`. A path the operator's row does not allow, or a path of another shape, is `patch-path-denied`. More files than
// `max_patch_files`, or more added lines than `max_patch_lines`, is `patch-too-large`. When several apply the order is kind, path, size.

pub struct Verdict {
    code: int,
    files: int,
    added: int,
}

pub fn ok() -> [] int {
    return 0;
}

pub fn kind_invalid() -> [] int {
    return 1;
}

pub fn path_denied() -> [] int {
    return 2;
}

pub fn too_large() -> [] int {
    return 3;
}

// The rule tag of a verdict code; "" for 0.
pub fn rule_name(code: int) -> [] &static [byte] {
    if code == 1 {
        return "patch-kind-invalid";
    }
    if code == 2 {
        return "patch-path-denied";
    }
    if code == 3 {
        return "patch-too-large";
    }
    return "";
}

fn starts[&l, &p](line: &l [byte], prefix: &p [byte]) -> [] bool {
    return len(line) >= len(prefix) && bytes.equal(line[0..len(prefix)], prefix);
}

fn digit(c: int) -> [] bool {
    return c >= 48 && c <= 57;
}

// A number of at most 9 digits at `i` of `s`: (value, next index), next -1 when there is none.
fn number[&s](s: &s [byte], i: int) -> [] (int, int) {
    var k = i;
    var v = 0;
    while k < len(s) && digit(int_of(s[k])) && k - i < 9 {
        v = v * 10 + int_of(s[k]) - 48;
        k = k + 1;
    }
    if k == i || k < len(s) && digit(int_of(s[k])) {
        return (0, 0 - 1);
    }
    return (v, k);
}

// `@@ -a[,b] +c[,d] @@`: the old and new line counts, or old -1 when the line is not a hunk header.
fn hunk_counts[&l](line: &l [byte]) -> [] (int, int) {
    if !starts(line, "@@ -") {
        return (0 - 1, 0);
    }
    let a = number(line, 4);
    if a.1 < 0 {
        return (0 - 1, 0);
    }
    var i = a.1;
    var old = 1;
    if i < len(line) && int_of(line[i]) == 44 {
        let b = number(line, i + 1);
        if b.1 < 0 {
            return (0 - 1, 0);
        }
        old = b.0;
        i = b.1;
    }
    if i + 2 > len(line) || !bytes.equal(line[i..i + 2], " +") {
        return (0 - 1, 0);
    }
    let c = number(line, i + 2);
    if c.1 < 0 {
        return (0 - 1, 0);
    }
    i = c.1;
    var new = 1;
    if i < len(line) && int_of(line[i]) == 44 {
        let d = number(line, i + 1);
        if d.1 < 0 {
            return (0 - 1, 0);
        }
        new = d.0;
        i = d.1;
    }
    if i + 3 > len(line) || !bytes.equal(line[i..i + 3], " @@") {
        return (0 - 1, 0);
    }
    return (old, new);
}

// The path of a `--- base/` or `+++ tree/` line: the bytes after `prefix` up to a TAB or the end.
fn header_path[&l, &p](line: &l [byte], prefix: &p [byte]) -> [] &l [byte] {
    var end = len(prefix);
    while end < len(line) && int_of(line[end]) != 9 {
        end = end + 1;
    }
    return line[len(prefix)..end];
}

// Judge `patch` against the operator row's `publish_allow` and `publish_deny` (nodes `allow` and `deny` of `src`, `deny` -1 for none) and
// the two bounds.
pub fn check[&p, &s, &t](patch: &p [byte], src: &s [byte], tp: &t [int], allow: int, deny: int, max_files: int, max_lines: int) -> [] Verdict {
    var bad = false;
    var denied = false;
    var in_old = 0;
    var in_new = 0;
    var have_old = false;
    var old_start = 0;
    var old_end = 0;
    var have_file = false;
    var files = 0;
    var added = 0;
    var pos = 0;
    while pos < len(patch) {
        var end = pos;
        while end < len(patch) && int_of(patch[end]) != 10 {
            end = end + 1;
        }
        let line = patch[pos..end];
        if in_old > 0 || in_new > 0 {
            let c = 32;
            var first = c;
            if len(line) > 0 {
                first = int_of(line[0]);
            }
            if first == 32 {
                in_old = in_old - 1;
                in_new = in_new - 1;
            } else if first == 45 {
                in_old = in_old - 1;
            } else if first == 43 {
                in_new = in_new - 1;
                added = added + 1;
            } else if first != 92 {
                bad = true;
            }
            if in_old < 0 || in_new < 0 {
                bad = true;
                in_old = 0;
                in_new = 0;
            }
        } else if starts(line, "diff ") {
            have_old = false;
            have_file = false;
        } else if starts(line, "--- ") {
            if !starts(line[4..len(line)], "base/") {
                bad = true;
                have_old = false;
            } else {
                have_old = true;
                old_start = pos + 9;
                old_end = pos + 9 + len(header_path(line[4..len(line)], "base/"));
            }
            have_file = false;
        } else if starts(line, "+++ ") {
            if !have_old || !starts(line[4..len(line)], "tree/") {
                bad = true;
            } else {
                let path = header_path(line[4..len(line)], "tree/");
                if !bytes.equal(path, patch[old_start..old_end]) {
                    bad = true;
                } else {
                    have_file = true;
                    files = files + 1;
                    if !repo_row.path_allowed(src, tp, allow, deny, path) {
                        denied = true;
                    }
                }
            }
            have_old = false;
        } else if starts(line, "@@") {
            let counts = hunk_counts(line);
            if counts.0 < 0 || !have_file {
                bad = true;
            } else {
                in_old = counts.0;
                in_new = counts.1;
            }
        } else if len(line) > 0 && int_of(line[0]) == 92 {
            in_old = 0;
        } else {
            bad = true;
        }
        pos = end + 1;
    }
    if in_old > 0 || in_new > 0 || files == 0 {
        bad = true;
    }
    var code = 0;
    if bad {
        code = kind_invalid();
    } else if denied {
        code = path_denied();
    } else if files > max_files || added > max_lines {
        code = too_large();
    }
    return Verdict { code: code, files: files, added: added };
}

// The files a patch that `check` accepted touches, one path per line, in order, each once (a path the patch names twice is named once). The same
// walk the publish worker applies the patch by (`patch_apply.next_section`).
pub fn paths[&h, &p](heap: &!h Heap, patch: &p [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 128);
    var pos = 0;
    while pos < len(patch) {
        let s = patch_apply.next_section(patch, pos);
        if s.found == false {
            pos = len(patch);
        } else {
            let path = patch[s.path_at..s.path_at + s.path_len];
            var seen = false;
            var filled = false;
            borrow out as &ob in {
                filled = buffer.size(ob) > 0;
                var at = 0;
                let all = buffer.bytes(ob);
                while at < len(all) {
                    var e = at;
                    while e < len(all) && int_of(all[e]) != 10 {
                        e = e + 1;
                    }
                    if bytes.equal(all[at..e], path) {
                        seen = true;
                    }
                    at = e + 1;
                }
            }
            if seen == false {
                if filled {
                    out = buffer.push(heap, out, byte_of(10));
                }
                out = buffer.append(heap, out, path);
            }
            pos = s.end;
        }
    }
    return out;
}
