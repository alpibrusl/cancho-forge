edition 9;
module forge.company_clock;

import std.buffer;
import forge.company_cmd;
import forge.company_manifest;
import forge.company_state;
import forge.company_time;
import forge.journal;
import forge.journal_io;
import forge.task;

// `forge company run <dir> <operator-file> now=YYYY-MM-DD` (docs/company.md section 22): before the run starts, the day is put in the journal
// as a `company.clock.set` record when it is later than the last one. The lock is held. Answers 0 (written, or nothing to write, or a journal
// that does not replay: the run reports that as it always did) or the exit status of a refusal: 1 `clock-went-back` (the journal holds a later
// day; nothing is written), 3 the journal cannot be written.
pub fn mark[&h, &f, &i, &j, &m, &n](heap: &!h Heap, fs: &f Fs(""), io: &!i Io, jpath: &j [byte], hm: &m company_manifest.Manifest, now: &n [byte]) -> [heap, fs_read(""), fs_write(""), file_read, file_write, io_write] int {
    let day = company_time.day_of(now);
    let existed = journal_io.exists(fs, jpath);
    let (data, errno) = journal_io.read_all(heap, fs, jpath);
    var code = 0;
    if errno == 0 {
        borrow data as &db in {
            let state = company_state.replay(heap, buffer.bytes(db), hm);
            borrow state as &sr in {
                let rep = company_state.report_of(sr);
                if rep.rule == 0 {
                    if day < company_state.last_day(sr) {
                        company_cmd.refuse(io, company_time.rule_went_back());
                        code = 1;
                    } else if day > company_state.last_day(sr) {
                        let cut_to = journal.recovery_cut(rep);
                        var failed = false;
                        if cut_to >= 0 {
                            failed = journal_io.cut_torn_tail(fs, jpath, cut_to) != 0;
                        }
                        if failed == false {
                            let ev = company_state.clock_set(heap, rep.records + 1, now);
                            borrow ev as &eb in {
                                failed = journal_io.append(fs, jpath, buffer.bytes(eb), existed == false) != 0;
                            }
                            buffer.drop(heap, ev);
                        }
                        if failed {
                            company_cmd.line(io, "error: cannot write company.journal", "");
                            code = 3;
                        }
                    }
                }
            }
            company_state.drop(heap, state);
        }
    }
    buffer.drop(heap, data);
    return code;
}
