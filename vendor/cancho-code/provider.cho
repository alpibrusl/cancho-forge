// Vendored verbatim from cancho-code 6fcac18, src/provider.cho (EUPL-1.2, Copyright (c) 2026 Alpibru S.L., the same entity): the transport of the model review worker (docs/review-step.md). No other change.
edition 7;

module provider;

// `provider` — the Mistral agent over native HTTPS (issue #4, design §5):
// one `POST /v1/chat/completions` to `api.mistral.ai`, the request the
// API's JSON, the response body handed back for the driver to take the
// model's edited file out of.
//
// Native HTTPS, not a spawned `curl`: `packages/http-client` is pure
// cancho, and the I/O here is `vendor/fetch_io.cho` — the compiler's own
// `examples/http_fetch_nb/fetch_io.cho`, moved verbatim, as its header
// says to do ("an example module and not a package, for the reason
// `tls_echo/front.cho` is: the second program that needs it moves it" —
// this is the second program).
//
// The authority story, stated rather than hidden (design §8): the TLS
// engine is `packages/tls`, which uses the system's OpenSSL through
// `Ffi("libc")` — one foreign library, a number in the report. The
// network is `net_out` with the host a literal in this file
// (`api.mistral.ai`) but the report cannot bound a host DNS names, so
// the tests say which host is reached, the way `hooks-mcp`'s report does.
// The API key is never a literal and never written: the caller reads it
// from its own environment and hands it over as a slice that lives only
// as long as the request headers.
//
// What this module does not do: it does not edit any file (the driver
// writes the project file; this is the transport), and it does not retry
// (a failed transport answers `Failed` with a stable tag; the caller
// maps it to the loop's `ProviderOutage` — a wait, not a burn, §4).

import fetch_io as fio;
import http_client as hc;
import http_client_wire as wire;
import std.buffer;
import std.io;
import tls;

// How one completion attempt ended.
pub enum Answered {
    // The response body (the API's JSON, `choices[0].message.content`
    // among it), in a buffer the caller owns and must drop. The status
    // comes with it: the caller decides what a 4xx answer means.
    Ok(int, buffer.Buffer),
    // The transport refused: the tag is one of the `r_*` values below.
    Failed(int),
}

pub fn r_connect() -> [] int { return 1; }
pub fn r_tls() -> [] int { return 2; }
pub fn r_timeout() -> [] int { return 3; }
pub fn r_too_much() -> [] int { return 4; }
pub fn r_no_roots() -> [] int { return 5; }

// The tag a `Failed` carries, stable for the verdict line and the report.
pub fn tag_of(tag: int) -> [] &static [byte] {
    if tag == 1 { return "connect"; }
    if tag == 2 { return "tls"; }
    if tag == 3 { return "timeout"; }
    if tag == 4 { return "too-much"; }
    if tag == 5 { return "no-roots"; }
    // 100 + the client's own failure code: its tag says what it refused
    if tag > 100 { return hc.refusal_tag(tag - 100); }
    return "transport";
}

// One HTTPS POST to `api.mistral.ai:443`.
//
//   `key`     the API key, from the caller's environment
//   `body`    the request body, JSON the caller built (the model's task
//             and the file to edit, escaped — `append_escaped` below)
//   `roots`   the PEM bundle to trust; nothing is built in, the same
//             rule as `http_fetch_nb`: an https call is checked against
//             what the operator handed it or refused
//   `ip`      the IPv4 literal as text ("203.0.113.7"): where `api.mistral.ai` resolved to — resolving
//             is the caller's, exactly `http-client.md` §3.8, because a
//             resolver is a policy
//   `entropy` 32 bytes for the TLS engine
//   `most`    the bound on the response body, the caller's policy
//   `wait_ms` the whole attempt's deadline: one number, no hang
//
// `host_for()` names the host twice — once in the HTTP `Host:` header the
// client sends, once as the name the certificate must carry — from the
// same literal, so they cannot disagree.
pub fn host_for() -> [] &static [byte] {
    return "api.mistral.ai";
}

pub fn complete[&h, &n, &c, &i, &k, &b, &r, &a, &e](heap: &!h Heap, net: &n Net(""), clock: &c Clock, io: &!i Io, key: &k [byte], body: &b [byte], roots: &r [byte], ip: &a [byte], entropy: &e [byte], most: int, wait_ms: int) -> [heap, net_out(""), conn_read, conn_write, poll, clock] Answered {
    // Mistral's headers: the key as a bearer token, the body as JSON. Each
    // line ends CRLF (http-client.md: `extra` is `Name: value` lines).
    var headers = buffer.empty(heap, 256);
    headers = buffer.append(heap, headers, "Authorization: Bearer ");
    headers = buffer.append(heap, headers, key);
    headers = buffer.append(heap, headers, "\r\nContent-Type: application/json\r\n");
    var status = 0;
    var tag = 0;
    var got = false;
    var out = buffer.empty(heap, 16);
    borrow headers as &hb in {
        match exchange(heap, net, clock, io, host_for(), 443, true, "/v1/chat/completions", buffer.bytes(hb), body, roots, ip, entropy, most, wait_ms) {
            Answered::Ok(st, o) => {
                status = st;
                got = true;
                buffer.drop(heap, out);
                out = o;
            }
            Answered::Failed(t) => {
                tag = t;
            }
        }
    }
    buffer.drop(heap, headers);
    if got {
        return Answered::Ok(status, out);
    }
    buffer.drop(heap, out);
    return Answered::Failed(tag);
}

// One POST to any host, over TLS or plain TCP — the transport every
// provider shares. The caller names everything (nothing is a default):
//
//   `host`     the `Host:` header and, over TLS, the name the certificate
//              must carry and the SNI
//   `port`     the TCP port
//   `secure`   TLS on or off; off is for a local server (Ollama)
//   `path`     the request target
//   `headers`  zero or more `Name: value` lines each ending CRLF, none of
//              `Host` or `Content-Length` (the client writes those)
//   the rest   as `complete` above
pub fn exchange[&h, &n, &c, &i, &t, &p, &x, &b, &r, &a, &e](heap: &!h Heap, net: &n Net(""), clock: &c Clock, io: &!i Io, host: &t [byte], port: int, secure: bool, path: &p [byte], headers: &x [byte], body: &b [byte], roots: &r [byte], ip: &a [byte], entropy: &e [byte], most: int, wait_ms: int) -> [heap, net_out(""), conn_read, conn_write, poll, clock] Answered {
    match fio.open(heap, 1, secure) {
        fio.Started::Failed(e) => {
            return Answered::Failed(r_tls());
        }
        fio.Started::Ok(opened) => {
            var trust = 1;
            borrow mut opened as &!ioh in {
                if secure {
                    trust = fio.trust(ioh, roots);
                    fio.seed(ioh, entropy);
                }
            }
            if trust < 1 {
                fio.close(heap, opened);
                return Answered::Failed(r_no_roots());
            }
            var up = -1;
            borrow mut opened as &!ouh in {
                up = fio.add_upstream(ouh, ip, port, secure, host);
            }
            if up < 0 {
                fio.close(heap, opened);
                return Answered::Failed(r_connect());
            }
            return pump(heap, net, clock, io, opened, host, path, headers, body, most, wait_ms);
        }
    }
}

// ---- waiting when the API says "not now" ------------------------------------------------------------------------------------------------
//
// Several units asked for at once (docs/parallel.md) can pass the API's rate limit, and a busy API says so: 429 (too many requests) or 529 (overloaded).
// That is a wait, not an attempt: `exchange_waiting` asks again after a pause, at most `max_waits()` times, the pauses `first_ms`, twice that, four
// times, ... at most 60 seconds each (the same every time: nothing random, so a run can be replayed and a gate can count them), and says so on the
// standard error. After the last wait the answer is whatever the API said, 429 included, and the caller treats it as it always has (an error: the agent
// gives up and the unit is "unavailable").

// Do these statuses mean "ask again later" rather than "this request is wrong"?
pub fn busy(status: int) -> [] bool {
    return status == 429 || status == 529;
}

// How many times a busy answer is waited out.
pub fn max_waits() -> [] int {
    return 6;
}

// The pause before wait `k` (1 is the first): `first_ms` doubled `k - 1` times, at most 60000.
pub fn delay_ms(first_ms: int, k: int) -> [] int {
    var d = first_ms;
    var i = 1;
    while i < k && d < 60000 {
        d = d * 2;
        i = i + 1;
    }
    if d > 60000 {
        d = 60000;
    }
    return d;
}

// Sleep `ms` milliseconds on a poller with nothing on it.
fn nap[&h, &c](heap: &!h Heap, clock: &c Clock, ms: int) -> [heap, poll, clock] int {
    match poller_new() {
        Polling::Failed(e) => {
            return e;
        }
        Polling::Ok(p) => {
            var poller = p;
            let events = box_slice(heap, 4, 0);
            let until = clock_ms(clock) + ms;
            while clock_ms(clock) < until {
                borrow mut events as &!ew in {
                    borrow mut poller as &!ph in {
                        poller_wait(ph, contents(ew), until - clock_ms(clock));
                    }
                }
            }
            unbox_slice(heap, events);
            poller_close(poller);
            return 0;
        }
    }
}

fn status_of[&a](answer: &a Answered) -> [] int {
    match answer {
        Answered::Ok(st, o) => {
            return *st;
        }
        Answered::Failed(tag) => {
            return 0;
        }
    }
}

fn drop_answer[&h](heap: &!h Heap, answer: Answered) -> [heap] int {
    match answer {
        Answered::Ok(st, o) => {
            buffer.drop(heap, o);
            return st;
        }
        Answered::Failed(tag) => {
            return 0 - tag;
        }
    }
}

// `exchange`, waiting out 429 and 529: the answer, how many waits there were, how long they were together (ms) and the first busy status.
pub fn exchange_waiting[&h, &n, &c, &i, &t, &p, &x, &b, &r, &a, &e](heap: &!h Heap, net: &n Net(""), clock: &c Clock, io: &!i Io, host: &t [byte], port: int, secure: bool, path: &p [byte], headers: &x [byte], body: &b [byte], roots: &r [byte], ip: &a [byte], entropy: &e [byte], most: int, wait_ms: int, first_ms: int) -> [heap, net_out(""), conn_read, conn_write, poll, clock, err_write] (Answered, int, int, int) {
    var waits = 0;
    var waited = 0;
    var first_status = 0;
    var answer = exchange(heap, net, clock, io, host, port, secure, path, headers, body, roots, ip, entropy, most, wait_ms);
    var going = true;
    while going {
        var status = 0;
        borrow answer as &ar in {
            status = status_of(ar);
        }
        if busy(status) && waits < max_waits() {
            waits = waits + 1;
            if first_status == 0 {
                first_status = status;
            }
            let pause = delay_ms(first_ms, waits);
            var msg = buffer.append(heap, buffer.empty(heap, 128), "cancho-agent: the API answered ");
            msg = buffer.push_nat(heap, msg, status);
            msg = buffer.append(heap, msg, " (busy); waiting ");
            msg = buffer.push_nat(heap, msg, pause);
            msg = buffer.append(heap, msg, " ms before try ");
            msg = buffer.push_nat(heap, msg, waits + 1);
            msg = buffer.append(heap, msg, "\n");
            borrow msg as &mb in {
                io.error_all(io, buffer.bytes(mb));
            }
            buffer.drop(heap, msg);
            nap(heap, clock, pause);
            waited = waited + pause;
            drop_answer(heap, answer);
            answer = exchange(heap, net, clock, io, host, port, secure, path, headers, body, roots, ip, entropy, most, wait_ms);
        } else {
            going = false;
        }
    }
    return (answer, waits, waited, first_status);
}

// The request, the send, and the read, until Done or the deadline. No
// hang: `wait_ms` is the whole attempt's ceiling, and every stop is
// named.
fn pump[&h, &n, &c, &i, &t, &p, &x, &b](heap: &!h Heap, net: &n Net(""), clock: &c Clock, io: &!i Io, iox: fio.Loop, host: &t [byte], path: &p [byte], headers: &x [byte], body: &b [byte], most: int, wait_ms: int) -> [heap, net_out(""), conn_read, conn_write, poll, clock] Answered {
    // The loop's whole state travels by value (`var iov = iox`, the shape
    // `fetch.cho`'s `run` uses): the dial gives it back changed, and the
    // borrows are taken per call, not held — a held `&!` borrow freezes
    // the value (the checker says so, and the checker is right).
    var iov = iox;
    var client = hc.open(heap, 1, 65536, 16384, hc.default_limits());
    var status = 0;
    var ok_done = false;
    var refused = 0;
    var why = 0;
    var out = buffer.empty(heap, 1024);
    borrow mut client as &!cw in {
        region hd {
            // One request: POST, the JSON body sized by its length, the
            // caller's header lines beside it. A key rides a header and
            // exists nowhere else.
            if true {
                let t = hc.request(cw, clock_ms(clock), 0, "POST", path, host, headers, len(body), 0);
                if t < 0 {
                    refused = r_connect();
                } else {
                    var sent = 0;
                    // The pump: step the transport, drain the events,
                    // collect the body, until Done or the deadline. No
                    // hang: `wait_ms` is the whole attempt's ceiling, and
                    // every stop is named.
                    var done = false;
                    var failed = false;
                    let started = clock_ms(clock);
                    var now = started;
                    while done == false && failed == false && refused == 0 && now - started < wait_ms {
                        // The request body, fed as the client has room: its
                        // output buffer is smaller than a body (16 KiB, and
                        // a language page alone is 29 KB), so the rest goes
                        // in on later turns, as the transport drains.
                        var sending = sent < len(body);
                        while sending {
                            let room = hc.send_room(cw, t);
                            var n = len(body) - sent;
                            if n > room {
                                n = room;
                            }
                            if n <= 0 {
                                sending = false;
                            } else {
                                let m = hc.send_body(cw, t, body[sent..sent + n], clock_ms(clock));
                                if m < 0 {
                                    sending = false;
                                } else {
                                    sent = sent + m;
                                    if sent >= len(body) {
                                        sending = false;
                                    }
                                }
                            }
                        }
                        borrow mut iov as &!ioh in {
                            fio.step(ioh, cw, clock, 100);
                        }
                        now = clock_ms(clock);
                        var going = true;
                        while going {
                            match hc.poll(cw, now) {
                                hc.Event::None => {
                                    going = false;
                                }
                                hc.Event::Connect(slot) => {
                                    iov = fio.dial(heap, iov, net, cw, slot, now);
                                }
                                hc.Event::Close(slot) => {
                                    borrow mut iov as &!ioh in {
                                        fio.shut(ioh, cw, slot, now);
                                    }
                                }
                                hc.Event::Head(tk) => {
                                    status = hc.status(cw, tk);
                                }
                                hc.Event::Body(tk) => {
                                    let n = hc.avail(cw, tk);
                                    borrow out as &ob in {
                                        // The bound: `most` is the
                                        // caller's, and a body past it is
                                        // refused, not silently kept.
                                        if buffer.size(ob) + n > most {
                                            failed = true;
                                        }
                                    }
                                    if failed == false {
                                        out = buffer.append(heap, out, hc.body(cw, tk)[0..n]);
                                    }
                                    hc.consume(cw, tk, n, now);
                                }
                                hc.Event::Done(tk) => {
                                    done = true;
                                }
                                hc.Event::Failed(tk) => {
                                    failed = true;
                                    why = hc.failure(cw, tk);
                                }
                                _ => {
                                    going = false;
                                }
                            }
                        }
                    }
                    if done && failed == false {
                        ok_done = true;
                    } else {
                        if failed {
                            refused = r_too_much();
                            if why != 0 {
                                refused = 100 + why;
                            }
                        } else {
                            refused = r_timeout();
                        }
                    }
                }
            }
        }
    }
    hc.close(heap, client);
    fio.close(heap, iov);
    // The answer is built exactly once, from plain values: `out` is moved
    // into it on the one path that made it.
    if ok_done {
        return Answered::Ok(status, out);
    }
    buffer.drop(heap, out);
    return Answered::Failed(refused);
}

// One string embedded in a JSON body, escaped as `std.json`'s writer
// escapes: the two bytes that must not appear raw (the quote and the
// backslash) and the control characters, in their six-byte form.
pub fn append_escaped[&h, &t](heap: &!h Heap, out: buffer.Buffer, text: &t [byte]) -> [heap] buffer.Buffer {
    var b = out;
    var i = 0;
    while i < len(text) {
        let c = text[i];
        if c == byte_of(34) {
            b = buffer.append(heap, b, "\\\"");
        } else {
            if c == byte_of(92) {
                b = buffer.append(heap, b, "\\\\");
            } else {
                if int_of(c) < 32 {
                    b = buffer.append(heap, b, "\\u00");
                    let n = int_of(c);
                    let hi = n / 16;
                    let lo = n - hi * 16;
                    let hex: &static [byte] = "0123456789abcdef";
                    b = buffer.push(heap, b, hex[hi]);
                    b = buffer.push(heap, b, hex[lo]);
                } else {
                    b = buffer.push(heap, b, c);
                }
            }
        }
        i = i + 1;
    }
    return b;
}
